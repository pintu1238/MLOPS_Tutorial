

{% liquid
  assign block_settings = block.settings
  assign use_inverse_logo = false

  if section.settings.enable_transparent_header_home and template.name == 'index' and section.settings.home_inverse_logo == true
    assign use_inverse_logo = true
  elsif section.settings.enable_transparent_header_product and template.name == 'product' and section.settings.product_inverse_logo == true
    assign use_inverse_logo = true
  elsif section.settings.enable_transparent_header_collection and template.name == 'collection' and section.settings.collection_inverse_logo == true
    assign use_inverse_logo = true
  endif

  if use_inverse_logo
    if settings.logo_inverse != blank
      assign inverse_logo = settings.logo_inverse
    else
      assign inverse_logo = settings.logo
    endif
  endif

  assign alt_text_fallback = 'accessibility.home_logo_alt' | t: store_name: shop.name
%}

{% comment %}
  Output all logo variants, use CSS to hide/show the appropriate one
  based on the .header[transparent] selector
{% endcomment %}
<a
  {% if template.name == 'index' and block_settings.hide_logo_on_home_page %}
    data-hidden-on-home-page
  {% endif %}
  href="{{ routes.root_url }}"
  class="size-style spacing-style header-logo"
  style="
    {% render 'size-style', settings: block_settings %}
    {% render 'spacing-style', settings: block_settings %}
    --font-family: var(--font-heading--family), "Playfair Display", Georgia, serif;
    --font-style: normal;
    --font-weight: 500;
    letter-spacing: 0.04em;
    font-size: 1.35rem;
  "
  {{ block.shopify_attributes }}
>
  {% liquid
    assign brand_logo_aspect = 5.5
    if settings.logo != blank
      assign brand_logo_aspect = settings.logo.aspect_ratio
    endif
    assign logo_height = settings.logo_height | default: 36
    assign logo_height_mobile = settings.logo_height_mobile | default: 28
    assign logo_width = logo_height | times: brand_logo_aspect | ceil
    assign logo_width_mobile = logo_height_mobile | times: brand_logo_aspect | ceil
    assign logo_style = '--header-logo-image-width: ' | append: logo_width | append: 'px;' | append: '--header-logo-image-width-mobile: ' | append: logo_width_mobile | append: 'px; --header-logo-image-height: ' | append: logo_height | append: 'px; --header-logo-image-height-mobile: ' | append: logo_height_mobile | append: 'px;'
    if settings.logo != blank
      assign inverse_logo_width = logo_height | times: inverse_logo.aspect_ratio | ceil
      assign inverse_logo_width_mobile = logo_height_mobile | times: inverse_logo.aspect_ratio | ceil
      assign inverse_logo_style = '--header-logo-image-width: ' | append: inverse_logo_width | append: 'px;' | append: '--header-logo-image-width-mobile: ' | append: inverse_logo_width_mobile | append: 'px; --header-logo-image-height: ' | append: logo_height | append: 'px; --header-logo-image-height-mobile: ' | append: logo_height_mobile | append: 'px;'
    endif
  %}

  {% if settings.logo == blank %}
    <span class="header-logo__brand-asset gw-brand" data-testid="header-logo">
      <span class="gw-brand__stack">
        <span class="gw-brand__title">Luxe Step</span>
        <span class="gw-brand__tagline">Footwear</span>
      </span>
    </span>
  {% else %}
    <span
      {% if use_inverse_logo %}
        class="header-logo__solid-header-image-container"
      {% endif %}
      data-testid="header-logo"
    >
      {% render 'image',
        image: settings.logo,
        class: 'header-logo__image',
        height: settings.logo_height,
        alt_text_fallback: alt_text_fallback,
        text_fallback: 'Luxe Step',
        style: logo_style
      %}
    </span>

    {% if use_inverse_logo %}
      <span
        class="header-logo__transparent-header-image-container"
        data-testid="header-logo-inverse"
      >
        {% render 'image',
          image: inverse_logo,
          class: 'header-logo__image',
          height: settings.logo_height,
          alt_text_fallback: alt_text_fallback,
          text_fallback: 'Luxe Step',
          style: inverse_logo_style
        %}
      </span>
    {% endif %}
  {% endif %}
</a>

{% stylesheet %}
  .header-logo {
    display: flex;
    height: 100%;
    font-size: var(--font-size--md);
    font-family: var(--font-family);
    font-weight: var(--font-weight);
    font-style: var(--font-style);
    color: var(--color-foreground);
    justify-content: center;
    align-items: center;
    text-decoration: none;

    &[data-hidden-on-home-page] {
      display: none;

      #header-component:is(
          [sticky='always']:not([data-scroll-direction='none']),
          [sticky='scroll-up'][data-scroll-direction='up']
        )
        & {
        display: flex;
      }
    }

    @media screen and (max-width: 749px) {
      padding: 0;
    }

    @media screen and (min-width: 750px) {
      flex-shrink: 0;
    }

    &:hover {
      text-decoration: none;
    }
  }

  .header-logo__image {
    display: block;
    object-fit: contain;
    object-position: left center;
    height: var(--header-logo-image-height-mobile);
    width: var(--header-logo-image-width-mobile);
    max-width: min(var(--header-logo-image-width-mobile), 58vw);

    @media screen and (min-width: 750px) {
      height: var(--header-logo-image-height);
      width: var(--header-logo-image-width);
      max-width: min(var(--header-logo-image-width), 320px);
    }
  }

  @media screen and (min-width: 750px) {
    .gw-brand__mark {
      width: 42px;
      height: 42px;
    }

    .header-logo .gw-brand__title {
      font-size: clamp(1.15rem, 1.35vw, 1.5rem);
      letter-spacing: 0.22em;
    }

    .header-logo .gw-brand__tagline {
      font-size: 0.62rem;
    }
  }

  @media screen and (max-width: 749px) {
    .header-logo__brand-asset.gw-brand {
      gap: 8px;
      justify-content: center;
    }

    .gw-brand__mark {
      width: 32px;
      height: 32px;
    }

    .gw-brand__stack {
      text-align: center;
    }

    .header-logo .gw-brand__title {
      font-size: 1rem;
      letter-spacing: 0.12em;
    }

    .header-logo .gw-brand__tagline {
      font-size: 0.58rem;
      letter-spacing: 0.32em;
    }

    .gw-brand__stack {
      align-items: center;
      text-align: center;
    }
  }

  .header-logo__brand-asset {
    display: flex;
    align-items: center;
    line-height: 0;
    gap: 10px;
    min-width: 0;
    max-width: 100%;
  }

  .header-logo__brand-asset.gw-brand {
    line-height: 1;
  }

  .gw-brand__mark {
    display: block;
    flex: 0 0 auto;
    width: 36px;
    height: 36px;
  }

  .gw-brand__stack {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    min-width: 0;
    text-align: start;
    line-height: 1.15;
  }

  .header-logo .gw-brand__tagline {
    display: block;
    font-family: Inter, 'Segoe UI', system-ui, sans-serif;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: #c4a574;
    line-height: 1.2;
  }

  .header-logo__solid-header-image-container {
    display: var(--header-logo-display, block);
  }

  .header-logo__transparent-header-image-container {
    display: var(--header-logo-inverse-display, none);
  }

  .gw-brand {
    display: grid;
    gap: 2px;
    line-height: 1;
    text-align: center;
    justify-items: center;
  }

  .header-logo .gw-brand__title {
    font-family: var(--gw-font-heading);
    font-size: clamp(1.05rem, 1.7vw, 1.45rem);
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #0a0a0a;
  }

  .header-logo .gw-brand__script {
    font-family: var(--gw-font-ui);
    font-size: 0.58rem;
    font-weight: 600;
    color: var(--gw-gold, #c4a574);
    letter-spacing: 0.34em;
    text-transform: uppercase;
    margin-top: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.logo",
  "tag": null,
  "class": "header-logo",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.edit_logo_in_theme_settings"
    },
    {
      "type": "header",
      "content": "t:content.visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_logo_on_home_page",
      "label": "t:settings.hide_logo_on_home_page",
      "info": "t:info.hide_logo_on_home_page_help"
    },
    {
      "type": "header",
      "content": "t:content.padding_desktop"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
