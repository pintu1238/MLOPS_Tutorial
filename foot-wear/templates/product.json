        "faq_1": {
          "type": "faq",
          "settings": {
            "kicker": "Comfort",
            "question": "Can I wear these all day?",
            "answer": "<p>Yes. Cushioned footbeds and balanced heel height are tuned for commutes, office hours, and evenings out — without the stiff soles or hot spots you get from ordinary pairs.</p>"
          }
        },
        "faq_2": {
          "type": "faq",
          "settings": {
            "kicker": "Quality",
            "question": "How is Solmarch different from fast-fashion shoes?",
            "answer": "<p>We use full-grain leather and suede, reinforced stitching, and finishes meant to look sharp season after season — not tired after a few wears.</p>"
          }
        },
        "faq_3": {
          "type": "faq",
          "settings": {
            "kicker": "Sizing",
            "question": "Which size should I order?",
            "answer": "<p>Use the Size Guide on this page (US 5–12). Measure foot length if you are between sizes and size up for a roomier fit. Free exchanges if the size is off.</p>"
          }
        },
        "faq_4": {
          "type": "faq",
          "settings": {
            "kicker": "Care",
            "question": "How do I clean and store them?",
            "answer": "<p>Wipe leather with a soft cloth, brush suede gently, and use protector spray outdoors. Store in a cool, dry place; shoe trees help leather keep its shape.</p>"
          }
        },
        "faq_5": {
          "type": "faq",
          "settings": {
            "kicker": "Fit",
            "question": "Do they run true to size?",
            "answer": "<p>Most styles run true to US sizing. If you have a wide foot or plan thick socks, consider sizing up half a size where available.</p>"
          }
        },
        "faq_6": {
          "type": "faq",
          "settings": {
            "kicker": "Shipping",
            "question": "When will they arrive? What if I do not love them?",
            "answer": "<p>Orders ship in 2–3 business days with tracking. Try them at home for up to 90 days — full refund if they are not right for you.</p>"
          }
        }
