{% comment %}
  Trust badges — home (Shop With Confidence) or product bar above footer.
{% endcomment %}

{% liquid
  assign layout = section.settings.layout | default: 'standard'
%}

<section class="gw-confidence gw-confidence--{{ layout }}">
  {% if section.settings.heading != blank %}
    <h2 class="gw-confidence__heading">{{ section.settings.heading | escape }}</h2>
  {% endif %}

  <ul
    class="gw-confidence__grid list-unstyled{% if layout == 'product_bar' %} gw-confidence__grid--product{% endif %}"
    role="list"
  >
    {% for block in section.blocks %}
      <li class="gw-confidence__item" {{ block.shopify_attributes }}>
        {% if layout == 'product_bar' %}
          <div class="gw-confidence__bubble" aria-hidden="true">
            {% render 'gw-icon', name: block.settings.icon, class: 'gw-icon--trust-bubble' %}
          </div>
        {% else %}
          <div class="gw-confidence__icon" aria-hidden="true">
            {% render 'gw-icon', name: block.settings.icon, class: 'gw-icon--trust' %}
          </div>
        {% endif %}
        {% if block.settings.title != blank %}
          <h3 class="gw-confidence__title">{{ block.settings.title | escape }}</h3>
        {% endif %}
        {% if block.settings.text != blank %}
          {% if layout != 'product_bar' or section.settings.show_descriptions %}
            <p class="gw-confidence__text">{{ block.settings.text | escape }}</p>
          {% endif %}
        {% endif %}
      </li>
    {% endfor %}
  </ul>
</section>

{% stylesheet %}
  .gw-confidence {
    padding: 56px 4vw 64px;
    background: #ffffff;
    text-align: center;
    font-family: var(--font-body--family), var(--gw-font-ui);
    color: #1c1412;
  }

  .gw-confidence--product_bar {
    padding: 40px 4vw;
    border-top: 1px solid rgb(0 0 0 / 0.06);
  }

  .gw-confidence__heading {
    margin: 0 0 40px;
    font-family: var(--font-heading--family, var(--font-heading-family, Georgia, serif));
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #3d2a33;
  }

  .gw-confidence__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 4vw, 48px);
    max-width: 1100px;
    margin: 0 auto;
    padding: 0;
  }

  .gw-confidence__grid--product {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(16px, 2.5vw, 28px);
    max-width: 1120px;
  }

  .gw-confidence__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .gw-confidence--product_bar .gw-confidence__item {
    gap: 12px;
  }

  .gw-confidence__bubble {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #faf0eb;
  }

  .gw-confidence__icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .gw-confidence__title {
    margin: 0;
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: none;
    color: #3d2a33;
  }

  .gw-confidence--product_bar .gw-confidence__title {
    font-size: clamp(0.75rem, 1.45vw, 0.88rem);
    line-height: 1.4;
    letter-spacing: 0.04em;
    font-weight: 600;
    color: #3d2a33;
    max-width: 16ch;
  }

  .gw-confidence__text {
    margin: 0;
    max-width: 28ch;
    font-family: inherit;
    font-size: 0.82rem;
    line-height: 1.55;
    font-weight: 400;
    color: #5c524c;
  }

  .gw-confidence--product_bar .gw-confidence__text {
    max-width: 22ch;
    font-size: 0.78rem;
    color: #5c524c;
  }

  @media screen and (max-width: 989px) {
    .gw-confidence__grid--product {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .gw-confidence {
      width: 100%;
      max-width: 100%;
      padding: 32px 16px 36px;
      box-sizing: border-box;
    }

    .gw-confidence__heading {
      margin-bottom: 24px;
      font-size: 1.35rem;
    }

    .gw-confidence__grid {
      grid-template-columns: 1fr;
      gap: 22px;
      width: 100%;
    }

    .gw-confidence__item {
      gap: 10px;
    }

    .gw-confidence__text {
      font-size: 0.8rem;
      line-height: 1.5;
    }

    .gw-confidence__grid--product {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px 12px;
      width: 100%;
      max-width: 100%;
    }

    .gw-confidence--product_bar .gw-confidence__title {
      max-width: none;
      font-size: 0.72rem;
    }

    .gw-confidence__text {
      max-width: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "GW shop with confidence",
  "tag": "section",
  "class": "gw-confidence-section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "standard", "label": "Home — large icons" },
        { "value": "product_bar", "label": "Product — compact bar" }
      ],
      "default": "standard"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop With Confidence"
    },
    {
      "type": "checkbox",
      "id": "show_descriptions",
      "label": "Show descriptions (product bar)",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'product_bar' }}"
    }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Trust item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shipping", "label": "Shipping" },
            { "value": "returns", "label": "Returns / guarantee" },
            { "value": "secure", "label": "Secure checkout" },
            { "value": "support", "label": "Support" },
            { "value": "heart", "label": "Heart" }
          ],
          "default": "shipping"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Worldwide Shipping"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "We offer fast worldwide delivery options, all with secure tracking for peace of mind."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GW shop with confidence"
    }
  ]
}
{% endschema %}
