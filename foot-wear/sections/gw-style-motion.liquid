{% comment %}
  Watch & Shop — vertical video reel row (Style in Motion).
{% endcomment %}

{% style %}
  #shopify-section-{{ section.id }} {
    margin-block: 0;
    background: #ffffff;
  }
{% endstyle %}

<gw-style-motion class="gw-motion">
  <div class="gw-motion__inner">
    <header class="gw-motion__head">
      <p class="gw-motion__eyebrow">
        <span class="gw-motion__eyebrow-icon">{% render 'gw-icon', name: 'play', class: 'gw-icon--play' %}</span>
        {{ section.settings.eyebrow | escape }}
      </p>
      {% if section.settings.heading != blank %}
        <h2 class="gw-motion__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.subtext != blank %}
        <p class="gw-motion__sub">{{ section.settings.subtext | escape }}</p>
      {% endif %}
    </header>

    <div class="gw-motion__row" data-gw-motion-carousel>
      <button
        type="button"
        class="gw-motion__arrow"
        data-gw-motion-prev
        aria-label="{{ 'content.pagination.previous' | t }}"
      >
        {% render 'gw-icon', name: 'chevron-left', class: 'gw-icon--nav' %}
      </button>

      <div class="gw-motion__viewport" data-gw-motion-viewport tabindex="0">
        <ul class="gw-motion__track list-unstyled" role="list">
      {% for block in section.blocks %}
        {% liquid
          assign video_src = blank
          if block.settings.video != blank
            assign video_src = block.settings.video.sources[1].url | default: block.settings.video.sources[0].url
          elsif block.settings.video_asset != blank
            assign video_src = block.settings.video_asset | asset_url
          endif
          assign poster_src = blank
          if block.settings.poster != blank
            assign poster_src = block.settings.poster | image_url: width: 600
          elsif block.settings.poster_asset != blank
            assign poster_src = block.settings.poster_asset | asset_url
          endif
        %}
        <li class="gw-motion__card-wrap" {{ block.shopify_attributes }}>
          <div class="gw-motion__card" data-gw-motion-card>
            {% if video_src != blank %}
              <video
                class="gw-motion__video"
                src="{{ video_src }}"
                {% if poster_src != blank %}
                  poster="{{ poster_src }}"
                {% endif %}
                muted
                playsinline
                loop
                autoplay
                preload="auto"
                disablepictureinpicture
                disableremoteplayback
              ></video>
            {% endif %}
            {% if block.settings.label != blank %}
              <span class="gw-motion__label">{{ block.settings.label | escape }}</span>
            {% endif %}
          </div>
        </li>
      {% endfor %}
        </ul>
      </div>

      <button
        type="button"
        class="gw-motion__arrow"
        data-gw-motion-next
        aria-label="{{ 'content.pagination.next' | t }}"
      >
        {% render 'gw-icon', name: 'chevron-right', class: 'gw-icon--nav' %}
      </button>
    </div>
  </div>
</gw-style-motion>

<script src="{{ 'gw-style-motion.js' | asset_url }}" defer></script>

{% stylesheet %}
  .gw-motion {
    box-sizing: border-box;
    padding-block: 40px;
    margin-block: 0;
    padding-inline: 0;
    background: #ffffff;
    color: #1c1412;
    overflow: hidden;
  }

  .gw-motion__inner {
    box-sizing: border-box;
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: clamp(20px, 4vw, 40px);
  }

  .gw-motion__head {
    margin: 0 auto 36px;
    text-align: center;
  }

  .gw-motion__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 12px;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #a42325;
    font-weight: 600;
  }

  .gw-motion__eyebrow-icon {
    display: inline-flex;
    width: 22px;
    height: 22px;
    align-items: center;
    justify-content: center;
    border: 1px solid currentcolor;
    border-radius: 4px;
    font-size: 0.55rem;
  }

  .gw-motion__heading {
    margin: 0 0 10px;
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 600;
    line-height: 1.1;
  }

  .gw-motion__sub {
    margin: 0 auto;
    max-width: 46ch;
    font-size: 0.92rem;
    line-height: 1.5;
    color: #4a403c;
  }

  .gw-motion__row {
    width: 100%;
    margin-inline: auto;
    padding-block: 4px 8px;
  }

  .gw-motion__card {
    position: relative;
    display: block;
    border-radius: 14px;
    overflow: hidden;
    aspect-ratio: 9 / 16;
    background: #e8dfd2;
    color: inherit;
    box-shadow: 0 8px 28px rgb(0 0 0 / 0.08);
    cursor: default;
    user-select: none;
  }

  @media screen and (max-width: 989px) {
    .gw-motion__row {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: clamp(8px, 1.5vw, 16px);
      max-width: 520px;
    }

    .gw-motion__arrow {
      flex-shrink: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border: 1px solid #d5ccc3;
      border-radius: 50%;
      background: #ffffff;
      color: #1c1412;
      font-size: 1.5rem;
      line-height: 1;
      cursor: pointer;
      box-shadow: 0 2px 10px rgb(28 20 18 / 0.06);
    }

    .gw-motion__arrow:hover {
      border-color: #1c1412;
    }

    .gw-motion__arrow:disabled {
      opacity: 0.35;
      cursor: default;
    }

    .gw-motion__viewport {
      container-type: inline-size;
      width: 100%;
      min-width: 0;
      overflow-x: auto;
      overflow-y: hidden;
      overscroll-behavior-x: contain;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      scrollbar-width: none;
      cursor: grab;
    }

    .gw-motion__viewport.is-dragging {
      cursor: grabbing;
      scroll-behavior: auto;
    }

    .gw-motion__viewport::-webkit-scrollbar {
      display: none;
    }

    .gw-motion__track {
      display: flex;
      gap: 0;
      width: max-content;
      padding: 0;
      margin: 0;
    }

    .gw-motion__card-wrap {
      flex: 0 0 100cqw;
      width: 100cqw;
      min-width: 0;
      scroll-snap-align: center;
      scroll-snap-stop: always;
      display: flex;
      justify-content: center;
      padding-inline: 4px;
      box-sizing: border-box;
    }

    .gw-motion__card {
      width: min(100%, 300px);
      max-height: min(72vh, 540px);
    }
  }

  @media screen and (min-width: 990px) {
    .gw-motion__row {
      display: block;
      max-width: min(1180px, 100%);
    }

    .gw-motion__arrow {
      display: none !important;
    }

    .gw-motion__viewport {
      container-type: normal;
      overflow: visible;
      scroll-snap-type: none;
      cursor: default;
      width: 100%;
    }

    .gw-motion__track {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: clamp(12px, 1.4vw, 20px);
      width: 100%;
      max-width: 100%;
      margin: 0;
      padding: 0;
    }

    .gw-motion__card-wrap {
      display: block;
      width: auto;
      min-width: 0;
      padding: 0;
    }

    .gw-motion__card {
      width: 100%;
      max-height: none;
    }
  }

  .gw-motion__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .gw-motion__label {
    position: absolute;
    left: 12px;
    bottom: 12px;
    right: 12px;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 700;
    color: #fff;
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.55);
  }

  @media screen and (max-width: 749px) {
    .gw-motion {
      width: 100%;
      max-width: 100%;
      overflow-x: clip;
      padding-inline: 0;
      padding-block: 16px 28px;
    }

    .gw-motion__head {
      margin-bottom: 20px;
    }

    .gw-motion__inner {
      width: 100%;
      max-width: 100%;
      padding-inline: 16px;
      box-sizing: border-box;
    }

    .gw-motion__row {
      max-width: none;
      gap: 6px;
    }

    .gw-motion__arrow {
      width: 40px;
      height: 40px;
      font-size: 1.35rem;
    }

    .gw-motion__card {
      width: min(100%, 327px);
      border-radius: 12px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "GW style in motion",
  "tag": "section",
  "class": "gw-style-motion-section",
  "enabled_on": {
    "templates": ["index", "product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Watch & Shop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Style in Motion"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Watch our latest looks, outfit inspiration & behind-the-scenes."
    }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Video reel",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Jackets"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video (upload)"
        },
        {
          "type": "text",
          "id": "video_asset",
          "label": "Theme video filename",
          "info": "Used when no uploaded video"
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Poster image"
        },
        {
          "type": "text",
          "id": "poster_asset",
          "label": "Theme poster filename"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GW style in motion"
    }
  ]
}
{% endschema %}
