{% doc %}
  Single footwear product card for the PDP related products grid.
  @param {product} rel - Product to display
{% enddoc %}

{% liquid
  assign rel_gen_asset = 'fw-gen-' | append: rel.handle | append: '.jpg'
  assign rel_pdp_asset = 'fw-pdp-' | append: rel.handle | append: '-01.jpg'
  assign rel_image_alt = rel.title | escape
%}

<li class="gw-pdp-related__item">
  <a class="gw-pdp-related__card" href="{{ rel.url }}">
    <div class="gw-pdp-related__media">
      <img
        class="gw-pdp-related__img"
        src="{{ rel_pdp_asset | asset_img_url: '600x' }}"
        srcset="
          {{ rel_pdp_asset | asset_img_url: '320x' }} 320w,
          {{ rel_pdp_asset | asset_img_url: '480x' }} 480w,
          {{ rel_pdp_asset | asset_img_url: '600x' }} 600w
        "
        sizes="(min-width: 990px) 22vw, (min-width: 750px) 30vw, 46vw"
        alt="{{ rel_image_alt }}"
        width="600"
        height="750"
        loading="lazy"
      >
    </div>
    <h3 class="gw-pdp-related__title">{{ rel.title | escape }}</h3>
    <p class="gw-pdp-related__price">{{ rel.price | money }}</p>
  </a>
</li>
