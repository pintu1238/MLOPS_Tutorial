    </div>

    <div class="mn-payments-row">
      <span class="mn-payment-card mn-payment-card--amex">AMEX</span>
      <span class="mn-payment-card mn-payment-card--apple">Apple Pay</span>
      <span class="mn-payment-card mn-payment-card--contactless">Bancontact</span>
      <span class="mn-payment-card mn-payment-card--contactless">Contactless</span>
      <span class="mn-payment-card mn-payment-card--contactless">Diners Club</span>
      <span class="mn-payment-card mn-payment-card--discover">Discover</span>
      <span class="mn-payment-card mn-payment-card--gpay">Google Pay</span>
      <span class="mn-payment-card mn-payment-card--klarna">Klarna</span>
      <span class="mn-payment-card mn-payment-card--contactless">Maestro</span>
      <span class="mn-payment-card mn-payment-card--mastercard">Mastercard</span>
      <span class="mn-payment-card mn-payment-card--mbway">MB WAY</span>
      <span class="mn-payment-card mn-payment-card--paypal">PayPal</span>
      <span class="mn-payment-card mn-payment-card--shoppay">Shop Pay</span>
      <span class="mn-payment-card mn-payment-card--unionpay">UnionPay</span>
      <span class="mn-payment-card mn-payment-card--visa">Visa</span>
