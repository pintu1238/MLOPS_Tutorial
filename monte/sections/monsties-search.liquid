<style>
  .monsties-wrapper {
    background-color: #ffffff;
    color: #121212;
    overflow-x: clip;
    line-height: 1.5;
    font-size: 15px;
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  .monsties-wrapper *,
  .monsties-wrapper *::before,
  .monsties-wrapper *::after {
    box-sizing: border-box;
  }
  .monsties-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .mn-ticker-wrap {
    background: #000000;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    overflow: hidden;
    white-space: nowrap;
    padding: 11px 0;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.05em;
  }
  .mn-ticker-move {
    display: inline-flex;
    animation: mnTickerAnim 24s linear infinite;
  }
  .mn-ticker-item {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 0 32px;
    color: #fff;
  }
  @keyframes mnTickerAnim {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .mn-header {
    background: #ffffff;
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid #ebebeb;
  }
  .mn-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 108px;
    padding-top: 5px;
    padding-bottom: 5px;
  }
  .mn-nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
    list-style: none;
    flex: 1;
    margin: 0;
    padding: 0;
  }
  .mn-nav-links a {
    color: #121212;
    text-decoration: none;
    font-weight: 500;
    font-size: 15px;
    transition: color 0.2s;
  }
  .mn-nav-links a:hover {
    color: #2cb2e8;
  }
  .mn-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
  }
  .mn-logo img {
    height: 96px;
    width: auto;
    max-width: 320px;
    object-fit: contain;
    display: block;
  }
  .mn-header-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    justify-content: flex-end;
    flex: 1;
  }
  .mn-nav-toggle {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .mn-menu-btn {
    display: none;
    width: 40px;
    height: 40px;
    padding: 10px 8px;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    border-radius: 8px;
    cursor: pointer;
  }
  .mn-menu-btn span {
    display: block;
    height: 2px;
    background: #121212;
    border-radius: 2px;
  }
  .mn-icon-btn {
    background: none;
    border: none;
    color: #121212;
    cursor: pointer;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
    border-radius: 50%;
    transition: background 0.15s ease;
  }
  .mn-icon-btn:hover {
    background: #f0f0f0;
  }
  .mn-cart-count {
    position: absolute;
    top: -2px;
    right: -4px;
    background: #2cb2e8;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .mn-search-overlay,
  .mn-cart-backdrop {
    position: fixed;
    inset: 0;
    z-index: 1200;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }
  .mn-search-overlay {
    background: rgba(0, 0, 0, 0.45);
  }
  .mn-search-overlay.open,
  .mn-cart-backdrop.open {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
  }
  .mn-search-panel {
    position: relative;
    display: block;
    padding: 12px 24px 24px;
    background: #ffffff;
    border-bottom: 1px solid #e2e2e2;
  }
  .mn-search-form {
    position: relative;
    display: flex;
    align-items: center;
    width: min(430px, 100%);
    margin: 0 auto;
  }
  .mn-search-form label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .mn-search-input {
    flex: 1;
    min-width: 0;
    height: 44px;
    padding: 0 48px 0 14px;
    border: 1px solid #bdbdbd;
    border-radius: 6px;
    color: #121212;
    font: inherit;
  }
  .mn-search-submit {
    position: absolute;
    top: 1px;
    right: 1px;
    height: 44px;
    width: 42px;
    padding: 0;
    border: 0;
    border-radius: 0 5px 5px 0;
    background: transparent;
    color: #6f6f6f;
    cursor: pointer;
  }
  .mn-search-submit-icon {
    width: 18px;
    height: 18px;
  }
  .mn-search-close {
    position: absolute;
    top: 12px;
    right: 24px;
  }
  .mn-search-results {
    width: min(430px, 100%);
    margin: 14px auto 0;
    color: #121212;
  }
  .mn-search-results-heading {
    margin-bottom: 8px;
    color: #6f6f6f;
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .mn-search-suggestion {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 0 14px;
    border-bottom: 1px solid #e2e2e2;
    font-size: 14px;
  }
  .mn-search-suggestion a {
    color: #121212;
    font-weight: 600;
    text-decoration: none;
  }
  .mn-search-products {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 14px;
  }
  .mn-search-product {
    display: block;
    overflow: hidden;
    color: #121212;
    text-decoration: none;
  }
  .mn-search-product-image {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    background: #f5f5f5;
  }
  .mn-search-product-title {
    display: block;
    margin-top: 7px;
    font-size: 13px;
    font-weight: 600;
  }
  .mn-search-product-meta {
    display: block;
    margin-top: 2px;
    color: #121212;
    font-size: 13px;
  }
  .mn-search-product-price {
    display: block;
    margin-top: 2px;
    color: #6f6f6f;
    font-size: 13px;
  }
  .mn-search-close,
  .mn-cart-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    border: 0;
    background: transparent;
    color: #121212;
    font-size: 30px;
    line-height: 1;
    cursor: pointer;
  }
  .mn-cart-backdrop {
    background: rgba(0, 0, 0, 0.52);
  }
  .mn-cart-drawer {
    display: flex;
    flex-direction: column;
    width: min(430px, 100%);
    height: 100%;
    margin-left: auto;
    background: #ffffff;
    color: #121212;
    box-shadow: -8px 0 30px rgba(0, 0, 0, 0.18);
    transform: translateX(100%);
    transition: transform 0.25s ease;
  }
  .mn-cart-backdrop.open .mn-cart-drawer {
    transform: translateX(0);
  }
  .mn-cart-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 18px;
    border-bottom: 1px solid #e2e2e2;
  }
  .mn-cart-title {
    font-size: 24px;
    font-weight: 800;
  }
  .mn-cart-reserved {
    padding: 12px 16px;
    background: #121212;
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
    text-align: center;
  }
  .mn-cart-body { flex: 1; overflow-y: auto; }
  .mn-cart-empty { display: none; padding: 100px 24px 40px; text-align: center; }
  .mn-cart-empty.open { display: block; }
  .mn-cart-empty h3 { margin-bottom: 28px; font-size: 28px; }
  .mn-cart-continue {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 28px;
    border-radius: 6px;
    background: #2c2c2e;
    color: #ffffff;
    font-weight: 700;
    text-decoration: none;
  }
  .mn-cart-footer {
    padding: 16px;
    border-top: 1px solid #dcdcdc;
    background: #ffffff;
  }
  .mn-cart-total-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 14px;
    font-size: 20px;
    font-weight: 800;
  }
  .mn-cart-checkout {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 50px;
    border-radius: 6px;
    background: #000000;
    color: #ffffff;
    font-size: 17px;
    font-weight: 800;
    text-decoration: none;
  }
  .mn-cart-payments {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    margin-top: 14px;
  }
  .mn-payment-card {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 38px;
    height: 24px;
    padding: 0 4px;
    border-radius: 4px;
    border: 1px solid rgba(0, 0, 0, 0.1);
    background: #ffffff;
    color: #111111;
    font-size: 7px;
    line-height: 1;
    font-weight: 800;
    white-space: nowrap;
  }
  .mn-payment-card--amex,
  .mn-payment-card--visa { background: #1453d1; color: #ffffff; }
  .mn-payment-card--klarna { background: #ffb3d1; }
  .mn-payment-card--mastercard { background: #1f1f1f; color: #ffffff; }
  .mn-payment-card--shoppay { background: #5a31f4; }
  body.mn-cart-open,
  body.mn-overlay-open { overflow: hidden; }

  .mn-search-page {
    max-width: 1240px;
    margin: 0 auto;
    padding: 36px 20px 72px;
  }
  .mn-search-page h1 {
    margin: 0 0 8px;
    font-size: 32px;
    line-height: 1.2;
    font-weight: 800;
  }
  .mn-search-page-copy {
    margin: 0 0 28px;
    color: #666666;
    font-size: 15px;
  }
  .mn-search-products--page {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 22px;
    margin-top: 0;
  }
  .mn-search-products--page .mn-search-product-title {
    font-size: 16px;
  }
  .mn-search-products--page .mn-search-product-meta,
  .mn-search-products--page .mn-search-product-price {
    font-size: 14px;
  }
  @media (max-width: 900px) {
    .mn-search-products--page {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 900px) {
    .mn-header-inner {
      display: grid;
      grid-template-columns: 40px minmax(0, 1fr) auto;
      align-items: center;
      height: 68px;
      padding: 0 8px;
    }
    .mn-menu-btn { display: flex; }
    .mn-nav-links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      z-index: 120;
      flex-direction: column;
      gap: 0;
      padding: 8px 16px 12px;
      background: #ffffff;
      border-bottom: 1px solid #ebebeb;
    }
    .mn-nav-toggle:checked ~ .mn-nav-links { display: flex; }
    .mn-logo {
      justify-content: center;
      min-width: 0;
    }
    .mn-logo img { height: 44px; max-width: 140px; }
    .mn-header-actions { justify-content: flex-end; }
    .mn-search-page { padding: 24px 16px 56px; }
    .mn-search-page h1 { font-size: 26px; }
  }
</style>

<div class="monsties-wrapper" id="MonstiesSearch-{{ section.id }}">
  {% render 'monsties-site-header' %}

  <main class="mn-search-page">
    <h1>Search results</h1>
    <p class="mn-search-page-copy">
      Showing Monsties homepage products
      {% if search.terms != blank %}
        for “{{ search.terms | escape }}”
      {% endif %}
    </p>
    {% render 'monsties-search-catalog', layout: 'page', emit_json: false %}
  </main>

  {% render 'monsties-site-footer' %}
</div>

{% schema %}
{
  "name": "Monsties Search",
  "settings": [],
  "presets": [
    {
      "name": "Monsties Search"
    }
  ]
}
{% endschema %}
