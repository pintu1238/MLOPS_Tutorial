<script>
  (function() {
    var mnVariants = {% if mn_product != blank %}{{ mn_product.variants | json }}{% else %}[]{% endif %};
    var mnProductHandle = {{ mn_product.handle | default: 'monsties' | json }};

    function closeAnimatedDropdown(wrap) {
      wrap.classList.remove('open');
      var trigger = wrap.querySelector('.mn-dropdown-trigger');
      if (trigger) trigger.setAttribute('aria-expanded', 'false');
    }

    function closeAllAnimatedDropdowns(exceptWrap) {
      document.querySelectorAll('.mn-dropdown.open').forEach(function(openWrap) {
        if (openWrap !== exceptWrap) closeAnimatedDropdown(openWrap);
      });
    }

    function enhanceAnimatedDropdowns() {
      var selects = document.querySelectorAll('.mn-bundle-color-select, .mn-bundle-size-select');
      selects.forEach(function(select) {
        if (select.closest('.mn-dropdown')) return;
        var wrap = document.createElement('div');
        wrap.className = 'mn-dropdown';
        select.parentNode.insertBefore(wrap, select);
        wrap.appendChild(select);
        select.setAttribute('aria-hidden', 'true');
        select.tabIndex = -1;

        var trigger = document.createElement('button');
        trigger.type = 'button';
        trigger.className = 'mn-dropdown-trigger';
        trigger.setAttribute('aria-haspopup', 'listbox');
        trigger.setAttribute('aria-expanded', 'false');
        trigger.setAttribute('aria-label', select.getAttribute('aria-label') || 'Choose option');

        var label = document.createElement('span');
        label.className = 'mn-dropdown-label';
        label.textContent = select.options[select.selectedIndex] ? select.options[select.selectedIndex].text : select.value;

        var chevron = document.createElement('span');
        chevron.className = 'mn-dropdown-chevron';
        chevron.setAttribute('aria-hidden', 'true');
        chevron.innerHTML = '<svg viewBox="0 0 12 8" width="10" height="7"><path d="M1 1.5 6 6.5 11 1.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
        trigger.appendChild(label);
        trigger.appendChild(chevron);

        var menu = document.createElement('div');
        menu.className = 'mn-dropdown-menu';
        menu.setAttribute('role', 'listbox');

        Array.prototype.forEach.call(select.options, function(option) {
          var item = document.createElement('button');
          item.type = 'button';
          item.className = 'mn-dropdown-option';
          item.setAttribute('role', 'option');
          item.textContent = option.text;
          if (option.selected) item.classList.add('is-selected');
          item.addEventListener('click', function(event) {
            event.preventDefault();
            event.stopPropagation();
            select.value = option.value;
            select.dispatchEvent(new Event('change', { bubbles: true }));
            label.textContent = option.text;
            menu.querySelectorAll('.mn-dropdown-option').forEach(function(btn) {
              btn.classList.toggle('is-selected', btn === item);
            });
            closeAnimatedDropdown(wrap);
          });
          menu.appendChild(item);
        });

        wrap.appendChild(trigger);
        wrap.appendChild(menu);
        wrap.addEventListener('click', function(event) {
          event.stopPropagation();
        });
        trigger.addEventListener('click', function(event) {
          event.preventDefault();
          event.stopPropagation();
          var willOpen = !wrap.classList.contains('open');
          closeAllAnimatedDropdowns(wrap);
          wrap.classList.toggle('open', willOpen);
          trigger.setAttribute('aria-expanded', String(willOpen));
        });
      });

      document.addEventListener('click', function(event) {
        if (event.target.closest('.mn-dropdown')) return;
        closeAllAnimatedDropdowns();
      });
      document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape') closeAllAnimatedDropdowns();
      });
    }
    enhanceAnimatedDropdowns();

    // Gallery & Swatches
    var mainImage = document.getElementById('mnMainDisplayImage');
    var thumbs = document.querySelectorAll('.mn-thumb');
    var colorBtns = document.querySelectorAll('.mn-color-btn');
    var sizeBtns = document.querySelectorAll('.mn-size-btn');
    var selectedColorText = document.getElementById('mnSelectedColorText');
    var selectedSizeText = document.getElementById('mnSelectedSizeText');
    var stickyThumb = document.getElementById('mnStickyThumb');
    var stickyVariant = document.getElementById('mnStickyVariant');

    var currentColor = "White Ultra";
    var currentSize = "M";

    function updateStickyInfo() {
      if (stickyVariant) {
        stickyVariant.textContent = currentColor + " / " + currentSize;
      }
    }

    function selectColor(colorName) {
      var match = Array.prototype.find.call(colorBtns, function(btn) {
        return btn.getAttribute('data-color') === colorName;
      });
      if (match) match.click();
    }

    thumbs.forEach(function(thumb) {
      thumb.addEventListener('click', function() {
        thumbs.forEach(function(t) { t.classList.remove('active'); });
        thumb.classList.add('active');
        var src = thumb.getAttribute('data-src');
        if (mainImage && src) {
          mainImage.src = src;
        }
      });
    });

    colorBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        colorBtns.forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        currentColor = btn.getAttribute('data-color');
        if (selectedColorText) selectedColorText.textContent = currentColor;
        var imgUrl = btn.getAttribute('data-img');
        if (mainImage && imgUrl) {
          mainImage.src = imgUrl;
        }
        if (stickyThumb && imgUrl) {
          stickyThumb.src = imgUrl;
        }
        // Sync thumbnail
        thumbs.forEach(function(t) {
          if (t.getAttribute('data-variant') === currentColor) {
            thumbs.forEach(function(th) { th.classList.remove('active'); });
            t.classList.add('active');
          }
        });
        updateStickyInfo();
      });
    });

    sizeBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        sizeBtns.forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        currentSize = btn.getAttribute('data-size');
        if (selectedSizeText) selectedSizeText.textContent = currentSize;
        updateStickyInfo();
      });
    });

    var params = new URLSearchParams(window.location.search);
    var requestedColor = params.get('color');
    if (requestedColor) selectColor(requestedColor);

    var bundleColorSelects = document.querySelectorAll('.mn-bundle-color-select');
    var bundleSizeSelects = document.querySelectorAll('.mn-bundle-size-select');
    bundleColorSelects.forEach(function(select) {
      select.addEventListener('change', function() {
        currentColor = select.value;
        var matchingColor = Array.prototype.find.call(colorBtns, function(btn) {
          return btn.getAttribute('data-color') === currentColor;
        });
        var imageUrl = matchingColor && matchingColor.getAttribute('data-img');
        if (selectedColorText) selectedColorText.textContent = currentColor;
        if (mainImage && imageUrl) mainImage.src = imageUrl;
        if (stickyThumb && imageUrl) stickyThumb.src = imageUrl;
        updateStickyInfo();
      });
    });
    bundleSizeSelects.forEach(function(select) {
      select.addEventListener('change', function() {
        currentSize = select.value;
        if (selectedSizeText) selectedSizeText.textContent = currentSize;
        updateStickyInfo();
      });
    });

    // Quantity selector
    var qtyVal = document.getElementById('mnQtyVal');
    var qtyPlus = document.getElementById('mnQtyPlus');
    var qtyMinus = document.getElementById('mnQtyMinus');
    var qty = 1;

    if (qtyPlus && qtyMinus && qtyVal) {
      qtyPlus.addEventListener('click', function() {
        qty++;
        qtyVal.textContent = qty;
      });
      qtyMinus.addEventListener('click', function() {
        if (qty > 1) {
          qty--;
          qtyVal.textContent = qty;
        }
      });
    }

    // Accordions
    var accItems = document.querySelectorAll('.mn-acc-item');
    accItems.forEach(function(item) {
      var header = item.querySelector('.mn-acc-header');
      if (header) {
        header.addEventListener('click', function() {
          var isOpen = item.classList.contains('open');
          accItems.forEach(function(i) { i.classList.remove('open'); });
          if (!isOpen) item.classList.add('open');
        });
      }
    });

    // FAQ Accordion
    var faqItems = document.querySelectorAll('.mn-faq-item');
    faqItems.forEach(function(item) {
      var header = item.querySelector('.mn-faq-q');
      if (header) {
        header.addEventListener('click', function() {
          item.classList.toggle('open');
        });
      }
    });

    // Review slider
    var reviewSlides = document.querySelectorAll('.mn-review-slide');
    var reviewDots = document.querySelectorAll('.mn-review-dot');
    var reviewPrev = document.getElementById('mnReviewPrev');
    var reviewNext = document.getElementById('mnReviewNext');
    var currentReviewIndex = 0;

    function showReview(index) {
      if (!reviewSlides.length) return;
      currentReviewIndex = (index + reviewSlides.length) % reviewSlides.length;
      reviewSlides.forEach(function(slide, slideIndex) {
        slide.classList.toggle('active', slideIndex === currentReviewIndex);
      });
      reviewDots.forEach(function(dot, dotIndex) {
        dot.classList.toggle('active', dotIndex === currentReviewIndex);
      });
    }

    if (reviewPrev) {
      reviewPrev.addEventListener('click', function() {
        showReview(currentReviewIndex - 1);
      });
    }
    if (reviewNext) {
      reviewNext.addEventListener('click', function() {
        showReview(currentReviewIndex + 1);
      });
    }
    reviewDots.forEach(function(dot) {
      dot.addEventListener('click', function() {
        showReview(parseInt(dot.getAttribute('data-review-dot'), 10));
      });
    });

    // Size Guide Modal
    var sizeModal = document.getElementById('mnSizeModal');
    var openSizeModal = document.getElementById('mnOpenSizeModal');
    var closeSizeModal = document.getElementById('mnCloseSizeModal');

    if (openSizeModal && sizeModal) {
      openSizeModal.addEventListener('click', function() {
        sizeModal.classList.add('open');
      });
    }
    if (closeSizeModal && sizeModal) {
      closeSizeModal.addEventListener('click', function() {
        sizeModal.classList.remove('open');
      });
      sizeModal.addEventListener('click', function(e) {
        if (e.target === sizeModal) sizeModal.classList.remove('open');
      });
    }

    // Sticky Bottom Bar
    var stickyBar = document.getElementById('mnStickyBar');
    var atcBtn = document.getElementById('mnAddToCartBtn');
    window.addEventListener('scroll', function() {
      if (!stickyBar || !atcBtn) return;
      var rect = atcBtn.getBoundingClientRect();
      if (rect.bottom < 0) {
        stickyBar.classList.add('visible');
        document.body.classList.add('mn-sticky-visible');
      } else {
        stickyBar.classList.remove('visible');
        document.body.classList.remove('mn-sticky-visible');
      }
    });

    // Bundle selection logic
    var bundleCards = document.querySelectorAll('.mn-bundle-card');
    var displayPrice = document.getElementById('mnDisplayPrice');
    var displayComparePrice = document.getElementById('mnDisplayComparePrice');
    var salePill = document.getElementById('mnSalePill');
    var atcPriceText = document.getElementById('mnAtcPriceText');
    var stickyPrice = document.getElementById('mnStickyPrice');
    var currentBundleQty = 1;
    var currentBundlePrice = "6299.97";

    function formatPrice(value) {
      return 'Rs. ' + Number(value).toLocaleString('en-IN', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      });
    }

    bundleCards.forEach(function(card) {
      card.addEventListener('click', function() {
        var selectedCard = card;
        bundleCards.forEach(function(card) {
          card.classList.toggle('active', card === selectedCard);
          card.classList.toggle('open', card === selectedCard);
        });
        var price = card.getAttribute('data-price');
        var compare = card.getAttribute('data-compare');
        var qtyAttr = card.getAttribute('data-bundle');
        if (price) {
          currentBundlePrice = price;
          var formattedPrice = formatPrice(price);
          if (displayPrice) displayPrice.textContent = formattedPrice;
          if (atcPriceText) atcPriceText.textContent = formattedPrice;
          if (stickyPrice) stickyPrice.textContent = formattedPrice;
        }
        if (compare) {
          if (displayComparePrice) displayComparePrice.textContent = formatPrice(compare);
          if (salePill) {
            salePill.textContent = 'SAVE ' + formatPrice(Number(compare) - Number(price));
          }
        }
        if (qtyAttr) {
          currentBundleQty = parseInt(qtyAttr, 10);
        }
      });
    });

    var stickyBtn = document.getElementById('mnStickyBtn');
    var feedback = document.getElementById('mnActionFeedback');
    var isAddingToCart = false;
    var originalAtcMarkup = atcBtn ? atcBtn.innerHTML : '';
    var originalStickyMarkup = stickyBtn ? stickyBtn.innerHTML : '';

    function getShopifyRoot() {
      var root = window.Shopify && window.Shopify.routes && window.Shopify.routes.root
        ? window.Shopify.routes.root
        : '/';
      return root.charAt(root.length - 1) === '/' ? root : root + '/';
    }

    function showFeedback(message, isError) {
      if (!feedback) return;
      feedback.textContent = message;
      feedback.classList.toggle('error', Boolean(isError));
    }

    var searchBtn = document.getElementById('mnSearchBtn');
    var searchOverlay = document.getElementById('mnSearchOverlay');
    var searchInput = document.getElementById('mnSearchInput');
    var searchForm = document.querySelector('.mn-search-form');
    var searchQueryLabel = document.getElementById('mnSearchQueryLabel');
    var searchClose = document.getElementById('mnSearchClose');
    var cartBtn = document.getElementById('mnCartBtn');
    var cartDrawer = document.getElementById('mnCartDrawer');
    var cartClose = document.getElementById('mnCartClose');
    var cartTitle = document.getElementById('mnCartTitle');
    var cartEmpty = document.getElementById('mnCartEmpty');
    var cartLines = document.getElementById('mnCartLines');
    var cartFooter = document.getElementById('mnCartFooter');
    var cartTotal = document.getElementById('mnCartTotal');

    function setSearchOpen(isOpen) {
      if (!searchOverlay) return;
      searchOverlay.classList.toggle('open', isOpen);
      searchOverlay.setAttribute('aria-hidden', String(!isOpen));
      if (searchBtn) searchBtn.setAttribute('aria-expanded', String(isOpen));
      document.body.classList.toggle('mn-overlay-open', isOpen);
      if (isOpen && searchInput) searchInput.focus();
    }

    if (searchBtn) searchBtn.addEventListener('click', function() {
      setSearchOpen(true);
    });
    if (searchClose) searchClose.addEventListener('click', function() {
      setSearchOpen(false);
    });
    if (searchOverlay) searchOverlay.addEventListener('click', function(event) {
      if (event.target === searchOverlay) setSearchOpen(false);
    });
    if (searchInput) searchInput.addEventListener('input', function() {
      var query = searchInput.value.trim() || 'one';
      if (searchQueryLabel) {
        searchQueryLabel.textContent = 'Search for “' + query + '”';
      }
    });
    if (searchForm) searchForm.addEventListener('submit', function(event) {
      event.preventDefault();
    });

    function escapeHtml(value) {
      return String(value == null ? '' : value).replace(/[&<>"']/g, function(character) {
        return {
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#039;'
        }[character];
      });
    }

    function formatCartMoney(cents) {
      return formatPrice(Number(cents || 0) / 100);
    }

    function fetchCart() {
      return fetch(getShopifyRoot() + 'cart.js', {
        headers: { Accept: 'application/json' }
      }).then(function(response) {
        if (!response.ok) throw new Error('Unable to load cart');
        return response.json();
      });
    }

    function isMonstiesItem(item) {
      var variantIds = {};
      (Array.isArray(mnVariants) ? mnVariants : []).forEach(function(variant) {
        variantIds[String(variant.id)] = true;
      });
      return Boolean(
        variantIds[String(item.variant_id)] ||
        item.handle === 'monsties' ||
        (item.product_title && item.product_title.toLowerCase().indexOf('monsties') !== -1)
      );
    }

    function removeOtherCartItems(cart) {
      var updates = {};
      cart.items.forEach(function(item) {
        if (!isMonstiesItem(item)) updates[item.key] = 0;
      });
      if (!Object.keys(updates).length) return Promise.resolve(cart);

      return fetch(getShopifyRoot() + 'cart/update.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json'
        },
        body: JSON.stringify({ updates: updates })
      }).then(function(response) {
        if (!response.ok) throw new Error('Unable to prepare the Monsties cart');
        return response.json();
      });
    }

    function renderCart(cart) {
      var items = cart.items.filter(isMonstiesItem);
      if (cartTitle) cartTitle.textContent = 'Cart • ' + cart.item_count + (cart.item_count === 1 ? ' item' : ' items');
      if (cartTotal) cartTotal.textContent = formatCartMoney(cart.total_price);
      var badge = document.getElementById('headerCartCount');
      if (badge) badge.textContent = cart.item_count;

      if (cartEmpty) cartEmpty.classList.toggle('open', items.length === 0);
      if (cartFooter) cartFooter.style.display = items.length ? '' : 'none';
      if (!cartLines) return;

      cartLines.innerHTML = items.map(function(item) {
        var key = escapeHtml(item.key);
        var image = item.image
          ? '<img class="mn-cart-line-image" src="' + escapeHtml(item.image) + '" alt="' + escapeHtml(item.product_title) + '">'
          : '<div class="mn-cart-line-image" aria-hidden="true"></div>';
        var variantTitle = item.variant_title && item.variant_title !== 'Default Title'
          ? escapeHtml(item.variant_title)
          : '';
        var oldPrice = item.original_line_price > item.final_line_price
          ? '<span class="mn-cart-line-old-price">' + formatCartMoney(item.original_line_price) + '</span>'
          : '';

        return '<article class="mn-cart-line" data-cart-line-key="' + key + '" data-cart-quantity="' + item.quantity + '">' +
          image +
          '<div>' +
            '<div class="mn-cart-line-title">' + escapeHtml(item.product_title) + '</div>' +
            '<div class="mn-cart-line-variant">' + variantTitle + '</div>' +
            '<div class="mn-cart-quantity">' +
              '<button type="button" class="mn-cart-action" data-cart-action="decrease" data-line-key="' + key + '" aria-label="Decrease quantity">−</button>' +
              '<span class="mn-cart-quantity-value">' + item.quantity + '</span>' +
              '<button type="button" class="mn-cart-action" data-cart-action="increase" data-line-key="' + key + '" aria-label="Increase quantity">+</button>' +
            '</div>' +
          '</div>' +
          '<div class="mn-cart-line-price">' +
            '<button type="button" class="mn-cart-remove" data-cart-action="remove" data-line-key="' + key + '" aria-label="Remove item">♧</button>' +
            oldPrice +
            formatCartMoney(item.final_line_price) +
          '</div>' +
        '</article>';
      }).join('');
    }

    function setCartOpen(isOpen) {
      if (!cartDrawer) return;
      cartDrawer.classList.toggle('open', isOpen);
      cartDrawer.setAttribute('aria-hidden', String(!isOpen));
      if (cartBtn) cartBtn.setAttribute('aria-expanded', String(isOpen));
      document.body.classList.toggle('mn-cart-open', isOpen);
    }

    function openCartDrawer() {
      return fetchCart().then(removeOtherCartItems).then(function(cart) {
        renderCart(cart);
        setCartOpen(true);
        return cart;
      }).catch(function(error) {
        showFeedback(error.message || 'Unable to open cart.', true);
        throw error;
      });
    }

    function updateCartLine(lineKey, quantity) {
      return fetch(getShopifyRoot() + 'cart/change.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json'
        },
        body: JSON.stringify({ id: lineKey, quantity: quantity })
      }).then(function(response) {
        if (!response.ok) throw new Error('Unable to update cart');
        return response.json();
      }).then(function(cart) {
        renderCart(cart);
        return cart;
      });
    }

    if (cartBtn) cartBtn.addEventListener('click', function() {
      openCartDrawer().catch(function() {});
    });
    if (cartClose) cartClose.addEventListener('click', function() {
      setCartOpen(false);
    });
    if (cartDrawer) cartDrawer.addEventListener('click', function(event) {
      if (event.target === cartDrawer) setCartOpen(false);
    });
    if (cartLines) cartLines.addEventListener('click', function(event) {
      var control = event.target.closest('[data-cart-action]');
      if (!control) return;
      var line = control.closest('[data-cart-line-key]');
      if (!line) return;
      var action = control.getAttribute('data-cart-action');
      var currentQuantity = parseInt(line.getAttribute('data-cart-quantity') || '1', 10);
      var nextQuantity = action === 'remove'
        ? 0
        : action === 'increase'
          ? currentQuantity + 1
          : Math.max(0, currentQuantity - 1);
      updateCartLine(control.getAttribute('data-line-key'), nextQuantity).catch(function(error) {
        showFeedback(error.message || 'Unable to update cart.', true);
      });
    });
    document.addEventListener('keydown', function(event) {
      if (event.key !== 'Escape') return;
      setSearchOpen(false);
      setCartOpen(false);
    });

    function setCartButtonState(state) {
      if (atcBtn) {
        atcBtn.disabled = state === 'busy';
        atcBtn.innerHTML = state === 'busy'
          ? '<span>ADDING...</span>'
          : state === 'success'
            ? '<span>ADDED ✓</span>'
            : originalAtcMarkup;
      }
      if (stickyBtn) {
        stickyBtn.disabled = state === 'busy';
        stickyBtn.textContent = state === 'busy'
          ? 'ADDING...'
          : state === 'success'
            ? 'ADDED ✓'
            : originalStickyMarkup;
      }
    }

    function getVariantOptions(variant) {
      return (variant.options || [variant.option1, variant.option2, variant.option3])
        .filter(Boolean)
        .map(function(option) { return String(option); });
    }

    function normalizeOption(value) {
      return String(value || '').toLowerCase().replace(/\s+/g, ' ').trim();
    }

    function isMonstiesCatalogProduct(product) {
      if (!product) return false;
      var haystack = ((product.handle || '') + ' ' + (product.title || '')).toLowerCase();
      return haystack.indexOf('monst') !== -1 || haystack.indexOf('onesie') !== -1;
    }

    function applyProduct(product) {
      if (!isMonstiesCatalogProduct(product)) return [];
      if (product.handle) mnProductHandle = product.handle;
      mnVariants = Array.isArray(product.variants) ? product.variants : [];
      return mnVariants;
    }

    function fetchJson(url) {
      return fetch(url, { headers: { Accept: 'application/json' } }).then(function(response) {
        if (!response.ok) throw new Error('Unable to load the product variants.');
        return response.json();
      });
    }

    function loadVariants() {
      if (Array.isArray(mnVariants) && mnVariants.length && mnVariants[0] && mnVariants[0].id && isMonstiesCatalogProduct({
        handle: mnProductHandle,
        title: 'Monsties Onesie'
      })) {
        return Promise.resolve(mnVariants);
      }

      return fetchJson(getShopifyRoot() + 'products/' + mnProductHandle + '.js').then(applyProduct).catch(function() {
        return fetchJson(getShopifyRoot() + 'products.json').then(function(data) {
          var products = Array.isArray(data.products) ? data.products : [];
          var match = products.find(isMonstiesCatalogProduct);
          if (match) return applyProduct(match);
          throw new Error('Monsties product is not available in this store yet.');
        });
      });
    }

    function findSelectedVariant() {
      if (!Array.isArray(mnVariants) || !mnVariants.length) return null;

      var wantedColor = normalizeOption(currentColor);
      var wantedSize = normalizeOption(currentSize);
      var exactMatch = mnVariants.find(function(variant) {
        var options = getVariantOptions(variant).map(normalizeOption);
        return options.indexOf(wantedColor) !== -1 && options.indexOf(wantedSize) !== -1;
      });
      if (exactMatch) return exactMatch;

      var sizeMatch = mnVariants.find(function(variant) {
        return getVariantOptions(variant).map(normalizeOption).indexOf(wantedSize) !== -1;
      });
      return sizeMatch || mnVariants.find(function(variant) { return variant.available !== false; }) || mnVariants[0];
    }

    function refreshCartBadge() {
      return fetchCart().then(function(cart) {
        var badge = document.getElementById('headerCartCount');
        if (badge) badge.textContent = cart.item_count;
      });
    }

    function handleAddToCart() {
      if (isAddingToCart) return;

      isAddingToCart = true;
      setCartButtonState('busy');
      showFeedback('', false);

      loadVariants().then(function() {
        var selectedVariant = findSelectedVariant();
        if (!selectedVariant || !selectedVariant.id) {
          throw new Error('This product variant is not available right now.');
        }
        return fetchCart().then(removeOtherCartItems).then(function() {
          return selectedVariant;
        });
      }).then(function(selectedVariant) {
        return fetch(getShopifyRoot() + 'cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json'
        },
        body: JSON.stringify({
          items: [{
            id: selectedVariant.id,
            quantity: currentBundleQty
          }]
        })
        });
      }).then(function(response) {
        if (!response.ok) {
          return response.json().then(function(error) {
            throw new Error(error.description || 'Unable to add this item to the cart.');
          });
        }
        return response.json();
      }).then(function() {
        return refreshCartBadge().catch(function() {});
      }).then(function() {
        setCartButtonState('success');
        showFeedback('Added to cart.', false);
        return openCartDrawer();
      }).catch(function(error) {
        setCartButtonState('idle');
        showFeedback(error.message || 'Unable to add this item to the cart.', true);
      }).then(function() {
        isAddingToCart = false;
      });
    }

    if (atcBtn) atcBtn.addEventListener('click', handleAddToCart);
    if (stickyBtn) stickyBtn.addEventListener('click', handleAddToCart);

    // Lightweight interactions for the community cards.
    var socialButtons = document.querySelectorAll('.mn-fb-act-btn[data-social-action]');
    socialButtons.forEach(function(button) {
      button.addEventListener('click', function() {
        var action = button.getAttribute('data-social-action');
        var card = button.closest('.mn-fb-card');

        if (action === 'like' && card) {
          var likeStat = card.querySelector('.mn-fb-likes');
          var isLiked = button.getAttribute('aria-pressed') === 'true';
          var likeCount = likeStat ? parseInt(likeStat.getAttribute('data-likes') || '0', 10) : 0;
          likeCount += isLiked ? -1 : 1;
          button.setAttribute('aria-pressed', String(!isLiked));
          var likeLabel = button.querySelector('.mn-fb-act-label');
          if (likeLabel) likeLabel.textContent = isLiked ? 'Like' : 'Liked';
          if (likeStat) {
            likeStat.setAttribute('data-likes', String(likeCount));
            var likeCountEl = likeStat.querySelector('.mn-fb-like-count');
            if (likeCountEl) likeCountEl.textContent = String(likeCount);
          }
          showFeedback(isLiked ? 'Like removed.' : 'Post liked.', false);
        } else if (action === 'comment') {
          showFeedback('Comments are not available on this preview yet.', false);
        } else if (action === 'share') {
          var shareData = {
            title: 'Monsties Onesie',
            text: 'Check out this Monsties onesie.',
            url: window.location.href
          };
          if (navigator.share) {
            navigator.share(shareData).catch(function() {});
          } else if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(window.location.href).then(function() {
              showFeedback('Link copied to clipboard.', false);
            }).catch(function() {
              showFeedback('Copy the page URL to share this product.', false);
            });
          } else {
            showFeedback('Copy the page URL to share this product.', false);
          }
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Monsties Landing Page",
  "settings": [
    {
      "type": "text",
      "id": "product_title",
      "label": "Product Title",
      "default": "Monsties Onesie"
    },
    {
      "type": "text",
      "id": "product_price",
      "label": "Price",
      "default": "Rs. 6,299.97"
    },
    {
      "type": "text",
      "id": "compare_price",
      "label": "Compare Price",
      "default": "Rs. 8,999.96"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Shopify product",
      "info": "Used to select the variant that is added to the cart."
    }
  ],
  "presets": [
    {
      "name": "Monsties Product Landing Page"
    }
  ]
}
{% endschema %}
