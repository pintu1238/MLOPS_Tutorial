    gap: 6px;
  }
  .mn-bundle-variant-row {
    display: grid;
    grid-template-columns: 42px 158px 64px;
    justify-content: start;
    align-items: center;
    gap: 8px;
    overflow: visible;
  }
  .mn-bundle-variant-row img {
    width: 42px;
    height: 42px;
    border-radius: 4px;
    object-fit: cover;
    background: #ffffff;
  }
  .mn-bundle-color-select,
  .mn-bundle-size-select {
    width: 100%;
    max-width: 158px;
    height: 36px;
    border: 1px solid #c7c7c7;
    border-radius: 5px;
    background: #ffffff;
    color: #121212;
    padding: 0 8px;
    font: inherit;
    font-size: 12px;
    cursor: pointer;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.18s ease;
  }
  .mn-bundle-color-select:hover,
  .mn-bundle-size-select:hover {
    border-color: #2cb2e8;
    box-shadow: 0 4px 12px rgba(44, 178, 232, 0.16);
  }
  .mn-bundle-color-select:active,
  .mn-bundle-size-select:active {
    transform: scale(0.97);
  }
  .mn-bundle-size-select {
    max-width: 64px;
  }
  .mn-dropdown {
    position: relative;
    width: 100%;
    min-width: 0;
    z-index: 1;
  }
  .mn-dropdown.open {
    z-index: 40;
  }
  .mn-dropdown select.mn-bundle-color-select,
  .mn-dropdown select.mn-bundle-size-select {
    display: none;
  }
  .mn-dropdown-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    width: 100%;
    height: 36px;
    padding: 0 8px;
    border: 1px solid #c7c7c7;
    border-radius: 5px;
    background: #ffffff;
    color: #121212;
    font: inherit;
    font-size: 12px;
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
    outline: none;
    transform-origin: center;
    transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease, transform 0.18s ease;
  }
  .mn-dropdown-trigger:hover {
    border-color: #2cb2e8;
    background: #f4fbfe;
    box-shadow: 0 4px 12px rgba(44, 178, 232, 0.16);
    transform: translateY(-1px);
  }
  .mn-dropdown-trigger:active {
    transform: scale(0.97);
    box-shadow: 0 1px 4px rgba(44, 178, 232, 0.12);
  }
  .mn-dropdown.open .mn-dropdown-trigger {
    border-color: #2cb2e8;
    background: #f4fbfe;
    box-shadow: 0 0 0 3px rgba(44, 178, 232, 0.18);
  }
  .mn-dropdown-label {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-align: left;
  }
  .mn-dropdown-chevron {
    display: inline-flex;
    flex: 0 0 auto;
    color: #555555;
    transition: transform 0.22s ease;
  }
  .mn-dropdown.open .mn-dropdown-chevron {
    transform: rotate(180deg);
  }
  .mn-dropdown-menu {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    z-index: 50;
    max-height: 220px;
    overflow-y: auto;
    padding: 4px 0;
    border: 1px solid #c7c7c7;
    border-radius: 6px;
    background: #ffffff;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.12);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-8px);
    transform-origin: top center;
    transition: opacity 0.22s ease, transform 0.22s ease, visibility 0.22s ease;
  }
  .mn-dropdown.open .mn-dropdown-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }
  .mn-dropdown-option {
    display: block;
    width: 100%;
    padding: 8px 10px;
    border: 0;
    background: transparent;
    color: #121212;
    font: inherit;
    font-size: 12px;
    text-align: left;
    cursor: pointer;
    transition: background 0.18s ease, color 0.18s ease, padding-left 0.18s ease, transform 0.18s ease;
  }
  .mn-dropdown-option:hover,
  .mn-dropdown-option.is-selected {
    background: #e8f6fb;
    color: #0b6e8a;
    padding-left: 14px;
