{% comment %}
  Monsties Landing Page Section
  Store: y9yn6k-me | Theme ID: 154169671749
  Faithful replica of https://monstiesco.com/products/monsties
{% endcomment %}

{% assign mn_product = section.settings.product | default: product %}
{% assign mn_product_ok = false %}
{% if mn_product != blank %}
  {% assign mn_product_handle = mn_product.handle | downcase %}
  {% assign mn_product_title = mn_product.title | downcase %}
  {% if mn_product_handle == 'monsties' or mn_product_title contains 'monsties' or mn_product_title contains 'onesie' %}
    {% assign mn_product_ok = true %}
  {% endif %}
{% endif %}
{% if mn_product_ok == false %}
  {% assign mn_product = all_products['monsties'] %}
{% endif %}
{% if mn_product == blank %}
  {% for mn_candidate in collections.all.products %}
    {% assign mn_candidate_handle = mn_candidate.handle | downcase %}
    {% assign mn_candidate_title = mn_candidate.title | downcase %}
    {% if mn_candidate_handle == 'monsties' or mn_candidate_title contains 'monsties' or mn_candidate_title contains 'onesie' %}
      {% assign mn_product = mn_candidate %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}

<style>
  :root {
    --mn-bg: #ffffff;
    --mn-bg-card: #ffffff;
    --mn-bg-alt: #f5f9fa;
    --mn-text: #121212;
    --mn-text-muted: #6f6f6f;
    --mn-accent: #2cb2e8;
    --mn-accent-glow: rgba(44, 178, 232, 0.35);
    --mn-primary-btn: #2c2c2e;
    --mn-primary-btn-text: #ffffff;
    --mn-border: #e2e2e2;
    --mn-border-focus: #2cb2e8;
    --mn-star: #ffcc00;
    --mn-radius: 8px;
    --mn-font: 'Poppins', -apple-system, BlinkMacSystemFont, sans-serif;
  }

  .monsties-wrapper * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: var(--mn-font);
  }
  .monsties-wrapper .material-symbols-outlined {
    font-family: 'Material Symbols Outlined' !important;
    font-weight: 400;
    font-style: normal;
    font-size: 1em;
    line-height: 1;
    letter-spacing: normal;
    text-transform: none;
    display: inline-block;
    white-space: nowrap;
    direction: ltr;
    -webkit-font-feature-settings: 'liga';
    -webkit-font-smoothing: antialiased;
  }

  .monsties-wrapper {
    background-color: #ffffff;
    color: #121212;
    overflow-x: clip;
    line-height: 1.5;
    font-size: 15px;
    -webkit-font-smoothing: antialiased;
  }

  .monsties-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* TICKER ANNOUNCEMENT */
  .mn-ticker-wrap {
    background: #000000;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    overflow: hidden;
    white-space: nowrap;
    padding: 11px 0;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.05em;
  }
  .mn-ticker-move {
    display: inline-flex;
    animation: mnTickerAnim 24s linear infinite;
  }
  .mn-ticker-item {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 0 32px;
    color: #fff;
  }
  @keyframes mnTickerAnim {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* HEADER */
  .mn-header {
    background: #ffffff;
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid #ebebeb;
  }
  .mn-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 108px;
    padding-top: 5px;
    padding-bottom: 5px;
  }
  .mn-nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
    list-style: none;
    flex: 1;
  }
  .mn-nav-links a {
    color: #121212;
    text-decoration: none;
    font-weight: 500;
    font-size: 15px;
    transition: color 0.2s;
  }
  .mn-nav-links a:hover {
    color: #2cb2e8;
  }
  .mn-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
  }
  .mn-logo img {
    height: 96px;
    width: auto;
    max-width: 320px;
    object-fit: contain;
    display: block;
  }
  .mn-header-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    justify-content: flex-end;
    flex: 1;
  }
  .mn-nav-toggle {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .mn-menu-btn {
    display: none;
    width: 40px;
    height: 40px;
    padding: 10px 8px;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    border-radius: 8px;
    cursor: pointer;
  }
  .mn-menu-btn span {
    display: block;
    height: 2px;
    background: #121212;
    border-radius: 2px;
  }
  .mn-icon-btn {
    background: none;
    border: none;
    color: #121212;
    cursor: pointer;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
    border-radius: 50%;
    transition: background 0.15s ease;
  }
  .mn-icon-btn:hover {
    background: #f0f0f0;
  }
  .mn-icon-btn:focus-visible,
  .mn-search-close:focus-visible,
  .mn-cart-close:focus-visible,
  .mn-cart-action:focus-visible,
  .mn-cart-checkout:focus-visible {
    outline: 2px solid #2cb2e8;
    outline-offset: 2px;
  }
  .mn-cart-count {
    position: absolute;
    top: -2px;
    right: -4px;
    background: #2cb2e8;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* SEARCH OVERLAY */
  .mn-search-overlay,
  .mn-cart-backdrop {
    position: fixed;
    inset: 0;
    z-index: 1200;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }
  .mn-search-overlay {
    background: rgba(0, 0, 0, 0.45);
  }
  .mn-search-overlay.open,
  .mn-cart-backdrop.open {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
  }
  .mn-search-panel {
    position: relative;
    display: block;
    padding: 12px 24px 24px;
    background: #ffffff;
    border-bottom: 1px solid #e2e2e2;
  }
  .mn-search-form {
    position: relative;
    display: flex;
    align-items: center;
    width: min(430px, 100%);
    margin: 0 auto;
  }
  .mn-search-form label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .mn-search-input {
    flex: 1;
    min-width: 0;
    height: 44px;
    padding: 0 48px 0 14px;
    border: 1px solid #bdbdbd;
    border-radius: 6px;
    color: #121212;
    font: inherit;
  }
  .mn-search-submit {
    position: absolute;
    top: 1px;
    right: 1px;
    height: 44px;
    width: 42px;
    padding: 0;
    border: 0;
    border-radius: 0 5px 5px 0;
    background: transparent;
    color: #6f6f6f;
    cursor: pointer;
  }
  .mn-search-submit-icon {
    width: 18px;
    height: 18px;
  }
  .mn-search-close {
    position: absolute;
    top: 12px;
    right: 24px;
  }
  .mn-search-results {
    width: min(430px, 100%);
    margin: 14px auto 0;
    color: #121212;
  }
  .mn-search-results-heading {
    margin-bottom: 8px;
    color: #6f6f6f;
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .mn-search-suggestion {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 0 14px;
    border-bottom: 1px solid #e2e2e2;
    font-size: 14px;
  }
  .mn-search-suggestion a {
    color: #121212;
    font-weight: 600;
    text-decoration: none;
  }
  .mn-search-products {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 14px;
  }
  .mn-search-product {
    display: block;
    overflow: hidden;
    color: #121212;
    text-decoration: none;
  }
  .mn-search-product-image {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    background: #f5f5f5;
  }
  .mn-search-product-title {
    display: block;
    margin-top: 7px;
    font-size: 13px;
    font-weight: 600;
  }
  .mn-search-product-meta {
    display: block;
    margin-top: 2px;
    color: #121212;
    font-size: 13px;
  }
  .mn-search-product-price {
    display: block;
    margin-top: 2px;
    color: #6f6f6f;
    font-size: 13px;
  }
  @media (max-width: 520px) {
    .mn-search-panel {
      padding-right: 14px;
      padding-left: 14px;
    }
  }
  .mn-search-close,
  .mn-cart-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    border: 0;
    background: transparent;
    color: #121212;
    font-size: 30px;
    line-height: 1;
    cursor: pointer;
  }

  /* CART DRAWER */
  .mn-cart-backdrop {
    background: rgba(0, 0, 0, 0.52);
  }
  .mn-cart-drawer {
    display: flex;
    flex-direction: column;
    width: min(430px, 100%);
    height: 100%;
    margin-left: auto;
    background: #ffffff;
    color: #121212;
    box-shadow: -8px 0 30px rgba(0, 0, 0, 0.18);
    transform: translateX(100%);
    transition: transform 0.25s ease;
  }
  .mn-cart-backdrop.open .mn-cart-drawer {
    transform: translateX(0);
  }
  .mn-cart-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 18px;
    border-bottom: 1px solid #e2e2e2;
  }
  .mn-cart-title {
    font-size: 24px;
    font-weight: 800;
  }
  .mn-cart-reserved {
    padding: 12px 16px;
    background: #121212;
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
    text-align: center;
  }
  .mn-cart-body {
    flex: 1;
    overflow-y: auto;
  }
  .mn-cart-empty {
    display: none;
    padding: 100px 24px 40px;
    text-align: center;
  }
  .mn-cart-empty.open {
    display: block;
  }
  .mn-cart-empty h3 {
    margin-bottom: 28px;
    font-size: 28px;
  }
  .mn-cart-continue {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 28px;
    border-radius: 6px;
    background: #2c2c2e;
    color: #ffffff;
    font-weight: 700;
    text-decoration: none;
  }
  .mn-cart-lines {
    display: flex;
    flex-direction: column;
  }
  .mn-cart-line {
    display: grid;
    grid-template-columns: 72px 1fr auto;
    gap: 12px;
    padding: 16px;
    border-bottom: 1px solid #eeeeee;
  }
  .mn-cart-line-image {
    width: 72px;
    height: 86px;
    border-radius: 5px;
    background: #f6f6f6;
    object-fit: cover;
  }
  .mn-cart-line-title {
    margin-bottom: 4px;
    font-size: 15px;
    font-weight: 800;
    line-height: 1.2;
  }
  .mn-cart-line-variant {
    margin-bottom: 10px;
    color: #555555;
    font-size: 13px;
  }
  .mn-cart-line-price {
    text-align: right;
    font-size: 15px;
    font-weight: 800;
    white-space: nowrap;
  }
  .mn-cart-line-old-price {
    display: block;
    color: #999999;
    font-size: 12px;
    font-weight: 400;
    text-decoration: line-through;
  }
  .mn-cart-quantity {
    display: inline-flex;
    align-items: center;
    height: 28px;
    border: 1px solid #999999;
    border-radius: 5px;
  }
  .mn-cart-action {
    width: 28px;
    height: 26px;
    border: 0;
    background: transparent;
    color: #121212;
    cursor: pointer;
  }
  .mn-cart-quantity-value {
    min-width: 30px;
    text-align: center;
    font-size: 13px;
  }
  .mn-cart-remove {
    align-self: start;
    border: 0;
    background: transparent;
    color: #555555;
    cursor: pointer;
    font-size: 18px;
  }
  .mn-cart-footer {
    padding: 16px;
    border-top: 1px solid #dcdcdc;
    background: #ffffff;
  }
  .mn-cart-total-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 14px;
    font-size: 20px;
    font-weight: 800;
  }
  .mn-cart-checkout {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 50px;
    border-radius: 6px;
    background: #000000;
    color: #ffffff;
    font-size: 17px;
    font-weight: 800;
    text-decoration: none;
  }
  .mn-cart-payments {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    margin-top: 14px;
  }
  .mn-cart-payments .mn-payment-card {
    min-width: 34px;
    height: 22px;
    font-size: 6px;
  }
  body.mn-cart-open {
    overflow: hidden;
  }
  body.mn-overlay-open {
    overflow: hidden;
  }
  @media (max-width: 600px) {
    .mn-search-panel {
      padding: 12px 14px;
    }
    .mn-cart-line {
      grid-template-columns: 64px 1fr auto;
      padding: 14px;
    }
    .mn-cart-line-image {
      width: 64px;
      height: 78px;
    }
    .mn-header-inner {
      position: relative;
      height: 58px;
      padding: 0 10px;
      gap: 6px;
    }
    .mn-menu-btn {
      display: flex;
    }
    .mn-nav-links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      z-index: 120;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      margin: 0;
      padding: 8px 16px 12px;
      background: #ffffff;
      border-bottom: 1px solid #ebebeb;
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.08);
    }
    .mn-nav-toggle:checked ~ .mn-nav-links {
      display: flex;
    }
    .mn-nav-links a {
      display: block;
      padding: 10px 0;
      font-size: 15px;
    }
    .mn-logo {
      justify-content: flex-start;
    }
    .mn-logo img {
      height: 56px;
      max-width: 180px;
    }
    .mn-header-inner {
      height: 68px;
    }
    .mn-header-actions {
      flex: 0 0 auto;
      gap: 2px;
    }
    .mn-icon-btn {
      padding: 6px;
    }
    .mn-ticker-wrap {
      padding: 8px 0;
      font-size: 12px;
    }
    .mn-title {
      font-size: 24px;
    }
    .mn-price {
      font-size: 22px;
    }
  }

  /* PRODUCT HERO */
  .mn-hero {
    padding: 30px 0 60px;
    background: #ffffff;
  }
  .mn-hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 48px;
    align-items: start;
  }
  @media (max-width: 900px) {
    .mn-hero {
      padding: 8px 0 40px;
      overflow-x: hidden;
    }
    .mn-hero-grid {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 18px;
      padding: 0;
      min-width: 0;
    }
    .mn-gallery {
      position: static;
      height: auto;
      max-height: none;
      display: block;
      overflow: visible;
      width: 100%;
      min-width: 0;
    }
    .mn-main-image-wrap {
      height: auto;
      min-width: 0;
      min-height: 0;
      aspect-ratio: auto;
      border: 0;
      border-radius: 8px;
      background: #ffffff;
      overflow: hidden;
    }
    .mn-main-image {
      width: 100%;
      max-width: 100%;
      height: auto;
      object-fit: contain;
      object-position: center center;
    }
    .mn-details {
      width: 100%;
      min-width: 0;
    }
    .mn-thumb-carousel {
      display: flex;
      margin-top: 10px;
      padding-bottom: 4px;
    }
    .mn-details {
      position: static;
      z-index: auto;
      margin: 0;
      padding: 0 0 8px;
      gap: 16px;
    }
    .mn-info-card {
      padding: 0;
      gap: 14px;
    }
    .mn-bundles-block {
      margin-top: 4px;
    }
    .mn-bundle-header {
      gap: 8px;
      align-items: flex-start;
    }
    .mn-bundle-heading {
      flex-wrap: wrap;
      font-size: 15px;
    }
    .mn-bundle-prices {
      flex-shrink: 0;
    }
    .mn-bundle-price {
      font-size: 15px;
    }
    .mn-bundle-addon-list {
      margin-left: 0;
      margin-right: 0;
    }
    .mn-bundle-color-select,
    .mn-bundle-size-select {
      min-width: 0;
      max-width: 100%;
    }
    .mn-header-inner {
      height: 68px;
      padding: 0 12px;
      gap: 10px;
    }
    .mn-nav-links {
      flex: 0 1 auto;
      gap: 14px;
    }
    .mn-logo img {
      height: 56px;
      max-width: 180px;
    }
    .mn-header-actions {
      flex: 0 0 auto;
      gap: 6px;
    }
  }
  @media (min-width: 901px) {
    .mn-gallery {
      align-self: start;
      height: calc(100vh - 120px);
      max-height: calc(100vh - 120px);
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .mn-main-image-wrap {
      flex: 1 1 auto;
      min-height: 0;
      aspect-ratio: auto;
    }
    .mn-thumb-carousel {
      flex: 0 0 auto;
    }
  }

  /* GALLERY */
  .mn-gallery {
    position: sticky;
    top: 120px;
  }
  .mn-main-image-wrap {
    position: relative;
    background: #f9f9f9;
    border-radius: 12px;
    border: 1px solid #ebebeb;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .mn-main-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    transition: opacity 0.25s ease;
  }
  @media (max-width: 900px) {
    .mn-gallery {
      position: static;
      top: auto;
      width: 100%;
      max-width: none;
      min-width: 0;
      margin: 0 auto;
    }
    .mn-main-image-wrap {
      aspect-ratio: auto;
      width: 100%;
      height: auto;
      overflow: hidden;
    }
    .mn-main-image {
      display: block;
      width: 100%;
      max-width: 100%;
      min-width: 0;
      height: auto;
      margin: 0 auto;
      object-fit: contain;
      object-position: center center;
    }
  }
  .mn-thumb-carousel {
    display: flex;
    gap: 12px;
    margin-top: 16px;
    overflow-x: auto;
    padding-bottom: 8px;
    scrollbar-width: thin;
  }
  .mn-thumb-carousel::-webkit-scrollbar {
    height: 4px;
  }
  .mn-thumb-carousel::-webkit-scrollbar-thumb {
    background: rgba(0, 0, 0, 0.15);
    border-radius: 4px;
  }
  .mn-thumb {
    flex: 0 0 76px;
    height: 76px;
    border-radius: 8px;
    border: 2px solid transparent;
    cursor: pointer;
    overflow: hidden;
    background: #f5f5f5;
    opacity: 0.75;
    transition: all 0.2s ease;
  }
  .mn-thumb.active {
    border-color: #2c2c2e;
    opacity: 1;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }
  .mn-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* PRODUCT DETAILS */
  .mn-details {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .mn-info-card {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .mn-urgency-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #2cb2e8;
    border-radius: 30px;
    padding: 6px 16px;
    font-size: 13px;
    font-weight: 700;
    color: #ffffff;
    width: fit-content;
    box-shadow: 0 2px 10px rgba(44, 178, 232, 0.25);
  }
  .mn-rating-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
  }
  .mn-stars {
    color: #f7a800;
    letter-spacing: 2px;
    font-size: 16px;
  }
  .mn-rating-text {
    color: #4a4a4a;
    font-weight: 500;
  }
  .mn-title {
    font-size: 36px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: #121212;
  }
  @media (max-width: 600px) {
    .mn-title {
      font-size: 28px;
    }
  }
  .mn-price-box {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-top: 2px;
  }
  .mn-price {
    font-size: 28px;
    font-weight: 800;
