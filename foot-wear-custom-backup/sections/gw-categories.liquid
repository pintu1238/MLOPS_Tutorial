{% comment %}
  Section contract.
  Editorial category row: a serif headline, a script line, and five winter categories.
  @example
  <!-- Jackets, hoodies, pullovers, coats, winter dresses -->
{% endcomment %}

<section class="gw-cat" style="background: {{ section.settings.background }};">
  <div class="gw-cat__intro">
    <div>
      {% if section.settings.eyebrow != blank %}
        <p class="gw-cat__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      <h2 class="gw-cat__heading">
        <span class="gw-cat__serif">{{ section.settings.heading | escape }}</span>
        {% if section.settings.script != blank %}
          <span class="gw-cat__script">{{ section.settings.script | escape }}</span>
        {% endif %}
      </h2>
    </div>
    {% if section.settings.note != blank %}
      <p class="gw-cat__note">{{ section.settings.note | escape }}</p>
    {% endif %}
  </div>

  <div class="gw-cat__grid">
    {% for block in section.blocks %}
      {% liquid
        assign index_label = forloop.index | prepend: '00' | slice: -2, 2
        assign card_link = block.settings.link
      %}
      {% if card_link != blank %}
        <a class="gw-cat__card" href="{{ card_link }}" {{ block.shopify_attributes }}>
      {% else %}
        <div class="gw-cat__card" {{ block.shopify_attributes }}>
      {% endif %}
        <div class="gw-cat__media">
          {% if block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: 900
              | image_tag:
                alt: block.settings.alt,
                class: 'gw-cat__img',
                widths: '300, 450, 700, 900',
                sizes: '(min-width: 990px) 18vw, 70vw',
                loading: 'lazy'
            }}
          {% elsif block.settings.image_asset != blank %}
            <img
              class="gw-cat__img"
              src="{{ block.settings.image_asset | asset_url }}"
              alt="{{ block.settings.alt | escape }}"
              width="900"
              height="1200"
              loading="lazy"
            >
          {% endif %}
        </div>
        <div class="gw-cat__label">
          <span class="gw-cat__index">{{ index_label }}</span>
          <span class="gw-cat__title">{{ block.settings.title | escape }}</span>
          <span class="gw-cat__arrow">{% render 'gw-icon', name: 'arrow-up-right', class: 'gw-icon--arrow-cta' %}</span>
        </div>
      {% if card_link != blank %}
        </a>
      {% else %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .gw-cat {
    padding: 84px 4vw 72px;
    color: #0a0a0a;
  }

  .gw-cat__intro {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 24px 40px;
    align-items: end;
    margin-bottom: 36px;
  }

  .gw-cat__eyebrow {
    margin: 0 0 14px;
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #1a1a1a;
  }

  .gw-cat__heading {
    margin: 0;
    text-transform: none;
  }

  .gw-cat__serif {
    display: block;
    font-family: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
    font-size: clamp(3rem, 6vw, 5.5rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 0.9;
    text-transform: none;
  }

  .gw-cat__script {
    display: block;
    margin-top: 6px;
    font-family: "Segoe Script", "Snell Roundhand", "Apple Chancery", cursive;
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 400;
    line-height: 1;
    color: #a6843d;
    text-transform: none;
  }

  .gw-cat__note {
    margin: 0;
    max-width: 46ch;
    justify-self: end;
    align-self: end;
    padding-bottom: 0.12em;
    font-family: "Iowan Old Style", Palatino, Georgia, serif;
    font-size: 1.05rem;
    line-height: 1.45;
    color: #5e564f;
  }

  .gw-cat__grid {
    container-type: inline-size;
    display: flex;
    gap: 14px;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-inline: 9cqw;
    padding-bottom: 8px;
  }

  .gw-cat__grid::-webkit-scrollbar {
    display: none;
  }

  .gw-cat__card {
    flex: 0 0 82cqw;
    width: 82cqw;
    min-width: 0;
    color: inherit;
    text-decoration: none;
    scroll-snap-align: center;
    scroll-snap-stop: always;
    opacity: 0;
    animation: gw-cat-rise 0.8s ease forwards;
  }

  .gw-cat__card:nth-child(2) { animation-delay: 0.08s; }
  .gw-cat__card:nth-child(3) { animation-delay: 0.16s; }
  .gw-cat__card:nth-child(4) { animation-delay: 0.24s; }
  .gw-cat__card:nth-child(5) { animation-delay: 0.32s; }

  .gw-cat__media {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: #f3ece4;
  }

  .gw-cat__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease;
  }

  .gw-cat__card:hover .gw-cat__img {
    transform: scale(1.04);
  }

  .gw-cat__label {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 10px;
    align-items: baseline;
    margin-top: 12px;
    font-family: "Iowan Old Style", Palatino, Georgia, serif;
  }

  .gw-cat__index {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: #8d8378;
  }

  .gw-cat__title {
    font-size: 1.15rem;
    text-transform: none;
  }

  .gw-cat__arrow {
    font-size: 1rem;
  }

  @keyframes gw-cat-rise {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (min-width: 990px) {
    .gw-cat__grid {
      container-type: normal;
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 18px;
      overflow: visible;
      padding-inline: 0;
    }

    .gw-cat__card {
      flex: unset;
      width: auto;
      scroll-snap-align: unset;
      scroll-snap-stop: normal;
    }
  }

  @media (max-width: 989px) {
    .gw-cat__grid {
      width: 100%;
      max-width: 100%;
      margin-inline: -4vw;
      padding-inline: 9cqw;
    }
  }

  @media (max-width: 749px) {
    .gw-cat { padding: 40px 16px 36px; }
    .gw-cat__intro {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .gw-cat__note {
      display: none;
    }
    .gw-cat__serif { font-size: clamp(2.1rem, 10vw, 3rem); }
    .gw-cat__script { font-size: clamp(1.45rem, 7vw, 2.2rem); }
    .gw-cat__grid {
      margin-inline: -16px;
      gap: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gw-cat__card { opacity: 1; animation: none; }
    .gw-cat__img { transition: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Winter categories",
  "tag": "section",
  "class": "gw-categories-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Find your moment"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Curated with"
    },
    {
      "type": "text",
      "id": "script",
      "label": "Script line",
      "default": "warmth you can wear."
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Note",
      "default": "Start with a feeling. Jackets, hoodies, and the pieces you actually live in."
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Jackets"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Image description",
          "default": "Woman wearing a winter jacket"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Theme image filename"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Winter categories"
    }
  ]
}
{% endschema %}
