{% doc %}
  Scrolling trust ticker placed directly under the header on every page.
{% enddoc %}

{%- assign gw_ticker_items = 'FREE SHIPPING OVER $150,TRUE TO SIZE,30-DAY RETURNS,USA WAREHOUSE,PREMIUM LEATHER,SECURE CHECKOUT,EASY EXCHANGES' | split: ',' -%}

<style>
  .gw-ticker{
    position:relative;
    z-index:4;
    flex-shrink:0;
    min-height:38px;
    background:#1a1a1a;
    color:#f5f3f0;
    overflow:hidden;
    font-family:"Inter","Segoe UI",system-ui,sans-serif;
  }
  .gw-ticker__track{
    display:flex;
    align-items:center;
    width:max-content;
    min-height:38px;
    animation:gw-ticker-scroll 32s linear infinite;
  }
  .gw-ticker__group{
    display:flex;
    align-items:center;
    flex-shrink:0;
  }
  .gw-ticker__item{
    padding-inline:22px;
    font-size:.72rem;
    font-weight:600;
    letter-spacing:.16em;
    text-transform:uppercase;
    white-space:nowrap;
    color:#f5f3f0;
  }
  .gw-ticker__sep{
    color:#c4a574;
    font-size:.7rem;
    line-height:1;
    user-select:none;
  }
  @keyframes gw-ticker-scroll{
    to{transform:translateX(-50%)}
  }
  @media (prefers-reduced-motion:reduce){
    .gw-ticker__track{
      animation:none;
      width:100%;
      justify-content:center;
      flex-wrap:wrap;
    }
    .gw-ticker__group:last-child{display:none}
  }
</style>

<section class="gw-ticker" aria-label="Store highlights">
  <div class="gw-ticker__track">
    {% for copy in (1..2) %}
      <div class="gw-ticker__group" aria-hidden="true">
        {% for n in (1..3) %}
          {% for item in gw_ticker_items %}
            <span class="gw-ticker__item">{{ item | escape }}</span>
            <span class="gw-ticker__sep" aria-hidden="true">•</span>
          {% endfor %}
        {% endfor %}
      </div>
    {% endfor %}
  </div>
  <p class="visually-hidden">Free shipping over $150. True to size. 30-day returns. USA warehouse. Premium leather. Secure checkout. Easy exchanges.</p>
</section>
