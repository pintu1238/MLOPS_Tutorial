{{ 'lustrastrand.css' | asset_url | stylesheet_tag }}
<footer class="ls-footer ls-footer--schicht ls-footer--flytek" role="contentinfo">
  <div class="ls-footer__top ls-wrap">
    <div class="ls-footer__cols">
      <nav class="ls-footer__col" aria-label="Quick links">
        <h3 class="ls-footer__heading">Quick links</h3>
        <ul class="ls-footer__links">
          <li><a href="{{ routes.search_url }}">Search</a></li>
          <li><a href="/products/flytek-curve-rc-drift-car-4x4">RC Drift Car</a></li>
          <li><a href="/">Home</a></li>
          <li><a href="/pages/contact">Contact</a></li>
          <li><a href="/pages/track-order">Track Order</a></li>
        </ul>
      </nav>
      <div class="ls-footer__col ls-footer__news">
        <h3 class="ls-footer__heading ls-footer__heading--subscribe">Subscribe to our emails</h3>
        {% form 'customer', class: 'ls-footer__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="ls-footer__field">
            <span class="visually-hidden">Email</span>
            <input type="email" name="contact[email]" class="ls-footer__input" placeholder="Email" required autocomplete="email">
          </label>
          <button type="submit" class="ls-footer__signup">Sign up</button>
        {% endform %}
      </div>
    </div>
    <div class="ls-footer__pay" aria-label="Accepted payment methods">
      {% render 'ss-payment-icons' %}
    </div>
  </div>
  <div class="ls-footer__bar">
    <p class="ls-footer__copy">
      © {{ 'now' | date: '%Y' }}, {{ section.settings.brand_name }}™ Powered by Shopify
    </p>
  </div>
</footer>

{% stylesheet %}
  .ls-footer--flytek.ls-footer--schicht {
    background: linear-gradient(180deg, #1a1a1c 0%, #101012 45%, #0a0a0b 100%);
    color: #f4f4f5;
    border-top: 3px solid var(--ft-accent-bright, #ff1b1b);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  .ls-footer--flytek.ls-footer--schicht::before {
    background:
      radial-gradient(ellipse 85% 50% at 12% 0%, rgba(225, 6, 0, 0.28), transparent 58%),
      radial-gradient(ellipse 65% 45% at 88% 15%, rgba(255, 27, 27, 0.1), transparent 55%);
  }

  .ls-footer--flytek.ls-footer--schicht .ls-footer__links a:hover {
    color: #ff1b1b;
  }

  .ls-footer--flytek.ls-footer--schicht .ls-footer__input {
    border-color: rgba(255, 255, 255, 0.22);
    background: rgba(0, 0, 0, 0.35);
  }

  .ls-footer--flytek.ls-footer--schicht .ls-footer__input:focus {
    border-color: rgba(255, 27, 27, 0.75);
    background: rgba(0, 0, 0, 0.45);
    box-shadow: 0 0 0 1px rgba(255, 27, 27, 0.35);
  }

  .ls-footer--flytek.ls-footer--schicht .ls-footer__signup {
    background: linear-gradient(135deg, #ff1b1b, #e10600);
    box-shadow: 0 10px 24px rgba(225, 6, 0, 0.35);
  }

  .ls-footer--flytek.ls-footer--schicht .ls-footer__signup:hover {
    filter: brightness(1.06);
  }

  .ls-footer--flytek .ls-footer__pay {
    background: rgba(0, 0, 0, 0.35);
    border-color: rgba(255, 27, 27, 0.22);
  }

  .ls-footer--flytek .ls-footer__bar {
    border-top-color: rgba(255, 27, 27, 0.2);
    background: rgba(0, 0, 0, 0.45);
  }

  @media (min-width: 250px) and (max-width: 700px) {
    .ls-footer--flytek.ls-footer--schicht .ls-footer__top {
      padding: 1.65rem 0.85rem 1.35rem;
    }

    .ls-footer--flytek .ls-footer__cols {
      gap: 1.15rem;
      margin-bottom: 1.1rem;
    }

    .ls-footer--flytek.ls-footer--schicht .ls-footer__heading,
    .ls-footer--flytek.ls-footer--schicht .ls-footer__heading--subscribe {
      font-size: 0.66rem;
      margin-bottom: 0.55rem;
      letter-spacing: 0.1em;
    }

    .ls-footer--flytek.ls-footer--schicht .ls-footer__links a,
    .ls-footer--flytek.ls-footer--schicht .ls-footer__links a:link,
    .ls-footer--flytek.ls-footer--schicht .ls-footer__links a:visited {
      font-size: 0.86rem;
      line-height: 1.4;
      margin-bottom: 0.3rem;
    }

    .ls-footer--flytek.ls-footer--schicht .ls-footer__field {
      margin-bottom: 0.5rem;
    }

    .ls-footer--flytek.ls-footer--schicht .ls-footer__input {
      padding: 0.62rem 0.72rem;
      font-size: 0.86rem;
      border-radius: 7px;
    }

    .ls-footer--flytek.ls-footer--schicht .ls-footer__signup {
      padding: 0.62rem 0.85rem;
      font-size: 0.82rem;
      border-radius: 7px;
    }

    .ls-footer--flytek .ls-footer__pay {
      padding: 0.65rem 0.55rem;
      margin-top: 0.35rem;
      gap: 0.35rem 0.4rem;
      border-radius: 10px;
    }

    .ls-footer--flytek .sfoot__pay-icon {
      width: 36px;
      height: 23px;
    }

    .ls-footer--flytek .ls-footer__bar {
      padding: 0.7rem 0.85rem 0.85rem;
    }

    .ls-footer--flytek .ls-footer__copy {
      font-size: 0.7rem;
      line-height: 1.38;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "LS Footer",
  "class": "ls-footer-section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "FLYTEK" },
    {
      "type": "text",
      "id": "newsletter_text",
      "label": "Newsletter text",
      "default": "Join our email list for exclusive offers and the latest news."
    },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Disclaimer (optional)",
      "default": "*These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease. Individual results may vary."
    }
  ],
  "presets": [{ "name": "LS Footer" }]
}
{% endschema %}
