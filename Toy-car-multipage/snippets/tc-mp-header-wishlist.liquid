{% doc %}
  Header wishlist heart with red count badge.
  @param {string} link - Wishlist page URL
  @param {string} label - Accessible label
  @param {string} wrapper_class - Link element classes
{% enddoc %}
<a class="{{ wrapper_class }}" href="{{ link }}" aria-label="{{ label | escape }}">
  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <path d="M12 20.5 4.5 13a5.5 5.5 0 0 1 8-4.9 5.5 5.5 0 0 1 8 4.9L12 20.5z"/>
  </svg>
  <span class="tc-mp-hdr__wishlist-badge" data-tc-wishlist-count aria-hidden="true">0</span>
</a>
