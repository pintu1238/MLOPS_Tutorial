{% doc %}
  Renders filled star icons for product reviews.
  @param {number} rating - Star count 1–5
  @param {string} [class] - Optional extra class on the wrapper
{% enddoc %}
{%- liquid
  assign rating = rating | default: 5 | plus: 0
  if rating > 5
    assign rating = 5
  endif
  if rating < 0
    assign rating = 0
  endif
-%}
<span class="ft-reviews-widget__stars{% if class != blank %} {{ class }}{% endif %}" aria-hidden="true">
  {%- for i in (1..5) -%}
    <svg viewBox="0 0 20 20" focusable="false">
      {%- if i <= rating -%}
        <path fill="currentColor" d="M10 1.5l2.47 5.01 5.53.8-4 3.9.94 5.5L10 14.77l-4.94 2.94.94-5.5-4-3.9 5.53-.8L10 1.5z"/>
      {%- else -%}
        <path fill="#e5e7eb" d="M10 1.5l2.47 5.01 5.53.8-4 3.9.94 5.5L10 14.77l-4.94 2.94.94-5.5-4-3.9 5.53-.8L10 1.5z"/>
      {%- endif -%}
    </svg>
  {%- endfor -%}
</span>
