
<div class="ssh">
  <div class="wrap range-wrap">
    <div style="text-align:center;max-width:600px;margin:0 auto 26px">
      <div class="eyebrow">The full range</div>
      <h2 style="font-size:clamp(26px,4vw,32px);margin:0 0 8px">Complete your Sira Sculpt routine</h2>
      <p style="color:#5a4c44">Everything to smooth, support and love your body, honestly.</p>
    </div>
    <div class="shopgrid">
      <a class="pcard" href="/products/sira-sculpt-4d-lipedema-leggings-offer">
        <img src="{{ 'ss_card_leggings.png' | asset_url }}" alt="4D Lipedema Leggings" width="600" height="600" loading="lazy">
        <div class="pc-b"><h3>4D Lipedema Leggings</h3><div class="pc-p">$64.95 <s>$109.95</s></div><span class="pc-cta">Shop →</span></div>
      </a>
      <a class="pcard" href="/products/sira-sculpt-anti-chafing-3d-shorts">
        <img src="{{ 'ss_card_shorts.jpg' | asset_url }}" alt="Anti-Chafing 3D Shorts" width="600" height="600" loading="lazy">
        <div class="pc-b"><h3>Anti-Chafing 3D Shorts</h3><div class="pc-p">$49.95 <s>$89.95</s></div><span class="pc-cta">Shop →</span></div>
      </a>
      <a class="pcard" href="/products/sira-sculpt-magic-body-oil">
        <img src="{{ 'ss_card_oil.jpg' | asset_url }}" alt="Magic Body Oil" width="600" height="600" loading="lazy">
        <div class="pc-b"><h3>Magic Body Oil</h3><div class="pc-p">$55.99 <s>$60.00</s></div><span class="pc-cta">Shop →</span></div>
      </a>
      <a class="pcard" href="/products/the-lipedema-handbook">
        <img src="{{ 'ss_card_handbook.png' | asset_url }}" alt="The Lipedema Handbook" width="600" height="600" loading="lazy">
        <div class="pc-b"><h3>The Lipedema Handbook</h3><div class="pc-p">$24.00 <s>$39.00</s></div><span class="pc-cta">Shop →</span></div>
      </a>
    </div>
  </div>
</div>

