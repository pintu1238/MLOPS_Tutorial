{{ 'flytek-home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'flytek-sale-countdown.js' | asset_url }}" defer></script>
<script src="{{ 'flytek-reviews-carousel.js' | asset_url }}" defer></script>
<script src="{{ 'flytek-cta-cards-carousel.js' | asset_url }}" defer></script>
{%- liquid
  assign product = section.settings.product
  assign cta_url = section.settings.cta_url

  if product != blank
    assign cta_url = product.url
  elsif cta_url == blank
    assign cta_url = '/collections/all'
  endif
-%}

<div class="flytek-home" id="flytek-home-{{ section.id }}">
  <section class="ft-hero">
    <div class="ft-hero__bg" aria-hidden="true">
      {%- if section.settings.hero_image != blank -%}
        {{
          section.settings.hero_image
          | image_url: width: 2400
          | image_tag: loading: 'eager', fetchpriority: 'high', alt: section.settings.headline
        }}
      {%- else -%}
        <img
          src="{{ 'flytek-hero.jpg' | asset_url }}"
          alt="FLYTEK 1:14 remote control drift car with 2.4 GHz controller"
          width="1920"
          height="1080"
          loading="eager"
          fetchpriority="high"
        >
      {%- endif -%}
    </div>

    <div class="ft-wrap ft-hero__grid">
      <div class="ft-hero__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ft-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.headline != blank -%}
          <p class="ft-hero__kicker">{{ section.settings.headline | escape }}</p>
        {%- endif -%}
        {%- liquid
          assign offer_lead = section.settings.offer_lead | default: 'Up to'
          assign offer_accent = section.settings.offer_accent | default: '60%'
          assign offer_end = section.settings.offer_end | default: 'Off'
          assign trust_one = section.settings.trust_one | default: 'Pan India|Delivery'
          assign trust_two = section.settings.trust_two | default: 'Quality|Checked'
          assign trust_three = section.settings.trust_three | default: 'Perfect gift|For all ages'
        -%}
        <h1 class="ft-hero__offer">
          <span>{{ offer_lead | escape }}</span>
          <span class="ft-hero__offer-accent">{{ offer_accent | escape }}</span>
          <span>{{ offer_end | escape }}</span>
        </h1>
        {%- if section.settings.subheadline != blank -%}
          <p class="ft-hero__sub">{{ section.settings.subheadline | escape }}</p>
        {%- endif -%}
        <div class="ft-actions">
          <a class="ft-btn ft-btn--sale" href="{{ cta_url }}">
            {{ section.settings.cta_label | escape }}
            <svg class="ft-btn__arrow" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
              <path d="M4 10h11M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
        <ul class="ft-hero__trust">
          <li>
            <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
              <path d="M3 20h3.2l1.4-4.2A2 2 0 0 1 9.5 14.5h9.2a2 2 0 0 1 1.9 1.4L22 20h3.2a2 2 0 0 1 2 1.6l.6 3.2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M6 24.5h16.5M8.5 24.5a2.2 2.2 0 1 0 0 .1M22.2 24.5a2.2 2.2 0 1 0 0 .1" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
              <path d="M5 14.5V9.8A1.8 1.8 0 0 1 6.8 8h6.4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
            <span>
              {%- assign trust_one_lines = trust_one | split: '|' -%}
              {%- for line in trust_one_lines -%}
                {{ line | strip | escape }}{%- unless forloop.last -%}<br>{%- endunless -%}
              {%- endfor -%}
            </span>
          </li>
          <li>
            <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
              <path d="M16 4.5 26 8.5v7.2c0 6.2-4.1 10.4-10 12.3-5.9-1.9-10-6.1-10-12.3V8.5L16 4.5Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
              <path d="m11.5 16.2 3 3 6.2-6.4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>
              {%- assign trust_two_lines = trust_two | split: '|' -%}
              {%- for line in trust_two_lines -%}
                {{ line | strip | escape }}{%- unless forloop.last -%}<br>{%- endunless -%}
              {%- endfor -%}
            </span>
          </li>
          <li>
            <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
              <rect x="6" y="13" width="20" height="13" rx="1.6" fill="none" stroke="currentColor" stroke-width="1.6"/>
              <path d="M16 13v13M6 17.5h20M10.5 13c0-3 1.6-5 5.5-5s5.5 2 5.5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
            <span>
              {%- assign trust_three_lines = trust_three | split: '|' -%}
              {%- for line in trust_three_lines -%}
                {{ line | strip | escape }}{%- unless forloop.last -%}<br>{%- endunless -%}
              {%- endfor -%}
            </span>
          </li>
        </ul>
      </div>
      <div class="ft-hero__card">
        <span class="ft-hero__badge">1:14 RC Drift</span>
        {%- if section.settings.product_image != blank -%}
          {{
            section.settings.product_image
            | image_url: width: 1200
            | image_tag: loading: 'eager', class: 'ft-hero__product-img', alt: 'FLYTEK racing drift RC car'
          }}
        {%- else -%}
          <img
            class="ft-hero__product-img"
            src="{{ 'flytek-racing-drift-hero.jpg' | asset_url }}"
            alt="FLYTEK 1:14 racing drift RC car"
            width="1200"
            height="900"
            loading="eager"
            fetchpriority="high"
          >
        {%- endif -%}
      </div>
    </div>
  </section>

  <section class="ft-section ft-section--features">
    <div class="ft-wrap">
      <header class="ft-head ft-head--features">
        <p class="ft-head__eyebrow">Why FLYTEK</p>
        <h2>{{ section.settings.features_heading }}</h2>
        <p class="ft-head__lead">{{ section.settings.features_subheading }}</p>
      </header>
      <div class="ft-features">
        <article class="ft-feature">
          <h3>4WD drift capability</h3>
          <p>Four-wheel drive with dedicated drifting tyres for smooth sideways action on flat surfaces.</p>
        </article>
        <article class="ft-feature">
          <h3>2.4 GHz pistol-grip remote</h3>
          <p>Precise throttle, steering, forward and reverse — responsive control for beginners and enthusiasts.</p>
        </article>
        <article class="ft-feature">
          <h3>Complete starter kit</h3>
          <p>RC car, remote, USB rechargeable battery, drift and racing tyre sets, cones, screwdriver, and manual.</p>
        </article>
        <article class="ft-feature">
          <h3>GT-inspired design</h3>
          <p>LED headlights, rear spoiler, and racing decals — approx. 20.5 × 8.7 × 5.9 cm (1:14 scale).</p>
        </article>
      </div>
    </div>
  </section>

  <section class="ft-section ft-section--alt" id="flytek-inbox">
    <div class="ft-wrap ft-box">
      <div class="ft-box__media">
        {%- if section.settings.box_image != blank -%}
          {{
            section.settings.box_image
            | image_url: width: 1400
            | image_tag: loading: 'lazy', alt: "What's in the box"
          }}
        {%- else -%}
          <img
            src="{{ 'flytek-inbox.jpg' | asset_url }}"
            alt="What's in the box"
            width="1400"
            height="788"
            loading="lazy"
          >
        {%- endif -%}
      </div>
      <div class="ft-box__copy">
        <header class="ft-head ft-head--box">
          <h2>{{ section.settings.box_heading }}</h2>
          <p>Everything included to start drifting right out of the box.</p>
        </header>
        <ul>
          <li>1 × FLYTEK Curve RC drift car</li>
          <li>1 × 2.4 GHz remote controller</li>
          <li>1 × Rechargeable battery + USB charging cable</li>
          <li>4 × Drifting tyres + 4 × Racing tyres</li>
          <li>4 × Obstacle cones + screwdriver</li>
          <li>Instruction manual</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="ft-section ft-section--reviews">
    <div class="ft-wrap ft-section--reviews__wrap">
      <header class="ft-head ft-head--reviews">
        <h2>{{ section.settings.reviews_heading }}</h2>
      </header>
      <div class="ft-reviews-carousel" data-ft-reviews-carousel>
        <button type="button" class="ft-reviews__nav ft-reviews__nav--prev" data-ft-reviews-prev aria-label="Previous reviews">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="ft-reviews__track" data-ft-reviews-track tabindex="0">
          {%- liquid
            assign review_fallbacks = 'flytek-review-01.jpg,flytek-review-02.jpg,flytek-review-03.jpg,flytek-review-04.jpg,flytek-review-05.jpg,flytek-review-06.jpg,flytek-review-07.jpg,flytek-review-08.jpg,flytek-review-09.jpg' | split: ','
            assign review_quotes = section.settings.review_1_quote
            assign review_quotes = review_quotes | append: '♦' | append: section.settings.review_2_quote
            assign review_quotes = review_quotes | append: '♦' | append: section.settings.review_3_quote
            assign review_quotes = review_quotes | append: '♦' | append: section.settings.review_4_quote
            assign review_quotes = review_quotes | append: '♦' | append: section.settings.review_5_quote
            assign review_quotes = review_quotes | append: '♦' | append: section.settings.review_6_quote
            assign review_quotes = review_quotes | append: '♦' | append: section.settings.review_7_quote
            assign review_quotes = review_quotes | append: '♦' | append: section.settings.review_8_quote
            assign review_quotes = review_quotes | append: '♦' | append: section.settings.review_9_quote
            assign review_quotes = review_quotes | split: '♦'
          -%}
          {%- for i in (0..8) -%}
            {%- liquid
              case i
                when 0
                  assign review_image = section.settings.review_1_image
                when 1
                  assign review_image = section.settings.review_2_image
                when 2
                  assign review_image = section.settings.review_3_image
                when 3
                  assign review_image = section.settings.review_4_image
                when 4
                  assign review_image = section.settings.review_5_image
                when 5
                  assign review_image = section.settings.review_6_image
                when 6
                  assign review_image = section.settings.review_7_image
                when 7
                  assign review_image = section.settings.review_8_image
                when 8
                  assign review_image = section.settings.review_9_image
              endcase
              assign fallback_index = i
            -%}
            <blockquote class="ft-review">
              <div class="ft-review__media">
                {%- if review_image != blank -%}
                  {{
                    review_image
                    | image_url: width: 720
                    | image_tag: loading: 'lazy', class: 'ft-review__photo', alt: 'Customer with FLYTEK RC drift car'
                  }}
                {%- else -%}
                  <img
                    class="ft-review__photo"
                    src="{{ review_fallbacks[fallback_index] | asset_url }}"
                    alt="Customer with FLYTEK RC drift car"
                    width="720"
                    height="720"
                    loading="lazy"
                  >
                {%- endif -%}
                <span class="ft-review__media-fade" aria-hidden="true"></span>
              </div>
              <div class="ft-review__body">
                <p>“{{ review_quotes[i] | strip }}”</p>
                <div class="ft-review__meta">
                  <span class="ft-review__verified">
                    <svg class="ft-review__check" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                      <path d="M2.5 7.2 5.4 10 11.5 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    {{ section.settings.review_verified_label }}
                  </span>
                  <span class="ft-review__source">{{ section.settings.review_source_label }}</span>
                </div>
              </div>
            </blockquote>
          {%- endfor -%}
        </div>
        <button type="button" class="ft-reviews__nav ft-reviews__nav--next" data-ft-reviews-next aria-label="Next reviews">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>
  </section>

  <section
    class="ft-cta ft-cta--sale"
    data-ft-sale-countdown
    data-end="{{ section.settings.sale_end_datetime | escape }}"
    data-start="{{ section.settings.sale_start_datetime | escape }}"
    aria-labelledby="ft-cta-title-{{ section.id }}"
  >
    <div class="ft-wrap ft-cta__inner">
      <header class="ft-cta__head">
        <h2 id="ft-cta-title-{{ section.id }}">{{ section.settings.final_heading }}</h2>
        <p>{{ section.settings.final_subheading }}</p>
      </header>

      <div class="ft-cta__panel">
      <div class="ft-cta__cards-carousel" data-ft-cta-cards-carousel>
        <button type="button" class="ft-cta__cards-nav ft-cta__cards-nav--prev" data-ft-cta-cards-prev aria-label="Previous color">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <ul class="ft-cta__cards" role="list" data-ft-cta-cards-track tabindex="0">
          {%- assign sale_cards = 'flytek-sale-01.jpg|Cyan blue,flytek-sale-02.jpg|Racing red,flytek-sale-03.jpg|Volt yellow' | split: ',' -%}
          {%- for card in sale_cards -%}
            {%- assign parts = card | split: '|' -%}
            {%- assign img_file = parts[0] | strip -%}
            {%- assign card_label = parts[1] | strip -%}
            <li class="ft-cta__card">
              <a class="ft-cta__card-link" href="{{ cta_url }}">
                <span class="ft-cta__card-media">
                  <img
                    src="{{ img_file | asset_url }}"
                    alt="FLYTEK DRIFT RC car — {{ card_label | escape }}"
                    width="400"
                    height="520"
                    loading="lazy"
                  >
                </span>
                <span class="ft-cta__card-label">{{ card_label | escape }}</span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
        <button type="button" class="ft-cta__cards-nav ft-cta__cards-nav--next" data-ft-cta-cards-next aria-label="Next color">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>

      <div data-ft-cd-live>
        <p class="ft-cta__timer-eyebrow">{{ section.settings.sale_timer_label | escape }}</p>
        <div class="ft-cta__timer" role="timer" aria-live="polite">
          <div class="ft-cta__timer-unit">
            <span class="ft-cta__timer-value" data-ft-cd-days>00</span>
            <span class="ft-cta__timer-name">Days</span>
          </div>
          <span class="ft-cta__timer-sep" aria-hidden="true">:</span>
          <div class="ft-cta__timer-unit">
            <span class="ft-cta__timer-value" data-ft-cd-hours>00</span>
            <span class="ft-cta__timer-name">Hrs</span>
          </div>
          <span class="ft-cta__timer-sep" aria-hidden="true">:</span>
          <div class="ft-cta__timer-unit">
            <span class="ft-cta__timer-value" data-ft-cd-mins>00</span>
            <span class="ft-cta__timer-name">Min</span>
          </div>
          <span class="ft-cta__timer-sep" aria-hidden="true">:</span>
          <div class="ft-cta__timer-unit">
            <span class="ft-cta__timer-value" data-ft-cd-secs>00</span>
            <span class="ft-cta__timer-name">Sec</span>
          </div>
        </div>
        <div class="ft-cta__timebar" aria-hidden="true">
          <span class="ft-cta__timebar-fill" data-ft-timebar-fill style="width: 100%"></span>
        </div>
      </div>
      <p class="ft-cta__expired" data-ft-cd-expired hidden>{{ section.settings.sale_expired_text | escape }}</p>

      <a class="ft-cta__shop ft-btn ft-btn--sale" href="{{ cta_url }}">{{ section.settings.sale_cta_label | escape }}</a>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "FLYTEK home",
  "tag": "section",
  "class": "flytek-home-section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product for price and CTA"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL (if no product selected)",
      "info": "Default: /collections/all. Use /products/your-handle when the FLYTEK product is live."
    },
    {
      "type": "text",
      "id": "price_text",
      "label": "Price override",
      "default": "From ₹1,376",
      "info": "Shown when no product is selected, or to override display text."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero background image"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Hero product card image"
    },
    {
      "type": "image_picker",
      "id": "box_image",
      "label": "In the box image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "High speed toys"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "RC Drift Cars"
    },
    {
      "type": "text",
      "id": "offer_lead",
      "label": "Offer lead",
      "default": "Up to"
    },
    {
      "type": "text",
      "id": "offer_accent",
      "label": "Offer highlight",
      "default": "60%"
    },
    {
      "type": "text",
      "id": "offer_end",
      "label": "Offer end",
      "default": "Off"
    },
    {
      "type": "textarea",
      "id": "subheadline",
      "label": "Subheadline",
      "default": "High-speed RC cars, 4WD drift cars, mini RC cars and more — for racing, drifting and everyday fun."
    },
    {
      "type": "text",
      "id": "trust_one",
      "label": "Trust line 1",
      "default": "Pan India|Delivery",
      "info": "Use | to split onto two lines."
    },
    {
      "type": "text",
      "id": "trust_two",
      "label": "Trust line 2",
      "default": "Quality|Checked",
      "info": "Use | to split onto two lines."
    },
    {
      "type": "text",
      "id": "trust_three",
      "label": "Trust line 3",
      "default": "Perfect gift|For all ages",
      "info": "Use | to split onto two lines."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Primary button label",
      "default": "Shop now"
    },
    {
      "type": "text",
      "id": "secondary_cta_label",
      "label": "Secondary button label",
      "default": "See what's in the box"
    },
    {
      "type": "text",
      "id": "features_heading",
      "label": "Features heading",
      "default": "Built for sideways action"
    },
    {
      "type": "text",
      "id": "features_subheading",
      "label": "Features subheading",
      "default": "Four-wheel drive, swap tyres for drift or race mode, and charge via USB between sessions."
    },
    {
      "type": "text",
      "id": "box_heading",
      "label": "Box section heading",
      "default": "What's in the box"
    },
    {
      "type": "text",
      "id": "reviews_heading",
      "label": "Reviews heading",
      "default": "What riders are saying"
    },
    {
      "type": "header",
      "content": "Reviews"
    },
    {
      "type": "image_picker",
      "id": "review_1_image",
      "label": "Review 1 customer photo"
    },
    {
      "type": "textarea",
      "id": "review_1_quote",
      "label": "Review 1 quote",
      "default": "Car looks really nice and the build quality feels solid for the price. Remote is easy for my son to use, the LED lights look cool in the evening, and swapping to drift tyres took only a minute. Extra cones and spare tyres in the box were a pleasant surprise."
    },
    {
      "type": "image_picker",
      "id": "review_2_image",
      "label": "Review 2 customer photo"
    },
    {
      "type": "textarea",
      "id": "review_2_quote",
      "label": "Review 2 quote",
      "default": "Really cool remote control car — headlights and body LEDs make it look amazing on the floor. Setup was simple, USB charging is handy between races, and it drifts smoothly once you get the hang of throttle control. Great toy for kids and adults."
    },
    {
      "type": "image_picker",
      "id": "review_3_image",
      "label": "Review 3 customer photo"
    },
    {
      "type": "textarea",
      "id": "review_3_quote",
      "label": "Review 3 quote",
      "default": "Nice car — my boy is very happy and plays with it every evening after homework. Good speed for home use, tyres grip well on our tiles, and the complete kit means we did not need to buy anything extra. Strong value RC car for the price."
    },
    {
      "type": "image_picker",
      "id": "review_4_image",
      "label": "Review 4 customer photo"
    },
    {
      "type": "textarea",
      "id": "review_4_quote",
      "label": "Review 4 quote",
      "default": "Battery lasts long enough for multiple drift sessions before we plug in the USB cable. Build feels solid for kids and adults, shell has taken a few bumps without cracking, and the pistol-grip remote is comfortable even for longer play."
    },
    {
      "type": "image_picker",
      "id": "review_5_image",
      "label": "Review 5 customer photo"
    },
    {
      "type": "textarea",
      "id": "review_5_quote",
      "label": "Review 5 quote",
      "default": "Fast delivery and well packed — box arrived intact with all accessories listed. The drift tyres work great on tiles and smooth floors, and racing tyres are fun in the hallway. Would buy again for a birthday gift."
    },
    {
      "type": "image_picker",
      "id": "review_6_image",
      "label": "Review 6 customer photo"
    },
    {
      "type": "textarea",
      "id": "review_6_quote",
      "label": "Review 6 quote",
      "default": "My daughter loves the LED lights on the car — she chases it around the living room every day. Easy setup out of the box, USB charging is convenient, and the included screwdriver made tyre swaps simple without hunting for tools."
    },
    {
      "type": "image_picker",
      "id": "review_7_image",
      "label": "Review 7 customer photo"
    },
    {
      "type": "textarea",
      "id": "review_7_quote",
      "label": "Review 7 quote",
      "default": "Great value RC kit — remote response is quick with almost no lag, steering feels precise for drifting corners, and the spare drift and race tyres are useful when one set wears out. Complete package for weekend fun."
    },
    {
      "type": "image_picker",
      "id": "review_8_image",
      "label": "Review 8 customer photo"
