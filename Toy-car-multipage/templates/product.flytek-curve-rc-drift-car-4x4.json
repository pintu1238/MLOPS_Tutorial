      "blocks": {
        "faq_1": {
          "type": "item",
          "settings": {
            "question": "How do I choose the right RC car?",
            "answer": "<p>FLYTEK Curve is a 1:14 4WD drift car for indoor and outdoor play. This kit includes both drift and racing tyres so you can switch surfaces.</p>"
          }
        },
        "faq_2": {
          "type": "item",
          "settings": {
            "question": "What is the difference between drift tyres and racing tyres?",
            "answer": "<p>Drift tyres slide on smooth tile, wood, or concrete. Racing tyres add grip for carpet or rougher ground. Both sets come in the box.</p>"
          }
        },
        "faq_3": {
          "type": "item",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>We dispatch within 24 hours on business days and ship pan-India. Delivery usually takes 2–5 days depending on your pin code.</p>"
          }
        },
        "faq_4": {
          "type": "item",
          "settings": {
            "question": "Can I return or exchange a car?",
            "answer": "<p>Contact us within 7 days of delivery with photos if the car arrives damaged or faulty. We will arrange a replacement for transit damage or faults on arrival.</p>"
          }
        },
        "faq_5": {
          "type": "item",
          "settings": {
            "question": "How should I store my RC car?",
            "answer": "<p>Keep it in a cool, dry place away from direct sun. Remove the battery if you will not use it for a while, and store the remote and spare tyres with the car.</p>"
          }
        }
      },
