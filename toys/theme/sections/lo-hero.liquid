<section class="lo-hero" id="top">
  <div>
    <p class="lo-kicker">Ages 2 and up</p>
    <h1>Wooden toys a child can really play with.</h1>
    <p>Quiet wood, smooth edges, and no batteries. Little Oak is a shelf for toddlers and big kids, built so parents can shop in one calm minute.</p>
    <div class="lo-hero__actions">
      <a class="lo-btn lo-btn--clay" href="#shelf">Shop 50% off</a>
      <a class="lo-btn lo-btn--ghost" href="#ages">Find an age</a>
    </div>
    <p class="lo-hero__note">Hover a toy to see a child playing with it.</p>
  </div>
  <div class="lo-hero__photo">
    <img src="{{ 'lo-hero.jpg' | asset_url }}" alt="A wooden train on a sunlit oak floor">
  </div>
</section>

{% schema %}
{ "name": "Little Oak hero", "settings": [], "presets": [{ "name": "Little Oak hero" }] }
{% endschema %}
