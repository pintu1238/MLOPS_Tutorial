<section class="lo-story" id="story">
  <div class="lo-story__copy">
    <p class="lo-kicker" style="background:#4e3d31;color:#f3c9a2;">A Saturday</p>
    <h2>One train. The whole morning.</h2>
    <p>The toy stays on the floor. That is how we know it was the right one.</p>
    <ol class="lo-story__beats">
      <li>
        <b>Breakfast</b>
        <span>The train comes to the table. A car waits by the chair.</span>
      </li>
      <li>
        <b>The rug</b>
        <span>Animals line up. The bus door opens. Nobody asks for a screen.</span>
      </li>
      <li>
        <b>Again tomorrow</b>
        <span>Same wood. Same hands. The play is still theirs.</span>
      </li>
    </ol>
    <div class="lo-story__facts">
      <span>Ages 2+</span>
      <span>No batteries</span>
      <span>50% off</span>
    </div>
    <a class="lo-btn lo-btn--clay" href="#shelf">Back to the shelf</a>
  </div>
  <img src="{{ 'lo-play-train.jpg' | asset_url }}" alt="A child pushing a wooden train across the floor">
</section>

{% schema %}
{ "name": "Little Oak story", "settings": [], "presets": [{ "name": "Little Oak story" }] }
{% endschema %}
