<script>
  document.querySelectorAll("[data-pants-tabs]").forEach(function (root) {
    root.querySelectorAll("[data-tab]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        root.querySelectorAll("[data-tab]").forEach(function (el) { el.classList.remove("is-on"); });
        root.querySelectorAll("[data-panel]").forEach(function (el) { el.hidden = true; el.classList.remove("is-on"); });
        btn.classList.add("is-on");
        var panel = root.querySelector('[data-panel="' + btn.dataset.tab + '"]');
        if (panel) { panel.hidden = false; panel.classList.add("is-on"); }
      });
    });
  });
  document.querySelectorAll(".reel video").forEach(function (video) {
    video.controls = false;
    video.muted = true;
    video.loop = true;
    video.playsInline = true;
    video.disablePictureInPicture = true;
    if (!video.getAttribute("src") && video.dataset.src) video.src = video.dataset.src;
    var play = function () {
      var p = video.play();
      if (p && p.catch) p.catch(function () {});
    };
    play();
    video.addEventListener("pause", function () {
      if (document.visibilityState === "visible") play();
    });
  });
</script>
