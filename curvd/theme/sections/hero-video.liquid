<section class="video-hero">
  {% if section.settings.video != blank %}
    {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: '1600x' }}
  {% else %}
    <video autoplay muted loop playsinline poster="{{ 'move-poster.jpg' | asset_url }}">
      <source src="{{ 'move-with-you.mp4' | asset_url }}" type="video/mp4">
    </video>
  {% endif %}
  <div class="hero__shade"></div>
  <div class="video-hero__copy">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
    <a class="btn btn--light" href="{{ section.settings.link }}">{{ section.settings.button }}</a>
  </div>
</section>

{% schema %}
{
  "name": "Hero video",
  "settings": [
    { "type": "video", "id": "video", "label": "Video" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made To Move With You" },
    { "type": "text", "id": "text", "label": "Text", "default": "All-Day Comfort Guaranteed" },
    { "type": "text", "id": "button", "label": "Button", "default": "SHOP NOW" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Hero video" }]
}
{% endschema %}
