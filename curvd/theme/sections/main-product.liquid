{% assign current = product.selected_or_first_available_variant %}
{% assign show_bundle = false %}
{% assign is_capri = false %}
{% if product.handle == 'comfort-stretch-smart-capri-pants-high-rise-all-day-comfort' or product.handle == 'performance-work-trousers' or product.handle == 'sherpa-fur-leggings-toasty-warm-figure-shaping' %}
  {% assign show_bundle = true %}
{% endif %}
{% if product.handle == 'comfort-stretch-smart-capri-pants-high-rise-all-day-comfort' %}
  {% assign is_capri = true %}
{% endif %}
{% if product.handle == 'sherpa-fur-leggings-toasty-warm-figure-shaping' %}
  {% assign is_leggings = true %}
{% endif %}
{% assign gallery_files = '' %}
{% case product.handle %}
