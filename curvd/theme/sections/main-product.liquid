          </div>
        {% else %}
          <div>
            <img src="https://cdn.shopify.com/s/files/1/0937/9230/5418/files/truck-2.svg" alt="" width="28" height="20">
            <strong>FREE Worldwide</strong> Shipping
          </div>
        <div>
          <img src="https://cdn.shopify.com/s/files/1/0937/9230/5418/files/easy-returns.svg" alt="" width="22" height="22">
          <strong>30-Day Money-Back</strong> Guarantee
        </div>
        <div>
          <img src="https://cdn.shopify.com/s/files/1/0937/9230/5418/files/secure-checkout.svg" alt="" width="22" height="22">
          <strong>Easy &amp; Secure</strong> Checkout
        </div>
        {% endif %}
      </div>
      {% if is_leggings %}
        <div class="leg-upsells">
          <p>COMPLETE YOUR WINTER LOOK WITH:</p>
          {% assign winter_upsells = 'curvd-cozy-fall-slouch-socks,curvd-cozy-suede-look-slippers' | split: ',' %}
          {% for up_handle in winter_upsells %}
            {% assign up = all_products[up_handle] %}
            {% if up != blank %}
              {% form 'product', up, class: 'leg-upsell' %}
                <a href="{{ up.url }}"><img src="{{ up.featured_image | image_url: width: 160 }}" alt="" width="72" height="90"></a>
                <div>
                  {% if up.compare_at_price > up.price %}
                    <span class="leg-upsell__off">-{{ up.compare_at_price | minus: up.price | times: 100 | divided_by: up.compare_at_price }}%</span>
                  {% endif %}
                  <strong>{{ up.title }}</strong>
                  <label>Color
                    <select name="id">
                      {% for variant in up.variants %}
                        <option value="{{ variant.id }}">{{ variant.title }}</option>
                      {% endfor %}
                    </select>
                  </label>
                  <span class="leg-upsell__price">{{ up.price | money }} {% if up.compare_at_price > up.price %}<s>{{ up.compare_at_price | money }}</s>{% endif %}</span>
                  <button type="submit">+ ADD TO CART</button>
                </div>
              {% endform %}
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    {% else %}
      <div class="pdp-acc">
        <details>
          <summary>Description</summary>
          <div class="pdp-copy">{{ product.description }}</div>
        </details>
        <details>
          <summary>Materials &amp; Care</summary>
          <div class="pdp-copy">
            {% case product.handle %}
              {% when 'curvd-cozy-fall-slouch-socks' %}
                <p>Wash cold at 30°C / 86°F. Hang dry. Do not bleach, tumble dry, iron, or dry-clean.</p>
              {% when 'curvd-cozy-suede-look-slippers' %}
                <p>Suede-look upper with plush faux-fur lining. Spot clean. Do not machine wash.</p>
              {% when 'sherpa-fur-leggings-toasty-warm-figure-shaping' %}
                <p>Premium sherpa fur lining with a breathable, heat-lock outer. Machine wash cold and hang dry.</p>
              {% else %}
                <p>Ribbed stretch knit with a built-in shelf bra. Machine wash cold and hang dry. Do not bleach.</p>
            {% endcase %}
          </div>
        </details>
        <details>
          <summary>Certifications</summary>
          <div class="pdp-copy"><p>Quality materials, thoughtful details, and products made to keep up.</p></div>
        </details>
        <details>
          <summary>Shipping &amp; Returns</summary>
          <div class="pdp-copy"><p>Free worldwide shipping with tracking. Eligible orders can be returned within 30 days of delivery.</p></div>
        </details>
      </div>
    {% endif %}
  </div>
  </div>
</section>

{% if show_bundle %}
  {% if is_capri %}
    {% assign sticky_title = 'Everyday Stretch Capri | High Rise & All-Day Comfort' %}
  {% elsif is_leggings %}
    {% assign sticky_title = product.title %}
  {% else %}
    {% assign sticky_title = 'Everyday Stretch Pants | High Rise & All-Day Comfort' %}
  {% endif %}
{% else %}
  {% assign sticky_title = product.title %}
{% endif %}
<div class="sticky-atc" data-sticky-atc>
  <div class="sticky-atc__copy">
    <strong>{{ sticky_title }}</strong>
    <p>
      <span class="sticky-atc__stars" aria-hidden="true">★★★★★</span>
      {% if show_bundle %}
        4.9 · Buy 1, Get 1 FREE Today
      {% else %}
        {{ current.price | money }}
      {% endif %}
    </p>
  </div>
  <button class="sticky-atc__btn" type="button" data-sticky-add {% unless current.available %}disabled{% endunless %}>
    {% if current.available %}Add to cart{% else %}Sold out{% endif %}
  </button>
</div>

<div class="modal" data-size-modal>
  <div class="modal__card" style="grid-template-columns:1fr;padding:24px">
    <button class="close-x" type="button" data-close>×</button>
    <h2>What's my size?</h2>
    <p class="muted" style="margin:8px 0 14px">Customers say these fit true to size. If you are between sizes, choose the larger size.</p>
    <table class="cart-table">
      <thead><tr><th>Size</th><th>Waist</th><th>Hip</th></tr></thead>
      <tbody>
        <tr><td>XS</td><td>24–26 in</td><td>34–36 in</td></tr>
        <tr><td>S</td><td>26–28 in</td><td>36–38 in</td></tr>
        <tr><td>M</td><td>28–31 in</td><td>38–41 in</td></tr>
        <tr><td>L</td><td>31–34 in</td><td>41–44 in</td></tr>
        <tr><td>XL</td><td>34–37 in</td><td>44–47 in</td></tr>
        <tr><td>2XL / XXL</td><td>37–41 in</td><td>47–51 in</td></tr>
      </tbody>
    </table>
  </div>
</div>
<script>
  document.querySelector('[data-size-open]')?.addEventListener('click', () => {
    document.querySelector('[data-size-modal]')?.classList.add('is-open');
  });
</script>

{% schema %}
{
  "name": "Product",
  "settings": [],
  "presets": [{ "name": "Product" }]
}
{% endschema %}
