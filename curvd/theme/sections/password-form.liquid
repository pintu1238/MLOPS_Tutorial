<section class="password-card">
  <a class="logo" href="{{ routes.root_url }}" style="color:#111">CURVD.</a>
  <p>Opening soon.</p>
  {% form 'storefront_password' %}
    {{ form.errors | default_errors }}
    <input type="password" name="password" placeholder="Password" aria-label="Password">
    <button class="btn" style="width:auto;margin-top:10px" type="submit">Enter</button>
  {% endform %}
</section>
{% schema %}
{ "name": "Password", "settings": [] }
{% endschema %}
