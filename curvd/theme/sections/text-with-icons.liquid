<section class="icons">
  <div class="wrap">
    <h2>{{ section.settings.heading }}</h2>
    <div class="icon-grid">
      {% for block in section.blocks %}
        <article {{ block.shopify_attributes }}>
          {% case block.settings.icon %}
            {% when 'globe' %}
              <svg class="icon-mark" viewBox="0 0 100 100" aria-hidden="true"><path d="M82.19 69.25a13.09 13.09 0 0 1-3.54-3 1.86 1.86 0 0 1 0-2.38c1.29-1.52 3.08-5-4.17-7.52a5.28 5.28 0 0 0-2.24 0 12.36 12.36 0 0 1-5.49 0 9.78 9.78 0 0 1-4.1-2.16c-.23-.2-.44-.41-.65-.63a10.08 10.08 0 0 1-2.17-10l.15-.46a8.09 8.09 0 0 0-3.92-9.55l-1.83-1c-3.54-1.58-5.69-3.88-6.39-6.83-1-4-.14-7.55 4.46-13.15"/><path d="M32 17.1a13 13 0 0 1 3.52 7.23 9.74 9.74 0 0 1-.52 4.76 11.74 11.74 0 0 1-2.16 3.61 10.49 10.49 0 0 0-1.72 2.73c-.62 1.51-1.12 3.44-.61 4.91a4 4 0 0 0 2.75 2.33c.25.08.52.16.8.23a5.11 5.11 0 0 1 4.24 4.65c.13 2-.82 4.29-2.68 6.44a17.84 17.84 0 0 1-6.76 4.78A15.87 15.87 0 0 1 23 59.93a14.39 14.39 0 0 1-3.14-.35c-3.45-.77-3.73-1.39-6.86-3.58"/><path d="M32.12 83c-.18-2.75-2.68-8.09.69-13.4a22.33 22.33 0 0 1 8.36-7.36c3.48-1.79 6.77-2.37 9-1.58a4.61 4.61 0 0 1 3.08 5.12v.83a4 4 0 0 0 1.21 3.3c1.49 1.26 4.42 1.3 6.66.91a2.55 2.55 0 0 0 .59-.18A12.09 12.09 0 0 1 67 69.43a9.74 9.74 0 0 1 4.51 1.2 12.61 12.61 0 0 1 5.41 5.51"/><circle cx="50" cy="50" r="37.5"/></svg>
            {% when 'cotton' %}
              <svg class="icon-mark" viewBox="0 0 100 100" aria-hidden="true"><path d="M50 82V66.516m0 0c-17.66 5.051-25.761-5.526-27.861-12.043M50 66.516a17.074 17.074 0 0 0-1.157-3.138c-1.927-4.012-5.85-8.56-12.469-10.24a19.532 19.532 0 0 0-2.585-.488M50 66.516c17.396 5.21 26.15-5.987 28.388-12.318M50 66.516c.222-.956.59-2.03 1.102-3.138 1.892-4.026 5.843-8.568 12.655-10.13h.007a18.86 18.86 0 0 1 2.343-.399m-43.968 1.624a18.624 18.624 0 0 1-.208-.688c4.58-1.294 8.51-1.562 11.858-1.135m-11.65 1.823C17.897 52.423 15 48.26 15 43.463c0-6.841 5.891-12.388 13.168-12.388 1.511 0 2.96.241 4.311.682m1.31 20.893c-1.809-3.469-2.848-7.557-2.848-11.94 0-3.18.547-6.208 1.538-8.953m45.937 22.372s-.014.048-.028.069m.028-.069c-4.79-1.376-8.864-1.693-12.31-1.28m12.31 1.28c-.007.02-.014.048-.028.069m0 0C82.338 52.065 85 48.053 85 43.462c0-6.84-5.898-12.387-13.168-12.387-1.511 0-2.96.241-4.311.682m-1.414 21.092c1.871-3.51 2.952-7.673 2.952-12.14 0-3.179-.547-6.207-1.538-8.952m-35.042 0C35.39 23.664 42.141 18 50 18c7.86 0 14.61 5.664 17.52 13.757"/></svg>
            {% when 'heart' %}
              <svg class="icon-mark" viewBox="0 0 100 100" aria-hidden="true"><path d="M79.7 25.248c-7.057-6.991-18.504-6.991-25.562 0l-4.144 4.106-4.145-4.106c-7.057-6.998-18.498-6.998-25.556 0a17.79 17.79 0 0 0 0 25.323l4.145 4.106L50 80l25.562-25.323 4.145-4.106a17.79 17.79 0 0 0 0-25.323H79.7Z"/></svg>
            {% else %}
              {% if block.settings.icon != blank %}
                <img src="{{ block.settings.icon | asset_url }}" alt="" width="70" height="70">
              {% endif %}
          {% endcase %}
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Text with icons",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop With Confidence" }
  ],
  "blocks": [
    {
      "type": "icon",
      "name": "Icon",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon", "default": "globe", "info": "globe, cotton, or heart" },
        { "type": "text", "id": "title", "label": "Title", "default": "Worldwide Shipping" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "We offer Fast Worldwide Delivery options, all with secure tracking for peace of mind." }
      ]
    }
  ],
  "presets": [{ "name": "Text with icons" }]
}
{% endschema %}
