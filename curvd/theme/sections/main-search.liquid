<section class="search-page">
  <div class="wrap">
    <h1>Search</h1>
    <form action="{{ routes.search_url }}" method="get" class="field" style="display:flex;gap:8px">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search" aria-label="Search">
      <button class="btn" style="width:auto" type="submit">Search</button>
    </form>
    {% if search.performed %}
      <p style="margin:12px 0 18px">{{ search.results_count }} results for “{{ search.terms }}”</p>
      <div class="product-grid">
        {% for item in search.results %}
          {% if item.object_type == 'product' %}
            {% render 'product-card', product: item %}
          {% else %}
            <a href="{{ item.url }}">{{ item.title }}</a>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>
{% schema %}
{ "name": "Search", "settings": [] }
{% endschema %}
