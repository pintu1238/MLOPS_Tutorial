<section class="account">
  <div class="wrap" style="max-width:460px">
    <h1>Log in</h1>
    {% form 'customer_login' %}
      {{ form.errors | default_errors }}
      <div class="field"><label for="CustomerEmail">Email</label><input id="CustomerEmail" type="email" name="customer[email]" autocomplete="email" required></div>
      <div class="field"><label for="CustomerPassword">Password</label><input id="CustomerPassword" type="password" name="customer[password]" autocomplete="current-password" required></div>
      <button class="btn" type="submit">Log in</button>
    {% endform %}
    <p style="margin-top:14px"><a href="{{ routes.account_register_url }}">Create account</a> · <a href="#recover">Forgot password</a></p>
    <div id="recover" style="margin-top:24px">
      <h2>Reset password</h2>
      {% form 'recover_customer_password' %}
        {% if form.posted_successfully? %}<p class="notice">Check your email for a reset link.</p>{% endif %}
        {{ form.errors | default_errors }}
        <div class="field"><label for="RecoverEmail">Email</label><input id="RecoverEmail" type="email" name="email" required></div>
        <button class="btn btn--ghost" type="submit">Email me a link</button>
      {% endform %}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Login", "settings": [] }
{% endschema %}
