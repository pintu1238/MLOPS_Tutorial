<section class="page">
  <div class="wrap">
    <h1>{{ blog.title }}</h1>
    <div class="product-grid" style="grid-template-columns:repeat(auto-fill,minmax(240px,1fr))">
      {% for article in blog.articles %}
        <article>
          <a href="{{ article.url }}">
            {% if article.image %}{{ article.image | image_url: width: 800 | image_tag }}{% endif %}
            <h3 style="margin-top:8px">{{ article.title }}</h3>
          </a>
          <p class="muted">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
        </article>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
