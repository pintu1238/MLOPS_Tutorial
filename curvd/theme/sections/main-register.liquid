<section class="account">
  <div class="wrap" style="max-width:460px">
    <h1>Create account</h1>
    {% form 'create_customer' %}
      {{ form.errors | default_errors }}
      <div class="field"><label for="FirstName">First name</label><input id="FirstName" name="customer[first_name]" required></div>
      <div class="field"><label for="LastName">Last name</label><input id="LastName" name="customer[last_name]" required></div>
      <div class="field"><label for="Email">Email</label><input id="Email" type="email" name="customer[email]" required></div>
      <div class="field"><label for="Password">Password</label><input id="Password" type="password" name="customer[password]" required></div>
      <button class="btn" type="submit">Create</button>
    {% endform %}
    <p style="margin-top:12px"><a href="{{ routes.account_login_url }}">Already have an account? Log in</a></p>
  </div>
</section>
{% schema %}
{ "name": "Register", "settings": [] }
{% endschema %}
