{{ 'aurelle.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ab-core.js' | asset_url }}" defer></script>
<section class="ab-page ab-section" id="attachments">
  <div class="ab-wrap ab-reveal">
    <p class="ab-kicker">Attachments</p>
    <h2 class="ab-h2">{{ section.settings.heading }}</h2>
    <p class="ab-lead">{{ section.settings.text }}</p>
    <div class="ab-attach__grid" style="margin-top: 28px;">
      {% for block in section.blocks %}
        <button
          type="button"
          class="ab-attach__card"
          data-ab-attach-card
          data-title="{{ block.settings.title | escape }}"
          data-desc="{{ block.settings.description | escape }}"
          data-img="{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 800 }}{% else %}{{ block.settings.fallback | default: 'ab-attachment-round.jpg' | asset_url }}{% endif %}"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', alt: block.settings.title }}
          {% else %}
            <img src="{{ block.settings.fallback | default: 'ab-attachment-round.jpg' | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy">
          {% endif %}
          <div class="ab-attach__meta">
            <strong>{{ block.settings.title }}</strong>
            <p class="ab-note" style="margin-top: 6px;">{{ block.settings.use }}</p>
          </div>
        </button>
      {% endfor %}
    </div>
  </div>
</section>

<div class="ab-modal" data-ab-attach-modal aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="ab-modal-title">
  <div class="ab-modal__backdrop"></div>
  <div class="ab-modal__panel">
    <button type="button" class="ab-modal__close" aria-label="Close">✕</button>
    <img data-ab-modal-img src="" alt="" width="480" height="480" style="width:100%;border-radius:12px;margin-bottom:16px;">
    <h3 id="ab-modal-title" class="ab-h2" style="font-size:1.5rem;" data-ab-modal-title></h3>
    <p data-ab-modal-body class="ab-note" style="font-size:15px;color:var(--ab-ink);"></p>
  </div>
</div>

{% schema %}
{
  "name": "AB Attachment Explorer",
  "class": "ab-attach-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Meet Your Styling Essentials." },
    { "type": "textarea", "id": "text", "label": "Intro", "default": "Each attachment is designed for a specific part of your routine. Tap to learn more." }
  ],
  "blocks": [
    {
      "type": "attachment",
      "name": "Attachment",
      "settings": [
        { "type": "text", "id": "title", "label": "Name", "default": "Round Brush" },
        { "type": "text", "id": "use", "label": "Intended use", "default": "Volume and blowout shaping" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback", "label": "Fallback asset", "default": "ab-attachment-round.jpg" }
      ]
    }
  ],
  "presets": [
    {
      "name": "AB Attachment Explorer",
      "blocks": [
        { "type": "attachment", "settings": { "title": "Round Brush", "use": "Volume & blowouts", "description": "Adds lift at the roots and helps shape ends while you dry.", "fallback": "ab-attachment-round.jpg" } },
        { "type": "attachment", "settings": { "title": "Smoothing Brush", "use": "Sleek finish", "description": "Helps guide hair smooth while styling.", "fallback": "ab-attachment-smooth.jpg" } },
        { "type": "attachment", "settings": { "title": "Curling Barrel", "use": "Soft waves", "description": "Wrap sections for defined waves and curls.", "fallback": "ab-attachment-curl.jpg" } },
        { "type": "attachment", "settings": { "title": "Drying Nozzle", "use": "Targeted airflow", "description": "Focus airflow for section-by-section drying.", "fallback": "ab-attachment-dry.jpg" } },
        { "type": "attachment", "settings": { "title": "Concentrator", "use": "Precision styling", "description": "Narrow airflow for polished sections.", "fallback": "ab-attachment-concentrator.jpg" } },
        { "type": "attachment", "settings": { "title": "Storage Case", "use": "Travel-ready organization", "description": "Keeps the system and accessories together.", "fallback": "ab-gallery-07.jpg" } }
      ]
    }
  ]
}
{% endschema %}
