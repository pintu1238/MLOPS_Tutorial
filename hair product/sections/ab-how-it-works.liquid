{{ 'aurelle.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ab-core.js' | asset_url }}" defer></script>
<section class="ab-page ab-section">
  <div class="ab-wrap ab-reveal" style="text-align:center;margin-bottom:32px;">
    <p class="ab-kicker">How it works</p>
    <h2 class="ab-h2">{{ section.settings.heading }}</h2>
  </div>
  <div class="ab-wrap ab-steps ab-reveal">
    {% for block in section.blocks %}
      <div class="ab-step" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', alt: block.settings.title }}
        {% else %}
          <img src="{{ block.settings.fallback | default: 'ab-gallery-04.jpg' | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy">
        {% endif %}
        <p class="ab-step__num">Step {{ forloop.index }}</p>
        <h3 class="ab-serif" style="font-size:1.35rem;margin:8px 0;">{{ block.settings.title }}</h3>
        <p class="ab-note" style="color:var(--ab-ink);">{{ block.settings.text }}</p>
      </div>
    {% endfor %}
  </div>
  <div class="ab-wrap" style="text-align:center;margin-top:32px;">
    <a class="ab-btn ab-btn--primary" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>
  </div>
</section>

{% schema %}
{
  "name": "AB How It Works",
  "class": "ab-how-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three steps to your signature look" },
    { "type": "text", "id": "cta_label", "label": "CTA", "default": "Explore the Styler" },
    { "type": "url", "id": "cta_link", "label": "CTA link" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback", "label": "Fallback asset", "default": "ab-gallery-04.jpg" }
      ]
    }
  ],
  "presets": [
    {
      "name": "AB How It Works",
      "blocks": [
        { "type": "step", "settings": { "title": "Choose Your Attachment", "text": "Select the attachment that matches the look you want to create today." } },
        { "type": "step", "settings": { "title": "Create Your Look", "text": "Style section by section at your own pace—at home, on your schedule.", "fallback": "ab-editorial-02.jpg" } },
        { "type": "step", "settings": { "title": "Make It Your Own", "text": "Finish with your favorite products and store everything in the included case.", "fallback": "ab-editorial-03.jpg" } }
      ]
    }
  ]
}
{% endschema %}
