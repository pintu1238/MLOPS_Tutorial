{{ 'aurelle.css' | asset_url | stylesheet_tag }}
<div class="ab-ticker ab-page" aria-label="Benefits">
  <div class="ab-ticker__track">
    {% for block in section.blocks %}
      <span {{ block.shopify_attributes }}>{{ block.settings.icon }} {{ block.settings.text }}</span>
    {% endfor %}
    {% for block in section.blocks %}
      <span aria-hidden="true">{{ block.settings.icon }} {{ block.settings.text }}</span>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "AB Benefit Ticker",
  "class": "ab-ticker-section",
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon", "default": "✦" },
        { "type": "text", "id": "text", "label": "Text", "default": "Versatile Styling Attachments" }
      ]
    }
  ],
  "presets": [
    {
      "name": "AB Benefit Ticker",
      "blocks": [
        { "type": "item", "settings": { "text": "Versatile Styling Attachments" } },
        { "type": "item", "settings": { "text": "Thoughtful Storage" } },
        { "type": "item", "settings": { "text": "A Style for Every Occasion" } },
        { "type": "item", "settings": { "text": "Easy Online Shopping" } }
      ]
    }
  ]
}
{% endschema %}
