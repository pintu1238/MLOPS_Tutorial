<section class="sssr">
  {% assign ss_q = search.terms | downcase | strip %}
  {% assign ss_handles = 'the-lipedema-handbook,sirasculpt-3d-lipedema-leggings-drain-lighten,sira-sculpt-4d-lipedema-leggings-offer,sira-sculpt-3d-anti-cellulite-leggings-sculpt-smooth,sira-sculpt-4d-compression-leggings-for-nurses,sira-sculpt-anti-chafing-3d-shorts,sira-sculpt-4d-compression-leggings-for-lymphedema,sira-sculpt-4d-compression-leggings-for-varicose-veins,sira-sculpt-4d-compression-leggings-for-tired-swollen-legs,sira-sculpt-belly-brief-meno-offer,sira-sculpt-belly-brief-mom-pooch-offer,sira-sculpt-belly-brief-c-section-offer,sira-sculpt-belly-brief-offer,sira-sculpt-magic-body-oil' | split: ',' %}
  {% assign ss_seen = '|' %}

  <h1>Search results</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" class="sssr__form">
    <div class="sssr__field">
      <input class="sssr__input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search" autocomplete="off" autocorrect="off" spellcheck="false">
      <input type="hidden" name="type" value="product">
      <input type="hidden" name="options[prefix]" value="last">
      {% if search.terms != blank %}
        <button class="sssr__clear" type="reset" aria-label="Clear search term">×</button>
      {% endif %}
      <button class="sssr__go" type="submit" aria-label="Search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3-3"/></svg>
      </button>
    </div>
    <div class="sssr__live ss-search__results" hidden></div>
  </form>

  <div class="sssr__bar">
    <div class="sssr__filters"><span>Filter:</span> <em>Availability</em> <em>Price</em></div>
    <div class="sssr__sort">Sort by: <b>Relevance</b> <span data-ss-result-count>0</span> results</div>
  </div>

  <div class="sssr__grid">
    {% if search.performed %}
      {% for h in ss_handles %}
        {% assign needle = '|' | append: h | append: '|' %}
        {% unless ss_seen contains needle %}
          {% assign ss_seen = ss_seen | append: h | append: '|' %}
          {% render 'ss-sira-search-card', ss_handle: h, ss_q: ss_q %}
        {% endunless %}
      {% endfor %}
    {% endif %}
  </div>

  {% if search.performed %}
    <p class="ss-search__empty" data-ss-empty>No Sira Sculpt products found. Try another search.</p>
    <script>
      (function(){
        var n = document.querySelectorAll('.sssr__grid a.pcard').length;
        var el = document.querySelector('[data-ss-result-count]');
        if(el) el.textContent = n;
        var empty = document.querySelector('[data-ss-empty]');
        if(empty) empty.style.display = n ? 'none' : '';
      })();
    </script>
  {% endif %}
</section>

{% schema %}
{
  "name": "Sira Search Results",
  "tag": "section",
  "class": "ss-search-results",
  "settings": [],
  "presets": [{ "name": "Sira Search Results" }]
}
{% endschema %}
