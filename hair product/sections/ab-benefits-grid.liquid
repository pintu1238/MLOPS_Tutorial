{{ 'aurelle.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ab-core.js' | asset_url }}" defer></script>
<section class="ab-page ab-section ab-section--cream">
  <div class="ab-wrap ab-reveal">
    <p class="ab-kicker">{{ section.settings.kicker }}</p>
    <h2 class="ab-h2">{{ section.settings.heading }}</h2>
    <div class="ab-cards ab-cards--4" style="margin-top: 28px;">
      {% for block in section.blocks %}
        <article class="ab-card" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.title }}
          {% else %}
            <img src="{{ block.settings.fallback_asset | default: 'ab-gallery-01.jpg' | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy">
          {% endif %}
          <div class="ab-card__body">
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "AB Benefits Grid",
  "class": "ab-benefits-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Why AURELLE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything You Need for Your Styling Ritual." }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Versatile Styling" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback_asset", "label": "Fallback asset filename", "default": "ab-gallery-03.jpg" }
      ]
    }
  ],
  "presets": [
    {
      "name": "AB Benefits Grid",
      "blocks": [
        { "type": "benefit", "settings": { "title": "Versatile Styling", "text": "Interchangeable attachments support different styling routines—smooth, voluminous, or softly shaped looks." } },
        { "type": "benefit", "settings": { "title": "Thoughtful Design", "text": "Champagne finish and coordinated metallic details for a cohesive, elevated vanity moment.", "fallback_asset": "ab-gallery-02.jpg" } },
        { "type": "benefit", "settings": { "title": "Organized Storage", "text": "The included case keeps your handle and attachments together between styling sessions.", "fallback_asset": "ab-gallery-07.jpg" } },
        { "type": "benefit", "settings": { "title": "Your Personal Style", "text": "From everyday polish to evening-ready volume—style inspiration that fits your routine.", "fallback_asset": "ab-editorial-01.jpg" } }
      ]
    }
  ]
}
{% endschema %}
