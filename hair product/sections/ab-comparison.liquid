{{ 'aurelle.css' | asset_url | stylesheet_tag }}
<section class="ab-page ab-section">
  <div class="ab-wrap ab-reveal">
    <p class="ab-kicker">Compare</p>
    <h2 class="ab-h2">{{ section.settings.heading }}</h2>
    <div class="ab-table-wrap" style="margin-top:24px;">
      <table class="ab-table">
        <thead>
          <tr>
            <th scope="col">Feature</th>
            <th scope="col">{{ section.settings.col_complete }}</th>
            <th scope="col">{{ section.settings.col_essential }}</th>
          </tr>
        </thead>
        <tbody>
          {% for block in section.blocks %}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">{{ block.settings.label }}</th>
              <td>{{ block.settings.complete }}</td>
              <td>{{ block.settings.essential }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <p class="ab-note" style="margin-top:12px;">{{ section.settings.disclaimer }}</p>
  </div>
</section>

{% schema %}
{
  "name": "AB Comparison",
  "class": "ab-compare-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose your configuration" },
    { "type": "text", "id": "col_complete", "label": "Column 1", "default": "Complete System" },
    { "type": "text", "id": "col_essential", "label": "Column 2", "default": "Styler Essentials" },
    { "type": "text", "id": "disclaimer", "label": "Disclaimer", "default": "Specifications shown are placeholders until confirmed for your market. Contact support for the latest details." }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "label", "label": "Feature" },
        { "type": "text", "id": "complete", "label": "Complete" },
        { "type": "text", "id": "essential", "label": "Essential" }
      ]
    }
  ],
  "presets": [
    {
      "name": "AB Comparison",
      "blocks": [
        { "type": "row", "settings": { "label": "Included attachments", "complete": "Full attachment set", "essential": "Core attachments" } },
        { "type": "row", "settings": { "label": "Storage case", "complete": "Included", "essential": "Included" } },
        { "type": "row", "settings": { "label": "Finish", "complete": "Champagne beige", "essential": "Champagne beige" } },
        { "type": "row", "settings": { "label": "Voltage", "complete": "Confirm for US", "essential": "Confirm for US" } },
        { "type": "row", "settings": { "label": "Heat / speed settings", "complete": "See product manual", "essential": "See product manual" } },
        { "type": "row", "settings": { "label": "Warranty", "complete": "See warranty page", "essential": "See warranty page" } }
      ]
    }
  ]
}
{% endschema %}
