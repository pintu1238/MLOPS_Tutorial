<section class="ssct" style="--plum:#4A2E3A;--plum-soft:#63414F;--clay:#B87A6B;--clay-deep:#9E5F50;--cream:#FAF6F1;--sand:#EDE3D8;--ink:#2E2733;--ink-soft:#6A6068;--line:#E6DACE;">
  <div class="ssct__wrap">

    <header class="ssct__head">
      <p class="ssct__eyebrow">Contact Us</p>
      <h1 class="ssct__title">We're here to help.</h1><p class="ssct__sub">Questions about your order, sizing, or your Sira Sculpt leggings? Drop us a note and a real person will get back to you.</p></header>

    <div class="ssct__grid"><div class="ssct__card ssct__formcard">
        <h2 class="ssct__card-h">Tell us what's on your mind.</h2><form method="post" action="/contact#sira-contact-form" id="sira-contact-form" accept-charset="UTF-8" class="ssct__form"><input type="hidden" name="form_type" value="contact" /><input type="hidden" name="utf8" value="✓" /><div class="ssct__row">
              <div class="ssct__field">
                <label for="ssct-name">First name</label>
                <input type="text" id="ssct-name" name="contact[name]" autocomplete="given-name" value="">
              </div>
              <div class="ssct__field">
                <label for="ssct-email">Email <span class="ssct__req">*</span></label>
                <input type="email" id="ssct-email" name="contact[email]" required autocomplete="email" value="">
              </div>
            </div>

            <div class="ssct__field">
              <label for="ssct-order">Order number <span class="ssct__opt">(if your question is about an order)</span></label>
              <input type="text" id="ssct-order" name="contact[Order number]" placeholder="e.g. #1234">
            </div>

            <div class="ssct__field">
              <label for="ssct-topic">What can we help with?</label>
              <div class="ssct__selectwrap">
                <select id="ssct-topic" name="contact[Topic]">
                  <option value="Order status / tracking">Order status / tracking</option>
                  <option value="Sizing help">Sizing help</option>
                  <option value="Returns or exchange">Returns or exchange</option>
                  <option value="Product question">Product question</option>
                  <option value="Something else">Something else</option>
                </select>
                <svg class="ssct__caret" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
              </div>
            </div>

            <div class="ssct__field">
              <label for="ssct-body">Your message</label>
              <textarea id="ssct-body" name="contact[body]" rows="5" required></textarea>
            </div>

            <button type="submit" class="ssct__submit">Send message</button>
            <p class="ssct__fine">We only use your details to reply to you. No spam, ever.</p></form></div><aside class="ssct__card ssct__info">
        <div class="ssct__info-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z"/></svg>
        </div>
        <h2 class="ssct__info-h">A real person, every time.</h2>
        <p class="ssct__info-lead">You'll never get a bot. Our team is small, and we read every single email.</p>

        <div class="ssct__block">
          <p class="ssct__block-h">When we're here</p>
          <p class="ssct__block-body">Monday to Friday: 9 AM to 5 PM PT<br>We reply within 1 business day<br>Closed Saturday & Sunday</p>
        </div>

        <div class="ssct__block">
          <p class="ssct__block-h">Reach us directly</p>
          <p class="ssct__block-body"><a href="mailto:support@sirasculpt.com">support@sirasculpt.com</a></p>
        </div>

        <a class="ssct__track" href="/pages/track-order" data-ss-track>
          <span>Already placed an order? <strong>Track it here</strong>, the fastest way to get an update.</span>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </aside>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sira Contact",
  "tag": "section",
  "class": "ss-contact",
  "settings": [],
  "presets": [{ "name": "Sira Contact" }]
}
{% endschema %}
