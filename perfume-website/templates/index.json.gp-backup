      "type": "gw-faq",
      "blocks": {
        "faq_1": {
          "type": "faq",
          "settings": {
            "question": "What styles do you carry?",
            "answer": "<p>Yes. Girls Purse curates totes, crossbodies, satchels, shoulder bags, and evening clutches — with clear categories on our shop page.</p>"
          }
        },
        "faq_2": {
          "type": "faq",
          "settings": {
            "question": "Will my laptop fit?",
            "answer": "<p>Each product lists interior dimensions and pocket layout. Totes and shoppers note laptop-friendly sizing where applicable.</p>"
          }
        },
        "faq_3": {
          "type": "faq",
          "settings": {
            "question": "What materials do you use?",
            "answer": "<p>We focus on premium leather, suede linings, and brushed hardware selected for longevity — material details are listed on every bag page.</p>"
          }
        },
        "faq_4": {
          "type": "faq",
          "settings": {
            "question": "Can I exchange if the fit isn't right?",
            "answer": "<p>Absolutely. Unworn items can be exchanged within 30 days. Start a return or exchange from your order confirmation email or our Returns page.</p>"
          }
        }
      },
