      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<section class=\"sk-gallery-page\" aria-labelledby=\"sk-gallery-title\">\n  <section class=\"sk-gal-hero\">\n    <div class=\"sk-gal-hero__top\">\n      <img src=\"https://www.srikrishnamistannabhander.com/assets/homeWelcome1-D4omb6sy.png\" alt=\"Sri Krishna sweets shop interior\" loading=\"eager\">\n      <p class=\"sk-gal-kicker\"><span aria-hidden=\"true\"></span>PRODUCT</p>\n      <img src=\"https://www.srikrishnamistannabhander.com/assets/homeWelcome2-DPya6aZP.png\" alt=\"Sri Krishna sweets display\" loading=\"eager\">\n    </div>\n    <h1 id=\"sk-gallery-title\">Where Every Bite Is a <em>Celebration</em><span aria-hidden=\"true\">✳</span></h1>\n    <p class=\"sk-gal-hero__text\">Our chena-based delicacies remain timeless favorites—Malai Chena Toast, Malai Sandwich, Lot chomchom, and an exquisite range of Sandesh varieties that celebrate Bengal’s sweet heritage.<br>But our story doesn’t stop at Bengali sweets. We cater to every Indian palate, bringing together flavors from across the country under one roof.</p>\n    <div class=\"sk-gal-hero__actions\">\n      <div class=\"sk-gal-stat\"><span class=\"sk-gal-stat__icon\" aria-hidden=\"true\">♧</span><span><strong>200+</strong><small>Delicious Sweets</small></span></div>\n      <img class=\"sk-gal-mini\" src=\"https://www.srikrishnamistannabhander.com/assets/product-barfi-DIioxQba.png\" alt=\"Indian sweet\" loading=\"lazy\">\n      <a class=\"sk-gal-button sk-gal-button--light\" href=\"#sk-gallery-products\">Know More <span aria-hidden=\"true\">↗</span></a>\n      <img class=\"sk-gal-mini\" src=\"https://www.srikrishnamistannabhander.com/assets/dorbesh-oq3hHHtB.avif\" alt=\"Gulab jamun\" loading=\"lazy\">\n      <div class=\"sk-gal-stat\"><span class=\"sk-gal-stat__icon\" aria-hidden=\"true\">♧</span><span><strong>200+</strong><small>Delicious Sweets</small></span></div>\n    </div>\n    <div class=\"sk-gal-hero__images\">\n      <img src=\"https://www.srikrishnamistannabhander.com/assets/product-laddu-CHWEIEhJ.png\" alt=\"Traditional Indian sweets\" loading=\"lazy\">\n      <img src=\"https://www.srikrishnamistannabhander.com/assets/dorbesh-oq3hHHtB.avif\" alt=\"Fresh gulab jamun\" loading=\"lazy\">\n      <img src=\"https://www.srikrishnamistannabhander.com/assets/product-shonpapri-euPEFw5N.png\" alt=\"Assorted sweets platter\" loading=\"lazy\">\n    </div>\n  </section>\n\n  <section class=\"sk-gal-why\" aria-labelledby=\"sk-gal-why-title\">\n    <img class=\"sk-gal-shop-photo\" src=\"https://www.srikrishnamistannabhander.com/assets/homeWelcome1-D4omb6sy.png\" alt=\"Sri Krishna sweets storefront\" loading=\"lazy\">\n    <div class=\"sk-gal-why__content\">\n      <p class=\"sk-gal-section-kicker\"><span aria-hidden=\"true\"></span>WHY US?</p>\n      <h2 id=\"sk-gal-why-title\">Why Our Sweets <em>Are The Best?</em></h2>\n      <div class=\"sk-gal-benefits\">\n        <article><span aria-hidden=\"true\">✿</span><div><h3>Freshly Made Every Morning</h3><p>Prepared in small batches so every bite stays authentic and melts in your mouth with pure freshness.</p></div></article>\n        <article><span aria-hidden=\"true\">✿</span><div><h3>Handpicked Ingredients</h3><p>We source only premium nuts, pure ghee, and high-quality milk to ensure the rich, traditional taste you love.</p></div></article>\n        <article><span aria-hidden=\"true\">✿</span><div><h3>100% Authentic Recipes</h3><p>Our recipes are passed down through generations, maintaining the original flavor and essence of Indian sweets.</p></div></article>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"sk-gal-products\" id=\"sk-gallery-products\" aria-labelledby=\"sk-gal-products-title\">\n    <p class=\"sk-gal-section-kicker\"><span aria-hidden=\"true\"></span>OUR SWEETS</p>\n    <h2 id=\"sk-gal-products-title\">Why Our Sweets <em>Are The Best?</em></h2>\n    <div class=\"sk-gal-filters\" role=\"group\" aria-label=\"Sweet categories\"><button class=\"is-active\" type=\"button\">All</button><button type=\"button\">Wedding</button><button type=\"button\">Corporate</button><button type=\"button\">Cultural</button><button type=\"button\">Miscellaneous</button></div>\n    <div class=\"sk-gal-grid\">\n      <a class=\"sk-gal-card\" data-category=\"cultural\" href=\"/products/kamola-bhog\"><img src=\"https://www.srikrishnamistannabhander.com/assets/product-laddu-CHWEIEhJ.png\" alt=\"Nolen Gur Rosogolla\" loading=\"lazy\"><strong>NOLEN GUR ROSOGOLLA</strong></a>\n      <a class=\"sk-gal-card\" data-category=\"cultural\" href=\"/products/malai-sandesh\"><img src=\"https://www.srikrishnamistannabhander.com/assets/malai%20sondesh-mn1pxZUo.avif\" alt=\"Malai Sandesh\" loading=\"lazy\"><strong>MALAI SANDESH</strong></a>\n      <a class=\"sk-gal-card\" data-category=\"corporate\" href=\"/products/moti-pak\"><img src=\"https://www.srikrishnamistannabhander.com/assets/product-barfi-DIioxQba.png\" alt=\"Barfi\" loading=\"lazy\"><strong>BARFI</strong></a>\n      <a class=\"sk-gal-card\" data-category=\"wedding\" href=\"/products/chena-tost\"><img src=\"https://www.srikrishnamistannabhander.com/assets/about-sweets-4-DKPX9OPL.png\" alt=\"Lot Chomchom\" loading=\"lazy\"><strong>LOT CHOMCHOM</strong></a>\n      <a class=\"sk-gal-card\" data-category=\"cultural\" href=\"/products/darbesh\"><img src=\"https://www.srikrishnamistannabhander.com/assets/product-modok-1tx81R_U.png\" alt=\"Mihidana\" loading=\"lazy\"><strong>MIHIDANA</strong></a>\n      <a class=\"sk-gal-card\" data-category=\"wedding\" href=\"/products/gur-malai-sandesh\"><img src=\"https://www.srikrishnamistannabhander.com/assets/about-sweets-3-C07xwGWK.png\" alt=\"Malai Sandwich\" loading=\"lazy\"><strong>MALAI SANDWITCH</strong></a>\n      <a class=\"sk-gal-card\" data-category=\"cultural\" href=\"/products/kamola-bhog\"><img src=\"https://www.srikrishnamistannabhander.com/assets/product-shonpapri-euPEFw5N.png\" alt=\"Komola Bhog\" loading=\"lazy\"><strong>KOMOLA BHOG</strong></a>\n      <a class=\"sk-gal-card\" data-category=\"miscellaneous\" href=\"/products/darbesh\"><img src=\"https://www.srikrishnamistannabhander.com/assets/dorbesh-oq3hHHtB.avif\" alt=\"Gulab Jamun\" loading=\"lazy\"><strong>GULAB JAMUN</strong></a>\n      <a class=\"sk-gal-card\" data-category=\"corporate\" href=\"/products/gur-malai-sandesh\"><img src=\"https://www.srikrishnamistannabhander.com/assets/about-sweets-2-VZ3O9bkJ.png\" alt=\"Gur Malai Sandesh\" loading=\"lazy\"><strong>GUR MALAI SANDESH</strong></a>\n    </div>\n    <a class=\"sk-gal-button\" href=\"/pages/gallery\">VIEW ALL <span aria-hidden=\"true\">↗</span></a>\n  </section>\n\n  <section class=\"sk-gal-cta\" aria-labelledby=\"sk-gal-cta-title\">\n    <h2 id=\"sk-gal-cta-title\">Ready to Make <em>Life Sweeter</em><br>— Not Just <em>Read</em> About It?</h2>\n    <p>Visit our shop to taste and experience a culture of sweets never seen and tasted before that matches right with our culture.</p>\n    <a class=\"sk-gal-button\" href=\"/pages/contact\">Visit Our Shop <span aria-hidden=\"true\">↗</span></a>\n  </section>\n\n<script>\n(function(){\n  var root = document.currentScript && document.currentScript.closest('.sk-gallery-page');\n  if (!root) return;\n  var buttons = root.querySelectorAll('.sk-gal-filters button');\n  var cards = root.querySelectorAll('.sk-gal-card');\n  buttons.forEach(function(button){\n    button.addEventListener('click', function(){\n      var filter = button.textContent.trim().toLowerCase();\n      buttons.forEach(function(item){\n        var active = item === button;\n        item.classList.toggle('is-active', active);\n        item.setAttribute('aria-pressed', active ? 'true' : 'false');\n      });\n      cards.forEach(function(card){\n        card.hidden = filter !== 'all' && card.dataset.category !== filter;\n      });\n    });\n  });\n})();\n</script>\n</section>\n<style>\n.sk-gallery-page{--sk-red:#c91f2d;--sk-gold:#ffd000;--sk-ink:#08111b;--sk-blue:#49657e;background:#fff;color:var(--sk-ink);fon