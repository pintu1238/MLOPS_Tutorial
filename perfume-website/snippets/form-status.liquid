{% doc %}
Renders success and error feedback for a Shopify form.
@param {form} form - Shopify form object.
@param {string} [success_message] - Success message.
@param {string} [error_message] - Error heading.
@example
{% render 'form-status', form: form %}
{% enddoc %}

{% if form.posted_successfully? %}
  <p class="form-status form-status--success" role="status" tabindex="-1">{{ success_message | default: 'forms.success' | t }}</p>
{% elsif form.errors %}
  <div class="form-status form-status--error" role="alert" tabindex="-1">
    <p>{{ error_message | default: 'forms.error' | t }}</p>
    {{ form.errors | default_errors }}
  </div>
{% endif %}
