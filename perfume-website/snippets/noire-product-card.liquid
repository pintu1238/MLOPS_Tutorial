{% liquid
  assign card_variant = product.selected_or_first_available_variant
  assign concentration = product.metafields.custom.concentration.value | default: product.type
  assign hover_image = product.images[1]
%}
<article class="noire-product-card" data-noire-product-card>
  <a class="noire-product-card__media" href="{{ product.url | escape }}">
    {% if product.featured_image %}
      {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360,600,900', sizes: '(min-width:1024px) 22vw, 45vw', alt: product.featured_image.alt | default: product.title | escape }}
      {% if hover_image %}
        {% capture hover_markup %}{{ hover_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360,600,900', sizes: '(min-width:1024px) 22vw, 45vw', alt: hover_image.alt | default: product.title | escape }}{% endcapture %}
        {{ hover_markup | replace: '<img', '<img data-hover-image' }}
      {% endif %}
    {% else %}
      <span>{{ 'products.product.media.load_image' | t | default: 'Image' | escape }}</span>
    {% endif %}
    {% if product.available == false %}
      <span class="noire-product-card__badge">{{ 'products.sold_out' | t }}</span>
    {% endif %}
  </a>
  <div>
    <h3><a href="{{ product.url | escape }}">{{ product.title | escape }}</a></h3>
    {% if concentration != blank %}
      <p class="noire-product-card__meta">{{ concentration | escape }}</p>
    {% endif %}
    <p class="noire-product-card__price">{{ card_variant.price | money }}</p>
    {% assign rating = product.metafields.reviews.rating.value %}
    {% if rating != blank %}
      <p class="noire-product-card__meta" aria-label="{{ rating }} out of 5">{{ 'accessibility.star_reviews_info' | t: rating_value: rating, rating_max: 5 | default: rating }}</p>
    {% endif %}
    <div class="noire-product-card__actions">
      <form action="{{ routes.cart_add_url | escape }}" method="post">
        <input type="hidden" name="id" value="{{ card_variant.id | escape }}">
        <button type="submit" class="noire-btn noire-btn--outline" {% unless card_variant.available %}disabled{% endunless %}>
          {% if card_variant.available %}{{ 'products.add_to_cart' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif %}
        </button>
      </form>
    </div>
  </div>
</article>
