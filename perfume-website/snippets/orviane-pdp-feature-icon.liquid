{%- doc -%}
  ORVIANE PDP feature card note icons (oud, saffron, rose, amber).
  @param {string} icon - oud | saffron | rose | amber
{%- enddoc -%}

{% liquid
  assign icon_key = icon | default: 'oud'
%}

{% case icon_key %}
  {% when 'oud' %}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true">
      <path d="M5 17c2.2-5.2 4.4-7.8 7-7.8s4.8 2.6 7 7.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <path d="M7.5 14.5h9M8.5 12h7M9.5 9.5h5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" opacity="0.85"/>
      <path d="M12 6.5V9" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
      <circle cx="12" cy="5.5" r="1.2" fill="currentColor"/>
    </svg>
  {% when 'saffron' %}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true">
      <path d="M9 19V11c0-2.2 1.4-4 3-4s3 1.8 3 4v8" stroke="currentColor" stroke-width="1.45" stroke-linecap="round"/>
      <path d="M12 7V4.5" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
      <path d="M10 5.5 12 3l2 2.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M8.5 13.5c1.2.6 2.3.6 3.5 0s2.3-.6 3.5 0" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/>
    </svg>
  {% when 'rose' %}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true">
      <path d="M12 8.5c2.8 0 5 2 5 4.6 0 2.2-1.6 4.1-3.8 4.7-.6.2-1.2.2-1.8.2h-1.6c-.6 0-1.2 0-1.8-.2-2.2-.6-3.8-2.5-3.8-4.7 0-2.6 2.2-4.6 5-4.6z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
      <path d="M9.2 9.8c-.8-1.2-.2-2.6 1-2.9 1-.3 1.8.5 2.3 1.4M14.8 9.8c.8-1.2.2-2.6-1-2.9-1-.3-1.8.5-2.3 1.4" stroke="currentColor" stroke-width="1.15" stroke-linecap="round"/>
      <path d="M12 17.2v3.3M10 20.5h4" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
      <circle cx="12" cy="11.8" r="1.1" fill="currentColor"/>
    </svg>
  {% when 'amber' %}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true">
      <path d="M12 4.5c2.8 4.2 4.5 7.2 4.5 9.8a4.5 4.5 0 1 1-9 0c0-2.6 1.7-5.6 4.5-9.8z" fill="currentColor" opacity="0.92"/>
      <path d="M10.2 12.8c.9.7 1.8.7 3.6 0" stroke="#ffffff" stroke-width="0.9" stroke-linecap="round" opacity="0.55"/>
    </svg>
  {% else %}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true">
      <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.4"/>
    </svg>
{% endcase %}
