{% doc %}
Renders a compact inline icon by name.
@param {string} name - Icon name.
@param {string} [label] - Optional accessible label.
@example
{% render 'icon', name: 'cart' %}
{% enddoc %}

<svg class="icon icon--{{ name | escape }}" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" {% if label != blank %}aria-label="{{ label | escape }}" role="img"{% else %}aria-hidden="true" focusable="false"{% endif %}>
  {% case name %}
    {% when 'menu' %}
      <path d="M3 6h18M3 12h18M3 18h18"></path>
    {% when 'close' %}
      <path d="m6 6 12 12M18 6 6 18"></path>
    {% when 'search' %}
      <circle cx="10.75" cy="10.75" r="6.75"></circle>
      <path d="m16 16 5 5"></path>
    {% when 'account' %}
      <circle cx="12" cy="8" r="3.5"></circle>
      <path d="M4.5 21a7.5 7.5 0 0 1 15 0"></path>
    {% when 'cart' %}
      <path d="M3 4h2l2.2 11.2a2 2 0 0 0 2 1.6h7.9a2 2 0 0 0 1.9-1.4L21 8H6"></path>
      <circle cx="9" cy="20" r="1"></circle>
      <circle cx="18" cy="20" r="1"></circle>
    {% when 'chat' %}
      <path d="M20 11.5a7.5 7.5 0 0 1-8 7.5 8.4 8.4 0 0 1-3.2-.6L4 20l1.6-3.7A7.1 7.1 0 0 1 4.5 12 7.5 7.5 0 0 1 12 4.5a7.5 7.5 0 0 1 8 7Z"></path>
    {% when 'location' %}
      <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"></path>
      <circle cx="12" cy="10" r="2.5"></circle>
    {% when 'phone' %}
      <path d="M6.7 3.5 9 3l1.4 4-2 1.5a14 14 0 0 0 7.1 7.1l1.5-2 4 1.4-.5 2.3a2 2 0 0 1-2.3 1.5A17.5 17.5 0 0 1 5.2 5.8a2 2 0 0 1 1.5-2.3Z"></path>
    {% when 'mail' %}
      <rect x="3" y="5" width="18" height="14" rx="2"></rect>
      <path d="m4 7 8 6 8-6"></path>
    {% when 'arrow-right' %}
      <path d="M4 12h16M13 5l7 7-7 7"></path>
    {% when 'plus' %}
      <path d="M12 5v14M5 12h14"></path>
    {% when 'minus' %}
      <path d="M5 12h14"></path>
    {% when 'chevron-down' %}
      <path d="m6 9 6 6 6-6"></path>
    {% when 'check' %}
      <path d="m5 12 4 4L19 6"></path>
  {% endcase %}
</svg>
