  {
    "name": "Brand and messaging",
    "settings": [
      {
        "type": "text",
        "id": "brand_wordmark",
        "label": "Wordmark / brand name",
        "default": "ORVIANE"
      },
      {
        "type": "text",
        "id": "brand_tagline",
