<section class="faq section-shell">
  <div class="faq__inner">
    <div class="faq__heading">
      <p class="faq__kicker">{{ section.settings.eyebrow | escape }}</p>
      <h2>{{ section.settings.heading | escape }}</h2>
      {% if section.settings.intro != blank %}
        <div class="faq__intro">{{ section.settings.intro }}</div>
      {% endif %}
    </div>
    <div class="faq__items">
      {% for block in section.blocks %}
        <details class="faq__item" {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question | escape }}<span aria-hidden="true">+</span></summary>
          <div class="faq__answer">{{ block.settings.answer }}</div>
        </details>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .faq {
    padding: clamp(3rem, 8vw, 7rem) 1rem;
  }

  .faq__inner {
    display: grid;
    gap: clamp(2rem, 7vw, 7rem);
    grid-template-columns: minmax(12rem, 0.7fr) minmax(0, 1.3fr);
    width: min(100%, var(--page-width));
    margin: 0 auto;
  }

  .faq h2 {
    max-width: 8ch;
    margin: 0.5rem 0 1rem;
    font-size: clamp(2.5rem, 7vw, 6rem);
    line-height: 0.9;
    letter-spacing: -0.07em;
  }

  .faq__kicker {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .faq__intro {
    max-width: 28ch;
    color: var(--color-muted);
    line-height: 1.6;
  }

  .faq__item {
    border-top: 1px solid var(--color-border);
  }

  .faq__item:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 0;
    cursor: pointer;
    font-size: 1.1rem;
    font-weight: 700;
    list-style: none;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__item summary span {
    font-size: 1.5rem;
    font-weight: 400;
  }

  .faq__item[open] summary span {
    transform: rotate(45deg);
  }

  .faq__answer {
    max-width: 58ch;
    padding: 0 2rem 1.5rem 0;
    color: var(--color-muted);
    line-height: 1.6;
  }

  @media (max-width: 720px) {
    .faq__inner {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "section-faq",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Good to know"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The little details, answered"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>Everything you need for an easy order and an even easier visit.</p>"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Can I order ahead for pickup?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Yes. Choose your products, select a pickup time if your setup supports it, and we will have your order ready.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question" },
        { "type": "question" },
        { "type": "question" }
      ]
    }
  ]
}
{% endschema %}
