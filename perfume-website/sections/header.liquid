{% assign primary_menu = section.settings.menu %}
{% assign brand_wordmark = section.settings.wordmark | default: settings.brand_wordmark | default: 'Artisan Bakes' %}
{% assign cta_label = section.settings.cta_label | default: settings.header_cta_label | default: 'Order online' %}
{% assign cta_url = section.settings.cta_url | default: settings.header_cta_url | default: routes.all_products_collection_url %}
<header class="site-header" data-site-header>
  <div class="site-header__inner">
    <details class="site-header__mobile-menu">
      <summary class="site-header__control" data-menu-toggle data-disclosure-toggle aria-controls="mobile-menu-drawer" aria-expanded="false">
        {% render 'icon', name: 'menu' %}
        <span class="site-header__control-label">{{ 'accessibility.menu' | t }}</span>
      </summary>
      <div id="mobile-menu-drawer" class="site-header__drawer" data-menu-drawer>
        {% if primary_menu != blank %}
          <nav aria-label="{{ 'accessibility.menu' | t | escape }}">
            <ul class="site-header__drawer-list">
              {% for link in primary_menu.links %}
                <li><a href="{{ link.url | escape }}">{{ link.title | escape }}</a></li>
              {% endfor %}
            </ul>
          </nav>
        {% endif %}
      </div>
    </details>

    <a class="site-header__wordmark" href="{{ routes.root_url | escape }}" data-wordmark>{{ brand_wordmark | escape }}</a>

    <nav class="site-header__desktop-nav" aria-label="{{ 'accessibility.menu' | t | escape }}">
      {% if primary_menu != blank %}
        <ul>
          {% for link in primary_menu.links %}
            <li><a href="{{ link.url | escape }}">{{ link.title | escape }}</a></li>
          {% endfor %}
        </ul>
      {% endif %}
    </nav>

    <div class="site-header__actions">
      <a class="site-header__cta" href="{{ cta_url | escape }}">{{ cta_label | escape }}</a>

      <details class="site-header__search">
        <summary class="site-header__control" data-search-toggle data-disclosure-toggle aria-controls="search-drawer" aria-expanded="false">
          {% render 'icon', name: 'search' %}
          <span class="site-header__control-label">{{ 'actions.search' | t }}</span>
        </summary>
        <div id="search-drawer" class="site-header__drawer site-header__drawer--search" data-search-drawer>
          <form action="{{ routes.search_url | escape }}" method="get" role="search">
            <label for="header-search-input">{{ 'actions.search' | t }}</label>
            <input id="header-search-input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'actions.search' | t | escape }}">
            <button type="submit">{{ 'actions.submit' | t }}</button>
          </form>
        </div>
      </details>

      <a class="site-header__control" href="{{ routes.account_url | escape }}" data-account-link aria-label="{{ 'customer.account' | t | escape }}">
        {% render 'icon', name: 'account' %}
        <span class="site-header__control-label">{{ 'customer.account' | t }}</span>
      </a>

      <button class="site-header__control site-header__cart-toggle" type="button" data-cart-toggle data-dialog-open aria-controls="cart-drawer" aria-expanded="false">
        {% render 'icon', name: 'cart' %}
        <span class="site-header__control-label">{{ 'cart.title' | t }}</span>
        <span class="site-header__cart-count" data-cart-count>{{ cart.item_count }}</span>
      </button>
    </div>
  </div>
  {% render 'cart-drawer', cart: cart, id: 'cart-drawer' %}
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "wordmark",
      "label": "Section wordmark override",
      "default": "Artisan Bakes"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Desktop navigation"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Section CTA label override",
      "default": "Order online"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Section CTA URL override"
    }
  ],
  "presets": [
    {
      "name": "Header"
    }
  ]
}
{% endschema %}
