<section class="section testimonials" id="{{ section.settings.anchor_id | default: 'kind-words' | handleize }}">
  <div class="page-width">
    <div class="section-heading"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div>
    <div class="testimonial-grid">{% for block in section.blocks %}<figure class="testimonial-card" {{ block.shopify_attributes }}><div class="testimonial-card__stars" aria-label="5 out of 5 stars">★★★★★</div><blockquote>“{{ block.settings.quote | escape }}”</blockquote><figcaption>{{ block.settings.name | escape }}{% if block.settings.detail != blank %}<span>{{ block.settings.detail | escape }}</span>{% endif %}</figcaption></figure>{% endfor %}</div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "kind-words" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Kind words" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The table talk we love." }
  ],
  "blocks": [{ "type": "testimonial", "name": "Testimonial", "settings": [
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "The kind of place where one coffee becomes an afternoon." },
    { "type": "text", "id": "name", "label": "Name", "default": "A regular" },
    { "type": "text", "id": "detail", "label": "Detail", "default": "Local guide" }
  ] }],
  "presets": [{ "name": "Testimonials", "blocks": [{ "type": "testimonial" }, { "type": "testimonial" }, { "type": "testimonial" }] }]
}
{% endschema %}
