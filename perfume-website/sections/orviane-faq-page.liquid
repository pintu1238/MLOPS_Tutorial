<section class="orviane-page orviane-page--faq noire-reveal" data-section-id="{{ section.id }}">
  <div class="orviane-page__inner noire-page-width">
    <p class="orviane-page__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h1 class="orviane-page__title">{{ page.title | default: section.settings.heading | escape }}</h1>
    {% if section.settings.intro != blank %}
      <p class="orviane-page__intro">{{ section.settings.intro | escape }}</p>
    {% endif %}
    <div class="orviane-page__accordion noire-accordion">
      {% for block in section.blocks %}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question | escape }}</summary>
          <div class="orviane-page__answer noire-accordion__body rte">
            {% if block.settings.use_policy_shipping %}
              {% if shop.shipping_policy.body != blank %}
                {{ shop.shipping_policy.body }}
              {% else %}
                <p>{{ section.settings.shipping_fallback }}</p>
              {% endif %}
            {% elsif block.settings.use_policy_refund %}
              {% if shop.refund_policy.body != blank %}
                {{ shop.refund_policy.body }}
              {% else %}
                <p>{{ section.settings.refund_fallback }}</p>
              {% endif %}
            {% else %}
              {{ block.settings.answer }}
            {% endif %}
          </div>
        </details>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ORVIANE FAQ page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Support" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "FAQ" },
    { "type": "textarea", "id": "intro", "label": "Intro" },
    {
      "type": "textarea",
      "id": "shipping_fallback",
      "label": "Shipping answer (if store policy is empty)",
      "default": "Orders are processed within 1–2 business days. Delivery times depend on your location and the shipping method selected at checkout."
    },
    {
      "type": "textarea",
      "id": "refund_fallback",
      "label": "Returns answer (if store policy is empty)",
      "default": "Unopened items may be returned within 14 days of delivery. See our refund policy for full eligibility and instructions."
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How do I choose the right fragrance?" },
        { "type": "richtext", "id": "answer", "label": "Answer" },
        { "type": "checkbox", "id": "use_policy_shipping", "label": "Use shipping policy", "default": false },
        { "type": "checkbox", "id": "use_policy_refund", "label": "Use refund policy", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "ORVIANE FAQ page",
      "blocks": [
        { "type": "faq", "settings": { "question": "How do I choose the right fragrance?", "answer": "<p>Start with scent families you enjoy, then explore discovery sets.</p>" } },
        { "type": "faq", "settings": { "question": "What is the difference between Eau de Parfum and Eau de Toilette?", "answer": "<p>Eau de Parfum typically offers higher concentration and longer wear.</p>" } },
        { "type": "faq", "settings": { "question": "How long does shipping take?", "use_policy_shipping": true } },
        { "type": "faq", "settings": { "question": "Can I return or exchange a fragrance?", "use_policy_refund": true } },
        { "type": "faq", "settings": { "question": "How should I store my perfume?", "answer": "<p>Store away from heat and sunlight, cap secured.</p>" } }
      ]
    }
  ]
}
{% endschema %}
