{% comment %}
  Section contract.
  Watch & Shop video carousel above FAQ — premium fragrance motion cards.
  @example
  Homepage section "watch_shop" with five autoplaying portrait videos.
{% endcomment %}

<section class="noire-watch-shop noire-reveal" data-section-id="{{ section.id }}">
  <div class="noire-page-width">
    <header class="noire-watch-shop__head">
      {% if section.settings.eyebrow != blank %}
        <p class="noire-watch-shop__kicker">
          <img
            class="noire-watch-shop__kicker-icon"
            src="{{ 'orviane-watch-shop-kicker.png' | asset_url }}"
            width="11"
            height="16"
            alt=""
            aria-hidden="true"
            loading="eager"
            decoding="async"
          >
          {{ section.settings.eyebrow | escape }}
        </p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="noire-watch-shop__title">{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <p class="noire-watch-shop__text">{{ section.settings.text | escape }}</p>
      {% endif %}
    </header>

    <div class="noire-watch-shop__rail" data-noire-watch-shop>
      <div class="noire-watch-shop__viewport">
        <button
          type="button"
          class="noire-watch-shop__nav noire-watch-shop__nav--prev"
          data-noire-watch-prev
          aria-label="{{ section.settings.prev_label | escape }}"
        >
          {% render 'orviane-carousel-nav-icon', direction: 'prev' %}
        </button>

        <div class="noire-watch-shop__track" data-noire-watch-track tabindex="0" role="list">
        {% for block in section.blocks %}
          {% liquid
            assign card_video_url = block.settings.video_url
            if card_video_url == blank and block.settings.video_asset != blank
              assign card_video_url = block.settings.video_asset | asset_url
            endif
            assign card_link = block.settings.link | default: routes.collections_url
          %}
          <article class="noire-watch-shop__card" role="listitem" {{ block.shopify_attributes }}>
            <a class="noire-watch-shop__card-link" href="{{ card_link | escape }}">
              <div class="noire-watch-shop__media">
                {% if card_video_url != blank %}
                  <video
                    class="noire-watch-shop__video"
                    src="{{ card_video_url }}"
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="metadata"
                    aria-hidden="true"
                  ></video>
                {% elsif block.settings.image != blank %}
                  {{
                    block.settings.image
                    | image_url: width: 900
                    | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '240px', class: 'noire-watch-shop__image', alt: block.settings.label
                  }}
                {% endif %}
                <span class="noire-watch-shop__shade" aria-hidden="true"></span>
                {% if block.settings.label != blank %}
                  <span class="noire-watch-shop__label">{{ block.settings.label | escape }}</span>
                {% endif %}
              </div>
            </a>
          </article>
        {% endfor %}
        </div>

        <button
          type="button"
          class="noire-watch-shop__nav noire-watch-shop__nav--next"
          data-noire-watch-next
          aria-label="{{ section.settings.next_label | escape }}"
        >
          {% render 'orviane-carousel-nav-icon', direction: 'next' %}
        </button>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ORVIANE Watch & Shop",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "WATCH & SHOP" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Scent in Motion" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "ORVIANE in motion — studio details, layered notes, and how we wear every evening."
    },
    { "type": "text", "id": "prev_label", "label": "Previous control label", "default": "Previous videos" },
    { "type": "text", "id": "next_label", "label": "Next control label", "default": "Next videos" }
  ],
  "blocks": [
    {
      "type": "video_card",
      "name": "Video card",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "FRAGRANCE" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "text",
          "id": "video_asset",
          "label": "Theme video asset",
          "info": "Filename in Assets, e.g. orv-watch-premium-01.mp4",
          "default": "orv-watch-premium-01.mp4"
        },
        { "type": "url", "id": "video_url", "label": "Video URL override" },
        { "type": "image_picker", "id": "image", "label": "Poster image (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "ORVIANE Watch & Shop",
      "blocks": [
        { "type": "video_card", "settings": { "label": "MEN'S", "video_asset": "orv-watch-premium-03.mp4" } },
        { "type": "video_card", "settings": { "label": "WOMEN'S", "video_asset": "orv-watch-premium-01.mp4" } },
        { "type": "video_card", "settings": { "label": "UNISEX", "video_asset": "orv-watch-premium-02.mp4" } },
        { "type": "video_card", "settings": { "label": "OUD", "video_asset": "orv-watch-premium-04.mp4" } },
        { "type": "video_card", "settings": { "label": "DISCOVERY", "video_asset": "orv-watch-premium-05.mp4" } }
      ]
    }
  ]
}
{% endschema %}
