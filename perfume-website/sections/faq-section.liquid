<section id="noire-faq" class="noire-faq noire-reveal" data-section-id="{{ section.id }}">
  <div class="noire-faq__media" aria-hidden="true">
    {% render 'noire-theme-image',
      image: section.settings.image,
      asset: 'orviane-faq-perfume.jpg',
      alt: '',
      width: 2400,
      widths: '800,1200,1600,2400',
      sizes: '100vw',
      loading: 'lazy'
    %}
  </div>
  <div class="noire-faq__shade" aria-hidden="true"></div>
  <div class="noire-page-width noire-faq__layout">
    <h2 class="noire-faq__title">{{ section.settings.heading | default: 'FAQs' | escape }}</h2>
    <div class="noire-accordion">
      {% for block in section.blocks %}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question | escape }}</summary>
          <div class="noire-accordion__body rte">
            {% if block.settings.use_policy_shipping %}
              {% if shop.shipping_policy.body != blank %}
                {{ shop.shipping_policy.body }}
              {% else %}
                <p>{{ section.settings.shipping_fallback }}</p>
              {% endif %}
            {% elsif block.settings.use_policy_refund %}
              {% if shop.refund_policy.body != blank %}
                {{ shop.refund_policy.body }}
              {% else %}
                <p>{{ section.settings.refund_fallback }}</p>
              {% endif %}
            {% else %}
              {{ block.settings.answer }}
            {% endif %}
          </div>
        </details>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .noire-faq .noire-accordion summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .noire-faq .noire-accordion summary::after {
    flex-shrink: 0;
    font-size: 1.35rem;
    font-weight: 300;
    line-height: 1;
    opacity: 0.9;
    content: '+';
  }

  .noire-faq .noire-accordion details[open] > summary::after {
    content: '−';
  }

  .noire-faq .noire-accordion details:not([open]) .noire-accordion__body {
    display: none;
  }

  .noire-faq .noire-accordion details[open] .noire-accordion__body {
    display: block;
  }

  .noire-faq .noire-accordion__body :is(p, li) {
    margin: 0 0 0.65rem;
  }

  .noire-faq .noire-accordion__body :is(p, li):last-child {
    margin-bottom: 0;
  }

  .noire-faq .noire-accordion__body .shopify-policy__title {
    display: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "NOIRÉ FAQ",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "FAQs" },
    { "type": "textarea", "id": "text", "label": "Supporting text" },
    {
      "type": "textarea",
      "id": "shipping_fallback",
      "label": "Shipping answer (if store policy is empty)",
      "default": "Orders are processed within 1–2 business days. Delivery times depend on your location and the shipping method selected at checkout."
    },
    {
      "type": "textarea",
      "id": "refund_fallback",
      "label": "Returns answer (if store policy is empty)",
      "default": "Unopened items may be returned within 14 days of delivery. See our refund policy for full eligibility and instructions."
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How do I choose the right fragrance?" },
        { "type": "richtext", "id": "answer", "label": "Answer" },
        { "type": "checkbox", "id": "use_policy_shipping", "label": "Use store shipping policy for answer", "default": false },
        { "type": "checkbox", "id": "use_policy_refund", "label": "Use store refund policy for answer", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "NOIRÉ FAQ",
      "blocks": [
        { "type": "faq", "settings": { "question": "How do I choose the right fragrance?", "answer": "<p>Start with scent families you enjoy, then explore discovery sets to experience how each composition develops on your skin.</p>" } },
        { "type": "faq", "settings": { "question": "What is the difference between Eau de Parfum and Eau de Toilette?", "answer": "<p>Eau de Parfum typically offers higher fragrance concentration and longer wear than Eau de Toilette. Check each product page for concentration details.</p>" } },
        { "type": "faq", "settings": { "question": "How long does shipping take?", "use_policy_shipping": true } },
        { "type": "faq", "settings": { "question": "Can I return or exchange a fragrance?", "use_policy_refund": true } },
        { "type": "faq", "settings": { "question": "How should I store my perfume?", "answer": "<p>Store fragrances away from direct sunlight and heat, and keep bottles upright with caps secured.</p>" } }
      ]
    }
  ]
}
{% endschema %}
