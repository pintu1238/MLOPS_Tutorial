<section class="sk-wed-offerings" aria-labelledby="WeddingOfferings-{{ section.id }}">
  <p class="sk-wed-kicker">{{ section.settings.eyebrow }}</p>
  <h2 id="WeddingOfferings-{{ section.id }}">{{ section.settings.heading }} <em>{{ section.settings.accent }}</em></h2>
  <sk-wedding-marquee class="sk-wed-marquee">
    <div class="sk-wed-marquee__viewport">
      <div class="sk-wed-marquee__track">
        {% for copy in (1..2) %}
          <div class="sk-wed-marquee__group"{% if copy == 2 %} aria-hidden="true"{% endif %}>
            {% for block in section.blocks %}
              <img src="{{ block.settings.image_url | escape }}" alt="{% if copy == 1 %}{{ block.settings.caption | escape }}{% endif %}" width="320" height="320" loading="eager" decoding="async"{% if copy == 1 %} {{ block.shopify_attributes }}{% endif %}>
            {% endfor %}
          </div>
        {% endfor %}
      </div>
    </div>
    <button type="button" class="sk-wed-motion" aria-pressed="false">{{ section.settings.pause_label }}</button>
  </sk-wedding-marquee>
</section>
{% stylesheet %}
.sk-wed-offerings{padding:76px 24px 80px;text-align:center;background:#fff;color:#080808}
.sk-wed-kicker{margin:0 0 14px;color:#c91f2d;font:italic 24px/1.3 Georgia,serif}
.sk-wed-kicker:before{content:"— ";font-style:normal}
.sk-wed-offerings h2{margin:0;font:400 clamp(30px,3vw,44px)/1.2 Georgia,serif;letter-spacing:-.025em}
.sk-wed-offerings h2 em{color:#c91f2d;font-family:Arial,sans-serif;font-weight:400}
.sk-wed-marquee{display:block;max-width:850px;margin:66px auto 0}
.sk-wed-marquee__viewport{overflow:hidden}
.sk-wed-marquee__track{display:flex;width:max-content;animation:skWeddingScroll 46s linear infinite}
.sk-wed-marquee__group{display:flex;gap:18px;padding-right:18px}
.sk-wed-marquee__group img{display:block;width:220px;height:220px;object-fit:cover;border-radius:19px}
.sk-wed-marquee:hover .sk-wed-marquee__track,.sk-wed-marquee:focus-within .sk-wed-marquee__track,.sk-wed-marquee[data-paused="true"] .sk-wed-marquee__track{animation-play-state:paused}
.sk-wed-motion{display:block;margin:14px 0 0 auto;padding:6px 12px;font:12px Arial,sans-serif;color:#49657e;background:#fff;border:1px solid #e6e9ed;border-radius:30px;cursor:pointer}
.sk-wed-motion:focus-visible{outline:2px solid #c91f2d;outline-offset:3px}
@keyframes skWeddingScroll{to{transform:translateX(-50%)}}
@media(prefers-reduced-motion:reduce){.sk-wed-marquee__track{animation:none}.sk-wed-marquee__viewport{overflow-x:auto}.sk-wed-marquee__group[aria-hidden]{display:none}.sk-wed-motion{display:none}}
@media(max-width:749px){.sk-wed-offerings{padding:48px 20px}.sk-wed-kicker{font-size:20px}.sk-wed-marquee{margin-top:34px}.sk-wed-marquee__group img{width:165px;height:165px}}
{% endstylesheet %}
{% javascript %}
if(!customElements.get('sk-wedding-marquee')){
  customElements.define('sk-wedding-marquee',class extends HTMLElement{
    connectedCallback(){
      if(this.dataset.initialized)return;
      this.dataset.initialized='true';
      const button=this.querySelector('button');
      if(!button)return;
      button.addEventListener('click',()=>{
        const paused=this.dataset.paused!=='true';
        this.dataset.paused=String(paused);
        button.setAttribute('aria-pressed',String(paused));
      });
    }
  });
}
{% endjavascript %}
{% schema %}
{"name":"Wedding offerings","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"OUR OFFERINGS"},{"type":"text","id":"heading","label":"Heading","default":"Have A Look At Our"},{"type":"text","id":"accent","label":"Accent","default":"Awesome Sweets"},{"type":"text","id":"pause_label","label":"Pause button label","default":"Pause gallery"}],"blocks":[{"type":"photo","name":"Sweet photograph","settings":[{"type":"url","id":"image_url","label":"Image URL"},{"type":"text","id":"caption","label":"Image description","default":"Traditional Bengali sweets"}]}],"presets":[{"name":"Wedding offerings"}]}
{% endschema %}