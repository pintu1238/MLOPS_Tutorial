<section class="sk-wed-products" aria-labelledby="WeddingProducts-{{ section.id }}">
  <p class="sk-wed-products__kicker">{{ section.settings.eyebrow }}</p>
  <h2 id="WeddingProducts-{{ section.id }}">{{ section.settings.heading }} <em>{{ section.settings.accent }}</em></h2>
  <div class="sk-wed-products__grid">
    {% for block in section.blocks %}
      {% assign sweet = block.settings.product %}
      {% if sweet != blank %}
        <a class="sk-wed-product" href="{{ sweet.url }}" {{ block.shopify_attributes }}>
          {% if block.settings.image_url != blank %}
            <img src="{{ block.settings.image_url | escape }}" alt="{{ block.settings.title | default: sweet.title | escape }}" width="578" height="452" loading="lazy">
          {% elsif sweet.featured_image %}
            {{ sweet.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '280, 420, 700', sizes: '(max-width: 749px) 45vw, 30vw' }}
          {% endif %}
          <h3>{{ block.settings.title | default: sweet.title | escape }}</h3>
        </a>
      {% endif %}
    {% endfor %}
  </div>
  <a class="sk-wed-products__button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }} <span aria-hidden="true">↗</span></a>
</section>
{% stylesheet %}
.sk-wed-products{background:#fff;color:#080808;padding:42px 24px 80px;text-align:center}
.sk-wed-products__kicker{margin:0 0 12px;color:#c91f2d;font:italic 24px/1.3 Georgia,serif}
.sk-wed-products__kicker:before{content:"— ";font-style:normal}
.sk-wed-products h2{margin:0 0 60px;font:400 clamp(30px,3vw,44px)/1.2 Georgia,serif;letter-spacing:-.025em}
.sk-wed-products h2 em{color:#c91f2d;font-family:Arial,sans-serif;font-weight:400}
.sk-wed-products__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px;max-width:1000px;margin:0 auto 48px}
.sk-wed-product{display:block;text-decoration:none;color:#080808;padding:20px 20px 25px;border-radius:20px;background:white;box-shadow:0 9px 30px #07101b09;transition:transform .2s,box-shadow .2s}
.sk-wed-product:hover{transform:translateY(-4px);box-shadow:0 12px 30px #07101b16}
.sk-wed-product img{display:block;width:100%;height:auto;aspect-ratio:1.28;object-fit:cover;border-radius:13px}
.sk-wed-product h3{margin:20px 0 0;font:600 14px/1.4 Georgia,serif;letter-spacing:.025em;text-transform:uppercase}
.sk-wed-products__button{display:inline-flex;align-items:center;gap:10px;border-radius:999px;background:#c91f2d;color:#fff;text-decoration:none;font:700 12px/1.4 Arial,sans-serif;padding:14px 30px;box-shadow:0 4px 9px #0002}
.sk-wed-product:focus-visible,.sk-wed-products__button:focus-visible{outline:2px solid #c91f2d;outline-offset:5px}
@media(max-width:749px){.sk-wed-products{padding:34px 18px 50px}.sk-wed-products__kicker{font-size:20px}.sk-wed-products h2{margin-bottom:32px}.sk-wed-products__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:15px;margin-bottom:32px}.sk-wed-product{padding:10px 10px 16px;border-radius:14px}.sk-wed-product h3{font-size:11px;margin-top:13px}}
@media(prefers-reduced-motion:reduce){.sk-wed-product{transition:none}.sk-wed-product:hover{transform:none}}
{% endstylesheet %}
{% schema %}
{"name":"Wedding sweets","max_blocks":12,"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Our Products"},{"type":"text","id":"heading","label":"Heading","default":"Have A Look At Our"},{"type":"text","id":"accent","label":"Accent","default":"Awesome Sweets"},{"type":"text","id":"button_label","label":"Button label","default":"VIEW ALL"},{"type":"url","id":"button_link","label":"Button link"}],"blocks":[{"type":"sweet","name":"Sweet","settings":[{"type":"product","id":"product","label":"Shopify product"},{"type":"text","id":"title","label":"Display title"},{"type":"url","id":"image_url","label":"Reference photograph URL"}]}],"presets":[{"name":"Wedding sweets"}]}
{% endschema %}