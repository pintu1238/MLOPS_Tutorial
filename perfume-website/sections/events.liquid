<section class="section section--terracotta events" id="{{ section.settings.anchor_id | default: 'gather' | handleize }}">
  <div class="page-width"><div class="section-heading section-heading--split"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div><p class="section-heading__copy">{{ section.settings.copy | escape }}</p></div><div class="events__grid">{% for block in section.blocks %}<article class="event-card" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 600, 900', sizes: '(min-width: 900px) 33vw, 100vw', alt: block.settings.image.alt | default: block.settings.heading | escape }}{% endif %}<div class="event-card__body"><p class="eyebrow">{{ block.settings.kicker | escape }}</p><h3>{{ block.settings.heading | escape }}</h3><p>{{ block.settings.copy | escape }}</p>{% if block.settings.link_label != blank %}<a class="text-link" href="{{ block.settings.link_url | default: '#reserve' | escape }}">{{ block.settings.link_label | escape }} <span aria-hidden="true">→</span></a>{% endif %}</div></article>{% endfor %}</div></div>
</section>

{% schema %}
{
  "name": "Events and gatherings",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "gather" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Make it a gathering" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Good reasons to pull up another chair." },
    { "type": "textarea", "id": "copy", "label": "Copy", "default": "Birthday tables, office afternoons, and little celebrations all fit here." }
  ],
  "blocks": [{ "type": "event", "name": "Event", "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "For your people" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Private tables" },
    { "type": "textarea", "id": "copy", "label": "Copy", "default": "A warm corner, a considered menu, and no rush to leave." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Plan a gathering" },
    { "type": "url", "id": "link_url", "label": "Link" }
  ] }],
  "presets": [{ "name": "Events and gatherings", "blocks": [{ "type": "event" }, { "type": "event" }, { "type": "event" }] }]
}
{% endschema %}
