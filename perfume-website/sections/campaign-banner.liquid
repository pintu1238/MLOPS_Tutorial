<section class="noire-campaign noire-reveal" data-section-id="{{ section.id }}">
  <div class="noire-campaign__media" aria-hidden="true">
    {% render 'noire-theme-image',
      image: section.settings.image,
      asset: 'noire-collection-women-floral.jpg',
      alt: section.settings.heading,
      width: 2400,
      widths: '800,1200,2000,2400',
      sizes: '100vw',
      loading: 'lazy'
    %}
  </div>
  <div class="noire-campaign__overlay"></div>
  <div class="noire-campaign__content noire-page-width">
    <h2>{{ section.settings.heading | escape }}</h2>
    {% if section.settings.button_label != blank %}
      <a class="noire-btn noire-btn--primary" href="{{ section.settings.button_url | default: routes.all_products_collection_url | escape }}">{{ section.settings.button_label | escape }}</a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "NOIRÉ Campaign banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Recommended 2400×1200px dramatic fragrance campaign photography." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Make Every Moment Memorable." },
    { "type": "text", "id": "button_label", "label": "CTA label", "default": "FIND YOUR FRAGRANCE" },
    { "type": "url", "id": "button_url", "label": "CTA URL" }
  ],
  "presets": [{ "name": "NOIRÉ Campaign banner" }]
}
{% endschema %}
