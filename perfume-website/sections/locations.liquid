<section class="section section--ink locations" id="{{ section.settings.anchor_id | default: 'visit' | handleize }}">
  <div class="page-width">
    <div class="section-heading section-heading--split"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div><p class="section-heading__copy">{{ section.settings.copy | escape }}</p></div>
    <div class="locations__grid">{% for block in section.blocks %}<article class="location-card" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 600, 900', sizes: '(min-width: 900px) 33vw, 100vw', alt: block.settings.image.alt | default: block.settings.name | escape }}{% else %}<div class="location-card__placeholder" aria-hidden="true">{{ forloop.index | prepend: '0' }}</div>{% endif %}<div class="location-card__body"><p class="eyebrow">{{ block.settings.kicker | escape }}</p><h3>{{ block.settings.name | escape }}</h3><p>{{ block.settings.address | escape }}</p>{% if block.settings.hours != blank %}<p class="location-card__hours">{{ block.settings.hours | escape }}</p>{% endif %}<a class="text-link" href="{{ block.settings.link_url | default: settings.location_url | default: routes.root_url | escape }}">{{ block.settings.link_label | default: 'Get directions' | escape }} <span aria-hidden="true">↗</span></a></div></article>{% endfor %}</div>
  </div>
</section>

{% schema %}
{
  "name": "Locations",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "visit" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Come say hello" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your corner of the cafe." },
    { "type": "textarea", "id": "copy", "label": "Copy", "default": "Add your own outlets, opening hours, maps, and directions here." }
  ],
  "blocks": [{ "type": "location", "name": "Location", "settings": [
    { "type": "image_picker", "id": "image", "label": "Location image" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Studio counter" },
    { "type": "text", "id": "name", "label": "Name", "default": "Your first location" },
    { "type": "textarea", "id": "address", "label": "Address", "default": "Add your address in Theme Editor" },
    { "type": "text", "id": "hours", "label": "Hours", "default": "Mon–Sun · 8am–8pm" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Get directions" },
    { "type": "url", "id": "link_url", "label": "Directions link" }
  ] }],
  "presets": [{ "name": "Locations", "blocks": [{ "type": "location" }, { "type": "location" }] }]
}
{% endschema %}
