<section class="cafe-hero" id="{{ section.settings.anchor_id | default: 'top' | handleize }}">
  <div class="cafe-hero__media">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 1800 | image_tag: class: 'cafe-hero__image', widths: '640, 900, 1200, 1600, 1800', sizes: '100vw', loading: 'eager', alt: section.settings.image.alt | default: section.settings.heading | escape }}
    {% else %}
      <div class="cafe-hero__placeholder" aria-hidden="true"><span>AB</span></div>
    {% endif %}
    <div class="cafe-hero__veil"></div>
  </div>
  <div class="cafe-hero__content page-width">
    {% if section.settings.eyebrow != blank %}<p class="eyebrow cafe-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <h1>{{ section.settings.heading | escape }}</h1>
    {% if section.settings.copy != blank %}<div class="cafe-hero__copy rte">{{ section.settings.copy }}</div>{% endif %}
    <div class="cafe-hero__actions">
      {% if section.settings.primary_label != blank %}<a class="button button--primary" href="{{ section.settings.primary_url | default: routes.all_products_collection_url | escape }}">{{ section.settings.primary_label | escape }}</a>{% endif %}
      {% if section.settings.secondary_label != blank %}<a class="button button--ghost" href="{{ section.settings.secondary_url | default: '#story' | escape }}">{{ section.settings.secondary_label | escape }}</a>{% endif %}
    </div>
    {% if section.settings.note != blank %}<p class="cafe-hero__note">{{ section.settings.note | escape }}</p>{% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Cafe hero",
  "tag": "section",
  "class": "section-cafe-hero",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "top" },
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Small-batch bakery · Est. for slow mornings" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Come for the coffee. Stay for the good part." },
    { "type": "richtext", "id": "copy", "label": "Copy", "default": "<p>Warm bakes, thoughtful cups, and a table that is always worth lingering at.</p>" },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Order online" },
    { "type": "url", "id": "primary_url", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Our story" },
    { "type": "url", "id": "secondary_url", "label": "Secondary button link" },
    { "type": "text", "id": "note", "label": "Small note", "default": "Freshly baked each morning · Pickup and local delivery" }
  ],
  "presets": [{ "name": "Cafe hero" }]
}
{% endschema %}
