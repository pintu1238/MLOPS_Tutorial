{% comment %}
  Section contract.
  ORVIANE storefront search — demo fragrance catalog matches; excludes legacy footwear/purse pool.
{% endcomment %}

{% liquid
  assign orviane_search_titles = 'Orviane Noir Oud Eau De Parfum 100ml§Orviane Saffron Gold Eau De Parfum 100ml§Orviane Velvet Rose Eau De Parfum 100ml§Orviane Midnight Musk Eau De Parfum 100ml§Orviane Citrus Veil Eau De Parfum 100ml§Orviane Amber Night Eau De Parfum 100ml§Orviane White Tea Eau De Parfum 50ml§Orviane Discovery Set — 5 x 8ml§Orviane Obsidian Iris Eau De Parfum 100ml§Orviane Golden Dusk Eau De Parfum 100ml§Orviane Silk Jasmine Eau De Parfum 100ml§Orviane Velvet Incense Eau De Parfum 100ml' | split: '§'
  assign orviane_search_prices = '8900§7900§7500§6900§6500§8500§4900§5900§8200§7800§7200§7600' | split: '§'
  assign orviane_search_compares = '14900§13900§12900§11900§10900§14900§7900§9900§13900§12900§11900§12500' | split: '§'
  assign orviane_search_tags = 'Night,Oud,Warm§Rich,Spicy,Evening§Floral,Soft,Date§Dark,Musk,Daily§Fresh,Citrus,Day§Amber,Warm,Party§Clean,Light,Soft§Gift,Trial,Layer§Dark,Floral,Evening§Warm,Gold,Sunset§Floral,Soft,Day§Smoky,Incense,Night' | split: '§'
  assign orviane_search_ratings = '4.8§4.7§4.7§4.6§4.6§4.8§4.5§4.7§4.8§4.7§4.6§4.7' | split: '§'
  assign orviane_search_reviews = '58§71§64§51§45§88§42§97§63§59§48§55' | split: '§'
  assign orviane_search_assets = 'orviane-best-noir-oud.jpg,orviane-best-saffron-gold.jpg,orviane-best-velvet-rose.jpg,orviane-best-midnight-musk.jpg,orviane-best-citrus-veil.jpg,orviane-best-amber-night.jpg,orviane-best-white-tea.jpg,orviane-best-discovery.jpg,orviane-new-obsidian-iris.jpg,orviane-new-golden-dusk.jpg,orviane-new-silk-jasmine.jpg,orviane-new-velvet-incense.jpg' | split: ','
  assign orviane_search_slugs = 'noir-oud,saffron-gold,velvet-rose,midnight-musk,citrus-veil,amber-night,white-tea,discovery-set,obsidian-iris,golden-dusk,silk-jasmine,velvet-incense' | split: ','
  assign search_query = search.terms | downcase | strip
  assign orviane_match_count = 0
  if search.performed and search_query != blank
    for title in orviane_search_titles
      assign idx = forloop.index0
      assign title_l = title | downcase
      assign slug_l = orviane_search_slugs[idx] | downcase
      assign tags_l = orviane_search_tags[idx] | downcase
      assign matched = false
      if title_l contains search_query or slug_l contains search_query or tags_l contains search_query
        assign matched = true
      endif
      if matched
        assign orviane_match_count = orviane_match_count | plus: 1
      endif
    endfor
  endif
%}

<section class="orviane-search" data-section-id="{{ section.id }}">
  <div class="orviane-search__inner">
    <div class="search-results__header">
      <p class="search-results__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1>{{ section.settings.heading | escape }}</h1>
      <form
        action="{{ routes.search_url }}"
        method="get"
        role="search"
        class="search-results__form"
        data-noire-predictive-search
        data-suggestions-id="orviane-search-suggestions-{{ section.id }}"
      >
        <label for="SearchInput-{{ section.id }}">{{ section.settings.search_label | escape }}</label>
        <div class="orviane-search__field">
          <div class="orviane-search__field-row">
            <input
              id="SearchInput-{{ section.id }}"
              type="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="{{ section.settings.search_placeholder | escape }}"
              autocomplete="off"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
              aria-autocomplete="list"
              aria-controls="orviane-search-suggestions-{{ section.id }}"
              aria-expanded="false"
            >
            <input type="hidden" name="type" value="product">
            <input type="hidden" name="options[prefix]" value="last">
            <button type="submit">{{ section.settings.search_button | default: 'Search' | escape }}</button>
          </div>
          <div
            id="orviane-search-suggestions-{{ section.id }}"
            class="noire-header__search-suggestions orviane-search__suggestions"
            hidden
          ></div>
        </div>
      </form>
    </div>

    {% if search.performed %}
      <div class="search-results__meta">
        <p>
          {% if search_query != blank %}
            {{ orviane_match_count }}
            {{ section.settings.results_label | escape }}
            {{ section.settings.for_label | escape }} “{{ search.terms | escape }}”
          {% else %}
            {{ section.settings.prompt_heading | escape }}
          {% endif %}
        </p>
      </div>

      {% if search_query != blank and orviane_match_count > 0 %}
        <div class="noire-collection-villain__grid orviane-search__grid" role="list">
          {% for title in orviane_search_titles %}
            {% assign idx = forloop.index0 %}
            {% assign title_l = title | downcase %}
            {% assign slug_l = orviane_search_slugs[idx] | downcase %}
            {% assign tags_l = orviane_search_tags[idx] | downcase %}
            {% assign matched = false %}
            {% if title_l contains search_query or slug_l contains search_query or tags_l contains search_query %}
              {% assign matched = true %}
            {% endif %}
            {% if matched %}
              {% render 'noire-villain-product-card',
                card_index: idx,
                catalog: collections.all,
                demo_title: orviane_search_titles[idx],
                demo_price_cents: orviane_search_prices[idx],
                demo_compare_cents: orviane_search_compares[idx],
                demo_tags: orviane_search_tags[idx],
                demo_rating: orviane_search_ratings[idx],
                demo_reviews: orviane_search_reviews[idx],
                demo_asset: orviane_search_assets[idx],
                demo_slug: orviane_search_slugs[idx],
                show_discount_badge: false
              %}
            {% endif %}
          {% endfor %}
        </div>
      {% elsif search_query != blank %}
        <div class="search-results__empty">
          <h2>{{ section.settings.empty_heading | escape }}</h2>
          <p>{{ section.settings.empty_body | escape }}</p>
          <p class="orviane-search__hints">{{ section.settings.hint_text | escape }}</p>
        </div>
      {% endif %}
    {% else %}
      <div class="search-results__empty">
        <h2>{{ section.settings.prompt_heading | escape }}</h2>
        <p>{{ section.settings.prompt_body | escape }}</p>
      </div>
    {% endif %}
  </div>
  {% render 'noire-search-catalog', section_id: section.id %}
</section>

{% stylesheet %}
  /* Beat legacy `.search-results { background: white; max-width: … }` from older theme CSS */
  section.orviane-search,
  .shopify-section:has(> .orviane-search) {
    max-width: none !important;
    width: 100% !important;
    margin: 0 !important;
    background: #2a2a2a !important;
    background-color: #2a2a2a !important;
  }

  .orviane-search {
    box-sizing: border-box;
    max-width: none !important;
    width: 100% !important;
    margin: 0 !important;
    background: #2a2a2a !important;
    background-color: #2a2a2a !important;
    color: #ffffff;
    padding: clamp(0.85rem, 2.5vw, 1.75rem) 1.25rem clamp(4rem, 8vw, 6rem);
  }

  .orviane-search__inner {
    width: min(100% - 2rem, 1320px);
    margin-inline: auto;
  }

  .orviane-search .search-results__header {
    max-width: 40rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgb(0 0 0 / 0.15);
  }

  .orviane-search .search-results__eyebrow {
    margin: 0 0 0.5rem;
    color: #c9ad72;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .orviane-search h1,
  .orviane-search h2 {
    margin: 0;
    color: #ffffff;
    font-family: var(--font-heading-family, inherit);
  }

  .orviane-search .search-results__form {
    display: grid;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  .orviane-search .search-results__form label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.82);
  }

  .orviane-search__field {
    position: relative;
    min-width: 0;
  }

  .orviane-search__field-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .orviane-search__suggestions {
    position: absolute;
    top: calc(100% + 0.35rem);
    left: 0;
    right: 0;
    z-index: 20;
  }

  .orviane-search input[type='search'] {
    flex: 1 1 14rem;
    min-height: 2.75rem;
    border: 1px solid #111111;
    border-radius: 0;
    padding: 0.65rem 0.85rem;
    background: #f7f3ec;
    color: #111111;
    font: inherit;
  }

  .orviane-search input[type='search']::placeholder,
  .orviane-search input[type='search']::-webkit-input-placeholder {
    color: #5c5c5c;
    opacity: 1;
  }

  .orviane-search input[type='search']::-webkit-search-cancel-button {
    filter: none;
  }

  .orviane-search button[type='submit'] {
    min-height: 2.75rem;
    border: 1px solid #d4b76a;
    border-radius: 0;
    padding: 0.65rem 1.25rem;
    background: linear-gradient(180deg, #e8c882 0%, #c9ad72 100%);
    color: #111111;
    font: inherit;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .orviane-search .search-results__meta {
    padding: 1.25rem 0 0.5rem;
  }

  .orviane-search .search-results__meta > p,
  .orviane-search .search-results__empty p {
    color: rgb(255 255 255 / 0.88);
  }

  .orviane-search .search-results__meta > p {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .orviane-search__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(0.75rem, 2vw, 1.25rem);
    padding-top: 1rem;
  }

  .orviane-search__grid > * {
    box-sizing: border-box;
    flex: 0 1 calc(50% - 0.5rem);
    max-width: calc(50% - 0.5rem);
    min-width: 0;
  }

  @media (min-width: 768px) {
    .orviane-search__grid > * {
      flex: 0 1 calc(33.333% - 0.85rem);
      max-width: calc(33.333% - 0.85rem);
    }
  }

  @media (min-width: 1100px) {
    .orviane-search__grid > * {
      flex: 0 1 300px;
      width: 300px;
      max-width: 300px;
    }
  }

  .orviane-search .search-results__empty {
    display: grid;
    gap: 0.75rem;
    padding: 3rem 0 1rem;
  }

  .orviane-search .search-results__empty p {
    margin: 0;
  }

  .orviane-search__hints {
    color: #c9a03c !important;
    font-size: 0.875rem;
    font-weight: 600;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Search results",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FIND YOUR ORVIANE FRAGRANCE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Search" },
    { "type": "text", "id": "search_label", "label": "Search label", "default": "Search fragrances" },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Try oud, rose, citrus, or discovery set" },
    { "type": "text", "id": "search_button", "label": "Search button", "default": "Search" },
    { "type": "text", "id": "results_label", "label": "Results label", "default": "fragrances" },
    { "type": "text", "id": "for_label", "label": "For label", "default": "for" },
    { "type": "text", "id": "empty_heading", "label": "Empty heading", "default": "No fragrances found" },
    {
      "type": "text",
      "id": "empty_body",
      "label": "Empty body",
      "default": "Try another note or scent family — oud, musk, floral, citrus, or gift set."
    },
    {
      "type": "text",
      "id": "hint_text",
      "label": "Search hints",
      "default": "Popular: Noir Oud, Velvet Rose, Citrus Veil, Discovery Set"
    },
    { "type": "text", "id": "prompt_heading", "label": "Prompt heading", "default": "Search ORVIANE fragrances" },
    {
      "type": "text",
      "id": "prompt_body",
      "label": "Prompt body",
      "default": "Search by name or note — oud, rose, amber, jasmine, musk, and more."
    }
  ],
  "presets": [{ "name": "Search results" }]
}
{% endschema %}
