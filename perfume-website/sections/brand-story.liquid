<section class="noire-story noire-reveal" data-section-id="{{ section.id }}">
  <div class="noire-story__media">
    {% capture story_image_alt %}{{ section.settings.image.alt | default: section.settings.heading }}{% endcapture %}
    {% render 'noire-theme-image',
      image: section.settings.image,
      asset: 'noire-lifestyle-signature-scent.jpg',
      alt: story_image_alt,
      width: 1600,
      widths: '600,900,1200,1600',
      sizes: '(min-width:900px) 50vw, 100vw',
      loading: 'lazy'
    %}
  </div>
  <div class="noire-story__content">
    {% if section.settings.eyebrow != blank %}<p class="noire-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <h2>{{ section.settings.heading | escape }}</h2>
    {% if section.settings.text != blank %}
      <p>{{ section.settings.text | escape }}</p>
    {% endif %}
    {% if section.settings.button_label != blank %}
      <a class="noire-btn noire-btn--outline" href="{{ section.settings.button_url | default: routes.root_url | escape }}">{{ section.settings.button_label | escape }}</a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "NOIRÉ Brand story",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Recommended 1600×1200px editorial fragrance photography." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "BEYOND THE BOTTLE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Created to Be Remembered." },
    { "type": "textarea", "id": "text", "label": "Copy", "default": "Every fragrance tells a story. Explore expressive compositions, carefully selected notes, and distinctive scents designed to become part of your personal signature." },
    { "type": "text", "id": "button_label", "label": "CTA label", "default": "DISCOVER ORVIANE" },
    { "type": "url", "id": "button_url", "label": "CTA URL" }
  ],
  "presets": [{ "name": "NOIRÉ Brand story" }]
}
{% endschema %}
