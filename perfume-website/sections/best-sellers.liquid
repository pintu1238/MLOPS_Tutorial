{% assign featured_collection = section.settings.collection %}
<section class="section best-sellers" id="{{ section.settings.anchor_id | default: 'menu' | handleize }}">
  <div class="page-width">
    <div class="section-heading section-heading--split">
      <div>{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}<h2>{{ section.settings.heading | escape }}</h2></div>
      <a class="text-link" href="{{ section.settings.link_url | default: featured_collection.url | default: routes.all_products_collection_url | escape }}">{{ section.settings.link_label | default: 'View full menu' | escape }} <span aria-hidden="true">→</span></a>
    </div>
    {% if section.settings.intro != blank %}<p class="section-intro">{{ section.settings.intro | escape }}</p>{% endif %}
    <div class="product-grid product-grid--feature">
      {% if section.settings.products != blank %}
        {% assign selected_products = section.settings.products %}
      {% elsif featured_collection != blank %}
        {% assign selected_products = featured_collection.products %}
      {% endif %}
      {% if selected_products != blank %}
        {% for product in selected_products limit: section.settings.limit %}
          <article class="product-card" data-product-card>
            <a class="product-card__media" href="{{ product.url | escape }}">
              {% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 600, 900', sizes: '(min-width: 900px) 25vw, 50vw', alt: product.featured_image.alt | default: product.title | escape }}{% else %}<span aria-hidden="true">AB</span>{% endif %}
            </a>
            <div class="product-card__body"><div><h3><a href="{{ product.url | escape }}">{{ product.title | escape }}</a></h3><p class="product-card__price">{{ product.price | money }}</p></div>
              {% form 'product', product, class: 'product-card__form' %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><button class="button button--small" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}{{ section.settings.button_label | default: 'Add' | escape }}{% else %}{{ 'products.sold_out' | t }}{% endif %}</button>{% endform %}
            </div>
          </article>
        {% endfor %}
      {% else %}
        {% for i in (1..4) %}<article class="product-card product-card--placeholder"><div class="product-card__media"><span aria-hidden="true">AB</span></div><div class="product-card__body"><div><h3>{{ section.settings.placeholder_title | default: 'Your signature bake' | escape }}</h3><p class="product-card__price">{{ section.settings.placeholder_copy | default: 'Add products in Shopify' | escape }}</p></div></div></article>{% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Best sellers",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "menu" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "On the counter" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The things regulars come back for." },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Start with a classic, stay long enough to discover a new favourite." },
    { "type": "collection", "id": "collection", "label": "Fallback collection" },
    { "type": "product_list", "id": "products", "label": "Featured products", "limit": 8 },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "text", "id": "button_label", "label": "Add button label", "default": "Add" },
    { "type": "text", "id": "link_label", "label": "View link label", "default": "View full menu" },
    { "type": "url", "id": "link_url", "label": "View link" },
    { "type": "text", "id": "placeholder_title", "label": "Empty state title", "default": "Your signature bake" },
    { "type": "text", "id": "placeholder_copy", "label": "Empty state copy", "default": "Add products in Shopify" }
  ],
  "presets": [{ "name": "Best sellers" }]
}
{% endschema %}
