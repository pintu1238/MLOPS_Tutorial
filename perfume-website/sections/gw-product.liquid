  .gw-pdp-faq__item[open] .gw-pdp-faq__plus {
    transform: rotate(45deg);
  }

  .gw-pdp-faq__answer {
    padding: 0 18px 12px;
    color: #000000;
    line-height: 1.55;
    font-size: 0.88rem;
  }

  .gw-pdp-faq__item[open] .gw-pdp-faq__summary {
    padding-bottom: 8px;
  }

  .gw-pdp-faq__answer p {
    margin: 0;
  }

  .gw-pdp-compare__inner {
    max-width: 1120px;
    margin-inline: auto;
  }

  .gw-pdp-compare__heading {
    margin: 0 0 32px;
    text-align: center;
    font-family: var(--font-body--family), var(--gw-font-ui);
    font-size: clamp(1.35rem, 2.8vw, 2rem);
    font-weight: 700;
    line-height: 1.25;
    color: #1c1412;
  }

  .gw-pdp-compare__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(16px, 3vw, 28px);
    align-items: stretch;
  }

  .gw-pdp-compare__card {
    display: flex;
    flex-direction: column;
    border-radius: 20px;
    overflow: hidden;
    background: #ffffff;
    box-shadow: 0 10px 32px rgb(28 20 18 / 0.06);
  }

  .gw-pdp-compare__card--without {
    background: #f3ebe3;
  }

  .gw-pdp-compare__card--with {
    border: 2px solid #1a1a1a;
    box-shadow: 0 0 0 1px #1a1a1a, 0 12px 36px rgb(61 42 51 / 0.1);
  }

  .gw-pdp-compare__visual {
    background: #efe6da;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .gw-pdp-compare__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center center;
    background: #efe6da;
  }

  .gw-pdp-compare__img--ordinary {
    filter: saturate(0.82) contrast(0.94);
  }

  .gw-pdp-compare__img--brand {
    object-fit: cover;
    object-position: center 12%;
  }

  .gw-pdp-compare__body {
    padding: 18px 20px 22px;
    font-family: var(--font-body--family), var(--gw-font-ui);
  }

  .gw-pdp-compare__card-title {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin: 0 0 14px;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.3;
    color: #1c1412;
  }

  .gw-pdp-compare__mark {
    flex-shrink: 0;
    font-size: 1.05rem;
    line-height: 1.2;
  }

  .gw-pdp-compare__mark--no {
    color: #8a3a3a;
  }

  .gw-pdp-compare__mark--yes {
    color: #3d6b4a;
  }

  .gw-pdp-compare__list {
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .gw-pdp-compare__list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 8px;
    align-items: start;
    font-size: 0.88rem;
    line-height: 1.45;
    color: #3d3530;
  }

  .gw-pdp-compare__list li span {
    font-weight: 700;
    color: #8a3a3a;
  }

  .gw-pdp-compare__card--with .gw-pdp-compare__list li span {
    color: #3d6b4a;
  }

  .gw-pdp-compare__footnote {
    margin: 24px auto 0;
    max-width: 52rem;
    padding: 14px 18px;
    border-radius: 14px;
    background: #f6ebe4;
    text-align: center;
    font-family: var(--font-body--family), var(--gw-font-ui);
    font-size: 0.82rem;
    line-height: 1.5;
    color: #6b4a42;
  }

  .gw-pdp-compare__cta {
    margin-top: 28px;
    text-align: center;
  }

  .gw-pdp-trust {
    padding: 48px 4vw 88px;
    border-top: 1px solid rgb(0 0 0 / 0.06);
  }

  .gw-pdp-trust__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    text-align: center;
    margin: 0;
    padding: 0;
  }

  .gw-pdp-trust__grid strong {
    display: block;
    margin-bottom: 6px;
    font-size: 0.95rem;
    font-weight: 800;
    color: #000000;
  }

  .gw-pdp-trust__grid span {
    font-size: 0.82rem;
    font-weight: 600;
    color: #000000;
  }

  .gw-pdp-sticky {
    --gw-sticky-pad-inline: var(--page-margin, 16px);
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    padding: 0;
    padding-bottom: env(safe-area-inset-bottom, 0px);
    background: #ffffff;
    border-top: 1px solid rgb(0 0 0 / 0.08);
    box-shadow: 0 -8px 24px rgb(0 0 0 / 0.06);
    transform: translateY(110%);
    transition: transform 0.25s ease;
  }

  .gw-pdp-sticky.is-visible {
    transform: translateY(0);
  }

  .gw-pdp-sticky__inner {
    display: grid;
    align-items: center;
    width: 100%;
    max-width: min(1680px, 100%);
    margin-inline: auto;
    box-sizing: border-box;
    padding: 12px var(--gw-sticky-pad-inline);
    gap: 12px 16px;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: 'copy atc';
  }

  .gw-pdp-sticky__copy {
    grid-area: copy;
    min-width: 0;
    justify-self: start;
    text-align: start;
  }

  .gw-pdp-sticky__btn {
    grid-area: atc;
    justify-self: end;
  }

  .gw-pdp-sticky__title {
    margin: 0;
    font-weight: 700;
    font-size: 0.92rem;
  }

  .gw-pdp-sticky__meta {
    margin: 2px 0 0;
    font-size: 0.78rem;
    color: #5c524c;
  }

  @media screen and (min-width: 750px) {
    .gw-pdp-sticky {
      --gw-sticky-pad-inline: var(--page-margin, 40px);
    }

    .gw-pdp-sticky__inner {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'copy atc';
      gap: 20px 24px;
      padding-block: 14px;
    }

    .gw-pdp-sticky__copy {
      grid-area: copy;
      justify-self: start;
      text-align: start;
    }

    .gw-pdp-sticky__btn {
      grid-area: atc;
      grid-column: auto;
      grid-row: auto;
    }
  }

  .gw-pdp-size {
    border: 0;
    padding: 0;
    background: transparent;
    width: min(640px, 92vw);
    max-width: calc(100vw - 32px);
    margin: auto;
  }

  .gw-pdp-size::backdrop {
    background: rgb(28 20 18 / 0.45);
  }

  .gw-pdp-size__panel {
    background: #ffffff;
    border-radius: 16px;
    padding: 24px;
  }

  .gw-pdp-size__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }

  .gw-pdp-size__head h2 {
    margin: 0;
    font-size: 1.3rem;
  }

  .gw-pdp-size__close {
    border: 0;
    background: none;
    font-size: 1.6rem;
    cursor: pointer;
    line-height: 1;
  }

  .gw-pdp-size__table-wrap {
    overflow-x: auto;
  }

  .gw-pdp-size table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
  }

  .gw-pdp-size th,
  .gw-pdp-size td {
    text-align: left;
    padding: 8px 10px;
    border-bottom: 1px solid rgb(0 0 0 / 0.08);
  }

  @media screen and (max-width: 989px) {
    .gw-pdp__grid,
    .gw-pdp-story__inner,
    .gw-infographic {
      display: flex;
      flex-direction: column;
      grid-template-columns: minmax(0, 1fr);
      width: 100%;
      max-width: 100%;
      min-width: 0;
    }

    .gw-infographic {
      min-height: 0;
      padding: 0;
    }

    .gw-pdp-proof__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .gw-pdp-trust__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .gw-pdp-reviews__inner {
      overflow: visible;
    }

    .gw-pdp-reviews__nav {
      display: flex;
    }

    .gw-pdp-reviews__grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      gap: 14px;
      padding-bottom: 8px;
      margin-inline: -4px;
      padding-inline: 4px;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      touch-action: pan-x pan-y pinch-zoom;
      overscroll-behavior-y: auto;
      cursor: grab;
    }

    .gw-pdp-reviews__grid.is-dragging {
      cursor: grabbing;
      scroll-snap-type: none;
      scroll-behavior: auto;
      user-select: none;
    }

    .gw-pdp-reviews__grid::-webkit-scrollbar {
      display: none;
    }

    .gw-pdp-reviews__card {
      flex: 0 0 min(78%, 320px);
      scroll-snap-align: center;
      min-width: 0;
    }

    .gw-pdp__mini-card {
      flex: 0 0 78cqw;
      width: 78cqw;
      max-width: 78cqw;
    }

    .gw-pdp__mini-photo {
      height: 340px;
      min-height: 320px;
      max-height: none;
      aspect-ratio: auto;
      object-fit: cover;
      object-position: center bottom;
    }

    .gw-pdp__media {
      position: static;
    }

    .gw-pdp__ugc {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .gw-pdp {
      padding-bottom: calc(76px + env(safe-area-inset-bottom, 0px));
    }

    .gw-pdp__buy {
      padding: 0 0 32px;
      overflow: hidden;
    }

    .gw-pdp--purse .gw-pdp__buy {
      padding-inline: 0;
      max-width: none;
    }

    .gw-pdp--purse .gw-pdp__media {
      width: 100%;
      max-width: 100%;
      margin-inline: 0;
    }

    .gw-pdp--purse .gw-pdp__stage,
    .gw-pdp--purse .gw-pdp__track,
    .gw-pdp--purse .gw-pdp__slide,
    .gw-pdp--purse .gw-pdp__main-media {
      border-radius: 0;
    }

    .gw-pdp--purse .gw-pdp__main-media .gw-pdp__main-img {
      object-fit: cover !important;
      object-position: center center;
    }

    .gw-pdp__info,
    .gw-pdp__form,
    .gw-pdp__details,
    .gw-pdp__tiers,
    .gw-pdp__tier-wrap,
    .gw-pdp__tier,
    .gw-pdp__tier-panel,
    .gw-pdp__thumbs-row {
      width: 100%;
      max-width: 100%;
      min-width: 0;
      box-sizing: border-box;
      padding-inline: 16px;
    }

    .gw-pdp__form {
      padding-inline: 0;
    }

    .gw-pdp__main-media,
    .gw-pdp__stage,
    .gw-pdp__slide,
    .gw-infographic,
    .gw-infographic__photo {
      width: 100%;
      max-width: 100%;
      min-width: 0;
    }

    .gw-infographic {
      display: block;
      padding: 0;
      background: #efe6da;
      border-radius: 0;
      min-height: 0;
    }

    .gw-infographic__copy {
      display: none;
    }

    .gw-pdp__media {
      width: 100%;
      max-width: 100%;
      min-width: 0;
      overflow: visible;
    }

    .gw-pdp__stage,
    .gw-pdp__slide {
      width: 100%;
      max-width: 100%;
      min-width: 0;
      overflow: hidden;
    }

    .gw-pdp__main-media,
    .gw-infographic__photo {
      position: relative;
      aspect-ratio: 4 / 5;
      max-height: none;
      height: auto;
      border-radius: 0;
      overflow: hidden;
    }

    .gw-infographic__img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      max-height: none;
      min-height: 0;
      aspect-ratio: auto;
      object-fit: cover;
      object-position: center 18%;
    }

    .gw-pdp__main-media .gw-pdp__main-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      max-height: none;
      min-height: 0;
      aspect-ratio: auto;
      object-fit: cover;
      object-position: center center;
      background: #f3ece4;
    }

    .gw-pdp__tier {
      padding: 12px 14px;
    }

    .gw-pdp__tier-title {
      font-size: 0.9rem;
    }

    .gw-pdp__tier-subtitle {
      font-size: 0.74rem;
    }

    .gw-pdp__tier-price {
      font-size: 0.98rem;
    }

    .gw-pdp__tier-panel {
      padding: 0 12px 12px;
    }

    .gw-bundle__line {
      padding: 8px 0 2px;
    }

    .gw-dd__trigger {
      min-height: 42px;
      padding: 8px 12px;
    }

    .gw-pdp-compare {
      padding: 28px 12px 36px;
    }

    .gw-pdp-compare__heading {
      margin-bottom: 16px;
      font-size: 1.15rem;
    }

    .gw-pdp-compare__grid {
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }

    .gw-pdp-compare__card {
      border-radius: 12px;
    }

    .gw-pdp-compare__visual {
      aspect-ratio: 3 / 4;
      max-height: 210px;
    }

    .gw-pdp-compare__img {
      object-position: center 15%;
    }

    .gw-pdp-compare__body {
      padding: 10px 10px 12px;
    }

    .gw-pdp-compare__card-title {
      margin-bottom: 8px;
      font-size: 0.78rem;
    }

    .gw-pdp-compare__list {
      gap: 6px;
    }

    .gw-pdp-compare__list li {
      font-size: 0.68rem;
      line-height: 1.3;
    }

    .gw-pdp-compare__list li:nth-child(n + 4) {
      display: none;
    }

    .gw-pdp-compare__footnote {
      margin-top: 14px;
      padding: 10px 12px;
      font-size: 0.72rem;
    }

    .gw-pdp__atc {
      width: 100%;
      max-width: 100%;
      box-sizing: border-box;
      min-height: 48px;
      white-space: normal;
    }

    .gw-pdp__trust {
      flex-wrap: wrap;
      text-align: center;
      padding-inline: 4px;
    }

    .gw-pdp-proof,
    .gw-pdp-faq,
    .gw-pdp-compare,
    .gw-pdp-story,
    .gw-pdp-reviews,
    .gw-pdp-related,
    .gw-pdp-tabs {
      padding-inline: 16px;
      width: 100%;
      box-sizing: border-box;
    }

    .gw-pdp-proof__heading {
      max-width: none;
      padding-inline: 4px;
    }

    .gw-pdp-proof__grid,
    .gw-pdp-trust__grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .gw-pdp__ugc,
    .gw-pdp__ugc--videos {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 6px;
      width: 100%;
      max-width: 100%;
    }

    .gw-pdp__ugc-item {
      min-width: 0;
      border-radius: 8px;
    }

    .gw-pdp__ugc-video,
    .gw-pdp__ugc-img {
      aspect-ratio: 9 / 16;
    }

    .gw-pdp__mini-card {
      flex: 0 0 78cqw;
      width: 78cqw;
      max-width: 78cqw;
    }

    .gw-pdp__mini-photo {
      width: 100%;
      height: 320px;
      min-height: 320px;
      max-height: none;
      aspect-ratio: auto;
      object-fit: cover;
      object-position: center bottom;
    }

    .gw-pdp-reviews__img {
      object-position: center bottom;
    }

    .gw-pdp__tier-body {
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
    }

    .gw-pdp__tier-prices {
      align-self: flex-start;
      text-align: left;
    }

    .gw-pdp__tier-prices {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      justify-content: flex-start;
      gap: 8px;
    }

    .gw-pdp__tier-ribbon {
      right: 12px;
      max-width: calc(100% - 48px);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .gw-bundle__line-fields {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .gw-pdp-reviews__inner {
      width: 100%;
      max-width: 100%;
      overflow: hidden;
    }

    .gw-pdp-reviews__nav {
      display: flex;
      position: absolute;
      right: 0;
      top: 50%;
      transform: translateY(-50%);
    }

    .gw-pdp-reviews__title-row {
      padding-inline: 44px;
    }

    .gw-pdp-reviews__title-row h2 {
      text-align: center;
      font-size: clamp(1.65rem, 8vw, 2.35rem);
    }

    .gw-pdp-reviews__grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      gap: 14px;
      padding-bottom: 8px;
      margin-inline: -4px;
      padding-inline: 4px;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      touch-action: pan-x pan-y pinch-zoom;
      overscroll-behavior-y: auto;
      cursor: grab;
    }

    .gw-pdp-reviews__grid.is-dragging {
      cursor: grabbing;
      scroll-snap-type: none;
      scroll-behavior: auto;
      user-select: none;
    }

    .gw-pdp-reviews__grid::-webkit-scrollbar {
      display: none;
    }

    .gw-pdp-reviews {
      padding-block: 16px;
    }

    .gw-pdp-reviews__card {
      flex: 0 0 min(100%, 320px);
      scroll-snap-align: center;
      min-width: 0;
    }

    .gw-pdp-story__point-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
    }

    .gw-pdp-story__point-head span {
      white-space: normal;
    }

    .gw-pdp-faq__summary {
      padding: 10px 12px;
      gap: 10px;
    }

    .gw-pdp-faq__answer {
      padding: 0 12px 10px;
    }

    .gw-pdp-faq__item[open] .gw-pdp-faq__summary {
      padding-bottom: 6px;
    }

    .gw-pdp-faq__kicker {
      font-size: 0.62rem;
      letter-spacing: 0.1em;
    }

    .gw-pdp-sticky {
      --gw-sticky-pad-inline: 8px;
    }

    .gw-pdp-sticky__inner {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'copy atc';
      column-gap: 10px;
      row-gap: 4px;
      padding-block: 10px;
      padding-inline: max(8px, env(safe-area-inset-left, 0px)) max(8px, env(safe-area-inset-right, 0px));
    }

    .gw-pdp-sticky__copy {
      grid-area: copy;
      justify-self: start;
      text-align: start;
      width: 100%;
      min-width: 0;
      max-width: 100%;
    }

    .gw-pdp-sticky__title {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .gw-pdp-sticky__meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: flex-start;
      gap: 4px;
      font-size: 0.72rem;
      line-height: 1.3;
    }

    .gw-pdp-sticky__btn {
      grid-area: atc;
      grid-column: auto;
      grid-row: auto;
      justify-self: end;
      align-self: center;
      flex-shrink: 0;
      padding: 10px 14px;
      font-size: 0.72rem;
      min-height: 44px;
      white-space: nowrap;
    }

    .gw-pdp__payments {
      flex-wrap: wrap;
      justify-content: center;
    }
  }

  @media screen and (max-width: 390px) {
    .gw-pdp__title {
      font-size: 1.55rem;
    }

    .gw-pdp__tier-title {
      font-size: 0.88rem;
    }

    .gw-pdp__tier-subtitle {
      font-size: 0.74rem;
    }

    .gw-bundle__line {
      grid-template-columns: 24px minmax(0, 1fr);
      gap: 8px;
    }
  }

  /* Offer / bundle tiers — square gold outline when expanded */
  .gw-product-section .gw-pdp__tier-wrap,
  .gw-product-section .gw-pdp__tier-wrap.is-expanded,
  .gw-product-section .gw-pdp__tier-panel,
  .gw-product-section .gw-pdp__tier,
  .gw-product-section .gw-pdp__tier.is-selected,
  .gw-product-section .gw-pdp__tier[aria-pressed='true'],
  .gw-product-section .gw-size-picker__btn,
  .gw-product-section .gw-pdp__tier-ribbon,
  .gw-product-section .gw-pdp__tier-ribbon--dark {
    border-radius: 0 !important;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "GW product",
  "tag": "section",
  "class": "gw-product-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    { "type": "checkbox", "id": "show_quote_bar", "label": "Show review quote bar", "default": false },
    { "type": "text", "id": "rating_text", "label": "Rating line", "default": "4.7 · Loved by thousands of winter dressers" },
    { "type": "text", "id": "price_badge", "label": "Price badge", "default": "BUY 1 GET 1 FREE" },
    { "type": "text", "id": "pill_1", "label": "Legacy pill 1" },
    { "type": "text", "id": "pill_2", "label": "Legacy pill 2" },
    { "type": "text", "id": "pill_3", "label": "Legacy pill 3" },
    { "type": "text", "id": "infographic_headline", "label": "Infographic headline", "default": "Warmth That Lasts" },
    { "type": "text", "id": "infographic_script", "label": "Infographic script line", "default": "All Day Long" },
    { "type": "textarea", "id": "infographic_sub", "label": "Infographic subcopy", "default": "Soft wool, no bulk. One layer and the cold is handled." },
    { "type": "text", "id": "without_title", "label": "Without card title", "default": "Without this jacket:" },
    { "type": "text", "id": "without_1", "label": "Without line 1", "default": "Stiff, bulky coats" },
    { "type": "text", "id": "without_2", "label": "Without line 2", "default": "Cold by evening" },
    { "type": "text", "id": "without_3", "label": "Without line 3", "default": "Bulky under your coat" },
    { "type": "text", "id": "without_4", "label": "Without line 4", "default": "You take it off by afternoon" },
    { "type": "text", "id": "with_title", "label": "With card title", "default": "With Girls Winter:" },
    { "type": "text", "id": "with_1", "label": "With line 1", "default": "Warm without bulk" },
    { "type": "text", "id": "with_2", "label": "With line 2", "default": "Polished from morning to night" },
    { "type": "text", "id": "with_3", "label": "With line 3", "default": "Soft wool that layers easily" },
    { "type": "text", "id": "with_4", "label": "With line 4", "default": "Belted shape that holds all day" },
    { "type": "text", "id": "compare_heading", "label": "Compare section heading", "default": "Not all winter jackets work the same way." },
    { "type": "textarea", "id": "compare_footnote", "label": "Compare footnote", "default": "Dense wool, brushed lining, and a belted waist built for real cold — not costume bulk." },
    { "type": "image_picker", "id": "compare_without_image", "label": "Compare image — without" },
    { "type": "image_picker", "id": "compare_with_image", "label": "Compare image — with" },
    { "type": "text", "id": "benefit_1_title", "label": "Benefit 1 title", "default": "Warm without bulk" },
    { "type": "text", "id": "benefit_1_text", "label": "Benefit 1 text", "default": "Wool that layers under coats and over knits" },
    { "type": "text", "id": "benefit_2_title", "label": "Benefit 2 title", "default": "Soft against skin" },
    { "type": "text", "id": "benefit_2_text", "label": "Benefit 2 text", "default": "Brushed lining — no itch, all-day wear" },
    { "type": "text", "id": "benefit_3_title", "label": "Benefit 3 title", "default": "True winter fit" },
    { "type": "text", "id": "benefit_3_text", "label": "Benefit 3 text", "default": "Belted shape that holds · XS–XL" },
    { "type": "text", "id": "benefit_4_title", "label": "Benefit 4 title", "default": "Everyday polished" },
    { "type": "text", "id": "benefit_4_text", "label": "Benefit 4 text", "default": "Looks finished with jeans or a dress" },
    { "type": "text", "id": "benefit_5_title", "label": "Benefit 5 title", "default": "Easy-care wool" },
    { "type": "text", "id": "benefit_5_text", "label": "Benefit 5 text", "default": "Wear, hang, repeat — holds its shape" },
    { "type": "text", "id": "urgency_text", "label": "Urgency line", "default": "Low stock · 1,800+ shipped this week" },
    { "type": "text", "id": "offer_label", "label": "Bundle heading", "default": "Limited Time Offer" },
    { "type": "url", "id": "size_link", "label": "Size guide link" },
    { "type": "text", "id": "size_link_label", "label": "Size guide label", "default": "Size guide" },
    { "type": "richtext", "id": "size_guide_body", "label": "Size guide content" },
    { "type": "text", "id": "fit_note", "label": "Fit note", "default": "Runs true to size — size up if between sizes for layering." },
    { "type": "text", "id": "atc_label", "label": "Add to cart label", "default": "Add to Bag" },
    { "type": "text", "id": "trust_line", "label": "Trust line under button", "default": "Secure Checkout · 90-Day Money-Back Guarantee" },
    {
      "type": "product",
      "id": "demo_cart_product",
      "label": "ORVIANE cart placeholder product",
      "info": "Hidden Shopify product used for demo add to cart. Line items show ORVIANE title and image via cart properties."
    },
    {
      "type": "checkbox",
      "id": "show_feature_cards",
      "label": "Show feature cards above tabs",
      "default": true
    },
    {
      "type": "text",
      "id": "feature_cards_heading",
      "label": "Feature cards heading",
      "default": "How does it work"
    },
    {
      "type": "image_picker",
      "id": "feature_cards_bg",
      "label": "Feature cards background image",
      "info": "Falls back to theme hero image if empty."
    },
    {
      "type": "text",
      "id": "feature_cards_bg_asset",
      "label": "Feature cards background asset (filename)",
      "default": "noire-hero-perfume-bottle-dark.jpg"
    },
    { "type": "richtext", "id": "tab_description", "label": "Tab — description (if product has no description)" },
    { "type": "richtext", "id": "tab_details", "label": "Tab — details" },
    { "type": "richtext", "id": "tab_shipping", "label": "Tab — shipping & returns" },
    { "type": "text", "id": "tab_highlight_1_title", "label": "Highlight 1 title", "default": "Premium Materials" },
    { "type": "text", "id": "tab_highlight_1_text", "label": "Highlight 1 text", "default": "Crafted with care" },
    {
      "type": "select",
      "id": "tab_highlight_1_icon",
      "label": "Highlight 1 icon",
