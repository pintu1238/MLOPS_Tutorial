{% comment %}
  Section contract.
  Girls Winter product page — Sira-style offer layout with expandable bundles.
  Uses the current product. Merchant copy lives in section settings and blocks.
  @example
  Assigned as the main section on templates/product.json.
{% endcomment %}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign compare_at = current_variant.compare_at_price
  if compare_at == blank or compare_at <= current_variant.price
    assign compare_at = current_variant.price | times: 2
  endif
  assign featured_alt = product.title
  assign footwear_gen_asset = 'fw-gen-' | append: product.handle | append: '.jpg'
  assign footwear_hero_asset = 'fw-pdp-' | append: product.handle | append: '-01.jpg'
  assign gallery_numbers = '01,02,03,04,05,06,07,08' | split: ','
  assign gw_is_purse_product = false
  assign gw_is_perfume_product = true
  if product.handle contains 'gp-'
    assign gw_is_purse_product = true
    assign gw_is_perfume_product = false
  endif
  assign orviane_demo_asset = ''
  assign orviane_demo_title = ''
  assign orviane_demo_price_cents = ''
  assign orviane_demo_compare_cents = ''
  assign orviane_demo_slug = ''
  if request.query_string != blank
    if request.query_string contains 'orviane_slug='
      assign orviane_demo_slug = request.query_string | split: 'orviane_slug=' | last | split: '&' | first | url_decode | strip
    endif
    assign orviane_qs_parts = request.query_string | split: '&'
    for part in orviane_qs_parts
      if part contains 'orviane_asset='
        assign orviane_demo_asset = part | split: 'orviane_asset=' | last | url_decode
      elsif part contains 'orviane_title='
        assign orviane_demo_title = part | split: 'orviane_title=' | last | url_decode
      elsif part contains 'orviane_price='
        assign orviane_demo_price_cents = part | split: 'orviane_price=' | last | url_decode
      elsif part contains 'orviane_asset_url='
        assign orviane_demo_asset_url = part | split: 'orviane_asset_url=' | last | url_decode
      endif
    endfor
  endif
  if orviane_demo_slug == blank and orviane_demo_asset != blank
    assign orviane_asset_key = orviane_demo_asset | split: '?' | first
    if orviane_asset_key contains 'orviane-best-'
      assign orviane_demo_slug = orviane_asset_key | replace: 'orviane-best-', '' | replace: '.jpg', '' | replace: '.jpeg', '' | replace: '.png', '' | replace: '.webp', ''
      if orviane_demo_slug == 'discovery'
        assign orviane_demo_slug = 'discovery-set'
      endif
    elsif orviane_asset_key contains 'orviane-new-'
      assign orviane_demo_slug = orviane_asset_key | replace: 'orviane-new-', '' | replace: '.jpg', '' | replace: '.jpeg', '' | replace: '.png', '' | replace: '.webp', ''
      if orviane_demo_slug == 'discovery-luxe'
        assign orviane_demo_slug = 'discovery-set'
      endif
    endif
  endif
  if orviane_demo_slug == blank and gw_is_perfume_product
    assign gw_handle_down = product.handle | downcase
    assign gw_catalog_slugs = 'noir-oud,saffron-gold,velvet-rose,midnight-musk,citrus-veil,amber-night,white-tea,discovery-set,obsidian-iris,golden-dusk,silk-jasmine,velvet-incense' | split: ','
    for gw_slug_candidate in gw_catalog_slugs
      if gw_handle_down contains gw_slug_candidate
        assign orviane_demo_slug = gw_slug_candidate
        break
      endif
    endfor
  endif
  if orviane_demo_slug == 'noir-oud'
    assign orviane_demo_title = 'Orviane Noir Oud Eau De Parfum 100ml'
    assign orviane_demo_asset = 'orviane-best-noir-oud.jpg'
    assign orviane_demo_price_cents = '8900'
    assign orviane_demo_compare_cents = '14900'
  elsif orviane_demo_slug == 'saffron-gold'
    assign orviane_demo_title = 'Orviane Saffron Gold Eau De Parfum 100ml'
    assign orviane_demo_asset = 'orviane-best-saffron-gold.jpg'
    assign orviane_demo_price_cents = '7900'
    assign orviane_demo_compare_cents = '13900'
  elsif orviane_demo_slug == 'velvet-rose'
    assign orviane_demo_title = 'Orviane Velvet Rose Eau De Parfum 100ml'
    assign orviane_demo_asset = 'orviane-best-velvet-rose.jpg'
    assign orviane_demo_price_cents = '7500'
    assign orviane_demo_compare_cents = '12900'
  elsif orviane_demo_slug == 'midnight-musk'
    assign orviane_demo_title = 'Orviane Midnight Musk Eau De Parfum 100ml'
    assign orviane_demo_asset = 'orviane-best-midnight-musk.jpg'
    assign orviane_demo_price_cents = '6900'
    assign orviane_demo_compare_cents = '11900'
  elsif orviane_demo_slug == 'citrus-veil'
    assign orviane_demo_title = 'Orviane Citrus Veil Eau De Parfum 100ml'
    assign orviane_demo_asset = 'orviane-best-citrus-veil.jpg'
    assign orviane_demo_price_cents = '6500'
    assign orviane_demo_compare_cents = '10900'
  elsif orviane_demo_slug == 'amber-night'
    assign orviane_demo_title = 'Orviane Amber Night Eau De Parfum 100ml'
    assign orviane_demo_asset = 'orviane-best-amber-night.jpg'
    assign orviane_demo_price_cents = '8500'
    assign orviane_demo_compare_cents = '14900'
  elsif orviane_demo_slug == 'white-tea'
    assign orviane_demo_title = 'Orviane White Tea Eau De Parfum 50ml'
    assign orviane_demo_asset = 'orviane-best-white-tea.jpg'
    assign orviane_demo_price_cents = '4900'
    assign orviane_demo_compare_cents = '7900'
  elsif orviane_demo_slug == 'discovery-set'
    assign orviane_demo_title = 'Orviane Discovery Set — 5 x 8ml'
    assign orviane_demo_asset = 'orviane-best-discovery.jpg'
    assign orviane_demo_price_cents = '5900'
    assign orviane_demo_compare_cents = '9900'
  elsif orviane_demo_slug == 'obsidian-iris'
    assign orviane_demo_title = 'Orviane Obsidian Iris Eau De Parfum 100ml'
    assign orviane_demo_asset = 'orviane-new-obsidian-iris.jpg'
    assign orviane_demo_price_cents = '8200'
    assign orviane_demo_compare_cents = '13900'
  elsif orviane_demo_slug == 'golden-dusk'
    assign orviane_demo_title = 'Orviane Golden Dusk Eau De Parfum 100ml'
    assign orviane_demo_asset = 'orviane-new-golden-dusk.jpg'
    assign orviane_demo_price_cents = '7800'
    assign orviane_demo_compare_cents = '12900'
  elsif orviane_demo_slug == 'silk-jasmine'
    assign orviane_demo_title = 'Orviane Silk Jasmine Eau De Parfum 100ml'
    assign orviane_demo_asset = 'orviane-new-silk-jasmine.jpg'
    assign orviane_demo_price_cents = '7200'
    assign orviane_demo_compare_cents = '11900'
  elsif orviane_demo_slug == 'velvet-incense'
    assign orviane_demo_title = 'Orviane Velvet Incense Eau De Parfum 100ml'
    assign orviane_demo_asset = 'orviane-new-velvet-incense.jpg'
    assign orviane_demo_price_cents = '7600'
    assign orviane_demo_compare_cents = '12500'
  endif
  assign orviane_demo_asset_url = orviane_demo_asset_url | default: ''
  assign gw_display_title = product.title
  if orviane_demo_title != blank
    assign gw_display_title = orviane_demo_title
  endif
  if gw_is_perfume_product
    assign gw_title_down = gw_display_title | downcase
    if gw_title_down contains 'toy' or gw_title_down contains 'plush' or gw_title_down contains 'doll' or gw_title_down contains 'figurine' or gw_title_down contains 'puzzle' or gw_title_down contains 'game'
      if orviane_demo_title != blank
        assign gw_display_title = orviane_demo_title
      else
        assign gw_display_title = 'ORVIANE Eau de Parfum'
      endif
    endif
    assign orviane_demo_active = true
    if orviane_demo_asset == blank and product.images.size == 0
      assign orviane_demo_asset = 'noire-catalog-classic.jpg'
    endif
  endif
  assign gw_pdp_unit_price = current_variant.price
  if orviane_demo_price_cents != blank
    assign gw_pdp_unit_price = orviane_demo_price_cents | plus: 0
    if orviane_demo_compare_cents != blank
      assign compare_at = orviane_demo_compare_cents | plus: 0
    else
      assign compare_at = gw_pdp_unit_price | times: 2
    endif
  endif
  assign gw_use_theme_gallery = false
  assign gw_use_purse_asset_gallery = false
  assign orviane_use_asset_gallery = false
  assign orviane_demo_active = false
  assign orviane_query_demo = false
  if orviane_demo_slug != blank or orviane_demo_title != blank or orviane_demo_asset != blank or orviane_demo_asset_url != blank
    assign orviane_query_demo = true
  endif
  if orviane_query_demo
    assign orviane_demo_active = true
    assign orviane_use_asset_gallery = true
    assign gw_is_purse_product = false
    assign gw_is_perfume_product = true
    assign gw_use_purse_asset_gallery = false
    if orviane_demo_asset == blank
      assign orviane_demo_asset = 'noire-catalog-classic.jpg'
    endif
  elsif orviane_demo_asset != blank and gw_is_perfume_product
    assign orviane_use_asset_gallery = true
    assign orviane_demo_active = true
  elsif orviane_demo_title != blank and gw_is_perfume_product
    assign orviane_demo_active = true
    assign orviane_use_asset_gallery = true
    if orviane_demo_asset == blank
      assign orviane_demo_asset = 'noire-catalog-classic.jpg'
    endif
  elsif orviane_demo_asset_url != blank and gw_is_perfume_product
    assign orviane_demo_active = true
    assign orviane_use_asset_gallery = true
    if orviane_demo_asset == blank
      assign orviane_demo_asset = 'noire-catalog-classic.jpg'
    endif
  elsif product.images.size == 0
    if gw_is_purse_product
      assign gw_use_purse_asset_gallery = true
    elsif gw_is_perfume_product
      assign orviane_use_asset_gallery = true
      if orviane_demo_asset == blank
        assign orviane_demo_asset = 'noire-catalog-classic.jpg'
      endif
    else
      assign gw_use_theme_gallery = true
    endif
  elsif gw_is_purse_product and product.images.size < 8
    assign gw_use_purse_asset_gallery = true
  endif
  if product.featured_image
    assign hero_thumb_url = product.featured_image | image_url: width: 480
  else
    assign hero_thumb_url = footwear_hero_asset | asset_img_url: '240x'
  endif
  assign gw_pdp_audience = 'women'
  assign gw_pdp_handle_lead = product.handle | split: '-' | first
  if gw_pdp_handle_lead == 'mens'
    assign gw_pdp_audience = 'men'
  elsif gw_pdp_handle_lead == 'womens'
    assign gw_pdp_audience = 'women'
  elsif product.tags contains 'men'
    assign gw_pdp_audience = 'men'
  elsif product.tags contains 'women'
    assign gw_pdp_audience = 'women'
  endif
  assign gw_pdp_quote_ext = 'jpg'
  capture orviane_cart_variant_id
    render 'orviane-resolve-cart-variant', demo_cart_product: section.settings.demo_cart_product, catalog: collections.all
  endcapture
  assign orviane_cart_variant_id = orviane_cart_variant_id | strip

  if orviane_demo_active or gw_is_perfume_product
    assign gw_pdp_quote_photo_prefix = 'orviane-review-'
    assign gw_pdp_review_asset_prefix = 'orviane-review-us-'
  elsif gw_pdp_audience == 'men'
    assign gw_pdp_quote_photo_prefix = 'fw-review-mens-'
    assign gw_pdp_review_asset_prefix = 'fw-review-mens-'
  else
    assign gw_pdp_quote_photo_prefix = 'gp-review-'
    assign gw_pdp_review_asset_prefix = 'gp-review-grid-'
  endif
  assign supplemental_ugc_assets = 'fw-pdp-' | append: product.handle | append: '-02.jpg,fw-pdp-' | append: product.handle | append: '-03.jpg,fw-pdp-' | append: product.handle | append: '-04.jpg' | split: ','
  assign gw_color_option_index = 0
  for option in product.options_with_values
    assign gw_opt_n = option.name | downcase
    if gw_opt_n == 'color' or gw_opt_n == 'colour'
      assign gw_color_option_index = forloop.index0
    endif
  endfor
%}

{% style %}
  #shopify-section-{{ section.id }} {
    overflow-x: clip;
    max-width: 100%;
    background: {% if orviane_demo_active or gw_is_perfume_product %}#2a2a2a{% else %}var(--gw-cream, #fdf8f5){% endif %};
  }
{% endstyle %}

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% assign orviane_asset_cdn_base = 'orviane-best-noir-oud.jpg' | asset_url | split: 'orviane-best-noir-oud.jpg' | first %}
<gw-product-bundle
  class="gw-pdp{% if gw_is_purse_product %} gw-pdp--purse{% endif %}"
  id="gw-pdp-{{ section.id }}"
  data-product-handle="{{ product.handle | escape }}"
  {% if orviane_demo_active or gw_is_perfume_product %}data-orviane-demo-active="true"{% endif %}
  data-orviane-server-title="{{ gw_display_title | escape }}"
  data-orviane-asset-base="{{ orviane_asset_cdn_base | escape }}"
>
  <div class="gw-pdp__buy">
    <div class="gw-pdp__grid">
      <div class="gw-pdp__media">
        <div class="gw-pdp__stage" data-gw-gallery-stage>
          <div class="gw-pdp__track" data-gw-gallery-track>
          {% if gw_use_purse_asset_gallery %}
            {% render 'gw-gp-pdp-gallery', product: product, part: 'slides' %}
          {% elsif orviane_use_asset_gallery %}
            {% render 'orviane-pdp-gallery', product: product, hero_asset: orviane_demo_asset, product_slug: orviane_demo_slug, product_title: gw_display_title, part: 'slides' %}
          {% elsif gw_use_theme_gallery == false %}
            {% for image in product.images %}
              {%- liquid
                assign gw_slide_color = ''
                for variant in product.variants
                  if variant.featured_image != blank and variant.featured_image == image
                    if gw_color_option_index == 0
                      assign gw_slide_color = variant.option1
                    elsif gw_color_option_index == 1
                      assign gw_slide_color = variant.option2
                    else
                      assign gw_slide_color = variant.option3
                    endif
                  endif
                endfor
              -%}
              <div
                class="gw-pdp__slide{% if forloop.first %} is-active{% endif %}"
                data-gw-slide
                {% if gw_slide_color != blank %}
                  data-gw-slide-color="{{ gw_slide_color | escape }}"
                {% endif %}
              >
                <div class="gw-pdp__main-media">
                  <img
                    src="{{ image | image_url: width: 1600 }}"
                    srcset="
                      {{ image | image_url: width: 800 }} 800w,
                      {{ image | image_url: width: 1200 }} 1200w,
                      {{ image | image_url: width: 1600 }} 1600w,
                      {{ image | image_url: width: 2000 }} 2000w
                    "
                    sizes="(min-width: 990px) 48vw, 100vw"
                    alt="{{ image.alt | default: product.title | escape }}"
                    class="gw-pdp__main-img{% unless gw_is_purse_product %} gw-pdp__main-img--contain{% endunless %}"
                    width="{{ image.width }}"
                    height="{{ image.height }}"
                    {% if forloop.first %}
                      loading="eager"
                      fetchpriority="high"
                    {% else %}
                      loading="lazy"
                    {% endif %}
                  >
                </div>
              </div>
            {% endfor %}
          {% else %}
            {% assign slide_alts = 'Front profile,Size guide,Side view,Top detail,Sole view,Detail shot,Pair view,Back angle' | split: ',' %}
            {% for num in gallery_numbers %}
              {% assign gallery_asset = 'fw-pdp-' | append: product.handle | append: '-' | append: num | append: '.jpg' %}
              {% assign slide_alt = slide_alts[forloop.index0] | default: 'View' %}
              {% assign is_size_slide = false %}
              {% if num == '02' and gw_is_purse_product == false %}
                {% assign is_size_slide = true %}
              {% endif %}
              <div class="gw-pdp__slide{% if forloop.first %} is-active{% endif %}" data-gw-slide>
                <div class="gw-pdp__main-media{% if is_size_slide %} gw-pdp__main-media--size-guide{% endif %}">
                  <img
                    src="{{ gallery_asset | asset_img_url: '2000x' }}"
                    srcset="
                      {{ gallery_asset | asset_img_url: '800x' }} 800w,
                      {{ gallery_asset | asset_img_url: '1200x' }} 1200w,
                      {{ gallery_asset | asset_img_url: '1600x' }} 1600w,
                      {{ gallery_asset | asset_img_url: '2000x' }} 2000w
                    "
                    sizes="(min-width: 990px) 48vw, 100vw"
                    alt="{{ product.title | escape }} — {{ slide_alt | escape }}"
                    class="gw-pdp__main-img"
                    width="1600"
                    height="2000"
                    {% if forloop.first %}
                      loading="eager"
                      fetchpriority="high"
                    {% else %}
                      loading="lazy"
                    {% endif %}
                  >
                  {% if is_size_slide %}
                    {% render 'gw-pdp-gallery-size-overlay', variant: 'main' %}
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          {% endif %}
          </div>
          <div class="gw-pdp__swipe" data-gw-gallery-swipe aria-hidden="true"></div>
        </div>

        <div class="gw-pdp__thumbs-row">
          <button
            type="button"
            class="gw-pdp__thumb-nav"
            data-gw-thumbs-prev
            aria-label="{{ 'girls_winter.product.gallery_prev' | t }}"
            disabled
          >
            {% render 'gw-icon', name: 'chevron-left', class: 'gw-icon--nav' %}
          </button>
          <div class="gw-pdp__thumbs" role="tablist" aria-label="{{ 'girls_winter.product.gallery_label' | t }}">
            {% if gw_use_purse_asset_gallery %}
              {% render 'gw-gp-pdp-gallery', product: product, part: 'thumbs' %}
            {% elsif orviane_use_asset_gallery %}
              {% render 'orviane-pdp-gallery', product: product, hero_asset: orviane_demo_asset, product_slug: orviane_demo_slug, product_title: gw_display_title, part: 'thumbs' %}
            {% elsif gw_use_theme_gallery == false %}
              {% for image in product.images %}
                <button
                  type="button"
                  class="gw-pdp__thumb{% if forloop.first %} is-active{% endif %}"
                  data-gw-gallery-thumb
                  aria-label="{{ 'girls_winter.product.load_image' | t: index: forloop.index }}"
                >
                  <span class="gw-pdp__thumb-frame">
                    <img
                      src="{{ image | image_url: width: 320 }}"
                      alt=""
                      class="gw-pdp__thumb-img"
                      width="160"
                      height="160"
                      {% if forloop.first %}
                        loading="eager"
                      {% else %}
                        loading="lazy"
                      {% endif %}
                    >
                  </span>
                </button>
              {% endfor %}
            {% else %}
              {% for num in gallery_numbers %}
                {% assign gallery_asset = 'fw-pdp-' | append: product.handle | append: '-' | append: num | append: '.jpg' %}
                {% assign thumb_size_guide = false %}
                {% if num == '02' and gw_is_purse_product == false %}
                  {% assign thumb_size_guide = true %}
                {% endif %}
                <button
                  type="button"
                  class="gw-pdp__thumb{% if forloop.first %} is-active{% endif %}{% if thumb_size_guide %} gw-pdp__thumb--size-guide{% endif %}"
                  data-gw-gallery-thumb
                  aria-label="{{ 'girls_winter.product.load_image' | t: index: forloop.index }}"
                >
                  <span class="gw-pdp__thumb-frame{% if thumb_size_guide %} gw-pdp__thumb-frame--size-guide{% endif %}">
                    <img
                      src="{{ gallery_asset | asset_img_url: '320x' }}"
                      alt=""
                      class="gw-pdp__thumb-img"
                      width="160"
                      height="200"
                      {% if forloop.first %}
                        loading="eager"
                      {% else %}
                        loading="lazy"
                      {% endif %}
                    >
                    {% if thumb_size_guide %}
                      {% render 'gw-pdp-gallery-size-overlay', variant: 'thumb' %}
                    {% endif %}
                  </span>
                </button>
              {% endfor %}
            {% endif %}
          </div>
          <button
            type="button"
            class="gw-pdp__thumb-nav"
            data-gw-thumbs-next
            aria-label="{{ 'girls_winter.product.gallery_next' | t }}"
          >
            {% render 'gw-icon', name: 'chevron-right', class: 'gw-icon--nav' %}
          </button>
        </div>
      </div>

      <div class="gw-pdp__info">
        {% if section.settings.rating_text != blank %}
          <p class="gw-pdp__rating">
            <span class="gw-pdp__rating-stars">{% render 'gw-star-rating' %}</span>
            {{ section.settings.rating_text | escape }}
          </p>
        {% endif %}

        <h1 class="gw-pdp__title">{{ gw_display_title | escape }}</h1>

        <ul class="gw-pdp__benefits list-unstyled" role="list">
          {% for i in (1..5) %}
            {% liquid
              assign title_key = 'benefit_' | append: i | append: '_title'
              assign text_key = 'benefit_' | append: i | append: '_text'
              assign b_title = section.settings[title_key]
              assign b_text = section.settings[text_key]
            %}
            {% if b_title != blank %}
              <li class="gw-pdp__benefit">
                <span class="gw-pdp__benefit-icon" aria-hidden="true">
                  {% case i %}
                    {% when 1 %}
                      <svg viewBox="0 0 24 24" fill="none"><path d="M12 3v3M12 18v3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M3 12h3M18 12h3M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="12" cy="12" r="3.2" stroke="currentColor" stroke-width="1.6"/></svg>
                    {% when 2 %}
                      <svg viewBox="0 0 24 24" fill="none"><path d="M12 20c6-4 8-8 8-12-4 0-8 2-8 2S8 8 4 8c0 4 2 8 8 12z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M12 20V10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                    {% when 3 %}
                      <svg viewBox="0 0 24 24" fill="none"><path d="M4 8h16M4 12h16M4 16h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M7 6l-3 2 3 2M17 14l3 2-3 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {% when 4 %}
                      <svg viewBox="0 0 24 24" fill="none"><path d="M12 4l1.4 4.2H18l-3.5 2.6 1.3 4.2L12 12.6 8.2 15l1.3-4.2L6 8.2h4.6z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
                    {% else %}
                      <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="3" stroke="currentColor" stroke-width="1.6"/><path d="M6 19c.8-3.2 3-5 6-5s5.2 1.8 6 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                  {% endcase %}
                </span>
                <span>
                  <strong>{{ b_title | escape }}</strong>
                  {% if b_text != blank %}
                    <span class="gw-pdp__benefit-text">{{ b_text | escape }}</span>
                  {% endif %}
                </span>
              </li>
            {% endif %}
          {% endfor %}
        </ul>

        {% if section.settings.urgency_text != blank %}
          <p class="gw-pdp__urgency">
            <span class="gw-pdp__urgency-dot" aria-hidden="true"></span>
            {{ section.settings.urgency_text | escape }}
          </p>
        {% endif %}

        <div class="gw-pdp__offer-head" data-gw-offer-anchor>
          <p class="gw-pdp__offer-label">
            <span class="gw-pdp__offer-clock" aria-hidden="true">◷</span>
            {% if section.settings.offer_label != blank %}
              {{ section.settings.offer_label | escape }}
            {% else %}
              {{ 'girls_winter.product.limited_offer' | t }}
            {% endif %}
          </p>
          {% unless gw_is_purse_product or gw_is_perfume_product %}
            <button type="button" class="gw-pdp__size-link" data-gw-size-open>
              {% if section.settings.size_link_label != blank %}
                {{ section.settings.size_link_label | escape }}
              {% else %}
                {{ 'girls_winter.product.size_guide' | t }}
              {% endif %}
            </button>
          {% endunless %}
        </div>

        <div class="gw-pdp__tiers" role="radiogroup" aria-label="{{ section.settings.offer_label | escape }}">
          {% for block in section.blocks %}
            {% if block.type == 'bundle_tier' %}
              {% liquid
                assign tier_qty = block.settings.quantity
                assign unit = gw_pdp_unit_price
                assign raw_total = unit | times: tier_qty
                assign discount = block.settings.percent_off | default: 0
                assign multiplier = 100 | minus: discount
                assign tier_total = raw_total | times: multiplier | divided_by: 100
                assign tier_compare = raw_total
                if block.settings.use_compare_multiplier
                  assign tier_compare = compare_at | times: tier_qty
                endif
                assign per_unit_label = ''
                if tier_qty > 0 and block.settings.per_unit_note != blank
                  assign per_unit_amount = tier_total | divided_by: tier_qty | money
                  assign per_unit_label = block.settings.per_unit_note | replace: '[price]', per_unit_amount
                endif
                assign ribbon_downcase = block.settings.ribbon | downcase
                assign is_default = false
                if ribbon_downcase contains 'popular'
                  assign is_default = true
                endif
              %}
              <div
                class="gw-pdp__tier-wrap"
                data-gw-tier-wrap
                data-gw-percent-off="{{ discount }}"
                data-gw-use-compare-multiplier="{{ block.settings.use_compare_multiplier }}"
                {% if is_default %}data-gw-default{% endif %}
                {{ block.shopify_attributes }}
              >
                {% if block.settings.ribbon != blank %}
                  <span class="gw-pdp__tier-ribbon{% if ribbon_downcase contains 'best' %} gw-pdp__tier-ribbon--dark{% endif %}">
                    {{ block.settings.ribbon | escape }}
                  </span>
                {% endif %}
                <button
                  type="button"
                  class="gw-pdp__tier"
                  role="radio"
                  aria-expanded="false"
                  data-gw-tier="{{ tier_qty }}"
                  data-gw-tier-price="{{ tier_total | money }}"
                  data-gw-tier-total-cents="{{ tier_total }}"
                  data-gw-tier-compare="{{ tier_compare | money }}"
                  aria-pressed="false"
                >
                  <span class="gw-pdp__tier-radio" aria-hidden="true"></span>
                  <span class="gw-pdp__tier-body">
                    <span class="gw-pdp__tier-main">
                      <strong class="gw-pdp__tier-title">{{ block.settings.heading | escape }}</strong>
                      {% if block.settings.subtitle != blank %}
                        <span class="gw-pdp__tier-subtitle">{{ block.settings.subtitle | escape }}</span>
                      {% endif %}
                      {% if per_unit_label != blank %}
                        <span class="gw-pdp__tier-per-unit">{{ per_unit_label | escape }}</span>
                      {% endif %}
                    </span>
                    <span class="gw-pdp__tier-prices">
                      <strong class="gw-pdp__tier-price">{{ tier_total | money }}</strong>
                      <s>{{ tier_compare | money }}</s>
                    </span>
                  </span>
                </button>
                <div class="gw-pdp__tier-panel" data-gw-bundle-lines hidden></div>
              </div>
            {% endif %}
          {% endfor %}
        </div>

        <form
          class="gw-pdp__form"
          id="gw-pdp-form-{{ section.id }}"
          data-gw-product-form
        >
          {% if section.settings.fit_note != blank %}
            <p class="gw-pdp__fit-note">{{ section.settings.fit_note | escape }}</p>
          {% endif %}
          <p class="gw-pdp__cart-error" data-gw-cart-error hidden role="alert"></p>
          <button type="submit" class="gw-pdp__atc">
            <span class="gw-pdp__atc-icon" aria-hidden="true">
              {{ 'icon-cart.svg' | inline_asset_content }}
            </span>
            {{ section.settings.atc_label | escape }}
          </button>
          {% if section.settings.trust_line != blank %}
            <p class="gw-pdp__trust">
              <span class="gw-pdp__trust-lock" aria-hidden="true">
                <svg viewBox="0 0 16 16" fill="none">
                  <rect x="3.5" y="7" width="9" height="7" rx="1.4" stroke="currentColor" stroke-width="1.3"/>
                  <path d="M5.4 7V5.2a2.6 2.6 0 0 1 5.2 0V7" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                </svg>
              </span>
              {{ section.settings.trust_line | escape }}
            </p>
          {% endif %}
          {% liquid
            assign pay_types = shop.enabled_payment_types
            if pay_types.size == 0
              assign pay_types = 'amazon,american_express,apple_pay,diners_club,discover,google_pay,master,paypal,shopify_pay,visa' | split: ','
            endif
          %}
          <ul class="gw-pdp__payments list-unstyled" role="list">
            {% for type in pay_types %}
              <li>{{ type | payment_type_svg_tag: class: 'gw-pdp__payment-icon' }}</li>
            {% endfor %}
          </ul>
        </form>

        <div class="gw-pdp__accordions">
          {% for block in section.blocks %}
            {% if block.type == 'accordion' %}
              <details class="gw-pdp__accordion" {{ block.shopify_attributes }}>
                <summary class="gw-pdp__accordion-summary">{{ block.settings.title | escape }}</summary>
                <div class="gw-pdp__accordion-body rte">
                  {{ block.settings.body }}
                </div>
              </details>
            {% endif %}
          {% endfor %}
        </div>

        {% assign quote_count = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'quote' %}
            {% assign quote_count = quote_count | plus: 1 %}
          {% endif %}
        {% endfor %}
        {% if quote_count > 0 %}
          <div class="gw-pdp__mini-reviews" data-gw-mini-reviews>
            <div class="gw-pdp__mini-head">
              <h2 class="gw-pdp__mini-title">
                {% if section.settings.reviews_heading != blank %}
                  {{ section.settings.reviews_heading | escape }}
                {% else %}
                  {{ 'girls_winter.product.what_women_say' | t }}
                {% endif %}
              </h2>
              <div class="gw-pdp__mini-nav">
                <button type="button" data-gw-mini-prev aria-label="{{ 'girls_winter.product.reviews_prev' | t }}">
                  {% render 'gw-icon', name: 'chevron-left', class: 'gw-icon--nav' %}
                </button>
                <button type="button" data-gw-mini-next aria-label="{{ 'girls_winter.product.reviews_next' | t }}">
                  {% render 'gw-icon', name: 'chevron-right', class: 'gw-icon--nav' %}
                </button>
              </div>
            </div>
            <div class="gw-pdp__mini-viewport">
              <div class="gw-pdp__mini-track" data-gw-mini-track>
                {% assign quote_index = 0 %}
                {% for block in section.blocks %}
                  {% if block.type == 'quote' %}
                    {% assign quote_index = quote_index | plus: 1 %}
                    {% liquid
                      if quote_index < 10
                        assign quote_asset = gw_pdp_quote_photo_prefix | append: '0' | append: quote_index | append: '.' | append: gw_pdp_quote_ext
                      else
                        assign quote_asset = gw_pdp_quote_photo_prefix | append: quote_index | append: '.' | append: gw_pdp_quote_ext
                      endif
                      assign quote_display_text = block.settings.text
                      assign quote_display_author = block.settings.author
                      if gw_pdp_audience == 'men'
                        assign quote_text_key = 'girls_winter.product.men_quote_' | append: quote_index | append: '_text'
                        assign quote_author_key = 'girls_winter.product.men_quote_' | append: quote_index | append: '_author'
                        assign quote_display_text = quote_text_key | t
                        assign quote_display_author = quote_author_key | t
                      endif
                    %}
                    <blockquote class="gw-pdp__mini-card" {{ block.shopify_attributes }}>
                      {% if quote_asset != blank %}
                        <img
                          class="gw-pdp__mini-photo"
                          src="{{ quote_asset | asset_img_url: '800x' }}"
                          srcset="
                            {{ quote_asset | asset_img_url: '400x' }} 400w,
                            {{ quote_asset | asset_img_url: '600x' }} 600w,
                            {{ quote_asset | asset_img_url: '800x' }} 800w
                          "
                          sizes="(min-width: 750px) 22vw, 88vw"
                          alt="{{ quote_display_author | escape }}"
                          width="360"
                          height="480"
                          loading="lazy"
                        >
                      {% elsif block.settings.image != blank %}
                        {{
                          block.settings.image
                          | image_url: width: 720
                          | image_tag:
                            loading: 'lazy',
                            widths: '240, 360, 480, 720',
                            sizes: '(min-width: 750px) 22vw, 88vw',
                            class: 'gw-pdp__mini-photo',
                            alt: block.settings.author
                        }}
                      {% else %}
                        <img
                          class="gw-pdp__mini-photo"
                          src="{{ footwear_hero_asset | asset_img_url: '800x' }}"
                          alt="{{ quote_display_author | default: product.title | escape }}"
                          width="360"
                          height="480"
                          loading="lazy"
                        >
                      {% endif %}
                      <span class="gw-pdp__rating-stars">{% render 'gw-star-rating' %}</span>
                      <p>{{ quote_display_text | escape }}</p>
                      {% if quote_display_author != blank %}
                        <footer>
                          <cite>{{ quote_display_author | escape }}</cite>
                          <span>
                            {% render 'gw-icon', name: 'check-simple', class: 'gw-icon--inline-check' %}
                            {{ 'girls_winter.product.verified' | t }}
                          </span>
                        </footer>
                      {% endif %}
                    </blockquote>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  {% if section.settings.show_feature_cards and gw_is_perfume_product %}
    {% render 'orviane-pdp-feature-cards',
      section_id: section.id,
      heading: section.settings.feature_cards_heading,
      bg_image: section.settings.feature_cards_bg,
      bg_asset: section.settings.feature_cards_bg_asset
    %}
  {% endif %}

  {% assign review_count = 0 %}
  {% for block in section.blocks %}
    {% if block.type == 'review' %}
      {% assign review_count = review_count | plus: 1 %}
    {% endif %}
  {% endfor %}
  {% if review_count > 0 %}
    <section
      class="gw-pdp-reviews{% if gw_is_perfume_product or orviane_demo_active %} gw-pdp-reviews--orviane{% endif %}"
      data-gw-pdp-reviews
    >
      <div class="gw-pdp-reviews__inner">
        <header class="gw-pdp-reviews__head">
          <p class="gw-pdp-reviews__rated">
            <span class="gw-pdp__rating-stars">{% render 'gw-star-rating' %}</span>
            {% if gw_pdp_audience == 'men' %}
              {{ 'girls_winter.product.reviews_rated_men' | t }}
            {% else %}
              {{ 'girls_winter.product.reviews_rated' | t }}
            {% endif %}
          </p>
          <div class="gw-pdp-reviews__title-row">
            {% if section.settings.reviews_heading != blank %}
              <h2>{{ section.settings.reviews_heading | escape | newline_to_br }}</h2>
            {% endif %}
            <div class="gw-pdp-reviews__nav">
              <button
                type="button"
                data-gw-pdp-reviews-prev
                aria-label="{{ 'girls_winter.product.reviews_prev' | t }}"
              >
                {% render 'gw-icon', name: 'chevron-left', class: 'gw-icon--nav' %}
              </button>
              <button
                type="button"
                data-gw-pdp-reviews-next
                aria-label="{{ 'girls_winter.product.reviews_next' | t }}"
              >
                {% render 'gw-icon', name: 'chevron-right', class: 'gw-icon--nav' %}
              </button>
            </div>
          </div>
          <ul class="gw-pdp-reviews__trust list-unstyled" role="list">
            <li>
              {% render 'gw-icon', name: 'check-simple', class: 'gw-icon--inline-check' %}
              {{ 'girls_winter.product.reviews_trust_count' | t }}
            </li>
            <li>
              {% render 'gw-icon', name: 'check-simple', class: 'gw-icon--inline-check' %}
              {{ 'girls_winter.product.reviews_trust_guarantee' | t }}
            </li>
            <li>
              {% render 'gw-icon', name: 'check-simple', class: 'gw-icon--inline-check' %}
              {{ 'girls_winter.product.reviews_trust_shipping' | t }}
            </li>
          </ul>
        </header>
        <ul class="gw-pdp-reviews__grid list-unstyled" data-gw-pdp-reviews-track role="list">
          {% assign review_img_index = 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'review' %}
              {% assign review_img_index = review_img_index | plus: 1 %}
              {% liquid
                if review_img_index > 6
                  continue
                endif
                if review_img_index < 10
                  assign review_asset = gw_pdp_review_asset_prefix | append: '0' | append: review_img_index | append: '.jpg'
                else
                  assign review_asset = gw_pdp_review_asset_prefix | append: review_img_index | append: '.jpg'
                endif
                assign review_display_text = block.settings.text
                assign review_display_author = block.settings.author
                assign review_display_purchased = block.settings.purchased
                if gw_pdp_audience == 'men'
                  assign review_text_key = 'girls_winter.product.men_review_' | append: review_img_index | append: '_text'
                  assign review_author_key = 'girls_winter.product.men_review_' | append: review_img_index | append: '_author'
                  assign review_purchased_key = 'girls_winter.product.men_review_' | append: review_img_index | append: '_purchased'
                  assign review_display_text = review_text_key | t
                  assign review_display_author = review_author_key | t
                  assign review_display_purchased = review_purchased_key | t
                endif
              %}
              {% assign author_name = review_display_author | split: ' · ' | first %}
              <li class="gw-pdp-reviews__card" {{ block.shopify_attributes }}>
                <div class="gw-pdp-reviews__media">
                  {% if block.settings.image != blank %}
                    {{
                      block.settings.image
                      | image_url: width: 800
                      | image_tag: loading: 'lazy', widths: '320, 480, 640, 800', sizes: '(min-width: 750px) 28vw, 78vw', class: 'gw-pdp-reviews__img', alt: author_name
                    }}
                  {% else %}
                    <img
                      class="gw-pdp-reviews__img"
                      src="{{ review_asset | asset_img_url: '800x' }}"
                      srcset="
                        {{ review_asset | asset_img_url: '320x' }} 320w,
                        {{ review_asset | asset_img_url: '480x' }} 480w,
                        {{ review_asset | asset_img_url: '640x' }} 640w,
                        {{ review_asset | asset_img_url: '800x' }} 800w
                      "
                      sizes="(min-width: 750px) 28vw, 78vw"
                      alt="{{ author_name | escape }}"
                      width="800"
                      height="810"
                      loading="lazy"
                    >
                  {% endif %}
                </div>
                <div class="gw-pdp-reviews__body">
                  <p class="gw-pdp__rating-stars">{% render 'gw-star-rating' %}</p>
                  <div class="gw-pdp-reviews__text">
                    {% if gw_pdp_audience == 'men' %}
                      <p>{{ review_display_text | escape }}</p>
                    {% else %}
                      {% render 'gw-pdp-tab-multiline', html: block.settings.text %}
                    {% endif %}
                  </div>
                  <div class="gw-pdp-reviews__buyer">
                    <span class="gw-pdp-reviews__buyer-label">{{ 'girls_winter.product.buyer' | t }}</span>
                    <strong>{{ author_name | escape }}</strong>
                    <span class="gw-pdp-reviews__verified">{{ 'girls_winter.product.verified_buyer' | t }}</span>
                  </div>
                  <p class="gw-pdp-reviews__purchase">
                    <span class="gw-pdp-reviews__shield" aria-hidden="true">
                      <svg viewBox="0 0 16 16" fill="none">
                        <path d="M8 1.6 13 3.7v4.8c0 3-2 5.4-5 6.3-3-.9-5-3.3-5-6.3V3.7L8 1.6Z" stroke="currentColor" stroke-width="1.2"/>
                        <path d="M5.5 8.1 7.3 9.8 10.6 6.2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                    <span class="gw-pdp-reviews__verified-purchase">{{ 'girls_winter.product.verified_purchase' | t }}</span>
                    {% if review_display_purchased != blank %}
                      <span class="gw-pdp-reviews__purchase-date">· {{ review_display_purchased | escape }}</span>
                    {% endif %}
                  </p>
                </div>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    </section>
  {% endif %}

  {% liquid
    assign gw_use_orviane_related = gw_is_perfume_product
    if orviane_demo_active
      assign gw_use_orviane_related = true
    endif
  %}
  {% render 'gw-pdp-you-may-also-like',
    product: product,
    section: section,
    use_orviane_catalog: gw_use_orviane_related,
    orviane_current_slug: orviane_demo_slug
  %}

  {% assign faq_count = 0 %}
  {% for block in section.blocks %}
    {% if block.type == 'faq' %}
      {% assign faq_count = faq_count | plus: 1 %}
    {% endif %}
  {% endfor %}
  {% if faq_count > 0 %}
    <section class="gw-pdp-faq">
      <div
        class="gw-pdp-faq__bg"
        style="background: {{ section.settings.faq_background | default: '#e8e4df' }};"
        aria-hidden="true"
      >
        {% if section.settings.faq_image != blank %}
          {{
            section.settings.faq_image
            | image_url: width: 2400
            | image_tag:
              class: 'gw-pdp-faq__img',
              widths: '800, 1200, 1600, 2000, 2400',
              sizes: '100vw',
              alt: '',
              loading: 'lazy'
          }}
        {% elsif section.settings.faq_image_asset != blank %}
          <img
            class="gw-pdp-faq__img"
            src="{{ section.settings.faq_image_asset | asset_url }}"
            alt=""
            width="2400"
            height="1200"
            loading="lazy"
          >
        {% endif %}
        <div class="gw-pdp-faq__scrim"></div>
      </div>
      <div class="gw-pdp-faq__inner">
        {% if section.settings.faq_heading != blank %}
          <h2>{{ section.settings.faq_heading | escape }}</h2>
        {% endif %}
        <div class="gw-pdp-faq__list">
          {% for block in section.blocks %}
            {% if block.type == 'faq' %}
              <details class="gw-pdp-faq__item" {{ block.shopify_attributes }}>
                <summary class="gw-pdp-faq__summary">
                  <div class="gw-pdp-faq__summary-copy">
                    {% if block.settings.kicker != blank %}
                      <span class="gw-pdp-faq__kicker">{{ block.settings.kicker | escape }}</span>
                    {% endif %}
                    {% if block.settings.question != blank %}
                      <span class="gw-pdp-faq__q">{{ block.settings.question | escape }}</span>
                    {% endif %}
                  </div>
                  <span class="gw-pdp-faq__plus" aria-hidden="true">+</span>
                </summary>
                <div class="gw-pdp-faq__answer rte">{{ block.settings.answer }}</div>
              </details>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  <div class="gw-pdp-sticky" data-gw-sticky>
    <div class="gw-pdp-sticky__inner">
      <div class="gw-pdp-sticky__copy">
        <p class="gw-pdp-sticky__title">{{ gw_display_title | escape }}</p>
        <p class="gw-pdp-sticky__meta">
          <span class="gw-pdp__rating-stars">{% render 'gw-star-rating' %}</span>
          {{ section.settings.sticky_offer | escape }}
        </p>
      </div>
      <button
        type="submit"
        class="gw-pdp-sticky__btn"
        form="gw-pdp-form-{{ section.id }}"
        data-gw-sticky-atc
      >
        {{ section.settings.atc_label | default: 'Add to Bag' | escape }}
      </button>
    </div>
  </div>

  {% unless gw_is_purse_product or gw_is_perfume_product %}
  <dialog class="gw-pdp-size" data-gw-size-dialog aria-labelledby="gw-size-title-{{ section.id }}">
    <div class="gw-pdp-size__panel">
      <div class="gw-pdp-size__head">
        <h2 id="gw-size-title-{{ section.id }}">{{ section.settings.size_link_label | escape }}</h2>
        <button type="button" class="gw-pdp-size__close" data-gw-size-close aria-label="{{ 'girls_winter.product.close_size_guide' | t }}">×</button>
      </div>
      {% if section.settings.size_guide_body != blank %}
        <div class="rte">{{ section.settings.size_guide_body }}</div>
      {% else %}
        <p>US sizes 5–12. Between sizes? Size up for a roomier fit.</p>
        <div class="gw-pdp-size__table-wrap">
          <table>
            <thead>
              <tr><th>US</th><th>EU</th><th>Foot length</th></tr>
            </thead>
            <tbody>
              <tr><td>5</td><td>35</td><td>8.5"</td></tr>
              <tr><td>6</td><td>36</td><td>8.9"</td></tr>
              <tr><td>7</td><td>37</td><td>9.25"</td></tr>
              <tr><td>8</td><td>38</td><td>9.6"</td></tr>
              <tr><td>9</td><td>39</td><td>10"</td></tr>
              <tr><td>10</td><td>40</td><td>10.25"</td></tr>
              <tr><td>11</td><td>41</td><td>10.6"</td></tr>
              <tr><td>12</td><td>42</td><td>11"</td></tr>
            </tbody>
          </table>
        </div>
      {% endif %}
    </div>
  </dialog>
  {% endunless %}

  <script type="application/json" data-gw-product-json>
    {
      "id": {{ product.id }},
      "title": {{ gw_display_title | json }},
      "handle": {{ product.handle | json }},
      "is_purse_product": {% if orviane_demo_active %}false{% else %}{{ gw_is_purse_product | json }}{% endif %},
      "is_perfume_product": {% if orviane_demo_active %}true{% else %}{{ gw_is_perfume_product | json }}{% endif %},
      "orviane_cart_variant_id": {% if orviane_cart_variant_id != blank %}{{ orviane_cart_variant_id | plus: 0 }}{% else %}null{% endif %},
      "orviane_slug": {{ orviane_demo_slug | json }},
      "orviane_demo_asset": {{ orviane_demo_asset | json }},
      "featured_image": {{ hero_thumb_url | json }},
      "swatch_images": {
        {%- assign gw_swatch_first = true -%}
        {%- assign gw_swatch_done = false -%}
        {%- for option in product.options_with_values -%}
          {%- assign gw_opt_name = option.name | downcase -%}
          {%- if gw_opt_name == 'color' or gw_opt_name == 'colour' -%}
            {%- assign gw_swatch_done = true -%}
            {%- for color_name in option.values -%}
              {%- assign gw_color_down = color_name | downcase -%}
              {%- if gw_color_down == 'white' -%}{%- continue -%}{%- endif -%}
              {%- liquid
                assign gw_swatch_url = ''
                for variant in product.variants
                  if variant.featured_image != blank
                    if variant.option1 == color_name or variant.option2 == color_name or variant.option3 == color_name
                      assign gw_swatch_url = variant.featured_image | image_url: width: 320
                      break
                    endif
                  endif
                endfor
                if gw_swatch_url == ''
                  assign gw_swatch_asset = 'fw-swatch-' | append: product.handle | append: '-' | append: gw_color_down | append: '.jpg'
                  assign gw_swatch_url = gw_swatch_asset | asset_img_url: '320x'
                endif
              -%}
              {%- unless gw_swatch_first -%},{%- endunless -%}
              {{ color_name | json }}: {{ gw_swatch_url | json }}
              {%- assign gw_swatch_first = false -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
        {%- unless gw_swatch_done -%}
          {%- assign gw_swatch_colors = 'Black,Blush,Red,Burgundy,Camel,Espresso' | split: ',' -%}
          {%- for color_name in gw_swatch_colors -%}
            {%- liquid
              assign gw_swatch_url = ''
              assign gw_color_down = color_name | downcase
              for variant in product.variants
                if variant.featured_image != blank
                  if variant.option1 == color_name or variant.option2 == color_name or variant.option3 == color_name
                    assign gw_swatch_url = variant.featured_image | image_url: width: 320
                    break
                  endif
                endif
              endfor
              if gw_swatch_url == ''
                assign gw_swatch_asset = 'fw-swatch-' | append: product.handle | append: '-' | append: gw_color_down | append: '.jpg'
                assign gw_swatch_url = gw_swatch_asset | asset_img_url: '320x'
              endif
            -%}
            {%- unless gw_swatch_first -%},{%- endunless -%}
            {{ color_name | json }}: {{ gw_swatch_url | json }}
            {%- assign gw_swatch_first = false -%}
          {%- endfor -%}
        {%- endunless -%}
      },
      "gallery_image_urls": [
        {%- if orviane_use_asset_gallery and orviane_demo_asset != blank -%}
          {{ orviane_demo_asset | asset_img_url: '1600x' | json }}
        {%- elsif product.images.size > 0 -%}
          {%- for image in product.images -%}
            {{ image | image_url: width: 1600 | json }}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        {%- elsif orviane_demo_asset != blank -%}
          {{ orviane_demo_asset | asset_img_url: '1600x' | json }}
        {%- endif -%}
      ],
      "options": {{ product.options | json }},
      "options_with_values": [
        {% for option in product.options_with_values %}
          {
            "name": {{ option.name | json }},
            "values": {{ option.values | json }}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ],
      "variants": [
        {% for variant in product.variants %}
          {
            "id": {{ variant.id }},
            "available": {{ variant.available }},
            "option1": {{ variant.option1 | json }},
            "option2": {{ variant.option2 | json }},
            "option3": {{ variant.option3 | json }},
            "price": {{ variant.price }},
            "featured_image": {% if variant.featured_image %}{{ variant.featured_image | image_url: width: 240 | json }}{% else %}null{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ],
      "selected_or_first_available_variant": {
        "id": {{ current_variant.id }}
      }
    }
  </script>
</gw-product-bundle>

<script src="{{ 'orviane-demo-pdp.js' | asset_url }}" defer></script>
<script type="module" src="{{ 'gw-product-bundle.js' | asset_url }}"></script>

{% stylesheet %}
  .gw-product-section {
    padding-top: 30px;
    padding-bottom: 0;
    background: var(--gw-cream, #fdf8f5);
    color: var(--gw-charcoal, #3d2b2b);
    font-family: var(--gw-font-ui);
  }

  .gw-pdp {
    display: block;
    background: var(--gw-cream, #fdf8f5);
    color: var(--gw-charcoal, #3d2b2b);
    font-family: var(--gw-font-ui);
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    overflow-x: clip;
  }

  .gw-pdp__buy {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding: 8px clamp(16px, 4vw, 32px) 48px;
    box-sizing: border-box;
  }

  .gw-pdp__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(24px, 3.5vw, 56px);
    align-items: start;
  }

  .gw-pdp__media {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  @media screen and (min-width: 990px) {
    .gw-pdp__media {
      position: sticky;
      top: 96px;
    }
  }

  .gw-pdp__stage {
    position: relative;
    overflow: hidden;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }

  .gw-pdp__stage.is-dragging,
  .gw-pdp__stage.is-dragging .gw-pdp__swipe {
    cursor: grabbing;
  }

  .gw-pdp__swipe {
    position: absolute;
    inset: 0;
    z-index: 4;
    touch-action: pan-y;
    cursor: grab;
  }

  .gw-pdp__track {
    display: flex;
    align-items: flex-start;
    width: 100%;
    will-change: transform;
  }

  .gw-pdp__slide {
    flex: 0 0 100%;
    width: 100%;
    min-width: 0;
  }

  .gw-pdp__main-img,
  .gw-infographic__img {
    -webkit-user-drag: none;
    pointer-events: none;
  }

  .gw-infographic {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 18px;
    padding: 18px 26px 28px 18px;
    background: #f6efe6;
    border-radius: 22px;
    min-height: min(72vh, 760px);
  }

  .gw-infographic__photo {
    min-width: 0;
    border-radius: 16px;
    overflow: hidden;
    background: #efe6da;
  }

  .gw-infographic__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 12%;
  }

  .gw-pdp__main-media .gw-pdp__main-img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    max-height: none;
    aspect-ratio: auto;
    object-fit: cover;
    object-position: center center;
    background: #f3ece4;
  }

  .gw-pdp__main-media .gw-pdp__main-img--contain {
    object-fit: contain;
  }

  .gw-pdp__thumb-img {
    object-fit: contain;
  }

  .gw-pdp--purse .gw-pdp__main-media .gw-pdp__main-img,
  .gw-pdp--purse .gw-pdp__main-media .gw-pdp__main-img--contain {
    object-fit: cover;
    object-position: center center;
  }

  .gw-infographic__img {
    min-height: 100%;
    aspect-ratio: 3 / 4;
  }

  .gw-infographic__copy {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 8px 8px 8px 0;
    min-width: 0;
  }

  .gw-infographic__headline {
    margin: 0;
    font-family: var(--gw-font-heading);
    font-size: clamp(1.7rem, 2.6vw, 2.55rem);
    font-weight: 600;
    line-height: 1.05;
    color: #3d2a33;
  }

  .gw-infographic__headline em {
    display: block;
    font-style: italic;
    font-weight: 500;
    color: #8b5a4a;
  }

  .gw-infographic__sub {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.45;
    color: #4a3f3a;
  }

  .gw-infographic__card {
    background: #ffffff;
    border-radius: 14px;
    padding: 12px 14px;
    box-shadow: 0 8px 24px rgb(61 42 51 / 0.06);
  }

  .gw-infographic__card p {
    margin: 0 0 6px;
    font-size: 0.86rem;
    line-height: 1.4;
  }

  .gw-infographic__card p:last-child {
    margin-bottom: 0;
  }

  .gw-infographic__card-title {
    font-weight: 700;
    margin-bottom: 8px !important;
  }

  .gw-infographic__card--with {
    border: 2px solid #1a1a1a;
    box-shadow: 0 0 0 1px #1a1a1a;
  }

  .gw-infographic__x {
    color: #8a3a3a;
    font-weight: 700;
    margin-inline-end: 4px;
  }

  .gw-infographic__check {
    color: #3d6b4a;
    font-weight: 700;
    margin-inline-end: 4px;
  }

  .gw-pdp__main-media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    max-height: min(78vh, 820px);
    background: #f3ece4;
    border-radius: 22px;
    overflow: hidden;
  }

  .gw-pdp__thumbs-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .gw-pdp__thumbs {
    --gw-thumb-gap: 8px;
    display: flex;
    flex-wrap: nowrap;
    gap: var(--gw-thumb-gap);
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    flex: 1;
    min-width: 0;
    padding: 4px 0;
  }

  .gw-pdp__thumbs::-webkit-scrollbar {
    display: none;
  }

  .gw-pdp__thumb-nav {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border: 1px solid rgb(0 0 0 / 0.12);
    border-radius: 50%;
    background: #ffffff;
    color: #1c1412;
    font-size: 1.2rem;
    line-height: 1;
    cursor: pointer;
  }

  .gw-pdp__thumb-nav:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .gw-pdp__thumb {
    flex: 0 0 calc((100% - (6 * var(--gw-thumb-gap, 8px))) / 7);
    width: calc((100% - (6 * var(--gw-thumb-gap, 8px))) / 7);
    min-width: 0;
    aspect-ratio: 1;
    padding: 0;
    border: 1px solid rgb(0 0 0 / 0.12);
    background: #ffffff;
    cursor: pointer;
    border-radius: 10px;
    overflow: hidden;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease;
  }

  .gw-pdp__thumb.is-active {
    border: 1px solid #ff4d14;
    background: #ffffff;
    box-shadow: none;
  }

  .gw-pdp__thumb:hover:not(.is-active) {
    border-color: rgb(255 77 20 / 0.55);
  }

  .gw-pdp__thumb-frame {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 8px;
    overflow: hidden;
  }

  .gw-pdp__thumb-img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 8px;
  }

  .gw-pdp__main-media--size-guide .gw-pdp__main-img {
    filter: brightness(0.92);
  }

  .gw-pdp-gallery-size {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 16px 14px 18px;
    background: linear-gradient(180deg, rgb(255 255 255 / 0) 0%, rgb(255 255 255 / 0.55) 38%, rgb(255 255 255 / 0.96) 62%);
    pointer-events: none;
    color: #1c1412;
  }

  .gw-pdp-gallery-size__title {
    margin: 0 0 8px;
    font-family: var(--gw-font-heading);
    font-size: clamp(1.05rem, 2.2vw, 1.35rem);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .gw-pdp-gallery-size__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.72rem;
    line-height: 1.35;
    background: rgb(255 255 255 / 0.88);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 4px 16px rgb(28 20 18 / 0.08);
  }

  .gw-pdp-gallery-size__table th,
  .gw-pdp-gallery-size__table td {
    padding: 5px 6px;
    text-align: center;
    border-bottom: 1px solid rgb(0 0 0 / 0.06);
  }

  .gw-pdp-gallery-size__table th {
    font-weight: 700;
    background: rgb(28 20 18 / 0.06);
    font-size: 0.68rem;
  }

  .gw-pdp-gallery-size__table tr:last-child td {
    border-bottom: none;
  }

  .gw-pdp-gallery-size__tip {
    margin: 8px 0 0;
    font-size: 0.68rem;
    color: #5c524c;
    line-height: 1.35;
  }

  .gw-pdp-gallery-size--thumb {
    padding: 4px 3px 5px;
    background: linear-gradient(180deg, rgb(255 255 255 / 0) 0%, rgb(255 255 255 / 0.92) 45%);
  }

  .gw-pdp-gallery-size--thumb .gw-pdp-gallery-size__title {
    margin: 0 0 2px;
    font-size: 0.42rem;
    line-height: 1.1;
    text-align: center;
  }

  .gw-pdp-gallery-size--thumb .gw-pdp-gallery-size__table {
    font-size: 0.28rem;
    border-radius: 4px;
  }

  .gw-pdp-gallery-size--thumb .gw-pdp-gallery-size__table th,
  .gw-pdp-gallery-size--thumb .gw-pdp-gallery-size__table td {
    padding: 1px 2px;
  }

  .gw-pdp-gallery-size--thumb .gw-pdp-gallery-size__tip {
    display: none;
  }

  .gw-pdp__rating {
    margin: 0 0 10px;
    font-size: 0.84rem;
    color: #4a3f3a;
    font-family: var(--gw-font-ui);
  }

  .gw-pdp__rating-stars {
    display: inline-flex;
    align-items: center;
    margin-inline-end: 6px;
  }

  .gw-pdp__rating-stars .gw-stars {
    color: #ff4d14;
  }

  .gw-pdp h1,
  .gw-pdp h2,
  .gw-pdp h3,
  .gw-pdp__title,
  .gw-infographic__headline {
    text-transform: none;
  }

  .gw-pdp__title {
    margin: 0 0 18px;
    font-family: var(--gw-font-heading);
    font-size: clamp(1.85rem, 3vw, 2.55rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: #000000;
  }

  .gw-pdp__benefits {
    margin: 0 0 18px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .gw-pdp__benefit {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .gw-pdp__benefit-icon {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #000000;
    color: #ffffff;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .gw-pdp__benefit-icon svg {
    width: 18px;
    height: 18px;
  }

  .gw-pdp__benefit strong {
    display: block;
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.25;
    color: #000000;
  }

  .gw-pdp__benefit-text {
    display: block;
    font-size: 0.86rem;
    color: #000000;
    line-height: 1.4;
    margin-top: 2px;
  }

  .gw-pdp__urgency {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 18px;
    padding: 10px 16px;
    border-radius: 0 !important;
    background: #f8e4d8;
    font-size: 0.8rem;
    font-weight: 600;
    color: #8b3a32;
  }

  .gw-pdp__urgency-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #d24a3a;
    flex-shrink: 0;
    animation: gw-pdp-pulse 1.4s ease-in-out infinite;
  }

  @keyframes gw-pdp-pulse {
    0%,
    100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  .gw-pdp__offer-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin: 0 0 12px;
    padding-top: 6px;
    border-top: 1px solid rgb(0 0 0 / 0.08);
    scroll-margin-top: 110px;
  }

  .gw-pdp__offer-label {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 600;
    color: #000000;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .gw-pdp__size-link {
    border: 0;
    background: none;
    padding: 0;
    color: #000000;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    font-family: inherit;
    transition: color 0.2s ease;
  }

  .gw-pdp__size-link:hover,
  .gw-pdp__size-link:focus-visible {
    color: #000000;
    text-decoration: underline;
  }

  .gw-pdp__tiers {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 14px;
  }

  .gw-pdp__tier-wrap {
    position: relative;
    box-sizing: border-box;
    border: none;
    border-radius: 0;
    background: #ffffff;
    overflow: visible;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.14);
    transition: box-shadow 0.2s ease;
  }

  .gw-pdp__tier-wrap.is-expanded {
    box-shadow: 0 0 0 2px #ff4d14;
  }

  .gw-pdp__tier-ribbon {
    position: absolute;
    top: 0;
    right: 16px;
    transform: translateY(-50%);
    z-index: 2;
    padding: 5px 12px;
    border-radius: 0;
    background: #ff4d14;
    color: #ffffff;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .gw-pdp__tier-ribbon--dark {
    background: #2b2422;
  }

  .gw-pdp__tier-wrap:has(.gw-pdp__tier-ribbon) .gw-pdp__tier {
    padding-top: 18px;
  }

  .gw-pdp__tier {
    display: flex;
    gap: 12px;
    width: 100%;
    text-align: left;
    padding: 16px 18px;
    border: none;
    background: transparent;
    cursor: pointer;
    color: inherit;
    font: inherit;
  }

  .gw-pdp__tier-radio {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 2px solid #c5bbb4;
    margin-top: 3px;
    flex-shrink: 0;
    position: relative;
  }

  .gw-pdp__tier.is-selected .gw-pdp__tier-radio {
    border-color: #ff4d14;
  }

  .gw-pdp__tier.is-selected .gw-pdp__tier-radio::after {
    content: '';
    position: absolute;
    inset: 4px;
    border-radius: 50%;
    background: #ff4d14;
  }

  .gw-pdp__tier-body {
    flex: 1;
    min-width: 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }

  .gw-pdp__tier-main {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .gw-pdp__tier-title {
    font-size: 0.98rem;
    font-weight: 700;
  }

  .gw-pdp__tier-subtitle {
    font-size: 0.8rem;
    color: #000000;
    line-height: 1.35;
  }

  .gw-pdp__tier-per-unit {
    display: inline-block;
    margin-top: 4px;
    padding: 3px 8px;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.06);
    color: #000000;
    font-size: 0.68rem;
    font-weight: 600;
    width: fit-content;
  }

  .gw-pdp__tier-prices {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
    flex-shrink: 0;
    text-align: right;
  }

  .gw-pdp__tier-price {
    font-size: 1.12rem;
    font-weight: 700;
  }

  .gw-pdp__tier-prices s {
    font-size: 0.82rem;
    color: #8a7c74;
  }

  .gw-pdp__tier-panel {
    padding: 4px 16px 16px;
    border-top: 1px solid rgb(0 0 0 / 0.08);
    background: #ffffff;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
  }

  .gw-pdp__tier-panel[hidden] {
    display: none;
  }

  .gw-bundle__line {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    gap: 10px;
    align-items: start;
    padding: 12px 0 4px;
  }

  .gw-bundle__line-index {
    font-size: 0.78rem;
    font-weight: 700;
    color: #3d3530;
  }

  .gw-bundle__line-thumb {
    width: 44px;
    height: 56px;
    border-radius: 8px;
    overflow: hidden;
    background: #efe8df;
    border: 1px solid rgb(0 0 0 / 0.08);
  }

  .gw-bundle__line-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .gw-bundle__line-fields {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }

  .gw-bundle__field {
    display: block;
    flex: 1 1 100%;
    min-width: 0;
    position: relative;
  }

  .gw-swatch-picker__label,
  .gw-size-picker__label {
    margin: 0 0 8px;
    font-size: 0.88rem;
    font-weight: 600;
    color: #000000;
  }

  .gw-swatch-picker__row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .gw-swatch-picker__btn {
    width: 40px;
