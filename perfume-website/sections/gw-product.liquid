    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .gw-pdp-story__point {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 14px;
    align-items: start;
    padding-top: 14px;
    border-top: 1px solid rgb(0 0 0 / 0.08);
  }

  .gw-pdp-story__thumb {
    width: 72px;
    height: 72px;
    object-fit: cover;
    border-radius: 12px;
  }

  .gw-pdp-story__point-head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 4px;
  }

  .gw-pdp-story__point h3 {
    margin: 0;
    font-size: 1rem;
  }

  .gw-pdp-story__point-head span {
    font-size: 0.78rem;
    color: #8a7c74;
    white-space: nowrap;
  }

  .gw-pdp-story__point p {
    margin: 0;
    font-size: 0.88rem;
    color: #5c524c;
    line-height: 1.5;
  }

  .gw-pdp-reviews {
    padding: 32px 48px 48px 48px;
  }

  .gw-pdp-related {
    padding: clamp(48px, 6vw, 72px) clamp(16px, 4vw, 48px);
    border-top: 1px solid rgb(0 0 0 / 0.05);
  }

  .gw-pdp-related__inner {
    max-width: 1120px;
    margin-inline: auto;
  }

  .gw-pdp-related__heading {
    margin: 0 0 clamp(24px, 4vw, 36px);
    font-family: var(--gw-font-heading);
    font-size: clamp(1.65rem, 3vw, 2.25rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: #1c1412;
    text-align: left;
  }

  .gw-pdp-related__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(16px, 2.5vw, 28px);
    margin: 0;
    padding: 0;
