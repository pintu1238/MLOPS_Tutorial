    color: #000000;
    text-shadow: none;
  }

  .gw-pdp-reviews__verified-purchase {
    font-weight: 600;
    color: #ff4d14;
  }

  .gw-pdp-reviews__purchase-date {
    color: #000000;
    font-weight: 400;
  }

  .gw-pdp-reviews__shield {
    display: inline-flex;
    width: 13px;
    height: 13px;
    color: #ff4d14;
  }

  .gw-pdp-reviews__shield svg {
    width: 100%;
    height: 100%;
  }

  .gw-pdp-faq__inner h2 {
    margin: 0 0 20px;
    text-align: center;
    font-family: var(--gw-font-heading);
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    font-weight: 500;
    color: #ff4d14;
  }

  .gw-pdp-faq__list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: calc(920px + 100px);
    margin-inline: auto;
    padding: 0;
  }

  .gw-pdp-faq__item {
    background: #ffffff;
    border: 1px solid rgb(28 20 18 / 0.1);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 2px 10px rgb(28 20 18 / 0.04);
  }

  .gw-pdp-faq__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 12px 18px;
    cursor: pointer;
    list-style: none;
