    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: #ff4d14;
  }

  .gw-pdp-reviews__rated .gw-pdp__rating-stars .gw-stars {
    color: #ff4d14;
  }

  .gw-pdp-reviews__title-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 16px;
    position: relative;
  }

  .gw-pdp-reviews__title-row h2 {
    margin: 0;
    flex: 0 1 auto;
    min-width: 0;
    text-align: center;
    font-family: var(--gw-font-heading);
    font-size: clamp(2rem, 4.2vw, 3.1rem);
    line-height: 1.12;
    font-weight: 500;
    text-transform: none;
    color: #000000;
  }

  .gw-pdp-reviews__nav {
    display: none;
    flex-shrink: 0;
    gap: 6px;
  }

  .gw-pdp-reviews__nav button {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid #d9c8ba;
    background: #ffffff;
    color: #1a1a1a;
    cursor: pointer;
    line-height: 1;
    padding: 0;
  }

  .gw-pdp-reviews__nav button:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .gw-pdp-reviews__trust {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin: 0;
    padding: 0;
    font-size: 0.78rem;
    color: #000000;
  }

  .gw-pdp-reviews__trust li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .gw-pdp-reviews__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px 22px;
    margin: 0;
    padding: 0;
  }

  .gw-pdp-reviews__card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 100%;
    padding: 0;
    background: #ffffff;
    border: 1px solid rgb(0 0 0 / 0.1);
    border-radius: 12px;
    box-shadow: none;
    overflow: hidden;
  }

  .gw-pdp-reviews__media {
    position: relative;
    width: 100%;
    flex-shrink: 0;
    overflow: hidden;
    background: #efe8df;
  }

  .gw-pdp-reviews__media::before {
    content: '';
    display: block;
    width: 100%;
    padding-bottom: calc(100% + 10px);
  }

  .gw-pdp-reviews__img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
    margin: 0;
    background: #efe8df;
  }

  .gw-pdp-reviews__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 12px 14px 16px;
    min-width: 0;
  }

  .gw-pdp-reviews__card .gw-pdp__rating-stars {
    display: block;
    margin: 0 0 8px;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: #ff4d14;
  }

  .gw-pdp-reviews__card .gw-pdp__rating-stars .gw-stars {
    color: #ff4d14;
  }

  .gw-pdp-reviews__text {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.5;
    color: #000000;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }

  .gw-pdp-reviews__buyer {
