    background: #ff4d14;
    border-color: #ff4d14;
    box-shadow: none;
  }

  .gw-pdp-proof__inner {
    text-align: center;
  }

  .gw-pdp-proof__risk {
    margin: 12px 0 0;
    font-size: 0.86rem;
    color: #3d6b4a;
  }

  .gw-pdp-story {
    padding: 72px 4vw;
  }

  .gw-pdp-story__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }

  .gw-pdp-story__img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 20px;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .gw-pdp-story__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 16px;
  }

  .gw-pdp-story__pills span {
    padding: 6px 12px;
    border: 1px solid rgb(0 0 0 / 0.1);
    border-radius: 999px;
    font-size: 0.78rem;
