    transform: scale(1.03);
  }

  .gw-pdp-related__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(145deg, #ebe6df, #d9d2c8);
  }

  .gw-pdp-related__wish {
    position: absolute;
    top: 10px;
    right: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.92);
    color: #1c1412;
    cursor: pointer;
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.08);
  }

  .gw-pdp-related__wish:focus-visible {
    outline: 2px solid #9a7b4f;
    outline-offset: 2px;
  }

  .gw-icon--related-wish {
    width: 18px;
    height: 18px;
  }

  .gw-pdp-related__title {
    margin: 12px 0 6px;
    font-family: var(--font-body--family), var(--gw-font-ui);
    font-size: clamp(0.82rem, 1.6vw, 0.92rem);
    font-weight: 500;
    line-height: 1.35;
    color: #1c1412;
  }

  .gw-pdp-related__price {
    margin: 0;
    font-family: var(--font-body--family), var(--gw-font-ui);
    font-size: clamp(0.88rem, 1.7vw, 0.98rem);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #1c1412;
  }

  @media screen and (max-width: 989px) {
    .gw-pdp-related__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 549px) {
    .gw-pdp-related__grid {
      gap: 14px 12px;
    }

    .gw-pdp-related__wish {
      width: 32px;
      height: 32px;
    }
  }

  .gw-pdp-reviews__head {
    text-align: center;
    margin-bottom: 40px;
  }

  .gw-pdp-reviews__rated {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin: 0 0 14px;
    font-size: 0.82rem;
    color: #000000;
  }

