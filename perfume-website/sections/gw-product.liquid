    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px;
    margin-top: 12px;
    font-size: 0.8rem;
  }

  .gw-pdp-reviews__buyer-label {
    font-size: 0.68rem;
    color: #000000;
  }

  .gw-pdp-reviews__buyer strong {
    font-weight: 700;
    color: #000000;
  }

  .gw-pdp-reviews__verified {
    font-size: 0.78rem;
    font-weight: 600;
    color: #ff4d14;
    text-shadow: none;
  }

  .gw-pdp-reviews__purchase {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin: 6px 0 0;
