  .gw-pdp-faq__summary::-webkit-details-marker {
    display: none;
  }

  .gw-pdp-faq__summary-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    min-width: 0;
    flex: 1;
  }

  .gw-pdp-faq__kicker {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.06);
    font-family: var(--font-body--family), var(--gw-font-ui);
    font-size: 0.68rem;
    font-weight: 600;
    color: #000000;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    line-height: 1.2;
  }

  .gw-pdp-faq__q {
    font-family: var(--font-body--family), var(--gw-font-ui);
    font-size: clamp(0.95rem, 1.6vw, 1.05rem);
    font-weight: 500;
    line-height: 1.35;
    color: #000000;
  }

  .gw-pdp-faq__plus {
    flex-shrink: 0;
    align-self: center;
    font-size: 1.35rem;
    font-weight: 400;
    line-height: 1;
    color: #000000;
    transition: transform 0.2s ease;
