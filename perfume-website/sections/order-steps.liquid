<section class="section section--paper order-steps" id="{{ section.settings.anchor_id | default: 'order' | handleize }}">
  <div class="page-width">
    <div class="section-heading section-heading--split">
      <div>{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}<h2>{{ section.settings.heading | escape }}</h2></div>
      {% if section.settings.copy != blank %}<p class="section-heading__copy">{{ section.settings.copy | escape }}</p>{% endif %}
    </div>
    <div class="order-steps__grid">
      {% for block in section.blocks %}
        <article class="order-step" {{ block.shopify_attributes }}>
          <span class="order-step__number">0{{ forloop.index }}</span>
          <h3>{{ block.settings.heading | escape }}</h3>
          <p>{{ block.settings.copy | escape }}</p>
          {% if block.settings.link_label != blank %}<a class="text-link" href="{{ block.settings.link_url | default: routes.all_products_collection_url | escape }}">{{ block.settings.link_label | escape }} <span aria-hidden="true">→</span></a>{% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Order steps",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "order" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A little ritual" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Make the good part easy." },
    { "type": "textarea", "id": "copy", "label": "Copy", "default": "Pick a favourite, choose your moment, and we will take care of the warm bit." }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Choose your table" },
      { "type": "textarea", "id": "copy", "label": "Copy", "default": "Browse the menu and find the thing you have been thinking about." },
      { "type": "text", "id": "link_label", "label": "Link label", "default": "Browse menu" },
      { "type": "url", "id": "link_url", "label": "Link" }
    ] }
  ],
  "presets": [{ "name": "Order steps", "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }] }]
}
{% endschema %}
