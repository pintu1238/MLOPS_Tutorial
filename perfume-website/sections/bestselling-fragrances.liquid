{% comment %}
  Section contract.
  Homepage bestsellers grid in the Villain card layout, using ORVIANE theme images only.
  @example
  Homepage section "bestsellers" with heading BESTSELLERS.
{% endcomment %}
{% liquid
  assign section_anchor = section.settings.anchor_id | default: '' | strip
  if section_anchor == blank
    assign section_anchor = 'orv-products-' | append: section.id
  endif
  assign row_modifier = ''
  if section.settings.limit >= 6
    assign row_modifier = ' orv-best--six'
  endif
%}
<section
  id="{{ section_anchor | escape }}"
  class="noire-collection-villain orv-best noire-reveal{{ row_modifier }}"
  data-section-id="{{ section.id }}"
>
  <div class="noire-collection-villain__inner">
    {% if section.settings.heading != blank %}
      <header class="noire-collection-villain__head">
        <h2>{{ section.settings.heading | escape }}</h2>
      </header>
    {% endif %}
    <div class="noire-collection-villain__grid" role="list">
      {% if section.settings.products != blank %}
        {% for product in section.settings.products limit: section.settings.limit %}
          {% render 'noire-villain-product-card', product: product, card_index: forloop.index0, show_discount_badge: false %}
        {% endfor %}
      {% elsif section.settings.collection != blank and section.settings.collection.products_count > 0 %}
        {% for product in section.settings.collection.products limit: section.settings.limit %}
          {% render 'noire-villain-product-card', product: product, card_index: forloop.index0, show_discount_badge: false %}
        {% endfor %}
      {% else %}
        {% liquid
          assign demo_titles = 'Orviane Noir Oud Eau De Parfum 100ml§Orviane Saffron Gold Eau De Parfum 100ml§Orviane Velvet Rose Eau De Parfum 100ml§Orviane Midnight Musk Eau De Parfum 100ml§Orviane Citrus Veil Eau De Parfum 100ml§Orviane Amber Night Eau De Parfum 100ml§Orviane White Tea Eau De Parfum 50ml§Orviane Discovery Set — 5 x 8ml§Orviane Obsidian Iris Eau De Parfum 100ml§Orviane Golden Dusk Eau De Parfum 100ml§Orviane Silk Jasmine Eau De Parfum 100ml§Orviane Velvet Incense Eau De Parfum 100ml' | split: '§'
          assign demo_prices = '8900§7900§7500§6900§6500§8500§4900§5900§8200§7800§7200§7600' | split: '§'
          assign demo_compares = '14900§13900§12900§11900§10900§14900§7900§9900§13900§12900§11900§12500' | split: '§'
          assign demo_tags = 'Night,Oud,Warm§Rich,Spicy,Evening§Floral,Soft,Date§Dark,Musk,Daily§Fresh,Citrus,Day§Amber,Warm,Party§Clean,Light,Soft§Gift,Trial,Layer§Dark,Floral,Evening§Warm,Gold,Sunset§Floral,Soft,Day§Smoky,Incense,Night' | split: '§'
          assign demo_ratings = '4.8§4.7§4.7§4.6§4.6§4.8§4.5§4.7§4.8§4.7§4.6§4.7' | split: '§'
          assign demo_reviews = '58§71§64§51§45§88§42§97§63§59§48§55' | split: '§'
          assign demo_assets = 'orviane-best-noir-oud.jpg,orviane-best-saffron-gold.jpg,orviane-best-velvet-rose.jpg,orviane-best-midnight-musk.jpg,orviane-best-citrus-veil.jpg,orviane-best-amber-night.jpg,orviane-best-white-tea.jpg,orviane-best-discovery.jpg,orviane-new-obsidian-iris.jpg,orviane-new-golden-dusk.jpg,orviane-new-silk-jasmine.jpg,orviane-new-velvet-incense.jpg' | split: ','
          assign demo_slugs = 'noir-oud,saffron-gold,velvet-rose,midnight-musk,citrus-veil,amber-night,white-tea,discovery-set,obsidian-iris,golden-dusk,silk-jasmine,velvet-incense' | split: ','
          assign demo_offset = section.settings.demo_offset | default: 0 | plus: 0
        %}
        {% for title in demo_titles offset: demo_offset limit: section.settings.limit %}
          {% assign idx = forloop.index0 | plus: demo_offset %}
          {% render 'noire-villain-product-card',
            card_index: idx,
            catalog: collections.all,
            demo_title: demo_titles[idx],
            demo_price_cents: demo_prices[idx],
            demo_compare_cents: demo_compares[idx],
            demo_tags: demo_tags[idx],
            demo_rating: demo_ratings[idx],
            demo_reviews: demo_reviews[idx],
            demo_asset: demo_assets[idx],
            demo_slug: demo_slugs[idx],
            show_discount_badge: false
          %}
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ORVIANE Bestsellers",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "BESTSELLERS" },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Section HTML id",
      "info": "Optional. Use bestsellers for the primary row."
    },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "product_list", "id": "products", "label": "Featured products", "limit": 12 },
    {
      "type": "range",
      "id": "demo_offset",
      "label": "Demo catalog start position",
      "min": 0,
      "max": 8,
      "step": 1,
      "default": 0,
      "info": "Skip this many demo perfumes (use 4 below the main bestsellers row)."
    },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 4, "max": 12, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "ORVIANE Bestsellers" }]
}
{% endschema %}
