<section class="sk-wedding-banner" aria-label="{{ section.settings.heading | escape }}">
  <h1 class="sk-wedding-visually-hidden">{{ section.settings.heading }}</h1>
  <img src="{{ section.settings.image_url | escape }}" alt="{{ section.settings.heading | escape }} — Bringing Sweetness to Every Celebration" width="1440" height="760" fetchpriority="high">
</section>
{% stylesheet %}
.sk-wedding-banner{position:relative;width:100%;background:#dfb649;overflow:hidden}
.sk-wedding-banner img{display:block;width:100%;height:clamp(300px,27vw,740px);object-fit:cover;object-position:center}
.sk-wedding-visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
@media(max-width:749px){.sk-wedding-banner img{height:auto;min-height:0;object-fit:contain}}
{% endstylesheet %}
{% schema %}
{"name":"Wedding banner","settings":[{"type":"text","id":"heading","label":"Heading","default":"Crafting Sweet Memories for Wedding Celebrations"},{"type":"url","id":"image_url","label":"Banner image URL"}],"presets":[{"name":"Wedding banner"}]}
{% endschema %}