<section class="noire-scents noire-reveal" data-section-id="{{ section.id }}">
  <div class="noire-page-width">
    <div class="noire-section-head">
      <div>
        {% if section.settings.eyebrow != blank %}<p class="noire-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        <h2>{{ section.settings.heading | escape }}</h2>
        {% if section.settings.text != blank %}<p>{{ section.settings.text | escape }}</p>{% endif %}
      </div>
    </div>
    <div class="noire-scents__grid">
      {% for block in section.blocks %}
        <a class="noire-scent-tile" href="{{ block.settings.link | default: routes.all_products_collection_url | escape }}" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.title | escape }}
          {% endif %}
          <span>{{ block.settings.title | escape }}</span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

<section class="noire-finder noire-reveal">
  <div class="noire-page-width">
    <div class="noire-finder__panel">
      <h3>{{ section.settings.finder_heading | escape }}</h3>
      <p>{{ section.settings.finder_text | escape }}</p>
      <form
        class="noire-finder__steps"
        data-noire-finder
        data-collection-url="{% if section.settings.collection != blank %}{{ section.settings.collection.url | escape }}{% else %}{{ routes.all_products_collection_url | escape }}{% endif %}"
        data-result-label="{{ section.settings.result_label | escape }}"
      >
        <div>
          <label for="scent-family-{{ section.id }}">{{ section.settings.family_label | escape }}</label>
          <select id="scent-family-{{ section.id }}" name="scent_family">
            <option value="">{{ section.settings.any_label | escape }}</option>
            <option value="woody">Woody</option>
            <option value="amber">Amber</option>
            <option value="fresh">Fresh &amp; Citrus</option>
            <option value="floral">Floral</option>
            <option value="spicy">Spicy</option>
            <option value="musk">Musk</option>
          </select>
        </div>
        <div>
          <label for="warmth-{{ section.id }}">{{ section.settings.warmth_label | escape }}</label>
          <select id="warmth-{{ section.id }}" name="warmth">
            <option value="">{{ section.settings.any_label | escape }}</option>
            <option value="fresh">Fresh</option>
            <option value="warm">Warm</option>
          </select>
        </div>
        <div>
          <label for="occasion-{{ section.id }}">{{ section.settings.occasion_label | escape }}</label>
          <select id="occasion-{{ section.id }}" name="occasion">
            <option value="">{{ section.settings.any_label | escape }}</option>
            <option value="day">Day</option>
            <option value="evening">Evening</option>
            <option value="special">Special occasion</option>
          </select>
        </div>
        <div>
          <label for="intensity-{{ section.id }}">{{ section.settings.intensity_label | escape }}</label>
          <select id="intensity-{{ section.id }}" name="intensity">
            <option value="">{{ section.settings.any_label | escape }}</option>
            <option value="light">Light</option>
            <option value="moderate">Moderate</option>
            <option value="intense">Intense</option>
          </select>
        </div>
        <button type="submit" class="noire-btn noire-btn--primary">{{ section.settings.submit_label | escape }}</button>
        <div class="noire-finder__result" data-noire-finder-result hidden>
          <a class="noire-btn noire-btn--outline" href="{{ routes.all_products_collection_url | escape }}" data-noire-finder-link>{{ section.settings.result_label | escape }}</a>
          <p class="noire-product-card__meta">{{ section.settings.tag_note | escape }}</p>
        </div>
      </form>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "NOIRÉ Fragrance finder",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Explore" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Discover by Scent Family" },
    { "type": "textarea", "id": "text", "label": "Supporting text", "default": "Browse expressive compositions grouped by character and mood." },
    { "type": "text", "id": "finder_heading", "label": "Finder heading", "default": "Find Your Fragrance" },
    { "type": "textarea", "id": "finder_text", "label": "Finder text", "default": "Answer a few preferences to browse fragrances tagged in Shopify Admin." },
    { "type": "collection", "id": "collection", "label": "Base collection for results" },
    { "type": "text", "id": "family_label", "label": "Family label", "default": "Scent family" },
    { "type": "text", "id": "warmth_label", "label": "Warmth label", "default": "Fresh or warm" },
    { "type": "text", "id": "occasion_label", "label": "Occasion label", "default": "Occasion" },
    { "type": "text", "id": "intensity_label", "label": "Intensity label", "default": "Intensity" },
    { "type": "text", "id": "any_label", "label": "Any option label", "default": "Any" },
    { "type": "text", "id": "submit_label", "label": "Submit label", "default": "See recommendations" },
    { "type": "text", "id": "result_label", "label": "Result link label", "default": "View matching fragrances" },
    { "type": "text", "id": "tag_note", "label": "Tag note", "default": "Results use product tags (e.g. woody, floral). Tag products in Admin for accurate matches." }
  ],
  "blocks": [
    {
      "type": "family",
      "name": "Scent family",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Woody" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "NOIRÉ Fragrance finder",
      "blocks": [
        { "type": "family", "settings": { "title": "Woody" } },
        { "type": "family", "settings": { "title": "Amber" } },
        { "type": "family", "settings": { "title": "Fresh & Citrus" } },
        { "type": "family", "settings": { "title": "Floral" } },
        { "type": "family", "settings": { "title": "Spicy" } },
        { "type": "family", "settings": { "title": "Musk" } }
      ]
    }
  ]
}
{% endschema %}
