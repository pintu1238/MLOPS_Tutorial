<section class="sk-festival-banner" aria-labelledby="FestivalHeading-{{ section.id }}">
  <h1 class="sk-festival-banner__heading" id="FestivalHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h1>
  {% if section.settings.image != blank %}
    {{ section.settings.image | image_url: width: 2400 | image_tag: widths: '480, 750, 1100, 1500, 2000, 2400', sizes: '100vw', fetchpriority: 'high', alt: section.settings.heading }}
  {% else %}
    <img src="{{ section.settings.image_url | escape }}" alt="{{ section.settings.heading | escape }}" width="1440" height="760" fetchpriority="high">
  {% endif %}
</section>
{% stylesheet %}
.sk-festival-banner{position:relative;width:100%;overflow:hidden;background:#e9bd7d}
.sk-festival-banner img{display:block;width:100%;height:clamp(300px,27vw,740px);object-fit:cover;object-position:center top}
.sk-festival-banner__heading{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
@media(max-width:749px){.sk-festival-banner img{height:auto;min-height:0;object-fit:contain}}
{% endstylesheet %}
{% schema %}
{
  "name":"Festival banner",
  "settings":[
    {"type":"text","id":"heading","label":"Accessible heading","default":"Tasty Tales of Kolkata — Sweet Legacy of Kolkata"},
    {"type":"image_picker","id":"image","label":"Banner image"},
    {"type":"url","id":"image_url","label":"Reference image URL"}
  ],
  "presets":[{"name":"Festival banner"}]
}
{% endschema %}