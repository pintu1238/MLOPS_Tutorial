<!-- sections/pookie-reviews.liquid -->
<div class="pookie-reviews-section" id="PookieReviews-{{ section.id }}">
  <h2 class="pookie-reviews-title">{{ section.settings.title | default: 'What They Said After the First Week' }}</h2>

  <div class="pookie-reviews-grid">
    <!-- Card 1: Jenna K. -->
    <div class="pookie-review-card">
      <div class="pookie-review-img-wrap">
        <img
          src="https://thepookiewear.com/cdn/shop/files/t1-laptop-nap.png?v=1789577377&width=1420"
          class="pookie-review-img"
          alt="Jenna K. baby wearing review"
          loading="lazy"
        >
        <div class="pookie-review-quote-bubble">
          <svg viewBox="0 0 512 512" width="16" height="16" fill="white">
            <path d="M119.472 66.59C53.489 66.59 0 120.094 0 186.1c0 65.983 53.489 119.487 119.472 119.487c0 0-0.578 44.392-36.642 108.284c-4.006 12.802 3.135 26.435 15.945 30.418c9.089 2.859 18.653 0.08 24.829-6.389c82.925-90.7 115.385-197.448 115.385-251.8C238.989 120.094 185.501 66.59 119.472 66.59zM392.482 66.59c-65.983 0-119.472 53.505-119.472 119.51c0 65.983 53.489 119.487 119.472 119.487c0 0-0.578 44.392-36.642 108.284c-4.006 12.802 3.136 26.435 15.945 30.418c9.089 2.859 18.653 0.08 24.828-6.389C479.539 347.2 512 240.452 512 186.1C512 120.094 458.511 66.59 392.482 66.59z"/>
          </svg>
        </div>
      </div>
      <div class="pookie-review-body">
        <div class="pookie-review-stars">★★★★★</div>
        <h3 class="pookie-review-headline">She naps on me and I finally get my hands back</h3>
        <p class="pookie-review-text">My daughter only naps on me. Now she naps in the hoodie while I answer emails at the kitchen table. Unzip, in, zip — she's out in ten minutes and I actually get things done.</p>
        <div class="pookie-review-author">Jenna K. — Charlotte, NC</div>
      </div>
    </div>

    <!-- Card 2: Ryan T. -->
    <div class="pookie-review-card">
      <div class="pookie-review-img-wrap">
        <img
          src="https://thepookiewear.com/cdn/shop/files/t2-selfie.png?v=1789661833&width=1420"
          class="pookie-review-img"
          alt="Ryan T. baby wearing review"
          loading="lazy"
        >
        <div class="pookie-review-quote-bubble">
          <svg viewBox="0 0 512 512" width="16" height="16" fill="white">
            <path d="M119.472 66.59C53.489 66.59 0 120.094 0 186.1c0 65.983 53.489 119.487 119.472 119.487c0 0-0.578 44.392-36.642 108.284c-4.006 12.802 3.135 26.435 15.945 30.418c9.089 2.859 18.653 0.08 24.829-6.389c82.925-90.7 115.385-197.448 115.385-251.8C238.989 120.094 185.501 66.59 119.472 66.59zM392.482 66.59c-65.983 0-119.472 53.505-119.472 119.51c0 65.983 53.489 119.487 119.472 119.487c0 0-0.578 44.392-36.642 108.284c-4.006 12.802 3.136 26.435 15.945 30.418c9.089 2.859 18.653 0.08 24.828-6.389C479.539 347.2 512 240.452 512 186.1C512 120.094 458.511 66.59 392.482 66.59z"/>
          </svg>
        </div>
      </div>
      <div class="pookie-review-body">
        <div class="pookie-review-stars">★★★★★</div>
        <h3 class="pookie-review-headline">Bought it for my wife, now she won't take it off</h3>
        <p class="pookie-review-text">Our son was five months old when I ordered it. She wears it every evening while she folds the laundry, and he just hangs out on her chest watching everything. Best money I've spent since he was born.</p>
        <div class="pookie-review-author">Ryan T. — Columbus, OH</div>
      </div>
    </div>

    <!-- Card 3: Dennis W. -->
    <div class="pookie-review-card">
      <div class="pookie-review-img-wrap">
        <img
          src="https://thepookiewear.com/cdn/shop/files/t3-window-camera.png?v=1789662419&width=1420"
          class="pookie-review-img"
          alt="Dennis W. baby wearing review"
          loading="lazy"
        >
        <div class="pookie-review-quote-bubble">
          <svg viewBox="0 0 512 512" width="16" height="16" fill="white">
            <path d="M119.472 66.59C53.489 66.59 0 120.094 0 186.1c0 65.983 53.489 119.487 119.472 119.487c0 0-0.578 44.392-36.642 108.284c-4.006 12.802 3.135 26.435 15.945 30.418c9.089 2.859 18.653 0.08 24.829-6.389c82.925-90.7 115.385-197.448 115.385-251.8C238.989 120.094 185.501 66.59 119.472 66.59zM392.482 66.59c-65.983 0-119.472 53.505-119.472 119.51c0 65.983 53.489 119.487 119.472 119.487c0 0-0.578 44.392-36.642 108.284c-4.006 12.802 3.136 26.435 15.945 30.418c9.089 2.859 18.653 0.08 24.828-6.389C479.539 347.2 512 240.452 512 186.1C512 120.094 458.511 66.59 392.482 66.59z"/>
          </svg>
        </div>
      </div>
      <div class="pookie-review-body">
        <div class="pookie-review-stars">★★★★★</div>
        <h3 class="pookie-review-headline">My daughter sent me the photo and I framed it</h3>
        <p class="pookie-review-text">Bought it for my daughter after my first grandson was born. A few months later she sent me a picture of the two of them at the window, watching the first snow. It's in a frame on my desk now.</p>
        <div class="pookie-review-author">Dennis W. — Tulsa, OK</div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Pookie Reviews",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "What They Said After the First Week"
    }
  ],
  "presets": [
    {
      "name": "Pookie Reviews"
    }
  ]
}
{% endschema %}
