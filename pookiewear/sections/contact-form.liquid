{% if page.handle == 'contact' or section.settings.render_on_all_pages %}
  <section class="contact-form" data-section-id="{{ section.id }}">
    <div class="contact-form__panel">
      <h1>{{ section.settings.heading | default: 'Get in touch' }}</h1>
      {% if section.settings.body != blank %}<p class="contact-form__desc">{{ section.settings.body }}</p>{% endif %}
      {% capture contact_form_id %}ContactForm-{{ section.id }}{% endcapture %}
      {% form 'contact', id: contact_form_id %}
        {% render 'form-status', form: form, success_message: 'forms.success' %}
        <div class="contact-form__fields">
          <div>
            <label class="visually-hidden" for="ContactName-{{ section.id }}">Name</label>
            <input id="ContactName-{{ section.id }}" type="text" name="contact[name]" autocomplete="name" placeholder="Name" required>
          </div>
          <div>
            <label class="visually-hidden" for="ContactEmail-{{ section.id }}">Email *</label>
            <input id="ContactEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" placeholder="Email *" required>
          </div>
          <div class="contact-form__wide">
            <label class="visually-hidden" for="ContactPhone-{{ section.id }}">Phone number</label>
            <input id="ContactPhone-{{ section.id }}" type="tel" name="contact[phone]" autocomplete="tel" placeholder="Phone number">
          </div>
          <div class="contact-form__wide">
            <label class="visually-hidden" for="ContactMessage-{{ section.id }}">Comment</label>
            <textarea id="ContactMessage-{{ section.id }}" name="contact[body]" rows="5" placeholder="Comment" required></textarea>
          </div>
        </div>
        <button type="submit" class="contact-form__submit-btn">Send</button>
      {% endform %}
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .contact-form { max-width: 800px; margin: 0 auto; padding: 50px 20px 80px; }
  .contact-form__panel { width: 100%; }
  .contact-form h1 { text-align: center; margin: 0 0 32px; font-size: 38px; font-weight: 800; color: #111; letter-spacing: -0.5px; }
  .contact-form__desc { text-align: center; color: #666; margin: -16px 0 24px; font-size: 15px; }
  .contact-form form { display: flex; flex-direction: column; gap: 18px; }
  .contact-form__fields { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .contact-form__wide { grid-column: 1 / -1; }
  .contact-form input, .contact-form textarea {
    width: 100%;
    border: 1px solid #c9c9c9;
    border-radius: 8px;
    padding: 13px 16px;
    font-size: 15px;
    font-family: inherit;
    color: #333;
    background: #fff;
    outline: none;
    transition: border-color 0.2s;
  }
  .contact-form input:focus, .contact-form textarea:focus {
    border-color: #bc7c3e;
  }
  .contact-form__submit-btn {
    width: 100%;
    background-color: #bc7c3e;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 14px 24px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.2s;
  }
  .contact-form__submit-btn:hover {
    background-color: #a76b32;
  }
  @media(max-width: 600px) {
    .contact-form { padding: 32px 16px 60px; }
    .contact-form h1 { font-size: 30px; margin-bottom: 24px; }
    .contact-form__fields { grid-template-columns: 1fr; gap: 12px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get in touch" },
    { "type": "textarea", "id": "body", "label": "Body" },
    { "type": "checkbox", "id": "render_on_all_pages", "label": "Render on every page", "default": false }
  ],
  "presets": [
    { "name": "Contact form" }
  ]
}
{% endschema %}
