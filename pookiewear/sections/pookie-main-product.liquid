<!-- sections/pookie-main-product.liquid -->
<div class="pookie-main-product-section" id="PookieProduct-{{ section.id }}">
  <div class="pookie-product-grid">

    <!-- ==================== LEFT COLUMN: GALLERY ==================== -->
    <div class="pookie-gallery">
      <div class="pookie-gallery-main">
        <img
          id="pookie-main-image"
          src="https://thepookiewear.com/cdn/shop/files/01-main-white_c64b1d83-69ec-47f7-a2e1-03d89d8845a7.png?v=1789668683&width=1946"
          alt="Pookie Hoodie — babywearing sherpa hoodie"
          loading="eager"
        >
      </div>

      <div class="pookie-gallery-thumbs-wrapper">
        <button type="button" class="pookie-gallery-nav pookie-gallery-nav-prev" id="pookie-gallery-prev" aria-label="Previous image">‹</button>
        <div class="pookie-gallery-thumbs" id="pookie-gallery-thumbs-track">
          <div class="pookie-gallery-thumb is-active" data-full-src="https://thepookiewear.com/cdn/shop/files/01-main-white_c64b1d83-69ec-47f7-a2e1-03d89d8845a7.png?v=1789668683&width=1946">
            <img src="https://thepookiewear.com/cdn/shop/files/01-main-white_c64b1d83-69ec-47f7-a2e1-03d89d8845a7.png?v=1789668683&width=160" alt="Cream Pookie Hoodie front view">
          </div>
          <div class="pookie-gallery-thumb" data-full-src="https://thepookiewear.com/cdn/shop/files/hf_20260919_000903_4a793c9f-1927-4e4e-81a2-4680f06db150.png?v=1789776709&width=1946">
            <img src="https://thepookiewear.com/cdn/shop/files/hf_20260919_000903_4a793c9f-1927-4e4e-81a2-4680f06db150.png?v=1789776709&width=160" alt="Hands free babywearing info">
          </div>
          <div class="pookie-gallery-thumb" data-full-src="https://thepookiewear.com/cdn/shop/files/hf_20260919_001029_16dfebf9-bb7c-4f05-8df3-1e762efa0af2.png?v=1789776708&width=1946">
            <img src="https://thepookiewear.com/cdn/shop/files/hf_20260919_001029_16dfebf9-bb7c-4f05-8df3-1e762efa0af2.png?v=1789776708&width=160" alt="Made to fit you both diagram">
          </div>
          <div class="pookie-gallery-thumb" data-full-src="https://thepookiewear.com/cdn/shop/files/hf_20260919_000856_b1116b3d-b92c-4af7-ad45-ec2e29756e6f.png?v=1789776709&width=1946">
            <img src="https://thepookiewear.com/cdn/shop/files/hf_20260919_000856_b1116b3d-b92c-4af7-ad45-ec2e29756e6f.png?v=1789776709&width=160" alt="Carrier seat and back straps">
          </div>
          <div class="pookie-gallery-thumb" data-full-src="https://thepookiewear.com/cdn/shop/files/hf_20260919_124448_91ce7a24-a8d4-4328-a54f-62d9651d293b.png?v=1789821945&width=1946">
            <img src="https://thepookiewear.com/cdn/shop/files/hf_20260919_124448_91ce7a24-a8d4-4328-a54f-62d9651d293b.png?v=1789821945&width=160" alt="Size chart infographic">
          </div>
          <div class="pookie-gallery-thumb" data-full-src="https://thepookiewear.com/cdn/shop/files/hf_20260919_000916_9d1c6e2f-df59-4f06-a869-f3c06d284dae.png?v=1789776706&width=1946">
            <img src="https://thepookiewear.com/cdn/shop/files/hf_20260919_000916_9d1c6e2f-df59-4f06-a869-f3c06d284dae.png?v=1789776706&width=160" alt="Lifestyle indoor cuddle">
          </div>
          <div class="pookie-gallery-thumb" data-full-src="https://thepookiewear.com/cdn/shop/files/hf_20260919_001039_c4c7de6f-ce3a-4d58-ad65-c5d4adeee04f.png?v=1789776703&width=1946">
            <img src="https://thepookiewear.com/cdn/shop/files/hf_20260919_001039_c4c7de6f-ce3a-4d58-ad65-c5d4adeee04f.png?v=1789776703&width=160" alt="Baby smiling in carrier seat">
          </div>
          <div class="pookie-gallery-thumb" data-full-src="https://thepookiewear.com/cdn/shop/files/hf_20260917_180142_c1a772d9-3adc-4018-9d30-0417a90d671c_1.png?v=1789668905&width=1946">
            <img src="https://thepookiewear.com/cdn/shop/files/hf_20260917_180142_c1a772d9-3adc-4018-9d30-0417a90d671c_1.png?v=1789668905&width=160" alt="Rose Pink color model">
          </div>
          <div class="pookie-gallery-thumb" data-full-src="https://thepookiewear.com/cdn/shop/files/hf_20260917_151918_ca38ed71-295a-415c-a57d-df0952d52043_2.png?v=1789668907&width=1946">
            <img src="https://thepookiewear.com/cdn/shop/files/hf_20260917_151918_ca38ed71-295a-415c-a57d-df0952d52043_2.png?v=1789668907&width=160" alt="Cream sherpa outdoor stroll">
          </div>
          <div class="pookie-gallery-thumb" data-full-src="https://thepookiewear.com/cdn/shop/files/hf_20260917_175802_6da7b4d6-582a-4a51-b0db-5cd9a7ce87ea.png?v=1789668906&width=1946">
            <img src="https://thepookiewear.com/cdn/shop/files/hf_20260917_175802_6da7b4d6-582a-4a51-b0db-5cd9a7ce87ea.png?v=1789668906&width=160" alt="Caramel brown model view">
          </div>
        </div>
        <button type="button" class="pookie-gallery-nav pookie-gallery-nav-next" id="pookie-gallery-next" aria-label="Next image">›</button>
      </div>
    </div>

    <!-- ==================== RIGHT COLUMN: BUY BOX ==================== -->
    <div class="pookie-product-info">
      <!-- Scarcity Badge -->
      <div class="pookie-badge-stock">HOT PRODUCT | LOW STOCK</div>

      <!-- Title -->
      <h1 class="pookie-product-title">{{ section.settings.product_title | default: 'Pookie Hoodie' }}</h1>

      <!-- Star Ratings -->
      <div class="pookie-stars-row">
        <span class="pookie-stars">★★★★★</span>
        <span class="pookie-review-count">(1131 Reviews)</span>
      </div>

      <!-- Price -->
      <div class="pookie-price-wrap">
        <span class="pookie-price-current">Rs. 5,900.00</span>
        <span class="pookie-price-compare">Rs. 11,800.00</span>
        <span class="pookie-discount-pill">🏷️ SAVE 50%</span>
      </div>

      <!-- Highlights -->
      <ul class="pookie-bullet-points">
        <li class="pookie-bullet-item">
          <span>🤱</span>
          <span>Baby on your chest, hands free</span>
        </li>
        <li class="pookie-bullet-item">
          <span>🧸</span>
          <span>One cozy hug for the two of you</span>
        </li>
        <li class="pookie-bullet-item">
          <span>🪑</span>
          <span>A hidden seat does the carrying</span>
        </li>
      </ul>

      <!-- Size Selector -->
      <div class="pookie-variant-group">
        <div class="pookie-variant-header">
          <span>Size - <strong id="pookie-selected-size-label">S</strong></span>
          <button type="button" class="pookie-size-chart-btn" id="pookie-open-size-chart">
            📐 Size chart
          </button>
        </div>
        <div class="pookie-size-pills">
          <div class="pookie-size-pill is-selected" data-size="S">S</div>
          <div class="pookie-size-pill" data-size="M">M</div>
          <div class="pookie-size-pill" data-size="L">L</div>
          <div class="pookie-size-pill" data-size="XL">XL</div>
          <div class="pookie-size-pill" data-size="XXL">XXL</div>
        </div>
      </div>

      <!-- Color Selector -->
      <div class="pookie-variant-group">
        <div class="pookie-variant-header">
          <span>Color - <strong id="pookie-selected-color-label">Cream</strong></span>
        </div>
        <select class="pookie-color-select" id="pookie-color-select" aria-label="Color selector">
          <option value="Cream" selected>Cream</option>
          <option value="Rose">Rose</option>
          <option value="Caramel">Caramel</option>
        </select>
      </div>

      <!-- Bundle & Save Section -->
      <div class="pookie-bundle-container">
        <div class="pookie-bundle-header">BUNDLE & SAVE</div>

        <!-- Tier 1: One Hoodie -->
        {% render 'pookie-bundle-card',
          tier_id: '1',
          title: 'One Hoodie',
          subtitle: 'Choose from 3 colors',
          price: 'Rs. 5,900.00',
          compare_price: 'Rs. 11,800.00',
          is_selected: false,
          item_count: 1
        %}

        <!-- Tier 2: Two Hoodies (Most Popular) -->
        {% render 'pookie-bundle-card',
          tier_id: '2',
          badge: 'Most Popular ✨',
          title: 'Two Hoodies',
          savings: 'SAVE Rs. 12,980.00',
          subtitle: 'Buy one, gift the other — save 55%',
          price: 'Rs. 10,620.00',
          compare_price: 'Rs. 23,600.00',
          is_selected: true,
          item_count: 2
        %}

        <!-- Tier 3: Three Hoodies -->
        {% render 'pookie-bundle-card',
          tier_id: '3',
          title: 'Three Hoodies',
          savings: 'SAVE Rs. 20,355.00',
          subtitle: 'A different color for each — save 58%',
          price: 'Rs. 15,045.00',
          compare_price: 'Rs. 35,400.00',
          is_selected: false,
          item_count: 3,
          is_free_gift: true
        %}
      </div>

      <!-- CTA Preorder Button -->
      <button type="button" class="pookie-btn-preorder" id="pookie-atc-button">
        PREORDER NOW
      </button>

      <!-- Urgency Scarcity Box -->
      <div class="pookie-urgency-alert">
        <div class="pookie-urgency-title">
          <span>●</span>
          <span>HIGH DEMAND</span>
        </div>
        <div>
          <span class="pookie-urgency-strong">54 people ordered this recently</span><br>
          Due to high demand, our first batch has sold out and we're now taking preorders. Processing can take 4 to 6 weeks, but don't worry: your Pookie Hoodie is 100% guaranteed to be at your door between mid and late November. <span style="color:var(--pookie-alert-text); font-weight:700;">Preorder now to secure yours!</span>
        </div>
      </div>

      <!-- Social Proof Quote (Brianna L.) -->
      <div class="pookie-social-quote">
        <img src="https://thepookiewear.com/cdn/shop/files/a2-mom-brianna.png?v=1789660467" class="pookie-social-avatar" alt="Brianna L. customer review">
        <div class="pookie-social-text">
          "I was sure it would be complicated. It isn't. Unzip, baby in, zip up, and I can eat lunch with both hands for the first time in months."
          <div class="pookie-social-author">Brianna L. ★★★★★</div>
        </div>
      </div>

      <!-- Trust Badges -->
      <div class="pookie-trust-badges">
        <div class="pookie-trust-item">
          <span class="pookie-trust-icon">🔒</span>
          <span>30-DAY MONEY-BACK GUARANTEE</span>
        </div>
        <div class="pookie-trust-item">
          <span class="pookie-trust-icon">🚚</span>
          <span>FREE WORLDWIDE SHIPPING</span>
        </div>
        <div class="pookie-trust-item">
          <span class="pookie-trust-icon">🏆</span>
          <span>#1 SELLING BABYWEAR</span>
        </div>
      </div>

      <!-- Accordions -->
      <div class="pookie-accordion">
        <!-- 1. Description -->
        <div class="pookie-accordion-item is-open">
          <button type="button" class="pookie-accordion-header">
            <span class="pookie-accordion-title">
              {% render 'pookie-icons', name: 'check' %}
              <span>Description</span>
            </span>
            <span class="pookie-accordion-icon">
              {% render 'pookie-icons', name: 'chevron' %}
            </span>
          </button>
          <div class="pookie-accordion-content">
            <p><strong>A baby who only settles on you, and two hands you need for everything else.</strong></p>
            <p>The Pookie Hoodie is an oversized cream sherpa hoodie with a baby-shaped front built right into it. Unzip the arc across the chest, place your baby in, zip back up. Their head peeks out, their little arms stay free, and their feet stay warm in the closed booties.</p>
            <p>The part you can't see does the carrying. A padded seat sewn inside holds your baby from below, and straps run over your shoulders and cross on your back — so the weight sits on you, not on the fleece.</p>
            <p>Mom sizes S, M, L, XL, XXL in a relaxed oversized cut that falls past the hips, with two zip side pockets for your phone and keys. The baby section fits babies from 3 months up to 1 year (up to 22 lb / 10 kg).</p>
            <p>It's thick, warm sherpa. Made for the house, the couch and cooler days out — not a summer afternoon. ❄️</p>
          </div>
        </div>

        <!-- 2. How fast will it ship? -->
        <div class="pookie-accordion-item">
          <button type="button" class="pookie-accordion-header">
            <span class="pookie-accordion-title">
              {% render 'pookie-icons', name: 'check' %}
              <span>How fast will it ship?</span>
            </span>
            <span class="pookie-accordion-icon">
              {% render 'pookie-icons', name: 'chevron' %}
            </span>
          </button>
          <div class="pookie-accordion-content">
            <p>Due to high demand, the Pookie Hoodie is currently on preorder. Processing and delivery can take 4 to 6 weeks. Shipping is FREE worldwide, and you'll get a tracking number the moment your order ships.</p>
            <p>Don't worry: your Pookie Hoodie will be at your door between mid and late November, 100% guaranteed. 🤍</p>
          </div>
        </div>

        <!-- 3. What if it doesn't fit? -->
        <div class="pookie-accordion-item">
          <button type="button" class="pookie-accordion-header">
            <span class="pookie-accordion-title">
              {% render 'pookie-icons', name: 'check' %}
              <span>What if it doesn't fit?</span>
            </span>
            <span class="pookie-accordion-icon">
              {% render 'pookie-icons', name: 'chevron' %}
            </span>
          </button>
          <div class="pookie-accordion-content">
            <p>We offer a hassle-free 30-day money-back guarantee. If you or your little one aren't completely in love with the fit, simply reach out to our support team and we will exchange it for another size or issue a full refund, no questions asked.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Size Chart Modal -->
<div class="pookie-modal" id="pookie-size-chart-modal" aria-hidden="true">
  <div class="pookie-modal-dialog">
    <button type="button" class="pookie-modal-close" id="pookie-close-size-chart" aria-label="Close modal">&times;</button>
    <div class="pookie-modal-header">
      <h2 class="pookie-modal-title">Size Chart</h2>
    </div>
    <div class="pookie-modal-body">
      <img
        src="https://thepookiewear.com/cdn/shop/files/hf_20260919_124448_91ce7a24-a8d4-4328-a54f-62d9651d293b.png?v=1789821945&width=1000"
        alt="Pookie Hoodie Official Size Chart Table"
        style="width: 100%; height: auto; display: block; border-radius: 8px;"
      >
      <div style="margin-top: 16px; font-size: 13px; color: #555; line-height: 1.5;">
        <strong>Mother's Fit:</strong> Oversized comfort fit. Order your regular pre-pregnancy size.<br>
        <strong>Baby Pouch:</strong> Accommodates babies from 3 months up to 1 year (up to 22 lbs / 10 kg).
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Pookie Main Product",
  "settings": [
    {
      "type": "text",
      "id": "product_title",
      "label": "Product Title",
      "default": "Pookie Hoodie"
    }
  ],
  "presets": [
    {
      "name": "Pookie Main Product"
    }
  ]
}
{% endschema %}
