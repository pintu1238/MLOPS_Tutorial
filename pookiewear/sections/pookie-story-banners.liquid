<div class="pookie-story-banners-container" id="PookieStoryBanners-{{ section.id }}">
  <!-- Banner 1: One Hoodie Instead of Carrier -->
  <section class="pookie-story-banner">
    <img
      src="{{ section.settings.banner_1_img | default: 'https://thepookiewear.com/cdn/shop/files/banner-1-zip-in-1x1.gif?v=1789670780&width=3840' }}"
      class="pookie-story-bg"
      alt="Pookie Hoodie zip in demonstration"
      loading="lazy"
    >
    <div class="pookie-story-card">
      <h2>{{ section.settings.banner_1_title | default: '🧸 One Hoodie Instead of a Carrier, a Blanket and a Sweater' }}</h2>
      <p>{{ section.settings.banner_1_text | default: "No buckles to figure out at 6 a.m., no blanket sliding off, no carrier straps over your sweater. Unzip the arc across the chest, place your baby in, zip back up. 🤱 Their head peeks out, their arms stay free, their feet stay warm in the closed booties — and you've got two hands for the coffee." }}</p>
    </div>
  </section>

  <!-- Banner 2: For Days They Only Want To Be On You -->
  <section class="pookie-story-banner">
    <img
      src="{{ section.settings.banner_2_img | default: 'https://thepookiewear.com/cdn/shop/files/banner-2-cozy-1x1.gif?v=1789670779&width=3840' }}"
      class="pookie-story-bg"
      alt="Pookie Hoodie cozy lifestyle"
      loading="lazy"
    >
    <div class="pookie-story-card">
      <h2>{{ section.settings.banner_2_title | default: '☕ For the Days They Only Want to Be on You' }}</h2>
      <p>{{ section.settings.banner_2_text | default: "Some days the baby won't be put down — and the emails, the laundry and the coffee don't wait. The Pookie Hoodie keeps them on your chest, warm and close, while your hands do everything else. 💛 Made for the house, the couch and cooler days out." }}</p>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Pookie Story Banners",
  "settings": [
    {
      "type": "text",
      "id": "banner_1_title",
      "label": "Banner 1 Title",
      "default": "🧸 One Hoodie Instead of a Carrier, a Blanket and a Sweater"
    },
    {
      "type": "textarea",
      "id": "banner_1_text",
      "label": "Banner 1 Text",
      "default": "No buckles to figure out at 6 a.m., no blanket sliding off, no carrier straps over your sweater. Unzip the arc across the chest, place your baby in, zip back up. 🤱 Their head peeks out, their arms stay free, their feet stay warm in the closed booties — and you've got two hands for the coffee."
    },
    {
      "type": "text",
      "id": "banner_1_img",
      "label": "Banner 1 Image / GIF URL",
      "default": "https://thepookiewear.com/cdn/shop/files/banner-1-zip-in-1x1.gif?v=1789670780&width=3840"
    },
    {
      "type": "text",
      "id": "banner_2_title",
      "label": "Banner 2 Title",
      "default": "☕ For the Days They Only Want to Be on You"
    },
    {
      "type": "textarea",
      "id": "banner_2_text",
      "label": "Banner 2 Text",
      "default": "Some days the baby won't be put down — and the emails, the laundry and the coffee don't wait. The Pookie Hoodie keeps them on your chest, warm and close, while your hands do everything else. 💛 Made for the house, the couch and cooler days out."
    },
    {
      "type": "text",
      "id": "banner_2_img",
      "label": "Banner 2 Image / GIF URL",
      "default": "https://thepookiewear.com/cdn/shop/files/banner-2-cozy-1x1.gif?v=1789670779&width=3840"
    }
  ],
  "presets": [
    {
      "name": "Pookie Story Banners"
    }
  ]
}
{% endschema %}
