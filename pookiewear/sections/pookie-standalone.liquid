<style>
/* assets/pookie-styles.css - Exact Replica Styles for Pookie Hoodie */
@import url('https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap');

:root {
  --pookie-caramel: #bc7c3e;
  --pookie-caramel-dark: #8a5726;
  --pookie-caramel-light: #fcf8f4;
  --pookie-caramel-hover: #a86c32;
  --pookie-font: 'Poppins', sans-serif;
  --pookie-text: #1a1a1a;
  --pookie-text-muted: #555555;
  --pookie-border: #e8dfd5;
  --pookie-radius: 12px;
  --pookie-radius-sm: 8px;
  --pookie-gold: #f5a623;
  --pookie-alert-bg: #fff5f5;
  --pookie-alert-border: #ffd1d1;
  --pookie-alert-text: #d93838;
}

.pookie-theme-wrapper {
  font-family: var(--pookie-font);
  color: var(--pookie-text);
  line-height: 1.5;
  background-color: #ffffff;
  -webkit-font-smoothing: antialiased;
  box-sizing: border-box;
}

.pookie-theme-wrapper *,
.pookie-theme-wrapper *::before,
.pookie-theme-wrapper *::after {
  box-sizing: border-box;
}

/* ==========================================================================
   1. TOP BAR & COUNTDOWN & MARQUEE
   ========================================================================== */
.pookie-top-bar {
  width: 100%;
  position: relative;
  z-index: 50;
}

.pookie-countdown-bar {
  background-color: #000000;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 8px 16px;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.5px;
}

.pookie-countdown-label {
  display: flex;
  align-items: center;
  gap: 6px;
  text-transform: uppercase;
}

.pookie-countdown-timer {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-family: monospace, var(--pookie-font);
}

.pookie-countdown-box {
  background: #1f1f1f;
  color: #ffffff;
  padding: 3px 6px;
  border-radius: 4px;
  font-weight: 700;
  font-size: 14px;
}

.pookie-marquee {
  background-color: var(--pookie-caramel);
  color: #ffffff;
  overflow: hidden;
  white-space: nowrap;
  padding: 10px 0;
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 0.5px;
  text-transform: uppercase;
}

.pookie-marquee-track {
  display: inline-flex;
  animation: pookieMarquee 35s linear infinite;
}

.pookie-marquee-track:hover {
  animation-play-state: paused;
}

.pookie-marquee-item {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-right: 48px;
}

@keyframes pookieMarquee {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

/* ==========================================================================
   2. MAIN PRODUCT SECTION LAYOUT
   ========================================================================== */
.pookie-main-product-section {
  max-width: 1240px;
  margin: 0 auto;
  padding: 32px 20px 60px;
}

.pookie-product-grid {
  display: grid;
  grid-template-columns: 1.15fr 1fr;
  gap: 48px;
  align-items: start;
}

/* Gallery */
.pookie-gallery {
  position: sticky;
  top: 24px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.pookie-gallery-main {
  width: 100%;
  aspect-ratio: 1/1;
  border-radius: var(--pookie-radius);
  overflow: hidden;
  background-color: #f7f7f7;
  position: relative;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
}

.pookie-gallery-main img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: opacity 0.25s ease-in-out;
}

.pookie-gallery-thumbs-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

.pookie-gallery-thumbs {
  display: flex;
  gap: 12px;
  overflow-x: auto;
  scroll-behavior: smooth;
  padding-bottom: 6px;
  scrollbar-width: thin;
}

.pookie-gallery-thumbs::-webkit-scrollbar {
  height: 4px;
}
.pookie-gallery-thumbs::-webkit-scrollbar-thumb {
  background: #ddd;
  border-radius: 4px;
}

.pookie-gallery-thumb {
  flex: 0 0 74px;
  height: 74px;
  border-radius: 8px;
  overflow: hidden;
  border: 2px solid transparent;
  cursor: pointer;
  transition: border-color 0.2s ease, transform 0.2s ease;
  background: #f7f7f7;
}

.pookie-gallery-thumb:hover {
  transform: translateY(-2px);
}

.pookie-gallery-thumb.is-active {
  border-color: var(--pookie-caramel);
}

.pookie-gallery-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Product Info / Details */
.pookie-product-info {
  display: flex;
  flex-direction: column;
}

.pookie-badge-stock {
  align-self: flex-start;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 1px;
  color: var(--pookie-caramel);
  border: 1px solid var(--pookie-caramel);
  padding: 4px 12px;
  border-radius: 4px;
  text-transform: uppercase;
  margin-bottom: 12px;
}

.pookie-product-title {
  font-size: 34px;
  font-weight: 800;
  color: #1a1a1a;
  margin: 0 0 8px 0;
  line-height: 1.2;
}

.pookie-stars-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 14px;
  font-size: 14px;
  color: #555;
}

.pookie-stars {
  color: var(--pookie-gold);
  letter-spacing: 2px;
  font-size: 16px;
}

.pookie-price-wrap {
  display: flex;
  align-items: baseline;
  gap: 12px;
  margin-bottom: 18px;
}

.pookie-price-current {
  font-size: 26px;
  font-weight: 700;
  color: var(--pookie-caramel);
}

.pookie-price-compare {
  font-size: 18px;
  color: #999999;
  text-decoration: line-through;
}

.pookie-discount-pill {
  background-color: var(--pookie-caramel);
  color: #ffffff;
  font-size: 12px;
  font-weight: 700;
  padding: 3px 8px;
  border-radius: 4px;
  text-transform: uppercase;
}

/* Bullets */
.pookie-bullet-points {
  list-style: none;
  padding: 0;
  margin: 0 0 20px 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.pookie-bullet-item {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 15px;
  font-weight: 500;
  color: #333333;
}

/* Variant selectors */
.pookie-variant-group {
  margin-bottom: 18px;
}

.pookie-variant-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
  font-size: 14px;
  font-weight: 600;
}

.pookie-size-chart-btn {
  background: none;
  border: none;
  color: var(--pookie-caramel);
  text-decoration: underline;
  cursor: pointer;
  font-size: 13px;
  font-family: inherit;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  gap: 4px;
}

.pookie-size-pills {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.pookie-size-pill {
  min-width: 46px;
  height: 42px;
  padding: 0 14px;
  border: 1px solid #dcdcdc;
  border-radius: var(--pookie-radius-sm);
  background: #ffffff;
  font-weight: 600;
  font-size: 14px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.pookie-size-pill:hover {
  border-color: #999;
}

.pookie-size-pill.is-selected {
  background: #000000;
  color: #ffffff;
  border-color: #000000;
}

.pookie-color-select {
  width: 100%;
  padding: 12px 14px;
  border: 1px solid #dcdcdc;
  border-radius: var(--pookie-radius-sm);
  font-size: 15px;
  font-family: inherit;
  font-weight: 500;
  background: #ffffff;
  cursor: pointer;
  outline: none;
}
.pookie-color-select:focus {
  border-color: var(--pookie-caramel);
}

/* ==========================================================================
   3. BUNDLE & SAVE WIDGET
   ========================================================================== */
.pookie-bundle-container {
  margin: 20px 0 24px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.pookie-bundle-header {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  text-transform: uppercase;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 1.5px;
  color: #777;
  margin-bottom: 6px;
}
.pookie-bundle-header::before,
.pookie-bundle-header::after {
  content: "";
  flex: 1;
  height: 1px;
  background: #e2e2e2;
  margin: 0 16px;
}

.pookie-bundle-tier {
  border: 2px solid #e5ded7;
  border-radius: var(--pookie-radius);
  padding: 16px 18px;
  cursor: pointer;
  position: relative;
  transition: all 0.25s ease;
  background-color: #ffffff;
}

.pookie-bundle-tier:hover {
  border-color: var(--pookie-caramel);
}

.pookie-bundle-tier.is-selected {
  border-color: var(--pookie-caramel);
  background-color: var(--pookie-caramel-light);
}

.pookie-bundle-badge {
  position: absolute;
  top: -12px;
  right: 18px;
  background: var(--pookie-caramel);
  color: #ffffff;
  font-size: 11px;
  font-weight: 700;
  padding: 4px 10px;
  border-radius: 20px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  box-shadow: 0 2px 6px rgba(188, 124, 62, 0.35);
}

.pookie-bundle-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pookie-bundle-left {
  display: flex;
  align-items: center;
  gap: 12px;
}

.pookie-bundle-radio {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  border: 2px solid #bbb;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.pookie-bundle-tier.is-selected .pookie-bundle-radio {
  border-color: var(--pookie-caramel);
}
.pookie-bundle-tier.is-selected .pookie-bundle-radio::after {
  content: "";
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--pookie-caramel);
}

.pookie-bundle-title {
  font-size: 16px;
  font-weight: 700;
  color: #1a1a1a;
}

.pookie-bundle-savings {
  background: #e27d3b;
  color: #ffffff;
  font-size: 11px;
  font-weight: 700;
  padding: 2px 6px;
  border-radius: 4px;
  margin-left: 6px;
}

.pookie-bundle-subtitle {
  font-size: 12px;
  color: #666;
  margin-top: 2px;
}

.pookie-bundle-price {
  text-align: right;
}
.pookie-bundle-price-main {
  font-size: 16px;
  font-weight: 700;
  color: #111;
}
.pookie-bundle-price-strike {
  font-size: 13px;
  color: #999;
  text-decoration: line-through;
}

/* Tier Multi-selectors & Upsells */
.pookie-bundle-selectors {
  margin-top: 14px;
  padding-top: 14px;
  border-top: 1px solid #ebd9cc;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.pookie-bundle-item-row {
  display: flex;
  align-items: center;
  gap: 12px;
}

.pookie-bundle-item-img {
  width: 44px;
  height: 44px;
  border-radius: 6px;
  object-fit: cover;
  background: #eee;
}

.pookie-bundle-selects {
  display: flex;
  gap: 8px;
  flex: 1;
}

.pookie-bundle-selects select {
  flex: 1;
  padding: 8px 10px;
  border: 1px solid #d4c8bf;
  border-radius: 6px;
  font-size: 13px;
  font-family: inherit;
  background: #ffffff;
}

/* Upsell addons */
.pookie-bundle-addons {
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px solid #ebd9cc;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.pookie-addon-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(188, 124, 62, 0.08);
  border-radius: 6px;
  padding: 8px 12px;
  font-size: 13px;
  font-weight: 500;
}

.pookie-addon-left {
  display: flex;
  align-items: center;
  gap: 10px;
}

.pookie-addon-left input[type="checkbox"] {
  accent-color: var(--pookie-caramel);
  width: 16px;
  height: 16px;
  cursor: pointer;
}

.pookie-addon-img {
  width: 32px;
  height: 32px;
  border-radius: 4px;
  object-fit: cover;
}

.pookie-addon-price {
  font-weight: 700;
  color: #333;
}

/* ==========================================================================
   4. PREORDER BUTTON, ALERTS & BADGES
   ========================================================================== */
.pookie-btn-preorder {
  width: 100%;
  background-color: var(--pookie-caramel);
  color: #ffffff;
  border: none;
  border-radius: var(--pookie-radius-sm);
  padding: 18px 24px;
  font-size: 17px;
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
  cursor: pointer;
  box-shadow: 0 6px 18px rgba(188, 124, 62, 0.35);
  transition: all 0.2s ease;
  margin-top: 6px;
  font-family: inherit;
}

.pookie-btn-preorder:hover {
  background-color: var(--pookie-caramel-hover);
  transform: translateY(-2px);
  box-shadow: 0 8px 22px rgba(188, 124, 62, 0.45);
}

.pookie-btn-preorder:active {
  transform: translateY(0);
}

/* Scarcity Alert */
.pookie-urgency-alert {
  background: var(--pookie-alert-bg);
  border: 1px solid var(--pookie-alert-border);
  border-radius: var(--pookie-radius-sm);
  padding: 14px 16px;
  margin-top: 20px;
  font-size: 13px;
  line-height: 1.5;
  color: #444;
}

.pookie-urgency-title {
  color: var(--pookie-alert-text);
  font-weight: 700;
  text-transform: uppercase;
  font-size: 12px;
  margin-bottom: 4px;
  display: flex;
  align-items: center;
  gap: 6px;
}

.pookie-urgency-strong {
  color: #111;
  font-weight: 700;
}

/* Brianna Quote */
.pookie-social-quote {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-top: 20px;
  padding: 14px 16px;
  background: #fbfbfb;
  border-radius: var(--pookie-radius-sm);
}

.pookie-social-avatar {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  object-fit: cover;
  flex-shrink: 0;
}

.pookie-social-text {
  font-size: 13px;
  font-style: italic;
  color: #444;
}

.pookie-social-author {
  font-size: 12px;
  font-weight: 700;
  color: #111;
  margin-top: 4px;
  font-style: normal;
}

/* Trust badges */
.pookie-trust-badges {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin-top: 24px;
  padding: 18px 0;
  border-top: 1px solid #eee;
  border-bottom: 1px solid #eee;
  text-align: center;
}

.pookie-trust-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: #333;
}

.pookie-trust-icon {
  font-size: 22px;
}

/* ==========================================================================
   5. ACCORDIONS
   ========================================================================== */
.pookie-accordion {
  margin-top: 24px;
  display: flex;
  flex-direction: column;
}

.pookie-accordion-item {
  border-bottom: 1px solid #eaeaea;
}

.pookie-accordion-header {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 4px;
  background: none;
  border: none;
  text-align: left;
  font-size: 15px;
  font-weight: 600;
  color: #1a1a1a;
  cursor: pointer;
  font-family: inherit;
}

.pookie-accordion-title {
  display: flex;
  align-items: center;
  gap: 10px;
}

.pookie-accordion-icon {
  font-size: 18px;
  transition: transform 0.25s ease;
  color: #666;
}

.pookie-accordion-item.is-open .pookie-accordion-icon {
  transform: rotate(180deg);
}

.pookie-accordion-content {
  display: none;
  padding: 0 4px 18px 32px;
  font-size: 14px;
  line-height: 1.6;
  color: #555555;
}

.pookie-accordion-item.is-open .pookie-accordion-content {
  display: block;
}

/* ==========================================================================
   6. STORY LIFESTYLE BANNERS
   ========================================================================== */
.pookie-story-banners-container {
  width: 100%;
  display: flex;
  flex-direction: column;
}

.pookie-story-banner {
  position: relative;
  width: 100%;
  min-height: 580px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60px 20px;
  background-size: cover;
  background-position: center;
  overflow: hidden;
}

.pookie-story-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 1;
}

.pookie-story-card {
  position: relative;
  z-index: 2;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  max-width: 680px;
  width: 100%;
  padding: 44px 38px;
  border-radius: 20px;
  text-align: center;
  box-shadow: 0 12px 36px rgba(0, 0, 0, 0.12);
}

.pookie-story-card h2 {
  font-size: 28px;
  font-weight: 800;
  color: #111;
  margin: 0 0 16px 0;
  line-height: 1.3;
}

.pookie-story-card p {
  font-size: 15px;
  color: #444;
  line-height: 1.7;
  margin: 0 0 12px 0;
}

/* ==========================================================================
   7. CUSTOMER REVIEWS
   ========================================================================== */
.pookie-reviews-section {
  max-width: 1240px;
  margin: 0 auto;
  padding: 80px 20px 60px;
}

.pookie-reviews-title {
  text-align: center;
  font-size: 32px;
  font-weight: 800;
  margin: 0 0 48px 0;
  color: #111;
}

.pookie-reviews-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 28px;
}

.pookie-review-card {
  background: #ffffff;
  border: 1px solid var(--pookie-border);
  border-radius: 18px;
  overflow: hidden;
  box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.pookie-review-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 10px 28px rgba(0, 0, 0, 0.08);
}

.pookie-review-img-wrap {
  width: 100%;
  height: 240px;
  overflow: hidden;
  position: relative;
}

.pookie-review-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.pookie-review-quote-bubble {
  position: absolute;
  bottom: 12px;
  right: 16px;
  background: var(--pookie-caramel);
  color: #ffffff;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  font-family: Georgia, serif;
}

.pookie-review-body {
  padding: 24px;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.pookie-review-stars {
  color: var(--pookie-gold);
  letter-spacing: 2px;
  font-size: 15px;
  margin-bottom: 10px;
}

.pookie-review-headline {
  font-size: 16px;
  font-weight: 700;
  color: #1a1a1a;
  margin: 0 0 10px 0;
  line-height: 1.35;
}

.pookie-review-text {
  font-size: 14px;
  color: #555;
  line-height: 1.6;
  margin: 0 0 18px 0;
  flex: 1;
}

.pookie-review-author {
  font-size: 13px;
  font-weight: 600;
  color: #222;
  border-top: 1px solid #f0f0f0;
  padding-top: 12px;
}

/* ==========================================================================
   8. 30-DAY GUARANTEE
   ========================================================================== */
.pookie-guarantee-section {
  max-width: 900px;
  margin: 0 auto;
  padding: 20px 20px 80px;
}

.pookie-guarantee-card {
  background-color: var(--pookie-caramel-light);
  border: 1px solid #ebd9cc;
  border-radius: 24px;
  padding: 48px;
  display: grid;
  grid-template-columns: 160px 1fr;
  gap: 36px;
  align-items: center;
}

.pookie-guarantee-badge-container {
  display: flex;
  justify-content: center;
}

.pookie-guarantee-seal {
  width: 140px;
  height: 140px;
  border-radius: 50%;
  border: 3px dashed var(--pookie-caramel);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 12px;
  color: var(--pookie-caramel);
  font-weight: 800;
}

.pookie-guarantee-seal-num {
  font-size: 38px;
  line-height: 1;
}

.pookie-guarantee-seal-sub {
  font-size: 11px;
  letter-spacing: 1px;
  text-transform: uppercase;
}

