{% if page.handle == 'contact' or section.settings.render_on_all_pages %}
  <section class="contact-form" data-section-id="{{ section.id }}">
    <div class="contact-form__panel">
      <p class="contact-form__eyebrow">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.heading }}</h1>
      {% if section.settings.body != blank %}<p>{{ section.settings.body }}</p>{% endif %}
      {% capture contact_form_id %}ContactForm-{{ section.id }}{% endcapture %}
      {% form 'contact', id: contact_form_id %}
        {% render 'form-status', form: form, success_message: 'forms.success' %}
        <div class="contact-form__fields">
          <div>
            <label class="visually-hidden" for="ContactName-{{ section.id }}">{{ section.settings.name_label | escape }}</label>
            <input id="ContactName-{{ section.id }}" type="text" name="contact[name]" autocomplete="name" placeholder="{{ section.settings.name_label | escape }}" required>
          </div>
          <div>
            <label class="visually-hidden" for="ContactEmail-{{ section.id }}">{{ section.settings.email_label | escape }}</label>
            <input id="ContactEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" placeholder="{{ section.settings.email_label | escape }}" required>
          </div>
          <div class="contact-form__wide">
            <label class="visually-hidden" for="ContactPhone-{{ section.id }}">Phone number</label>
            <input id="ContactPhone-{{ section.id }}" type="tel" name="contact[phone]" autocomplete="tel" placeholder="Phone number">
          </div>
          <div class="contact-form__wide">
            <label class="visually-hidden" for="ContactMessage-{{ section.id }}">{{ section.settings.message_label | escape }}</label>
            <textarea id="ContactMessage-{{ section.id }}" name="contact[body]" rows="5" placeholder="{{ section.settings.message_label | escape }}" required></textarea>
          </div>
        </div>
        <button type="submit">{{ section.settings.submit_label | escape }}</button>
      {% endform %}
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .contact-form { max-width: var(--page-width); margin: 0 auto; padding: 1rem 1.25rem 4rem; }
  .contact-form__panel { max-width: 48rem; border: 1px solid var(--color-border); border-radius: var(--radius); padding: clamp(1.5rem, 4vw, 3rem); }
  .contact-form__eyebrow { margin: 0 0 .5rem; color: var(--color-muted); font-size: .75rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .contact-form h2 { margin: 0; color: var(--color-ink); }
  .contact-form__panel > p:not(.contact-form__eyebrow) { color: var(--color-muted); }
  .contact-form .form-status--error { margin: 0; padding: .75rem; border: 1px solid #9e1f1f; background: #fff1f1; color: #9e1f1f; }
  .contact-form form { display: grid; gap: 1rem; margin-top: 1.5rem; }
  .contact-form__fields { display: grid; gap: 1rem; }
  .contact-form__fields > div { display: grid; gap: .5rem; }
  .contact-form label { font-size: .8rem; font-weight: 700; }
  .contact-form input, .contact-form textarea, .contact-form button { border: 1px solid var(--color-ink); border-radius: var(--radius); padding: .75rem; background: var(--color-bg); color: var(--color-ink); font: inherit; }
  .contact-form button { justify-self: start; background: var(--color-ink); color: var(--color-bg); cursor: pointer; }
  #MainContent .contact-form { max-width: 800px; padding: 60px 24px 70px; }
  #MainContent .contact-form__panel { padding: 0; border: 0; border-radius: 0; }
  #MainContent .contact-form h1 { text-align: center; margin: 0 0 35px; font-size: 39px; line-height: 48px; }
  #MainContent .contact-form__eyebrow:empty { display: none; }
  #MainContent .contact-form__fields { grid-template-columns: repeat(2, minmax(0,1fr)); gap: 20px; }
  #MainContent .contact-form__wide { grid-column: 1 / -1; }
  #MainContent .contact-form input, #MainContent .contact-form textarea { width: 100%; border-color: #aaa; border-radius: 6px; padding: 14px 16px; font-size: 16px; }
  #MainContent .contact-form button { width: 100%; justify-self: stretch; border-radius: 6px; padding: 13px 32px; font-size: 17px; font-weight: 700; }
  @media(max-width: 549px) { #MainContent .contact-form__fields { grid-template-columns: 1fr; } #MainContent .contact-form h1 { font-size: 30px; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Need a hand?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get in touch" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Send a note and we will get back to you as soon as we can." },
    { "type": "text", "id": "name_label", "label": "Name label", "default": "Name" },
    { "type": "text", "id": "email_label", "label": "Email label", "default": "Email" },
    { "type": "text", "id": "message_label", "label": "Message label", "default": "Message" },
    { "type": "text", "id": "submit_label", "label": "Submit label", "default": "Send message" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Thanks. Your message is on its way." },
    { "type": "checkbox", "id": "render_on_all_pages", "label": "Render on every page", "default": false }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
