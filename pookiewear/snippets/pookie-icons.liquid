{% doc %}
  Renders SVG icons used throughout the Pookie Wear theme.
  @param {string} name - The name of the icon to render (truck, flame, star, shield, check, chevron, quote, close)
  @param {string} [class] - Additional CSS classes
  @example
  {% render 'pookie-icons', name: 'truck', class: 'custom-icon' %}
{% enddoc %}

{% case name %}
  {% when 'truck' %}
    <svg class="{{ class | default: 'pookie-icon' }}" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="1" y="3" width="15" height="13"></rect>
      <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
      <circle cx="5.5" cy="18.5" r="2.5"></circle>
      <circle cx="18.5" cy="18.5" r="2.5"></circle>
    </svg>

  {% when 'flame' %}
    <svg class="{{ class | default: 'pookie-icon' }}" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 2c-.5 2-2 4-3.5 5.5C7 9 6 11 6 13a6 6 0 0 0 12 0c0-2-1-4-2.5-5.5C14 6 12.5 4 12 2zm0 17a4 4 0 0 1-4-4c0-1.2.6-2.3 1.5-3.1.6 1.1 1.5 1.9 2.5 2.1 0-1.5.5-2.8 1.5-3.8.3 1.2 1 2.3 1.8 3.1A3.98 3.98 0 0 1 12 19z"/>
    </svg>

  {% when 'star' %}
    <svg class="{{ class | default: 'pookie-icon-star' }}" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
    </svg>

  {% when 'shield' %}
    <svg class="{{ class | default: 'pookie-icon' }}" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
    </svg>

  {% when 'check' %}
    <svg class="{{ class | default: 'pookie-icon-check' }}" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="20 6 9 17 4 12"></polyline>
    </svg>

  {% when 'chevron' %}
    <svg class="{{ class | default: 'pookie-icon-chevron' }}" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>

  {% when 'quote' %}
    <svg class="{{ class | default: 'pookie-icon-quote' }}" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
      <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
    </svg>

  {% when 'close' %}
    <svg class="{{ class | default: 'pookie-icon-close' }}" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
{% endcase %}
