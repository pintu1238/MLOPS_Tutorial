{% comment %}
  Social proof stats strip above the newsletter card.
{% endcomment %}
{%- liquid
  assign hide_stats_strip = false
  if template.name == 'product' and product.handle == 'flytek-curve-rc-drift-car-4x4' or product.handle == 'super-micronized-creatine-monohydrate'
    assign hide_stats_strip = true
  endif
  if template.name == 'page' and page.handle == 'contact'
    assign hide_stats_strip = true
  endif
-%}

{%- unless hide_stats_strip -%}
<section class="ls-stats-strip" id="ls-stats-strip-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="ls-stats-strip__wrap">
    <ul class="ls-stats-strip__grid" role="list">
      <li class="ls-stats-strip__item">
        <span class="ls-stats-strip__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <path d="M4 8.5 12 4l8 4.5v9L12 22l-8-4.5v-9Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
            <path d="M12 13v9M4 8.5 12 13l8-4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
          </svg>
        </span>
        <p class="ls-stats-strip__value">{{ section.settings.stat_one_value | escape }}</p>
        <p class="ls-stats-strip__label">{{ section.settings.stat_one_label | escape }}</p>
      </li>
      <li class="ls-stats-strip__item">
        <span class="ls-stats-strip__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.6"/>
            <path d="M8.5 10.2c.4 1.6 1.8 2.8 3.5 2.8s3.1-1.2 3.5-2.8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            <circle cx="9" cy="9.5" r="0.9" fill="currentColor"/>
            <circle cx="15" cy="9.5" r="0.9" fill="currentColor"/>
          </svg>
        </span>
        <p class="ls-stats-strip__value">{{ section.settings.stat_two_value | escape }}</p>
        <p class="ls-stats-strip__label">{{ section.settings.stat_two_label | escape }}</p>
      </li>
      <li class="ls-stats-strip__item">
        <span class="ls-stats-strip__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <path d="M2.5 14h2.2l1-3a1.4 1.4 0 0 1 1.3-1h6.5a1.4 1.4 0 0 1 1.3 1l1 3h2.2a1.4 1.4 0 0 1 1.4 1.1l.4 2.4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M5 17.5h12M7 17.5a1.6 1.6 0 1 0 0 .1M17 17.5a1.6 1.6 0 1 0 0 .1" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            <path d="M4 10V7.2A1.2 1.2 0 0 1 5.2 6h4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
        </span>
        <p class="ls-stats-strip__value">{{ section.settings.stat_three_value | escape }}</p>
        <p class="ls-stats-strip__label">{{ section.settings.stat_three_label | escape }}</p>
      </li>
    </ul>
  </div>
</section>
{%- endunless -%}

{% stylesheet %}
  .ls-stats-strip {
    background: #f3f4f6;
    padding-block: clamp(2.5rem, 5.5vw, 3.5rem);
    padding-inline: var(--ft-site-gutter, clamp(1.25rem, 5vw, 6.25rem));
    border-bottom: 1px solid #d1d5db;
    font-family: "DM Serif Display", sans-serif;
  }

  .ls-stats-strip__wrap {
    width: 100%;
    max-width: none;
    margin-inline: auto;
  }

  .ls-stats-strip__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    background: #fff;
    border: 1px solid #d1d5db;
    border-radius: 20px;
    box-shadow: 0 20px 44px rgba(15, 23, 42, 0.07);
    overflow: hidden;
    min-height: 200px;
  }

  .ls-stats-strip__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: clamp(1.75rem, 4vw, 2.5rem) 1.25rem;
    text-align: center;
    min-width: 0;
  }

  .ls-stats-strip__item {
    border-inline-end: 1px solid #d1d5db;
  }

  .ls-stats-strip__item:last-child {
    border-inline-end: 0;
  }

  .ls-stats-strip__icon {
    width: 3.85rem;
    height: 3.85rem;
    border-radius: 10px;
    display: grid;
    place-items: center;
    color: #F0C56E;
    background: #ffe8e8;
    margin-bottom: 0.15rem;
  }

  .ls-stats-strip__icon svg {
    width: 2.1rem;
    height: 2.1rem;
  }

  .ls-stats-strip__value {
    margin: 0;
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #111;
    line-height: 1.15;
  }

  .ls-stats-strip__label {
    margin: 0;
    font-size: clamp(0.92rem, 2.2vw, 1.05rem);
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #111;
    line-height: 1.45;
  }

  @media (max-width: 699px) {
    .ls-stats-strip {
      padding-bottom: 0;
    }

    .ls-stats-strip__grid {
      grid-template-columns: 1fr;
    }

    .ls-stats-strip__item {
      border-inline-end: 0;
      border-block-start: 1px solid #d1d5db;
    }

    .ls-stats-strip__item:first-child {
      border-block-start: 0;
    }

    .ls-stats-strip__item {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: flex-start;
      align-items: center;
      text-align: start;
      column-gap: 0.85rem;
      row-gap: 0.15rem;
      padding: 1.1rem 1.15rem;
    }

    .ls-stats-strip__icon {
      margin-bottom: 0;
      flex: 0 0 auto;
    }

    .ls-stats-strip__value {
      flex: 1 1 auto;
      min-width: 0;
      font-size: 28px;
    }

    .ls-stats-strip__label {
      flex: 1 1 100%;
      padding-inline-start: calc(2.65rem + 0.85rem);
      margin-top: -0.35rem;
    }
  }

  @media (min-width: 250px) and (max-width: 700px) {
    .ls-stats-strip {
      padding-block: 1.6rem 0;
      padding-inline: max(0.75rem, var(--ft-site-gutter, 0.75rem));
    }

    .ls-stats-strip__grid {
      border-radius: 14px;
      min-height: 0;
      box-shadow: 0 12px 28px rgba(15, 23, 42, 0.06);
    }

    .ls-stats-strip__item {
      padding: 0.7rem 0.85rem;
      column-gap: 0.6rem;
      row-gap: 0.08rem;
      gap: 0.35rem;
    }

    .ls-stats-strip__icon {
      width: 2.55rem;
      height: 2.55rem;
      border-radius: 8px;
    }

    .ls-stats-strip__icon svg {
      width: 1.3rem;
      height: 1.3rem;
    }

    .ls-stats-strip__value {
      font-size: clamp(1.1rem, 5.2vw, 1.4rem);
    }

    .ls-stats-strip__label {
      font-size: clamp(0.6rem, 2.7vw, 0.7rem);
      letter-spacing: 0.08em;
      line-height: 1.28;
      padding-inline-start: calc(2.55rem + 0.6rem);
      margin-top: -0.22rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Stats strip",
  "class": "ls-stats-strip-section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "stat_one_value",
      "label": "Stat 1 value",
      "default": "10,000"
    },
    {
      "type": "text",
      "id": "stat_one_label",
      "label": "Stat 1 label",
      "default": "Units sold"
    },
    {
      "type": "text",
      "id": "stat_two_value",
      "label": "Stat 2 value",
      "default": "7,500"
    },
    {
      "type": "text",
      "id": "stat_two_label",
      "label": "Stat 2 label",
      "default": "Happy customers"
    },
    {
      "type": "text",
      "id": "stat_three_value",
      "label": "Stat 3 value",
      "default": "24h"
    },
    {
      "type": "text",
      "id": "stat_three_label",
      "label": "Stat 3 label",
      "default": "Dispatch time"
    }
  ],
  "presets": [
    {
      "name": "Stats strip"
    }
  ]
}
{% endschema %}
