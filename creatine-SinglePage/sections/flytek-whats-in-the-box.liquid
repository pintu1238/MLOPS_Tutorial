{% comment %}
  Section contract.
  Simple "What is in the box?" list after Product information.
  @example
  Add on a product JSON template after FLYTEK product information.
{% endcomment %}
{{ 'flytek-product-specs.css' | asset_url | stylesheet_tag }}

<section
  class="ft-inbox"
  id="ft-inbox-{{ section.id }}"
  aria-labelledby="ft-inbox-title-{{ section.id }}"
  {{ section.shopify_attributes }}
>
  <div class="ft-inbox__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="ft-inbox__title" id="ft-inbox-title-{{ section.id }}">
        {{ section.settings.heading | escape }}
      </h2>
    {%- endif -%}

    <ul class="ft-inbox__list">
      {%- assign has_items = false -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.text != blank -%}
          {%- assign has_items = true -%}
          <li {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</li>
        {%- endif -%}
      {%- endfor -%}
      {%- unless has_items -%}
        <li>Creatine Monohydrate 249g tub</li>
        <li>3g serving scoop</li>
        <li>83 unflavoured servings</li>
        <li>NABL lab-tested powder</li>
        <li>Serving guide on label</li>
      {%- endunless -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "FLYTEK box contents",
  "tag": "section",
  "class": "flytek-whats-in-the-box-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What is in the box?"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Item",
          "default": "Creatine Monohydrate 249g tub"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FLYTEK box contents",
      "blocks": [
        { "type": "item", "settings": { "text": "Creatine Monohydrate 249g tub" } },
        { "type": "item", "settings": { "text": "3g serving scoop" } },
        { "type": "item", "settings": { "text": "83 unflavoured servings" } },
        { "type": "item", "settings": { "text": "NABL lab-tested powder" } },
        { "type": "item", "settings": { "text": "Serving guide on label" } }
      ]
    }
  ]
}
{% endschema %}
