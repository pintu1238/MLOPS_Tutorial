{% comment %}
  Section contract.
  Four-column trust promises above the footer on the creatine product page.
  @example
  Last section in product.flytek-curve-rc-drift-car-4x4.json
{% endcomment %}
{%- if product.handle == 'super-micronized-creatine-monohydrate' -%}
<section class="ls-trust-row" id="ls-trust-row-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="ls-trust-row__wrap">
    <ul class="ls-trust-row__grid" role="list">
      <li class="ls-trust-row__item">
        <span class="ls-trust-row__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <path d="M3 16.5V8.8h11.2v7.7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M14.2 11.2h3.4l3.1 3.1v2.2h-3.1" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="6.4" cy="16.7" r="1.7" fill="none" stroke="currentColor" stroke-width="1.6"/>
            <circle cx="17.2" cy="16.7" r="1.7" fill="none" stroke="currentColor" stroke-width="1.6"/>
          </svg>
        </span>
        <p class="ls-trust-row__title">{{ section.settings.item_1_title | escape }}</p>
        <p class="ls-trust-row__text">{{ section.settings.item_1_text | escape }}</p>
      </li>
      <li class="ls-trust-row__item">
        <span class="ls-trust-row__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <path d="M12 3.6 19.2 6v5.2c0 4.4-2.9 7.6-7.2 9.2-4.3-1.6-7.2-4.8-7.2-9.2V6L12 3.6Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
            <path d="M9.1 12.1 11.1 14l3.8-4.2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <p class="ls-trust-row__title">{{ section.settings.item_2_title | escape }}</p>
        <p class="ls-trust-row__text">{{ section.settings.item_2_text | escape }}</p>
      </li>
      <li class="ls-trust-row__item">
        <span class="ls-trust-row__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <path d="M7.2 8.4H4.6V5.8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M4.8 8.2A7.4 7.4 0 1 1 6 16.8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
        </span>
        <p class="ls-trust-row__title">{{ section.settings.item_3_title | escape }}</p>
        <p class="ls-trust-row__text">{{ section.settings.item_3_text | escape }}</p>
      </li>
      <li class="ls-trust-row__item">
        <span class="ls-trust-row__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <path d="M5.2 16.8 4 20.2l3.5-1.2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M6.4 15.6A7.2 7.2 0 1 1 8.2 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            <circle cx="9.4" cy="11.4" r=".75" fill="currentColor"/>
            <circle cx="12" cy="11.4" r=".75" fill="currentColor"/>
            <circle cx="14.6" cy="11.4" r=".75" fill="currentColor"/>
          </svg>
        </span>
        <p class="ls-trust-row__title">{{ section.settings.item_4_title | escape }}</p>
        <p class="ls-trust-row__text">{{ section.settings.item_4_text | escape }}</p>
      </li>
    </ul>
  </div>
</section>
{%- endif -%}

{% stylesheet %}
  .ls-trust-row {
    background: #ffffff;
    color: #000000;
    padding-block: clamp(2.4rem, 5vw, 3.6rem);
    padding-inline: var(--ft-site-gutter, clamp(1.25rem, 5vw, 6.25rem));
    font-family: "DM Serif Display", sans-serif;
  }

  .ls-trust-row__wrap {
    width: 100%;
    max-width: 1180px;
    margin-inline: auto;
  }

  .ls-trust-row__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.4rem, 3vw, 2.4rem);
    align-items: start;
  }

  .ls-trust-row__item {
    min-width: 0;
    text-align: center;
  }

  .ls-trust-row__icon {
    width: 4.15rem;
    height: 4.15rem;
    margin: 0 auto 1.05rem;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: #f5e7cb;
    color: #000000;
  }

  .ls-trust-row__icon svg {
    width: 1.55rem;
    height: 1.55rem;
    display: block;
  }

  .ls-trust-row__title {
    margin: 0 0 0.45rem;
    color: #000000;
    font-size: clamp(0.92rem, 1.2vw, 1.02rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .ls-trust-row__text {
    margin: 0;
    color: #000000;
    font-size: clamp(0.82rem, 1.05vw, 0.9rem);
    font-weight: 400;
    line-height: 1.45;
    max-width: 16.5rem;
    margin-inline: auto;
  }

  @media (max-width: 899px) {
    .ls-trust-row__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.75rem 1.25rem;
    }
  }

  @media (max-width: 549px) {
    .ls-trust-row {
      padding-block: 1.9rem 2.1rem;
    }

    .ls-trust-row__grid {
      grid-template-columns: 1fr;
      gap: 1.45rem;
    }

    .ls-trust-row__icon {
      width: 3.7rem;
      height: 3.7rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product trust row",
  "class": "ls-pdp-trust-row-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "item_1_title",
      "label": "Item 1 title",
      "default": "Pan-India Shipping (2–5 Days)"
    },
    {
      "type": "textarea",
      "id": "item_1_text",
      "label": "Item 1 text",
      "default": "Tracked from our warehouse to your door."
    },
    {
      "type": "text",
      "id": "item_2_title",
      "label": "Item 2 title",
      "default": "Secure Payments"
    },
    {
      "type": "textarea",
      "id": "item_2_text",
      "label": "Item 2 text",
      "default": "Checkout encrypted. Cards, UPI and wallets accepted."
    },
    {
      "type": "text",
      "id": "item_3_title",
      "label": "Item 3 title",
      "default": "7-Day Replacement"
    },
    {
      "type": "textarea",
      "id": "item_3_text",
      "label": "Item 3 text",
      "default": "If the tub arrives damaged or faulty, we replace it."
    },
    {
      "type": "text",
      "id": "item_4_title",
      "label": "Item 4 title",
      "default": "Support"
    },
    {
      "type": "textarea",
      "id": "item_4_text",
      "label": "Item 4 text",
      "default": "A real person replies within a day."
    }
  ],
  "presets": [
    {
      "name": "Product trust row"
    }
  ]
}
{% endschema %}
