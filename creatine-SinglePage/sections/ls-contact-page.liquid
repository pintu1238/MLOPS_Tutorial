{{ 'flytek-contact.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign track_url = section.settings.track_url
  if track_url == blank
    assign track_url = '/pages/track-order'
  endif
  assign support_email = section.settings.support_email
  if support_email == blank
    assign support_email = shop.email
  endif
-%}

<section class="ft-contact" id="ft-contact" {{ section.shopify_attributes }}>
  <div class="ft-contact__wrap">
    <a href="{{ routes.root_url }}" class="ft-contact__back" aria-label="{{ section.settings.back_label | escape }}">
      <span aria-hidden="true">‹</span> {{ section.settings.back_label | escape }}
    </a>

    <header class="ft-contact__head">
      <h1 class="ft-contact__title">{{ section.settings.title | escape }}</h1>
      {%- if section.settings.intro != blank -%}
        <p class="ft-contact__lead">{{ section.settings.intro | escape }}</p>
      {%- endif -%}
    </header>

    <div class="ft-contact__quick">
      <a class="ft-contact__quick-card" href="{{ track_url }}">
        <span class="ft-contact__quick-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 7h11v8H3z"/><path d="M14 10h3l3 3v2h-6V10Z"/><circle cx="7" cy="17" r="1.5"/><circle cx="17" cy="17" r="1.5"/></svg>
        </span>
        <span>
          <p class="ft-contact__quick-title">{{ section.settings.quick_order_title | escape }}</p>
          <p class="ft-contact__quick-sub">{{ section.settings.quick_order_sub | escape }}</p>
        </span>
      </a>
      <a class="ft-contact__quick-card" href="mailto:{{ support_email }}">
        <span class="ft-contact__quick-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
        </span>
        <span>
          <p class="ft-contact__quick-title">{{ section.settings.quick_email_title | escape }}</p>
          <p class="ft-contact__quick-sub">{{ support_email | escape }}</p>
        </span>
      </a>
    </div>

    <div class="ft-contact__card">
      {% form 'contact', class: 'ft-contact__form' %}
        {%- if form.posted_successfully? -%}
          <p class="ft-contact__banner ft-contact__banner--ok" role="status">
            {{ 'templates.contact.form.post_success' | t | default: 'Thanks for contacting us. We will get back to you as soon as possible.' }}
          </p>
        {%- endif -%}
        {%- if form.errors -%}
          <div class="ft-contact__banner ft-contact__banner--err" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="ft-contact__row">
          <div class="ft-contact__field">
            <label for="ft-contact-name">{{ section.settings.label_name | escape }}</label>
            <input
              id="ft-contact-name"
              class="ft-contact__input"
              type="text"
              name="contact[name]"
              autocomplete="name"
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            >
          </div>
          <div class="ft-contact__field">
            <label for="ft-contact-email">{{ section.settings.label_email | escape }} <span class="ft-contact__req">*</span></label>
            <input
              id="ft-contact-email"
              class="ft-contact__input"
              type="email"
              name="contact[email]"
              required
              autocomplete="email"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            >
          </div>
        </div>

        <div class="ft-contact__field">
          <label for="ft-contact-order">{{ section.settings.label_order | escape }}</label>
          <input
            id="ft-contact-order"
            class="ft-contact__input"
            type="text"
            name="contact[Order number]"
            placeholder="{{ section.settings.order_placeholder | escape }}"
            autocomplete="off"
          >
        </div>

        <div class="ft-contact__field">
          <label for="ft-contact-body">{{ section.settings.label_message | escape }} <span class="ft-contact__req">*</span></label>
          <textarea
            id="ft-contact-body"
            class="ft-contact__textarea"
            name="contact[body]"
            rows="5"
            required
          >{{ form.body }}</textarea>
        </div>

        <button type="submit" class="ft-contact__submit">{{ section.settings.submit_label | escape }}</button>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LS Contact Page",
  "class": "ft-contact-section",
  "settings": [
    { "type": "text", "id": "back_label", "label": "Back button", "default": "Back to store" },
    { "type": "text", "id": "title", "label": "Title", "default": "Get in touch" },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Questions about an order, your creatine, or delivery? Send us a message and a real person replies within one business day."
    },
    { "type": "text", "id": "quick_order_title", "label": "Quick card — order", "default": "Where is my order?" },
    { "type": "text", "id": "quick_order_sub", "label": "Quick card — order link text", "default": "Track it live" },
    { "type": "url", "id": "track_url", "label": "Track order URL" },
    { "type": "text", "id": "quick_email_title", "label": "Quick card — email", "default": "Email us" },
    { "type": "text", "id": "support_email", "label": "Support email" },
    { "type": "text", "id": "label_name", "label": "Name label", "default": "Name" },
    { "type": "text", "id": "label_email", "label": "Email label", "default": "Email" },
    { "type": "text", "id": "label_order", "label": "Order label", "default": "Order number (if you have one)" },
    { "type": "text", "id": "order_placeholder", "label": "Order placeholder", "default": "e.g. #1624" },
    { "type": "text", "id": "label_message", "label": "Message label", "default": "Message" },
    { "type": "text", "id": "submit_label", "label": "Submit button", "default": "Send message" }
  ],
  "presets": [{ "name": "LS Contact Page" }]
}
{% endschema %}
