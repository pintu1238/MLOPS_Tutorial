{% liquid
  assign h = page.handle | downcase
  assign t = page.title | downcase
%}
{% if h contains 'track' or t contains 'track your order' or t contains 'track order' %}
  {% render 'ss-track-page' %}
{% elsif h == 'shop' or h == 'shop-all' %}
  {% render 'flytek-shop-all' %}
{% elsif h == 'offers' %}
  {% render 'flytek-shop-all',
    grid_catalog: 'super-micronized-creatine-monohydrate|flytek-shop-p01-beige-lifestyle.jpg|4.9|131|Offer|249g|Save,creatine-gold-combo-1kg|flytek-shop-p02-gold-combo.jpg|4.8|53|Offer|Gold|Bundle,creatine-training-stack|flytek-shop-p05-stack-green-gold.jpg|4.5|64|Offer|Stack|Value,creatine-shaker-combo|flytek-shop-p26-shaker-combo.jpg|4.7|72|Offer|Combo|Shaker,creatine-300g-gold-series|flytek-shop-p25-gold-series.jpg|4.8|61|Offer|Premium|Gold,creatine-mass-stack|flytek-shop-p22-mass-stack.jpg|4.4|51|Offer|Mass|Stack',
    grid_title: 'Offers',
    grid_sub: 'Limited-time creatine bundles and bestsellers — same lab-tested COREPULSE quality, bigger savings.',
    grid_title_id: 'ft-offers-title'
  %}
{% else %}
<section class="sspol">
  <div class="sspol__wrap">
    <h1>{{ page.title }}</h1>
    <div class="rte">{{ page.content }}</div>
  </div>
</section>
{% endif %}

{% schema %}
{
  "name": "Sira Page",
  "tag": "section",
  "class": "ss-page",
  "settings": [],
  "presets": [{ "name": "Sira Page" }]
}
{% endschema %}
