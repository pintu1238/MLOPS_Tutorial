<section class="ls-page ls-section" id="ls-reviews">
  <div class="ls-wrap">
    <div class="ls-reviews__summary">
      <p class="ls-kicker">{{ section.settings.kicker }}</p>
      <h2 class="ls-h2">{{ section.settings.heading }}</h2>
      <p><span class="ls-review__stars">★★★★★</span> <b>{{ section.settings.rating }}</b> average · {{ section.settings.count }}</p>
    </div>
    <div class="ls-reviews__grid">
      <article class="ls-review">
        <div class="ls-review__stars">★★★★★</div>
        <p>{{ section.settings.review_1 }}</p>
        <p class="ls-review__meta">{{ section.settings.review_1_author }}</p>
      </article>
      <article class="ls-review">
        <div class="ls-review__stars">★★★★★</div>
        <p>{{ section.settings.review_2 }}</p>
        <p class="ls-review__meta">{{ section.settings.review_2_author }}</p>
      </article>
      <article class="ls-review">
        <div class="ls-review__stars">★★★★★</div>
        <p>{{ section.settings.review_3 }}</p>
        <p class="ls-review__meta">{{ section.settings.review_3_author }}</p>
      </article>
      <article class="ls-review">
        <div class="ls-review__stars">★★★★☆</div>
        <p>{{ section.settings.review_4 }}</p>
        <p class="ls-review__meta">{{ section.settings.review_4_author }}</p>
      </article>
      <article class="ls-review">
        <div class="ls-review__stars">★★★★★</div>
        <p>{{ section.settings.review_5 }}</p>
        <p class="ls-review__meta">{{ section.settings.review_5_author }}</p>
      </article>
      <article class="ls-review">
        <div class="ls-review__stars">★★★★★</div>
        <p>{{ section.settings.review_6 }}</p>
        <p class="ls-review__meta">{{ section.settings.review_6_author }}</p>
      </article>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LS Reviews",
  "class": "ls-reviews-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "kicker", "default": "Real results" },
    { "type": "text", "id": "heading", "label": "heading", "default": "What customers are saying" },
    { "type": "text", "id": "rating", "label": "rating", "default": "4.2" },
    { "type": "text", "id": "count", "label": "count", "default": "6,700+ reviews" },
    { "type": "textarea", "id": "review_1", "label": "review 1", "default": "My ponytail feels thicker after about a month. The chews taste like candy — I never forget them." },
    { "type": "text", "id": "review_1_author", "label": "review 1 author", "default": "Megan R. — Austin, TX" },
    { "type": "textarea", "id": "review_2", "label": "review 2", "default": "I bought these for my husband and me. Easy routine, no giant pills. Hair looks healthier along my part line." },
    { "type": "text", "id": "review_2_author", "label": "review 2 author", "default": "Ryan & Jen — Columbus, OH" },
    { "type": "textarea", "id": "review_3", "label": "review 3", "default": "Week three and my stylist noticed less breakage. Mixed berry is actually good." },
    { "type": "text", "id": "review_3_author", "label": "review 3 author", "default": "Danielle K. — Charlotte, NC" },
    { "type": "textarea", "id": "review_4", "label": "review 4", "default": "Solid product. Took about 4 weeks to see a difference on my edges, but worth sticking with." },
    { "type": "text", "id": "review_4_author", "label": "review 4 author", "default": "Tasha M. — Atlanta, GA" },
    { "type": "textarea", "id": "review_5", "label": "review 5", "default": "Finally a hair vitamin I enjoy. One chew with coffee every morning." },
    { "type": "text", "id": "review_5_author", "label": "review 5 author", "default": "Laura S. — San Diego, CA" },
    { "type": "textarea", "id": "review_6", "label": "review 6", "default": "Shipping was fast. Pouch stays on my counter — whole family uses them." },
    { "type": "text", "id": "review_6_author", "label": "review 6 author", "default": "Chris P. — Denver, CO" }
  ],
  "presets": [{ "name": "LS Reviews" }]
}
{% endschema %}
