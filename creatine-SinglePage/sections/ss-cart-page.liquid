<section class="ss-cartpage">
  {% assign ss_cart_count = cart.item_count %}
  {% assign ss_cart_total = cart.total_price %}
  {% assign creatine_url = '/products/super-micronized-creatine-monohydrate' %}

  <h1>Your bag{% if ss_cart_count > 0 %} {{ ss_cart_count }}{% endif %}</h1>
  {% if ss_cart_count == 0 %}
    <p>Your bag is empty.</p>
    <a class="ssh btn" href="{{ creatine_url }}" style="display:inline-block;margin-top:16px">Shop Creatine →</a>
  {% else %}
    <div>
      {% for item in cart.items %}
        <div style="display:flex;gap:14px;padding:16px 0;border-bottom:1px solid #ece2d7">
          <a href="{{ item.url }}">{% if item.image %}<img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.product.title | escape }}" width="72" height="88" style="object-fit:cover;border-radius:8px">{% endif %}</a>
          <div style="flex:1">
            <a href="{{ item.url }}" style="font-weight:700;color:#26201C;text-decoration:none">{{ item.product.title }}</a>
            {% if item.variant.title != 'Default Title' %}
              <div style="font-size:13px;color:#6a5c53">{{ item.variant.title }}</div>
            {% endif %}
            <div>{% render 'ss-usd', ss_cents: item.final_line_price %}</div>
          </div>
        </div>
      {% endfor %}
      <p style="font-weight:800;margin:18px 0">Subtotal {% render 'ss-usd', ss_cents: ss_cart_total %}</p>
      <button type="button" data-ss-checkout style="background:#111111;color:#fff;border:0;border-radius:99px;padding:14px 28px;font-weight:800;cursor:pointer">Checkout</button>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Sira Cart Page",
  "tag": "section",
  "class": "ss-cart-page",
  "settings": [],
  "presets": [{ "name": "Sira Cart Page" }]
}
{% endschema %}
