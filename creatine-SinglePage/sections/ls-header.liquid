<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet">
{{ 'ss-core.css' | asset_url | stylesheet_tag }}
{{ 'lustrastrand.css' | asset_url | stylesheet_tag }}
{{ 'flytek-brand.css' | asset_url | stylesheet_tag }}

{% liquid
  assign home_url = section.settings.link_home
  assign shop_url = section.settings.link_shop_all | default: '/collections/creatine-monohydrate'
  assign bestsellers_url = section.settings.link_bestsellers | default: '/pages/best-sellers'
  assign offers_url = section.settings.link_offers | default: '/pages/offers'
  assign contact_url = section.settings.link_contact
  assign is_home = false
  assign is_shop_all = false
  assign is_bestsellers = false
  assign is_offers = false
  assign is_contact = false
  if request.page_type == 'index'
    assign is_home = true
  endif
  if request.page_type == 'collection' and collection.handle == 'creatine-monohydrate'
    assign is_shop_all = true
  endif
  if request.page_type == 'page'
    if page.handle == 'shop' or page.handle == 'shop-all'
      assign is_shop_all = true
    endif
    if page.handle == 'offers'
      assign is_offers = true
    endif
    if page.handle == 'best-sellers' or page.handle == 'bestsellers'
      assign is_bestsellers = true
    endif
  endif
  if request.page_type == 'page' and page.handle == 'contact'
    assign is_contact = true
  endif
  assign track_url = '/pages/track-order'
  assign is_track = false
  if request.page_type == 'page' and page.handle == 'track-order' or page.handle == 'track-your-order'
    assign is_track = true
  endif
%}

<header class="ls-hdr ls-hdr--split ls-hdr--logo-left">
  <div class="ls-hdr__bar">
    <button class="ls-hdr__burger" type="button" data-ss-open-menu aria-label="Menu">
      <svg width="22" height="18" viewBox="0 0 18 16" fill="none"><path d="M1 .5h16M1 8h16M1 15.5h16" stroke="currentColor" stroke-width="1.4"/></svg>
    </button>

    <a class="ls-hdr__logo" href="{{ home_url }}" aria-label="{{ section.settings.brand_name }}">
      {% if section.settings.logo != blank %}
        {{
          section.settings.logo
          | image_url: width: 600
          | image_tag: alt: section.settings.brand_name, loading: 'eager', class: 'ls-hdr__logo-img ls-hdr__logo-img--flytek'
        }}
      {% else %}
        <img
          class="ls-hdr__logo-img ls-hdr__logo-img--flytek"
          src="{{ 'corepulse-header-logo.png' | asset_url }}"
          alt="{{ section.settings.brand_name }}"
          width="220"
          height="72"
          loading="eager"
        >
      {% endif %}
    </a>

    <nav class="ls-hdr__left ls-hdr__nav-center" aria-label="Primary">
      <a href="{{ home_url }}" class="ls-nav-pill{% if is_home %} is-active{% endif %}">{{ section.settings.label_home }}</a>
      <a href="{{ shop_url }}" class="ls-nav-pill{% if is_shop_all %} is-active{% endif %}">{{ section.settings.label_shop_all | default: 'Shop All' }}</a>
      <a href="{{ bestsellers_url }}" class="ls-nav-pill ls-nav-pill--bestsellers{% if is_bestsellers %} is-active{% endif %}">{{ section.settings.label_bestsellers | default: 'Best Sellers' }}</a>
      <a href="{{ offers_url }}" class="ls-nav-pill ls-nav-pill--offers{% if is_offers %} is-active{% endif %}">{{ section.settings.label_offers | default: 'Offers' }}</a>
      <a href="{{ contact_url }}" class="ls-nav-pill{% if is_contact %} is-active{% endif %}">{{ section.settings.label_contact }}</a>
    </nav>

    <div class="ls-hdr__right">
      <a
        class="ls-hdr__icon ls-hdr__icon--track"
        href="{{ track_url }}"
        data-ss-track
        aria-label="Track order"
        {% if is_track %}aria-current="page"{% endif %}
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 7.25h11.25V16.5H3.75A.75.75 0 0 1 3 15.75V7.25Z"/>
          <path d="M14.25 10.5H18.6l2.15 3.1v2.4a.75.75 0 0 1-.75.75h-5.75"/>
          <circle cx="7.25" cy="17.75" r="1.55"/>
          <circle cx="17.35" cy="17.75" r="1.55"/>
        </svg>
      </a>
      <a class="ls-hdr__icon" href="{{ routes.account_login_url }}" aria-label="Log in">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="4"/><path d="M5 20c0-4 3.5-6 7-6s7 2 7 6"/></svg>
      </a>
      <a class="ls-hdr__icon ls-hdr__icon--cart" href="{{ routes.cart_url }}" data-ss-open-cart aria-label="Cart" role="button">
        <svg width="22" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M7 7h14l-1.2 8H8.2L7 7Z"/><path d="M7 7 6 4H3"/><circle cx="10" cy="19" r="1"/><circle cx="17" cy="19" r="1"/></svg>
        <span class="ss-hdr__count" data-ss-cart-count>0</span>
      </a>
    </div>
  </div>
</header>

<div class="smd" role="dialog" aria-label="Menu">
  <div class="smd__overlay" data-ss-close-menu></div>
  <div class="smd__panel">
    <div class="smd__head">
      <div class="smd__title">Menu</div>
      <button class="smd__x" type="button" data-ss-close-menu aria-label="Close">✕</button>
    </div>
    <div class="smd__body">
      <a class="smd__link{% if is_home %} is-active{% endif %}" href="{{ home_url }}"><span class="smd__ltxt">{{ section.settings.label_home }}</span><span class="smd__chev" aria-hidden="true">›</span></a>
      <a class="smd__link{% if is_shop_all %} is-active{% endif %}" href="{{ shop_url }}"><span class="smd__ltxt">{{ section.settings.label_shop_all | default: 'Shop All' }}</span><span class="smd__chev" aria-hidden="true">›</span></a>
      <a class="smd__link smd__link--bestsellers{% if is_bestsellers %} is-active{% endif %}" href="{{ bestsellers_url }}"><span class="smd__ltxt">{{ section.settings.label_bestsellers | default: 'Best Sellers' }}</span><span class="smd__chev" aria-hidden="true">›</span></a>
      <a class="smd__link smd__link--offers{% if is_offers %} is-active{% endif %}" href="{{ offers_url }}"><span class="smd__ltxt">{{ section.settings.label_offers | default: 'Offers' }}</span><span class="smd__chev" aria-hidden="true">›</span></a>
      <a class="smd__link{% if is_contact %} is-active{% endif %}" href="{{ contact_url }}"><span class="smd__ltxt">{{ section.settings.label_contact }}</span><span class="smd__chev" aria-hidden="true">›</span></a>
      <a class="smd__link{% if is_track %} is-active{% endif %}" href="{{ track_url }}" data-ss-track><span class="smd__ltxt">Track Order</span><span class="smd__chev" aria-hidden="true">›</span></a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "LS Header",
  "class": "ls-header-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "COREPULSE" },
    { "type": "image_picker", "id": "logo", "label": "Logo (upload for best clarity)" },
    { "type": "text", "id": "label_home", "label": "Home label", "default": "Home" },
    { "type": "text", "id": "label_shop_all", "label": "Shop All label", "default": "Shop All" },
    { "type": "text", "id": "label_bestsellers", "label": "Best Sellers label", "default": "Best Sellers" },
    { "type": "text", "id": "label_offers", "label": "Offers label", "default": "Offers" },
    { "type": "text", "id": "label_contact", "label": "Contact label", "default": "Contact" },
    { "type": "text", "id": "link_home", "label": "Home URL", "default": "/" },
    { "type": "text", "id": "link_shop_all", "label": "Shop All URL", "default": "/collections/creatine-monohydrate" },
    { "type": "text", "id": "link_bestsellers", "label": "Best Sellers URL", "default": "/pages/best-sellers" },
    { "type": "text", "id": "link_offers", "label": "Offers URL", "default": "/pages/offers" },
    { "type": "text", "id": "link_contact", "label": "Contact URL", "default": "/pages/contact" }
  ],
  "presets": [{ "name": "LS Header" }]
}
{% endschema %}
