.ss-lp2 .rev{transition:transform .25s ease,box-shadow .25s ease}
.ss-lp2 .rev:hover{transform:translateY(-4px);box-shadow:0 14px 32px rgba(38,32,28,.12)}
@media(prefers-reduced-motion:reduce){.ss-lp2 .reveal{opacity:1;transform:none;transition:none}}
</style>
<script>(function(){
 var els=document.querySelectorAll('.ss-lp2 .size-sec .wrap,.ss-lp2 .ba-img,.ss-lp2 .rev,.ss-lp2 .faq details,.ss-lp2 .final');
 if(!els.length)return;
 els.forEach(function(e,i){e.classList.add('reveal');e.style.transitionDelay=((i%3)*70)+'ms';});
 if(!('IntersectionObserver' in window)){els.forEach(function(e){e.classList.add('in');});return;}
 var io=new IntersectionObserver(function(en){en.forEach(function(x){if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target);}});},{threshold:.1,rootMargin:'0px 0px -5% 0px'});
 els.forEach(function(e){io.observe(e);});
})();</script>
<script>window.ssRevScroll=function(dir){var g=document.getElementById('ssRevGrid');if(!g)return;var c=g.querySelector('.rev');var w=c?c.getBoundingClientRect().width+14:280;g.scrollBy({left:dir*w,behavior:'smooth'});};</script>

