{% doc %}
  Returns comma-separated theme asset filenames (8) for COREPULSE creatine PDP galleries.
  @param {string} handle - product.handle
{% enddoc %}
{%- liquid
  assign product_handle = handle | default: ''
  assign hero_asset = 'flytek-shop-p01-beige-lifestyle.jpg'

  case product_handle
    when 'super-micronized-creatine-monohydrate'
      assign hero_asset = 'flytek-shop-p01-beige-lifestyle.jpg'
    when 'creatine-monohydrate-100g-unflavoured'
      assign hero_asset = 'flytek-shop-249-unflavoured.jpg'
    when 'creatine-monohydrate-400g-unflavoured'
      assign hero_asset = 'flytek-shop-p04-black-clean.jpg'
    when 'creatine-monohydrate-320g-citrus-blast'
      assign hero_asset = 'flytek-shop-p03-red-citrus.jpg'
    when 'creatine-monohydrate-320g-sunset-mango'
      assign hero_asset = 'corepulse-arrivals-scoop.jpg'
    when 'creatine-monohydrate-320g-juicy-berries'
      assign hero_asset = 'flytek-shop-p27-juicy-berries.jpg'
    when 'creapure-creatine-250g-unflavoured'
      assign hero_asset = 'flytek-shop-p29-creapure-white.jpg'
    when 'micronised-creatine-200g-fruit-splash'
      assign hero_asset = 'flytek-shop-p28-fruit-splash.jpg'
    when 'creatine-gold-combo-1kg'
      assign hero_asset = 'flytek-shop-p02-gold-combo.jpg'
    when 'creatine-training-stack'
      assign hero_asset = 'flytek-shop-p05-stack-green-gold.jpg'
    when 'creatine-chocolate-pouch-250g'
      assign hero_asset = 'flytek-shop-p06-mint-pouch.jpg'
    when 'creatine-320g-blue-raspberry'
      assign hero_asset = 'flytek-sale-02.jpg'
    when 'creatine-320g-green-apple'
      assign hero_asset = 'corepulse-hero-slide-02.jpg'
    when 'creatine-320g-lemon-lime'
      assign hero_asset = 'corepulse-hero-slide-04.jpg'
    when 'creatine-320g-peach-iced-tea'
      assign hero_asset = 'flytek-shop-p10-peach-tea.jpg'
    when 'creatine-200g-grape'
      assign hero_asset = 'flytek-shop-p11-grape.jpg'
    when 'creatine-320g-pineapple'
      assign hero_asset = 'flytek-shop-p12-pineapple.jpg'
    when 'creatine-250g-iced-coffee'
      assign hero_asset = 'flytek-shop-p13-iced-coffee.jpg'
    when 'creatine-320g-lychee-swirl'
      assign hero_asset = 'flytek-shop-p15-lychee.jpg'
    when 'creatine-250g-fruit-punch'
      assign hero_asset = 'flytek-sale-03.jpg'
    when 'creatine-400g-cola'
      assign hero_asset = 'flytek-shop-p17-cola.jpg'
    when 'creatine-500g-mixed-berry'
      assign hero_asset = 'flytek-shop-p18-mixed-berry.jpg'
    when 'creatine-1kg-unflavoured'
      assign hero_asset = 'flytek-brand-pack-hero.jpg'
    when 'creatine-mass-stack'
      assign hero_asset = 'flytek-shop-p22-mass-stack.jpg'
    when 'creatine-250g-chocolate'
      assign hero_asset = 'flytek-shop-p23-chocolate.jpg'
    when 'creatine-300g-gold-series'
      assign hero_asset = 'flytek-shop-p25-gold-series.jpg'
    when 'creatine-shaker-combo'
      assign hero_asset = 'flytek-shop-p26-shaker-combo.jpg'
    when 'creatine-320g-mango'
      assign hero_asset = 'flytek-shop-p30-mango.jpg'
    when 'creatine-monohydrate-640g-watermelon'
      assign hero_asset = 'flytek-shop-p19-watermelon-big.jpg'
    when 'creatine-monohydrate-320g-watermelon'
      assign hero_asset = 'flytek-shop-p14-candy-rush.jpg'
  endcase

  assign shared_gallery = 'flytek-pdp-shared-02.jpg,flytek-pdp-shared-03.jpg,flytek-pdp-shared-04.jpg,flytek-pdp-shared-05.jpg,flytek-pdp-shared-06.jpg,flytek-pdp-shared-07.jpg,flytek-pdp-shared-08.jpg' | split: ','
-%}{{- hero_asset -}},
{%- for img in shared_gallery -%}
  {{- img | strip -}}{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
