{% doc %}
  Category icon row: gold bar, black labels, matching line-art icons.
  @param {string} [creatine_url] - Creatine product URL
  @param {string} [shop_url] - Shop / collection URL

  @example
  {% render 'ft-category-icons', creatine_url: product.url, shop_url: '/collections/all' %}
{% enddoc %}

{%- liquid
  assign creatine_url = creatine_url | default: '/products/super-micronized-creatine-monohydrate'
  assign shop_url = shop_url | default: '/collections/creatine-monohydrate'
-%}

<nav class="ft-cats" aria-label="Shop categories">
  <ul class="ft-cats__row" role="list">
    <li>
      <a class="ft-cats__item" href="{{ shop_url }}">
        <span class="ft-cats__icon" aria-hidden="true">
          <img src="{{ 'ft-cat-protein.png' | asset_url }}" alt="" width="88" height="88" loading="eager">
        </span>
        <span class="ft-cats__label">Protein</span>
      </a>
    </li>
    <li>
      <a class="ft-cats__item" href="{{ creatine_url }}">
        <span class="ft-cats__icon" aria-hidden="true">
          <img src="{{ 'ft-cat-creatine.png' | asset_url }}" alt="" width="88" height="88" loading="eager">
        </span>
        <span class="ft-cats__label">Creatine</span>
      </a>
    </li>
    <li>
      <a class="ft-cats__item" href="{{ creatine_url }}">
        <span class="ft-cats__icon" aria-hidden="true">
          <img src="{{ 'ft-cat-offers.png' | asset_url }}" alt="" width="88" height="88" loading="eager">
        </span>
        <span class="ft-cats__label">Offers</span>
      </a>
    </li>
    <li>
      <a class="ft-cats__item" href="{{ shop_url }}">
        <span class="ft-cats__icon" aria-hidden="true">
          <img src="{{ 'ft-cat-gainers.png' | asset_url }}" alt="" width="88" height="88" loading="lazy">
        </span>
        <span class="ft-cats__label">Gainers</span>
      </a>
    </li>
    <li>
      <a class="ft-cats__item" href="{{ shop_url }}">
        <span class="ft-cats__icon" aria-hidden="true">
          <img src="{{ 'ft-cat-amino.png' | asset_url }}" alt="" width="88" height="88" loading="lazy">
        </span>
        <span class="ft-cats__label">Amino Acids</span>
      </a>
    </li>
    <li>
      <a class="ft-cats__item" href="{{ shop_url }}">
        <span class="ft-cats__icon" aria-hidden="true">
          <img src="{{ 'ft-cat-preworkout.png' | asset_url }}" alt="" width="88" height="88" loading="lazy">
        </span>
        <span class="ft-cats__label">Pre Workout</span>
      </a>
    </li>
    <li>
      <a class="ft-cats__item" href="{{ shop_url }}">
        <span class="ft-cats__icon" aria-hidden="true">
          <img src="{{ 'ft-cat-wellness.png' | asset_url }}" alt="" width="88" height="88" loading="lazy">
        </span>
        <span class="ft-cats__label">Wellness</span>
      </a>
    </li>
  </ul>
</nav>

{% stylesheet %}
  .ft-cats {
    background: #fff;
    padding: 4.45rem 200px 1.6rem;
  }

  .ft-cats__row {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: none;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .ft-cats__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    min-width: 0;
    text-decoration: none;
    color: #000000;
  }

  .flytek-home .ft-cats__item,
  .flytek-home .ft-cats__item:hover,
  .flytek-home .ft-cats__label {
    color: #000000;
  }

  .ft-cats__icon {
    width: 8.5rem;
    height: 8.5rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #f0c56e;
    color: #000;
    box-shadow: 0 6px 16px #0000001f;
    overflow: hidden;
  }

  .ft-cats__icon img {
    width: 70%;
    height: 70%;
    object-fit: contain;
    filter: brightness(0);
  }

  .ft-cats__label {
    font-family: "DM Sans", Poppins, sans-serif;
    font-size: 1.24rem;
    font-weight: 600;
    color: #000;
    text-align: center;
    line-height: 1.2;
    white-space: nowrap;
  }

  .ft-cats__item:hover .ft-cats__icon {
    transform: translateY(-2px);
  }

  @media (max-width: 1399px) {
    .ft-cats {
      padding-inline: 40px;
    }
  }

  @media (max-width: 1100px) {
    .ft-cats__icon {
      width: 7.2rem;
      height: 7.2rem;
    }
  }

  @media (max-width: 899px) {
    .ft-cats {
      padding: 1rem 0 1.2rem;
    }

    .ft-cats__row {
      justify-content: flex-start;
      gap: 1.05rem;
      overflow-x: auto;
      padding: 0.2rem 1rem 0.5rem;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .ft-cats__row::-webkit-scrollbar {
      display: none;
    }

    .ft-cats__item {
      flex: 0 0 auto;
    }

    .ft-cats__icon {
      width: 6.6rem;
      height: 6.6rem;
    }

    .ft-cats__label {
      font-size: clamp(0.85rem, 3.4vw, 1.24rem);
    }
  }
{% endstylesheet %}
