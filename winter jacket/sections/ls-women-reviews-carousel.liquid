{{ 'lustrastrand.css' | asset_url | stylesheet_tag }}
<section class="ls-wrc" id="ls-wrc-{{ section.id }}" aria-label="{{ section.settings.heading | escape }}">
  {% render 'wj-section-video', file: 'wj-video-carousel.mp4', poster: 'ls-wrc-review-01.jpg', label: 'Riders wearing the Yufawow winter jacket' %}
  <div class="ls-wrc__inner">
    <div class="ls-wrc__head">
      <p class="ls-wrc__rating-pill">
        <span class="ls-wrc__stars" aria-hidden="true">★★★★★</span>
        {{ section.settings.rating_line }}
      </p>
      <p class="ls-wrc__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="ls-wrc__title">{{ section.settings.heading }}</h2>
    </div>
    <div class="ls-wrc__viewport">
      <div class="ls-wrc__track" data-ls-wrc-track tabindex="0">
        {% assign review_images = 'ls-wrc-review-01.jpg|ls-wrc-review-02.jpg|ls-wrc-review-03.jpg|ls-wrc-review-04.jpg|ls-wrc-review-05.jpg|ls-wrc-review-06.jpg' | split: '|' %}
        {% for i in (1..6) %}
          {% case i %}
            {% when 1 %}
              {% assign body = section.settings.review_1 %}
              {% assign author = section.settings.author_1 %}
            {% when 2 %}
              {% assign body = section.settings.review_2 %}
              {% assign author = section.settings.author_2 %}
            {% when 3 %}
              {% assign body = section.settings.review_3 %}
              {% assign author = section.settings.author_3 %}
            {% when 4 %}
              {% assign body = section.settings.review_4 %}
              {% assign author = section.settings.author_4 %}
            {% when 5 %}
              {% assign body = section.settings.review_5 %}
              {% assign author = section.settings.author_5 %}
            {% when 6 %}
              {% assign body = section.settings.review_6 %}
              {% assign author = section.settings.author_6 %}
          {% endcase %}
          {% assign img_file = review_images[forloop.index0] %}
          <article class="ls-wrc__card">
            <div class="ls-wrc__photo">
              <img src="{{ img_file | asset_url }}" alt="" width="400" height="520" loading="lazy">
            </div>
            <div class="ls-wrc__card-body">
              <div class="ls-wrc__card-stars" aria-hidden="true">★★★★★</div>
              <blockquote class="ls-wrc__quote">“{{ body }}”</blockquote>
              <div class="ls-wrc__card-foot">
                <span class="ls-wrc__verified" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="11" fill="currentColor"/><path d="M7 12.5l3 3 7-7.5" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                <p class="ls-wrc__author">{{ author }}</p>
              </div>
            </div>
          </article>
        {% endfor %}
      </div>
    </div>
    <div class="ls-wrc__nav">
      <button class="ls-wrc__arrow" type="button" data-ls-wrc-prev aria-label="Previous reviews">‹</button>
      <button class="ls-wrc__arrow" type="button" data-ls-wrc-next aria-label="Next reviews">›</button>
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('ls-wrc-{{ section.id }}');
    if (!root) return;
    var track = root.querySelector('[data-ls-wrc-track]');
    var prev = root.querySelector('[data-ls-wrc-prev]');
    var next = root.querySelector('[data-ls-wrc-next]');
    if (!track || !prev || !next) return;

    function step() {
      var card = track.querySelector('.ls-wrc__card');
      if (!card) return 320;
      var gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap) || 20;
      return card.offsetWidth + gap;
    }

    function scrollByDir(dir) {
      track.scrollBy({ left: dir * step(), behavior: 'smooth' });
    }

    prev.addEventListener('click', function () { scrollByDir(-1); });
    next.addEventListener('click', function () { scrollByDir(1); });
  })();
</script>

{% schema %}
{
  "name": "LS Women Reviews Carousel",
  "class": "ls-women-reviews-carousel-section",
  "settings": [
    {
      "type": "text",
      "id": "rating_line",
      "label": "Rating line",
      "default": "Rated 4.9/5 based on +12,537 Total Ratings"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A DAILY RITUAL FOR" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "50,000+ Happy Women" },
    {
      "type": "textarea",
      "id": "review_1",
      "label": "Review 1",
      "default": "Week four and my ponytail actually feels thicker. I keep the pouch on my counter so I never skip my chew."
    },
    { "type": "text", "id": "author_1", "label": "Author 1", "default": "Michelle W. — Seattle, Washington" },
    {
      "type": "textarea",
      "id": "review_2",
      "label": "Review 2",
      "default": "Mixed berry tastes like a treat — not a vitamin. My edges look fuller and my stylist noticed less breakage."
    },
    { "type": "text", "id": "author_2", "label": "Author 2", "default": "Jessica R. — San Diego, California" },
    {
      "type": "textarea",
      "id": "review_3",
      "label": "Review 3",
      "default": "Postpartum shedding was scary. One soft chew a day is easy — baby hairs are coming in along my part."
    },
    { "type": "text", "id": "author_3", "label": "Author 3", "default": "Sofia L. — Austin, Texas" },
    {
      "type": "textarea",
      "id": "review_4",
      "label": "Review 4",
      "default": "I bought these for my husband and me. No giant pills, just a chew with coffee every morning."
    },
    { "type": "text", "id": "author_4", "label": "Author 4", "default": "Ryan & Jen — Columbus, Ohio" },
    {
      "type": "textarea",
      "id": "review_5",
      "label": "Review 5",
      "default": "Shipping was fast. I've tried biotin gummies before — these actually taste good and I stick with them."
    },
    { "type": "text", "id": "author_5", "label": "Author 5", "default": "Laura S. — Charlotte, North Carolina" },
    {
      "type": "textarea",
      "id": "review_6",
      "label": "Review 6",
      "default": "Love that it's drug-free with Lustriva inside. Hair looks shinier and feels stronger when I brush it."
    },
    { "type": "text", "id": "author_6", "label": "Author 6", "default": "Danielle K. — Denver, Colorado" }
  ],
  "presets": [{ "name": "LS Women Reviews Carousel" }]
}
{% endschema %}
