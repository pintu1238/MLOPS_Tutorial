<section class="sstr" style="--plum:#4A2E3A;--plum-soft:#63414F;--clay:#B87A6B;--clay-deep:#9E5F50;--cream:#FAF6F1;--sand:#EDE3D8;--ink:#2E2733;--ink-soft:#6A6068;--line:#E6DACE;">
  <div class="sstr__wrap">
    <header class="sstr__head">
      <p class="sstr__eyebrow">Track Your Order</p>
      <h1 class="sstr__title">Where's my order?</h1>
      <p class="sstr__sub">Pop in the tracking number from your shipping email and we'll show you exactly where your Sira Sculpt order is.</p>
    </header>

    <div class="sstr__card">
      <label class="sstr__label" for="YQNum">Tracking number</label>
      <div class="sstr__inputrow">
        <input type="text" id="YQNum" class="sstr__input" name="track-order-number" maxlength="50" placeholder="Enter your tracking number" autocomplete="off">
        <button type="button" class="sstr__btn" onclick="ssDoTrack()">Track</button>
      </div>
      <p class="sstr__hint">Tip: tracking can take 24 to 48 hours to update after your order ships.</p>
      <div id="YQContainer" class="sstr__result"></div>
    </div>

    <div class="sstr__steps">
      <div class="sstr__step">
        <div class="sstr__step-ic" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg>
        </div>
        <p class="sstr__step-h">Find your number</p>
        <p class="sstr__step-b">It's in your shipping-confirmation email, right under "Your order is on the way."</p>
      </div>
      <div class="sstr__step">
        <div class="sstr__step-ic" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        </div>
        <p class="sstr__step-h">Paste &amp; track</p>
        <p class="sstr__step-b">Drop it in the box above and hit track for a live status update.</p>
      </div>
      <div class="sstr__step">
        <div class="sstr__step-ic" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z"/></svg>
        </div>
        <p class="sstr__step-h">Need a hand?</p>
        <p class="sstr__step-b">Can't find it or something looks off? Email <a href="mailto:support@sirasculpt.com">support@sirasculpt.com</a> and we'll chase it down.</p>
      </div>
    </div>
  </div>
</section>

<script src="//www.17track.net/externalcall.js" defer></script>
<script>
  function ssDoTrack(){
    var el=document.getElementById('YQNum');
    if(!el) return;
    var num=el.value.trim();
    if(!num){ el.focus(); return; }
    if(typeof YQV5==='undefined'){ el.focus(); return; }
    YQV5.trackSingle({
      YQ_ContainerId:'YQContainer',
      YQ_Height:560,
      YQ_Fc:'0',
      YQ_Lang:'en',
      YQ_Num:num
    });
  }
  (function(){
    var el=document.getElementById('YQNum');
    if(!el) return;
    el.addEventListener('keydown',function(e){ if(e.key==='Enter'){ e.preventDefault(); ssDoTrack(); } });
  })();
</script>
<style>
  .shopify-section.ss-track,
  .shopify-section.ss-page,
  .shopify-section.ss-404{padding:0!important;margin:0!important;background:#FAF6F1}
  .sstr{
    background:#FAF6F1;font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
    color:var(--ink);min-height:70vh;
  }
  .sstr *{box-sizing:border-box}
  .sstr__wrap{max-width:820px;margin:0 auto;padding:64px 24px 80px}
  .sstr__head{text-align:center;max-width:640px;margin:0 auto 36px}
  .sstr__eyebrow{margin:0 0 14px;font-size:11px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--clay-deep)}
  .sstr .sstr__title{
    margin:0;font-family:'Fraunces',Georgia,serif;font-weight:600;color:var(--plum);
    font-size:clamp(34px,5.2vw,48px);line-height:1.08;letter-spacing:-.02em;white-space:nowrap;
  }
  .sstr__sub{margin:16px auto 0;max-width:560px;font-size:17px;line-height:1.55;color:var(--ink-soft);font-weight:400}

  .sstr__card{background:#fff;border:1px solid var(--line);border-radius:20px;padding:28px 28px 26px;box-shadow:0 8px 28px rgba(74,46,58,.06)}
  .sstr__label{display:block;margin:0 0 9px;font-size:13.5px;font-weight:600;color:var(--plum)}
  .sstr__inputrow{display:flex;gap:12px;align-items:stretch}
  .sstr__input{
    flex:1;font-family:inherit;font-size:15.5px;color:var(--ink);
    background:#FAF6F1;border:1.5px solid var(--line);border-radius:14px;
    padding:14px 16px;outline:none;min-height:52px;
  }
  .sstr__input:focus{border-color:var(--clay);box-shadow:0 0 0 3px rgba(184,122,107,.16);background:#fff}
  .sstr__btn{
    flex:0 0 auto;cursor:pointer;background:var(--plum);color:#fff;border:0;
    border-radius:999px;padding:0 28px;min-width:118px;font-family:inherit;font-weight:700;font-size:14px;
    letter-spacing:.04em;text-transform:uppercase;transition:filter .16s,transform .16s;
  }
  .sstr__btn:hover{filter:brightness(1.08)}
  .sstr__btn:active{transform:translateY(1px)}
  .sstr__hint{margin:12px 0 0;font-size:13px;color:var(--ink-soft)}
  .sstr__result{margin-top:8px}
  .sstr__result:not(:empty){margin-top:24px;border-top:1px solid var(--line);padding-top:20px}

  .sstr__steps{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:22px}
  .sstr__step{background:#fff;border:1px solid var(--line);border-radius:18px;padding:22px 20px 24px}
  .sstr__step-ic{width:44px;height:44px;border-radius:12px;background:var(--sand);color:var(--plum);display:flex;align-items:center;justify-content:center;margin:0 0 16px}
  .sstr__step-h{margin:0 0 8px;font-family:'Fraunces',Georgia,serif;font-weight:600;font-size:18px;color:var(--plum)}
  .sstr__step-b{margin:0;font-size:14.5px;line-height:1.55;color:var(--ink-soft)}
  .sstr__step-b a{color:var(--clay-deep);text-decoration:underline;text-underline-offset:2px}

  @media (max-width:720px){
    .sstr__steps{grid-template-columns:1fr}
    .sstr__inputrow{flex-direction:column}
    .sstr__btn{padding:14px 24px;min-height:50px}
    .sstr__wrap{padding:40px 18px 56px}
    .sstr .sstr__title{white-space:normal}
  }
</style>
