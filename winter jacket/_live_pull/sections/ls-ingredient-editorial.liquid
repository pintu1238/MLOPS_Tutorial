<section class="ls-page ls-section" id="ls-ingredients">
  <div class="ls-wrap ls-split">
    <div class="ls-split__media">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1000 | image_tag: alt: 'Lustriva ingredient', loading: 'lazy' }}
      {% else %}
        <img src="{{ 'ls-product-main.jpg' | asset_url }}" alt="Lustriva ingredient" width="800" height="800" loading="lazy">
      {% endif %}
    </div>
    <div>
      <p class="ls-kicker">{{ section.settings.kicker }}</p>
      <h2 class="ls-h2">{{ section.settings.heading }}</h2>
      <p class="ls-lead">{{ section.settings.body }}</p>
      <a class="ls-btn" href="#ls-buy">{{ section.settings.cta }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LS Ingredient Story",
  "class": "ls-ingredient-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "kicker", "label": "kicker", "default": "Star ingredient" },
    { "type": "text", "id": "heading", "label": "heading", "default": "Clinically studied Lustriva® complex" },
    { "type": "textarea", "id": "body", "label": "body",
      "default": "Lustriva® combines bonded arginine silicate with magnesium biotinate — designed to support hair health from within. Pair it with a simple daily soft chew routine and stay consistent for best results."
    },
    { "type": "text", "id": "cta", "label": "cta", "default": "Shop LustraStrand" }
  ],
  "presets": [{ "name": "LS Ingredient Story" }]
}
{% endschema %}
