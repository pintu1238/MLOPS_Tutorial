<footer class="ls-footer">
  <div class="ls-wrap">
    <div class="ls-footer__grid">
      <div>
        <h3>Shop</h3>
        <a href="/products/lustra-strand-hair-growth-accelerator-soft-chews">Soft Chews</a>
        <a href="/">Home</a>
      </div>
      <div>
        <h3>Support</h3>
        <a href="/pages/contact">Contact</a>
        <a href="/pages/track-order">Track Order</a>
        <a href="/policies/shipping-policy">Shipping</a>
        <a href="/policies/refund-policy">Returns</a>
      </div>
      <div>
        <h3>Stay in touch</h3>
        <p>{{ section.settings.newsletter_text }}</p>
        {% form 'customer', class: 'ls-footer__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="email" name="contact[email]" placeholder="your@email.com" required style="width:100%;padding:10px;border-radius:8px;border:0;margin-bottom:8px">
          <button type="submit" class="ls-btn" style="width:100%">Subscribe</button>
        {% endform %}
      </div>
    </div>
    <div class="ls-footer__legal">
      <p>© {{ 'now' | date: '%Y' }} {{ section.settings.brand_name }}. All rights reserved.</p>
      <a href="/policies/privacy-policy">Privacy</a> · <a href="/policies/terms-of-service">Terms</a>
      <p class="ls-footer__disclaimer">{{ section.settings.disclaimer }}</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "LS Footer",
  "class": "ls-footer-section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    { "type": "text", "id": "brand_name", "label": "brand name", "default": "LustraStrand" },
    { "type": "text", "id": "newsletter_text", "label": "newsletter text", "default": "Hair tips, restock alerts, and exclusive offers. No spam." },
    { "type": "textarea", "id": "disclaimer", "label": "disclaimer",
      "default": "*These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease. Individual results may vary."
    }
  ],
  "presets": [{ "name": "LS Footer" }]
}
{% endschema %}
