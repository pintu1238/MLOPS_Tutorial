<script>
(function(){
  var root=document.querySelector('[data-ssbg]'); if(!root) return;
  var main=root.querySelector('#ssbgMain');
  var btns=root.querySelectorAll('.ss-bookgal__th');
  var i=0;
  function show(n){
    if(!btns.length) return;
    if(n<0) n=btns.length-1;
    if(n>=btns.length) n=0;
    i=n;
    btns.forEach(function(b,k){ b.classList.toggle('on', k===i); });
    main.src=btns[i].getAttribute('data-src');
  }
  root.querySelector('.ss-bookgal__arr--l').addEventListener('click', function(){ show(i-1); });
  root.querySelector('.ss-bookgal__arr--r').addEventListener('click', function(){ show(i+1); });
  btns.forEach(function(b,k){ b.addEventListener('click', function(){ show(k); }); });
})();
</script>
