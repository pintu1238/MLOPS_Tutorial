<div class="ss-track-fallback">
  {% render 'ss-track-page' %}
</div>
<section class="ss404">
  <div class="ss404__box">
    <h1>Page not found</h1>
    <p>The link may be incorrect, or the page has been removed.</p>
    <a class="ss404__btn" href="/collections/best-sellers">Continue shopping</a>
  </div>
</section>
<style>
html:not(.ss-track-url) .ss-track-fallback{display:none!important}
html.ss-track-url .ss404{display:none!important}
html.ss-track-url .ss-track-fallback{display:block}
.ss404{background:#FAF6F1;min-height:48vh;font-family:Inter,-apple-system,sans-serif;color:#26201C}
.ss404__box{text-align:center;padding:100px 20px 80px}
.ss404 h1{font-family:Fraunces,Georgia,serif;font-size:clamp(28px,4vw,40px);margin:0 0 12px;font-weight:600}
.ss404 p{color:#5a4c44;font-size:16px;margin:0 0 24px}
.ss404__btn{display:inline-flex;align-items:center;justify-content:center;background:#26201C;color:#fff;text-decoration:none;font-weight:700;font-size:14px;padding:12px 22px;border-radius:100px}
.ss404__btn:hover{background:#4A2E3A}
</style>
<script>
(function(){
  try{
    var p=(location.pathname||'').toLowerCase();
    var want=p.indexOf('track')!==-1||sessionStorage.getItem('ssWantTrack')==='1';
    if(want){
      document.documentElement.classList.add('ss-track-url');
      document.title="Track Your Order";
      sessionStorage.removeItem('ssWantTrack');
    }
  }catch(e){}
})();
</script>
{% schema %}
{
  "name": "Sira 404",
  "tag": "section",
  "class": "ss-404",
  "settings": [],
  "presets": [{ "name": "Sira 404" }]
}
{% endschema %}
