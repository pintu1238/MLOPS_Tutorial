{% comment %}
  Section contract.
  Girls Winter product page — Sira-style offer layout with expandable bundles.
  Uses the current product. Merchant copy lives in section settings and blocks.
  @example
  Assigned as the main section on templates/product.json.
{% endcomment %}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign compare_at = current_variant.compare_at_price
  if compare_at == blank or compare_at <= current_variant.price
    assign compare_at = current_variant.price | times: 2
  endif
  assign featured = product.featured_media
  if featured != blank and featured.media_type != 'image'
    if featured.preview_image != blank
      assign featured = featured.preview_image
    else
      assign featured = blank
    endif
  endif
  if featured == blank
    for media in product.media
      if media.media_type == 'image'
        assign featured = media
        break
      endif
    endfor
  endif
  assign story_thumb_assets = 'gw-gallery-belted-detail.jpg,gw-gallery-burgundy-detail.jpg,gw-gallery-camel-detail.jpg' | split: ','
  assign supplemental_gallery_assets = '' | split: ','
  assign supplemental_ugc_assets = '' | split: ','
  assign mini_review_assets = 'gw-review-01.jpg,gw-review-02.jpg,gw-review-03.jpg,gw-review-04.jpg,gw-review-05.jpg,gw-review-06.jpg,gw-review-07.jpg,gw-review-08.jpg' | split: ','
  assign compare_without_asset = ''
  assign compare_with_asset = ''
  case product.handle
    when 'chocolate-wool-jacket'
      assign supplemental_gallery_assets = 'gw-gallery-chocolate-life.jpg,gw-gallery-chocolate-back.jpg,gw-gallery-chocolate-detail.jpg,gw-gallery-chocolate-card.jpg,gw-gallery-camel.jpg,gw-gallery-black.jpg,gw-gallery-ivory.jpg,gw-gallery-burgundy.jpg,gw-gallery-charcoal.jpg,gw-gallery-chocolate.jpg' | split: ','
      assign supplemental_ugc_assets = 'gw-gallery-chocolate-life.jpg,gw-gallery-chocolate-back.jpg,gw-gallery-chocolate-detail.jpg,gw-gallery-chocolate-card.jpg' | split: ','
      assign compare_without_asset = 'gw-gallery-puffer-back.jpg'
      assign compare_with_asset = 'gw-gallery-chocolate-life.jpg'
    when 'belted-wool-jacket'
      assign supplemental_gallery_assets = 'gw-gallery-belted-back.jpg,gw-gallery-belted-card.jpg,gw-gallery-belted-detail.jpg' | split: ','
      assign supplemental_ugc_assets = 'gw-gallery-belted-back.jpg,gw-gallery-belted-card.jpg,gw-gallery-belted-detail.jpg' | split: ','
    when 'camel-crewneck'
      assign supplemental_gallery_assets = 'gw-gallery-camelcrew-back.jpg,gw-gallery-camelcrew-card.jpg,gw-gallery-camelcrew-detail.jpg' | split: ','
      assign supplemental_ugc_assets = 'gw-gallery-camelcrew-back.jpg,gw-gallery-camelcrew-card.jpg,gw-gallery-camelcrew-detail.jpg' | split: ','
  endcase
  assign featured_asset_fallback = ''
  if featured == blank and supplemental_gallery_assets.size > 0
    assign featured_asset_fallback = supplemental_gallery_assets.first
  endif
  if featured == blank and featured_asset_fallback == blank and compare_with_asset != blank
    assign featured_asset_fallback = compare_with_asset
  endif
  assign featured_alt = product.title
  if featured != blank and featured.alt != blank
    assign featured_alt = featured.alt
  endif
  assign json_featured_image_url = ''
  if featured != blank
    assign json_featured_image_url = featured | image_url: width: 240
  elsif featured_asset_fallback != blank
    assign json_featured_image_url = featured_asset_fallback | asset_img_url: '240x'
  endif
%}

{% style %}
  #shopify-section-{{ section.id }} {
    overflow-x: clip;
    max-width: 100%;
  }
{% endstyle %}

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

<gw-product-bundle class="gw-pdp" id="gw-pdp-{{ section.id }}">
  <div class="gw-pdp__buy">
    <div class="gw-pdp__grid">
      <div class="gw-pdp__media">
        <div class="gw-pdp__stage" data-gw-gallery-stage>
          <div class="gw-pdp__track" data-gw-gallery-track>
          <div class="gw-pdp__slide is-active" data-gw-slide>
            <div class="gw-infographic">
              <div class="gw-infographic__photo">
                {% if featured != blank %}
                  {{
                    featured
                    | image_url: width: 2000
                    | image_tag:
                      loading: 'eager',
                      fetchpriority: 'high',
                      widths: '800, 1200, 1600, 2000',
                      sizes: '(min-width: 990px) 48vw, 100vw',
                      class: 'gw-infographic__img',
                      alt: featured_alt
                  }}
                {% elsif featured_asset_fallback != blank %}
                  <img
                    src="{{ featured_asset_fallback | asset_img_url: '2000x' }}"
                    srcset="
                      {{ featured_asset_fallback | asset_img_url: '800x' }} 800w,
                      {{ featured_asset_fallback | asset_img_url: '1200x' }} 1200w,
                      {{ featured_asset_fallback | asset_img_url: '1600x' }} 1600w,
                      {{ featured_asset_fallback | asset_img_url: '2000x' }} 2000w
                    "
                    sizes="(min-width: 990px) 48vw, 100vw"
                    class="gw-infographic__img"
                    width="1600"
                    height="2000"
                    loading="eager"
                    fetchpriority="high"
                    alt="{{ featured_alt | escape }}"
                  >
                {% endif %}
              </div>
              <div class="gw-infographic__copy">
                {% if section.settings.infographic_headline != blank %}
                  <h2 class="gw-infographic__headline">
                    {{ section.settings.infographic_headline | escape }}
                    {% if section.settings.infographic_script != blank %}
                      <em>{{ section.settings.infographic_script | escape }}</em>
                    {% endif %}
                  </h2>
                {% endif %}
                {% if section.settings.infographic_sub != blank %}
                  <p class="gw-infographic__sub">{{ section.settings.infographic_sub | escape }}</p>
                {% endif %}
                <div class="gw-infographic__card gw-infographic__card--without">
                  <p class="gw-infographic__card-title">{{ section.settings.without_title | escape }}</p>
                  {% if section.settings.without_1 != blank %}
                    <p><span class="gw-infographic__x" aria-hidden="true">✕</span> {{ section.settings.without_1 | escape }}</p>
                  {% endif %}
                  {% if section.settings.without_2 != blank %}
                    <p><span class="gw-infographic__x" aria-hidden="true">✕</span> {{ section.settings.without_2 | escape }}</p>
                  {% endif %}
                </div>
                <div class="gw-infographic__card gw-infographic__card--with">
                  <p class="gw-infographic__card-title">{{ section.settings.with_title | escape }}</p>
                  {% if section.settings.with_1 != blank %}
                    <p>{% render 'gw-icon', name: 'check-simple', class: 'gw-icon--inline-check gw-infographic__check' %} {{ section.settings.with_1 | escape }}</p>
                  {% endif %}
                  {% if section.settings.with_2 != blank %}
                    <p>{% render 'gw-icon', name: 'check-simple', class: 'gw-icon--inline-check gw-infographic__check' %} {{ section.settings.with_2 | escape }}</p>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>

          {% for media in product.media %}
            {% if media.media_type == 'image' %}
              <div class="gw-pdp__slide" data-gw-slide>
                <div class="gw-pdp__main-media">
                  {{
                    media
                    | image_url: width: 2400
                    | image_tag:
                      loading: 'lazy',
                      widths: '800, 1200, 1600, 2000, 2400',
                      sizes: '(min-width: 990px) 48vw, 100vw',
                      class: 'gw-pdp__main-img',
                      alt: media.alt | default: product.title
                  }}
                </div>
              </div>
            {% endif %}
          {% endfor %}
          {% assign extra_color_alts = 'Life,Back,Detail,Card,Camel,Black,Ivory,Burgundy,Charcoal,Chocolate' | split: ',' %}
          {% for extra_asset in supplemental_gallery_assets %}
            {% assign extra_alt = extra_color_alts[forloop.index0] | default: product.title %}
            <div class="gw-pdp__slide" data-gw-slide>
              <div class="gw-pdp__main-media">
                <img
                  src="{{ extra_asset | asset_img_url: '2000x' }}"
                  srcset="
                    {{ extra_asset | asset_img_url: '800x' }} 800w,
                    {{ extra_asset | asset_img_url: '1200x' }} 1200w,
                    {{ extra_asset | asset_img_url: '1600x' }} 1600w,
                    {{ extra_asset | asset_img_url: '2000x' }} 2000w
                  "
                  sizes="(min-width: 990px) 48vw, 100vw"
                  alt="{{ product.title | escape }} — {{ extra_alt | escape }}"
                  class="gw-pdp__main-img"
                  width="1600"
                  height="2000"
                  loading="lazy"
                >
              </div>
            </div>
          {% endfor %}
          </div>
          <div class="gw-pdp__swipe" data-gw-gallery-swipe aria-hidden="true"></div>
        </div>

        <div class="gw-pdp__thumbs-row">
          <button
            type="button"
            class="gw-pdp__thumb-nav"
            data-gw-thumbs-prev
            aria-label="{{ 'girls_winter.product.gallery_prev' | t }}"
            disabled
          >
            {% render 'gw-icon', name: 'chevron-left', class: 'gw-icon--nav' %}
          </button>
          <div class="gw-pdp__thumbs" role="tablist" aria-label="{{ 'girls_winter.product.gallery_label' | t }}">
            <button type="button" class="gw-pdp__thumb is-active" data-gw-gallery-thumb aria-label="{{ 'girls_winter.product.load_image' | t: index: 1 }}">
              {% if featured != blank %}
                {{
                  featured
                  | image_url: width: 160
                  | image_tag: loading: 'eager', widths: '80, 120, 160', sizes: '72px', class: 'gw-pdp__thumb-img', alt: ''
                }}
              {% elsif featured_asset_fallback != blank %}
                <img
                  src="{{ featured_asset_fallback | asset_img_url: '320x' }}"
                  alt=""
                  class="gw-pdp__thumb-img"
                  width="160"
                  height="200"
                  loading="eager"
                >
              {% endif %}
            </button>
            {% for media in product.media %}
              {% if media.media_type == 'image' %}
                <button
                  type="button"
                  class="gw-pdp__thumb"
                  data-gw-gallery-thumb
                  aria-label="{{ 'girls_winter.product.load_image' | t: index: forloop.index }}"
                >
                  {{
                    media
                    | image_url: width: 160
                    | image_tag: loading: 'lazy', widths: '80, 120, 160', sizes: '72px', class: 'gw-pdp__thumb-img', alt: ''
                  }}
                </button>
              {% endif %}
            {% endfor %}
            {% for extra_asset in supplemental_gallery_assets %}
              <button
                type="button"
                class="gw-pdp__thumb"
                data-gw-gallery-thumb
                aria-label="{{ 'girls_winter.product.load_image' | t: index: forloop.index }}"
              >
                <img
                  src="{{ extra_asset | asset_img_url: '320x' }}"
                  alt=""
                  class="gw-pdp__thumb-img"
                  width="160"
                  height="200"
                  loading="lazy"
                >
              </button>
            {% endfor %}
          </div>
          <button
            type="button"
            class="gw-pdp__thumb-nav"
            data-gw-thumbs-next
            aria-label="{{ 'girls_winter.product.gallery_next' | t }}"
          >
            {% render 'gw-icon', name: 'chevron-right', class: 'gw-icon--nav' %}
          </button>
        </div>
      </div>

      <div class="gw-pdp__info">
        {% if section.settings.rating_text != blank %}
          <p class="gw-pdp__rating">
            <span class="gw-pdp__rating-stars">{% render 'gw-star-rating' %}</span>
            {{ section.settings.rating_text | escape }}
          </p>
        {% endif %}

        <h1 class="gw-pdp__title">{{ product.title | escape }}</h1>

        <ul class="gw-pdp__benefits list-unstyled" role="list">
          {% for i in (1..5) %}
            {% liquid
              assign title_key = 'benefit_' | append: i | append: '_title'
              assign text_key = 'benefit_' | append: i | append: '_text'
              assign b_title = section.settings[title_key]
              assign b_text = section.settings[text_key]
            %}
            {% if b_title != blank %}
              <li class="gw-pdp__benefit">
                <span class="gw-pdp__benefit-icon" aria-hidden="true">
                  {% case i %}
                    {% when 1 %}
                      <svg viewBox="0 0 24 24" fill="none"><path d="M12 3v3M12 18v3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M3 12h3M18 12h3M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="12" cy="12" r="3.2" stroke="currentColor" stroke-width="1.6"/></svg>
                    {% when 2 %}
                      <svg viewBox="0 0 24 24" fill="none"><path d="M12 20c6-4 8-8 8-12-4 0-8 2-8 2S8 8 4 8c0 4 2 8 8 12z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M12 20V10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                    {% when 3 %}
                      <svg viewBox="0 0 24 24" fill="none"><path d="M4 8h16M4 12h16M4 16h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M7 6l-3 2 3 2M17 14l3 2-3 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {% when 4 %}
                      <svg viewBox="0 0 24 24" fill="none"><path d="M12 4l1.4 4.2H18l-3.5 2.6 1.3 4.2L12 12.6 8.2 15l1.3-4.2L6 8.2h4.6z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
                    {% else %}
                      <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="3" stroke="currentColor" stroke-width="1.6"/><path d="M6 19c.8-3.2 3-5 6-5s5.2 1.8 6 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                  {% endcase %}
                </span>
                <span>
                  <strong>{{ b_title | escape }}</strong>
                  {% if b_text != blank %}
                    <span class="gw-pdp__benefit-text">{{ b_text | escape }}</span>
                  {% endif %}
                </span>
              </li>
            {% endif %}
          {% endfor %}
        </ul>

        {% if section.settings.urgency_text != blank %}
          <p class="gw-pdp__urgency">
            <span class="gw-pdp__urgency-dot" aria-hidden="true"></span>
            {{ section.settings.urgency_text | escape }}
          </p>
        {% endif %}

        <div class="gw-pdp__offer-head" data-gw-offer-anchor>
          <p class="gw-pdp__offer-label">
            <span class="gw-pdp__offer-clock" aria-hidden="true">◷</span>
            {% if section.settings.offer_label != blank %}
              {{ section.settings.offer_label | escape }}
            {% else %}
              {{ 'girls_winter.product.limited_offer' | t }}
            {% endif %}
          </p>
          <button type="button" class="gw-pdp__size-link" data-gw-size-open>
            {% if section.settings.size_link_label != blank %}
              {{ section.settings.size_link_label | escape }}
            {% else %}
              {{ 'girls_winter.product.size_guide' | t }}
            {% endif %}
          </button>
        </div>

        <div class="gw-pdp__tiers" role="radiogroup" aria-label="{{ section.settings.offer_label | escape }}">
          {% for block in section.blocks %}
            {% if block.type == 'bundle_tier' %}
              {% liquid
                assign tier_qty = block.settings.quantity
                assign unit = current_variant.price
                assign raw_total = unit | times: tier_qty
                assign discount = block.settings.percent_off | default: 0
                assign multiplier = 100 | minus: discount
                assign tier_total = raw_total | times: multiplier | divided_by: 100
                assign tier_compare = raw_total
                if block.settings.use_compare_multiplier
                  assign tier_compare = compare_at | times: tier_qty
                endif
                assign per_unit_label = ''
                if tier_qty > 0 and block.settings.per_unit_note != blank
                  assign per_unit_amount = tier_total | divided_by: tier_qty | money
                  assign per_unit_label = block.settings.per_unit_note | replace: '[price]', per_unit_amount
                endif
                assign ribbon_downcase = block.settings.ribbon | downcase
                assign is_default = false
                if ribbon_downcase contains 'popular'
                  assign is_default = true
                endif
              %}
              <div
                class="gw-pdp__tier-wrap"
                data-gw-tier-wrap
                {% if is_default %}data-gw-default{% endif %}
                {{ block.shopify_attributes }}
              >
                {% if block.settings.ribbon != blank %}
                  <span class="gw-pdp__tier-ribbon{% if ribbon_downcase contains 'best' %} gw-pdp__tier-ribbon--dark{% endif %}">
                    {{ block.settings.ribbon | escape }}
                  </span>
                {% endif %}
                <button
                  type="button"
                  class="gw-pdp__tier"
                  role="radio"
                  aria-expanded="false"
                  data-gw-tier="{{ tier_qty }}"
                  data-gw-tier-price="{{ tier_total | money }}"
                  data-gw-tier-compare="{{ tier_compare | money }}"
                  aria-pressed="false"
                >
                  <span class="gw-pdp__tier-radio" aria-hidden="true"></span>
                  <span class="gw-pdp__tier-body">
                    <span class="gw-pdp__tier-main">
                      <strong class="gw-pdp__tier-title">{{ block.settings.heading | escape }}</strong>
                      {% if block.settings.subtitle != blank %}
                        <span class="gw-pdp__tier-subtitle">{{ block.settings.subtitle | escape }}</span>
                      {% endif %}
                      {% if per_unit_label != blank %}
                        <span class="gw-pdp__tier-per-unit">{{ per_unit_label | escape }}</span>
                      {% endif %}
                    </span>
                    <span class="gw-pdp__tier-prices">
                      <strong class="gw-pdp__tier-price">{{ tier_total | money }}</strong>
                      <s>{{ tier_compare | money }}</s>
                    </span>
                  </span>
                </button>
                <div class="gw-pdp__tier-panel" data-gw-bundle-lines hidden></div>
              </div>
            {% endif %}
          {% endfor %}
        </div>

        <form class="gw-pdp__form" data-gw-product-form>
          {% if section.settings.fit_note != blank %}
            <p class="gw-pdp__fit-note">{{ section.settings.fit_note | escape }}</p>
          {% endif %}
          <p class="gw-pdp__cart-error" data-gw-cart-error hidden role="alert"></p>
          <button type="submit" class="gw-pdp__atc">
            <span class="gw-pdp__atc-icon" aria-hidden="true">
              {{ 'icon-cart.svg' | inline_asset_content }}
            </span>
            {{ section.settings.atc_label | escape }}
          </button>
          {% if section.settings.trust_line != blank %}
            <p class="gw-pdp__trust">
              <span class="gw-pdp__trust-lock" aria-hidden="true">
                <svg viewBox="0 0 16 16" fill="none">
                  <rect x="3.5" y="7" width="9" height="7" rx="1.4" stroke="currentColor" stroke-width="1.3"/>
                  <path d="M5.4 7V5.2a2.6 2.6 0 0 1 5.2 0V7" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                </svg>
              </span>
              {{ section.settings.trust_line | escape }}
            </p>
          {% endif %}
          {% liquid
            assign pay_types = shop.enabled_payment_types
            if pay_types.size == 0
              assign pay_types = 'amazon,american_express,apple_pay,diners_club,discover,google_pay,master,paypal,shopify_pay,visa' | split: ','
            endif
          %}
          <ul class="gw-pdp__payments list-unstyled" role="list">
            {% for type in pay_types %}
              <li>{{ type | payment_type_svg_tag: class: 'gw-pdp__payment-icon' }}</li>
            {% endfor %}
          </ul>
        </form>

        {% liquid
          assign ugc_videos = 'gw-motion-jackets.mp4,gw-motion-hoodies.mp4,gw-motion-pullovers.mp4,gw-motion-coats.mp4' | split: ','
          assign ugc_posters = 'gw-cat-jackets.jpg,gw-cat-hoodies.jpg,gw-cat-pullovers.jpg,gw-cat-coats.jpg' | split: ','
        %}
        <div class="gw-pdp__ugc gw-pdp__ugc--videos" data-gw-ugc>
          {% for video_asset in ugc_videos %}
            {% assign poster_index = forloop.index0 %}
            <figure class="gw-pdp__ugc-item">
              <video
                class="gw-pdp__ugc-video"
                src="{{ video_asset | asset_url }}"
                poster="{{ ugc_posters[poster_index] | asset_img_url: '480x' }}"
                muted
                playsinline
                loop
                autoplay
                preload="metadata"
                disablepictureinpicture
              ></video>
            </figure>
          {% endfor %}
        </div>

        <div class="gw-pdp__accordions">
          {% for block in section.blocks %}
            {% if block.type == 'accordion' %}
              <details class="gw-pdp__accordion" {{ block.shopify_attributes }}>
                <summary class="gw-pdp__accordion-summary">{{ block.settings.title | escape }}</summary>
                <div class="gw-pdp__accordion-body rte">
                  {{ block.settings.body }}
                </div>
              </details>
            {% endif %}
          {% endfor %}
        </div>

        {% assign quote_count = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'quote' %}
            {% assign quote_count = quote_count | plus: 1 %}
          {% endif %}
        {% endfor %}
        {% if quote_count > 0 %}
          <div class="gw-pdp__mini-reviews" data-gw-mini-reviews>
            <div class="gw-pdp__mini-head">
              <h2 class="gw-pdp__mini-title">{{ 'girls_winter.product.what_women_say' | t }}</h2>
              <div class="gw-pdp__mini-nav">
                <button type="button" data-gw-mini-prev aria-label="{{ 'girls_winter.product.reviews_prev' | t }}">
                  {% render 'gw-icon', name: 'chevron-left', class: 'gw-icon--nav' %}
                </button>
                <button type="button" data-gw-mini-next aria-label="{{ 'girls_winter.product.reviews_next' | t }}">
                  {% render 'gw-icon', name: 'chevron-right', class: 'gw-icon--nav' %}
                </button>
              </div>
            </div>
            <div class="gw-pdp__mini-viewport">
              <div class="gw-pdp__mini-track" data-gw-mini-track>
                {% assign quote_index = 0 %}
                {% for block in section.blocks %}
                  {% if block.type == 'quote' %}
                    {% assign quote_index = quote_index | plus: 1 %}
                    {% assign review_photo_index = quote_index | minus: 1 %}
                    {% assign quote_asset = mini_review_assets[review_photo_index] %}
                    <blockquote class="gw-pdp__mini-card" {{ block.shopify_attributes }}>
                      {% if block.settings.image != blank %}
                        {{
                          block.settings.image
                          | image_url: width: 720
                          | image_tag:
                            loading: 'lazy',
                            widths: '240, 360, 480, 720',
                            sizes: '(min-width: 750px) 22vw, 88vw',
                            class: 'gw-pdp__mini-photo',
                            alt: block.settings.author
                        }}
                      {% elsif quote_asset != blank %}
                        <img
                          class="gw-pdp__mini-photo"
                          src="{{ quote_asset | asset_img_url: '800x' }}"
                          alt="{{ block.settings.author | escape }}"
                          width="360"
                          height="480"
                          loading="lazy"
                        >
                      {% elsif featured != blank %}
                        {{
                          featured
                          | image_url: width: 720
                          | image_tag:
                            loading: 'lazy',
                            widths: '240, 360, 480, 720',
                            sizes: '(min-width: 750px) 22vw, 88vw',
                            class: 'gw-pdp__mini-photo',
                            alt: block.settings.author | default: product.title
                        }}
                      {% endif %}
                      <span class="gw-pdp__rating-stars">{% render 'gw-star-rating' %}</span>
                      <p>{{ block.settings.text | escape }}</p>
                      {% if block.settings.author != blank %}
                        <footer>
                          <cite>{{ block.settings.author | escape }}</cite>
                          <span>
                            {% render 'gw-icon', name: 'check-simple', class: 'gw-icon--inline-check' %}
                            {{ 'girls_winter.product.verified' | t }}
                          </span>
                        </footer>
                      {% endif %}
                    </blockquote>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  <section class="gw-pdp-proof">
    <div class="gw-pdp-proof__inner">
      {% if section.settings.proof_heading != blank %}
        <h2 class="gw-pdp-proof__heading">
          {% if section.settings.proof_heading_lead != blank %}
            <span class="gw-pdp-proof__lead">{{ section.settings.proof_heading_lead | escape }}</span>
          {% endif %}
          {{ section.settings.proof_heading | escape }}
        </h2>
      {% endif %}
      <ul class="gw-pdp-proof__grid list-unstyled" role="list">
        {% for i in (1..4) %}
          {% liquid
            assign p_title_key = 'proof_' | append: i | append: '_title'
            assign p_text_key = 'proof_' | append: i | append: '_text'
            assign p_title = section.settings[p_title_key]
            assign p_text = section.settings[p_text_key]
          %}
          {% if p_title != blank %}
            <li class="gw-pdp-proof__card">
              <h3>{{ p_title | escape }}</h3>
              <p>{{ p_text | escape }}</p>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
      <button type="button" class="gw-pdp-proof__cta" data-gw-scroll-offer>
        {% if section.settings.proof_cta != blank %}
          {{ section.settings.proof_cta | escape }}
        {% else %}
          {{ 'girls_winter.product.check_availability' | t }}
        {% endif %}
      </button>
      <p class="gw-pdp-proof__risk">{{ 'girls_winter.product.risk_free' | t }}</p>
    </div>
  </section>

  <section class="gw-pdp-story">
    <div class="gw-pdp-story__inner">
      <div class="gw-pdp-story__media">
        {% if section.settings.story_image != blank %}
          {{
            section.settings.story_image
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              widths: '600, 900, 1200, 1400',
              sizes: '(min-width: 990px) 42vw, 100vw',
              class: 'gw-pdp-story__img',
              alt: section.settings.story_image.alt | default: product.title
          }}
        {% else %}
          <img
            class="gw-pdp-story__img"
            src="{{ 'gw-pdp-story.jpg' | asset_img_url: '1400x' }}"
            srcset="
              {{ 'gw-pdp-story.jpg' | asset_img_url: '600x' }} 600w,
              {{ 'gw-pdp-story.jpg' | asset_img_url: '900x' }} 900w,
              {{ 'gw-pdp-story.jpg' | asset_img_url: '1200x' }} 1200w,
              {{ 'gw-pdp-story.jpg' | asset_img_url: '1400x' }} 1400w
            "
            sizes="(min-width: 990px) 42vw, 100vw"
            width="1400"
            height="1867"
            loading="lazy"
            alt="{{ product.title | escape }}"
          >
        {% endif %}
      </div>
      <div class="gw-pdp-story__copy">
        {% if section.settings.story_pills != blank %}
          <p class="gw-pdp-story__pills">
            {% assign pills = section.settings.story_pills | split: ',' %}
            {% for pill in pills %}
              <span>{{ pill | strip | escape }}</span>
            {% endfor %}
          </p>
        {% endif %}
        {% if section.settings.story_heading != blank %}
          <h2>{{ section.settings.story_heading | escape }}</h2>
        {% endif %}
        {% if section.settings.story_sub != blank %}
          <p class="gw-pdp-story__sub">{{ section.settings.story_sub | escape }}</p>
        {% endif %}
        <ul class="gw-pdp-story__points list-unstyled" role="list">
          {% for i in (1..3) %}
            {% liquid
              assign s_title_key = 'story_' | append: i | append: '_title'
              assign s_kicker_key = 'story_' | append: i | append: '_kicker'
              assign s_text_key = 'story_' | append: i | append: '_text'
              assign s_title = section.settings[s_title_key]
              assign s_kicker = section.settings[s_kicker_key]
              assign s_text = section.settings[s_text_key]
              assign thumb_index = i | minus: 1
              assign story_thumb_asset = story_thumb_assets[thumb_index]
            %}
            {% if s_title != blank %}
              <li class="gw-pdp-story__point">
                {% if story_thumb_asset != blank %}
                  <img
                    class="gw-pdp-story__thumb"
                    src="{{ story_thumb_asset | asset_img_url: '200x' }}"
                    alt=""
                    width="72"
                    height="72"
                    loading="lazy"
                  >
                {% endif %}
                <div>
                  <div class="gw-pdp-story__point-head">
                    <h3>{{ s_title | escape }}</h3>
                    {% if s_kicker != blank %}<span>{{ s_kicker | escape }}</span>{% endif %}
                  </div>
                  <p>{{ s_text | escape }}</p>
                </div>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    </div>
  </section>

  {% assign review_count = 0 %}
  {% for block in section.blocks %}
    {% if block.type == 'review' %}
      {% assign review_count = review_count | plus: 1 %}
    {% endif %}
  {% endfor %}
  {% if review_count > 0 %}
    <section class="gw-pdp-reviews">
      <div class="gw-pdp-reviews__inner">
        <header class="gw-pdp-reviews__head">
          <p class="gw-pdp-reviews__rated">
            <span class="gw-pdp__rating-stars">{% render 'gw-star-rating' %}</span>
            {{ 'girls_winter.product.reviews_rated' | t }}
          </p>
          {% if section.settings.reviews_heading != blank %}
            <h2>{{ section.settings.reviews_heading | escape | newline_to_br }}</h2>
          {% endif %}
          <ul class="gw-pdp-reviews__trust list-unstyled" role="list">
            <li>
              {% render 'gw-icon', name: 'check-simple', class: 'gw-icon--inline-check' %}
              {{ 'girls_winter.product.reviews_trust_count' | t }}
            </li>
            <li>
              {% render 'gw-icon', name: 'check-simple', class: 'gw-icon--inline-check' %}
              {{ 'girls_winter.product.reviews_trust_guarantee' | t }}
            </li>
            <li>
              {% render 'gw-icon', name: 'check-simple', class: 'gw-icon--inline-check' %}
              {{ 'girls_winter.product.reviews_trust_shipping' | t }}
            </li>
          </ul>
        </header>
        <ul class="gw-pdp-reviews__grid list-unstyled" role="list">
          {% assign review_img_index = 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'review' %}
              {% assign review_img_index = review_img_index | plus: 1 %}
              {% liquid
                if review_img_index < 10
                  assign review_asset = 'gw-review-0' | append: review_img_index | append: '.jpg'
                else
                  assign review_asset = 'gw-review-' | append: review_img_index | append: '.jpg'
                endif
              %}
              {% assign author_name = block.settings.author | split: ' · ' | first %}
              <li class="gw-pdp-reviews__card" {{ block.shopify_attributes }}>
                <div class="gw-pdp-reviews__media">
                  {% if block.settings.image != blank %}
                    {{
                      block.settings.image
                      | image_url: width: 800
                      | image_tag: loading: 'lazy', widths: '320, 480, 640, 800', sizes: '(min-width: 750px) 28vw, 78vw', class: 'gw-pdp-reviews__img', alt: author_name
                    }}
                  {% else %}
                    <img
                      class="gw-pdp-reviews__img"
                      src="{{ review_asset | asset_img_url: '800x' }}"
                      srcset="
                        {{ review_asset | asset_img_url: '320x' }} 320w,
                        {{ review_asset | asset_img_url: '480x' }} 480w,
                        {{ review_asset | asset_img_url: '640x' }} 640w,
                        {{ review_asset | asset_img_url: '800x' }} 800w
                      "
                      sizes="(min-width: 750px) 28vw, 78vw"
                      alt="{{ author_name | escape }}"
                      width="800"
                      height="810"
                      loading="lazy"
                    >
                  {% endif %}
                </div>
                <div class="gw-pdp-reviews__body">
                  <p class="gw-pdp__rating-stars">{% render 'gw-star-rating' %}</p>
                  <p class="gw-pdp-reviews__text">{{ block.settings.text | escape }}</p>
                  <div class="gw-pdp-reviews__buyer">
                    <span class="gw-pdp-reviews__buyer-label">{{ 'girls_winter.product.buyer' | t }}</span>
                    <strong>{{ author_name | escape }}</strong>
                    <span class="gw-pdp-reviews__verified">{{ 'girls_winter.product.verified_buyer' | t }}</span>
                  </div>
                  <p class="gw-pdp-reviews__purchase">
                    <span class="gw-pdp-reviews__shield" aria-hidden="true">
                      <svg viewBox="0 0 16 16" fill="none">
                        <path d="M8 1.6 13 3.7v4.8c0 3-2 5.4-5 6.3-3-.9-5-3.3-5-6.3V3.7L8 1.6Z" stroke="currentColor" stroke-width="1.2"/>
                        <path d="M5.5 8.1 7.3 9.8 10.6 6.2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                    {{ 'girls_winter.product.verified_purchase' | t }}
                    {% if block.settings.purchased != blank %}
                      · {{ block.settings.purchased | escape }}
                    {% endif %}
                  </p>
                </div>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
        <p class="gw-pdp-reviews__swipe">{{ 'girls_winter.product.reviews_swipe' | t }}</p>
      </div>
    </section>
  {% endif %}

  {% assign faq_count = 0 %}
  {% for block in section.blocks %}
    {% if block.type == 'faq' %}
      {% assign faq_count = faq_count | plus: 1 %}
    {% endif %}
  {% endfor %}
  {% if faq_count > 0 %}
    <section class="gw-pdp-faq">
      <div class="gw-pdp-faq__inner">
        {% if section.settings.faq_heading != blank %}
          <h2>{{ section.settings.faq_heading | escape }}</h2>
        {% endif %}
        <div class="gw-pdp-faq__list">
          {% for block in section.blocks %}
            {% if block.type == 'faq' %}
              <details class="gw-pdp-faq__item" {{ block.shopify_attributes }}>
                <summary class="gw-pdp-faq__summary">
                  <div class="gw-pdp-faq__summary-copy">
                    {% if block.settings.kicker != blank %}
                      <span class="gw-pdp-faq__kicker">{{ block.settings.kicker | escape }}</span>
                    {% endif %}
                    {% if block.settings.question != blank %}
                      <span class="gw-pdp-faq__q">{{ block.settings.question | escape }}</span>
                    {% endif %}
                  </div>
                  <span class="gw-pdp-faq__plus" aria-hidden="true">+</span>
                </summary>
                <div class="gw-pdp-faq__answer rte">{{ block.settings.answer }}</div>
              </details>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  <section class="gw-pdp-compare" aria-labelledby="gw-pdp-compare-title-{{ section.id }}">
    <div class="gw-pdp-compare__inner">
      {% if section.settings.compare_heading != blank %}
        <h2 id="gw-pdp-compare-title-{{ section.id }}" class="gw-pdp-compare__heading">
          {{ section.settings.compare_heading | escape }}
        </h2>
      {% endif %}

      <div class="gw-pdp-compare__grid">
        <article class="gw-pdp-compare__card gw-pdp-compare__card--without">
          <div class="gw-pdp-compare__visual">
            {% if section.settings.compare_without_image != blank %}
              {{
                section.settings.compare_without_image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 600, 800, 1200',
                  sizes: '(min-width: 990px) 28vw, 46vw',
                  class: 'gw-pdp-compare__img gw-pdp-compare__img--ordinary',
                  alt: section.settings.compare_without_image.alt | default: 'Ordinary winter coat'
              }}
            {% elsif compare_without_asset != blank %}
              <img
                class="gw-pdp-compare__img gw-pdp-compare__img--ordinary"
                src="{{ compare_without_asset | asset_img_url: '1200x' }}"
                alt="{{ section.settings.without_title | escape }}"
                width="800"
                height="1000"
                loading="lazy"
              >
            {% elsif product.media.size > 2 %}
              {{
                product.media[2]
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 600, 800, 1200',
                  sizes: '(min-width: 990px) 28vw, 46vw',
                  class: 'gw-pdp-compare__img gw-pdp-compare__img--ordinary',
                  alt: section.settings.without_title
              }}
            {% endif %}
          </div>
          <div class="gw-pdp-compare__body">
            <h3 class="gw-pdp-compare__card-title">
              <span class="gw-pdp-compare__mark gw-pdp-compare__mark--no" aria-hidden="true">✕</span>
              {{ section.settings.without_title | escape }}
            </h3>
            <ul class="gw-pdp-compare__list list-unstyled" role="list">
              {% if section.settings.without_1 != blank %}
                <li><span aria-hidden="true">✕</span>{{ section.settings.without_1 | escape }}</li>
              {% endif %}
              {% if section.settings.without_2 != blank %}
                <li><span aria-hidden="true">✕</span>{{ section.settings.without_2 | escape }}</li>
              {% endif %}
              {% if section.settings.without_3 != blank %}
                <li><span aria-hidden="true">✕</span>{{ section.settings.without_3 | escape }}</li>
              {% endif %}
              {% if section.settings.without_4 != blank %}
                <li><span aria-hidden="true">✕</span>{{ section.settings.without_4 | escape }}</li>
              {% endif %}
            </ul>
          </div>
        </article>

        <article class="gw-pdp-compare__card gw-pdp-compare__card--with">
          <div class="gw-pdp-compare__visual">
            {% if section.settings.compare_with_image != blank %}
              {{
                section.settings.compare_with_image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 600, 800, 1200',
                  sizes: '(min-width: 990px) 28vw, 46vw',
                  class: 'gw-pdp-compare__img gw-pdp-compare__img--brand',
                  alt: section.settings.compare_with_image.alt | default: product.title
              }}
            {% elsif compare_with_asset != blank %}
              <img
                class="gw-pdp-compare__img gw-pdp-compare__img--brand"
                src="{{ compare_with_asset | asset_img_url: '1200x' }}"
                alt="{{ product.title | escape }}"
                width="800"
                height="1000"
                loading="lazy"
              >
            {% elsif featured != blank %}
              {{
                featured
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 600, 800, 1200',
                  sizes: '(min-width: 990px) 28vw, 46vw',
                  class: 'gw-pdp-compare__img gw-pdp-compare__img--brand',
                  alt: product.title
              }}
            {% endif %}
          </div>
          <div class="gw-pdp-compare__body">
            <h3 class="gw-pdp-compare__card-title">
              <span class="gw-pdp-compare__mark gw-pdp-compare__mark--yes">{% render 'gw-icon', name: 'check-simple', class: 'gw-icon--mark-yes' %}</span>
              {{ section.settings.with_title | escape }}
            </h3>
            <ul class="gw-pdp-compare__list list-unstyled" role="list">
              {% if section.settings.with_1 != blank %}
                <li>{% render 'gw-icon', name: 'check-simple', class: 'gw-icon--inline-check' %}{{ section.settings.with_1 | escape }}</li>
              {% endif %}
              {% if section.settings.with_2 != blank %}
                <li>{% render 'gw-icon', name: 'check-simple', class: 'gw-icon--inline-check' %}{{ section.settings.with_2 | escape }}</li>
              {% endif %}
              {% if section.settings.with_3 != blank %}
                <li>{% render 'gw-icon', name: 'check-simple', class: 'gw-icon--inline-check' %}{{ section.settings.with_3 | escape }}</li>
              {% endif %}
              {% if section.settings.with_4 != blank %}
                <li>{% render 'gw-icon', name: 'check-simple', class: 'gw-icon--inline-check' %}{{ section.settings.with_4 | escape }}</li>
              {% endif %}
            </ul>
          </div>
        </article>
      </div>

      {% if section.settings.compare_footnote != blank %}
        <p class="gw-pdp-compare__footnote">{{ section.settings.compare_footnote | escape }}</p>
      {% endif %}

      <div class="gw-pdp-compare__cta">
        <button type="button" class="gw-pdp-proof__cta" data-gw-scroll-offer>
          {% if section.settings.proof_cta != blank %}
            {{ section.settings.proof_cta | escape }}
          {% else %}
            {{ 'girls_winter.product.check_availability' | t }}
          {% endif %}
        </button>
      </div>
    </div>
  </section>

  <div class="gw-pdp-sticky" data-gw-sticky>
    <div class="gw-pdp-sticky__inner">
      <div class="gw-pdp-sticky__copy">
        <p class="gw-pdp-sticky__title">{{ product.title | escape }}</p>
        <p class="gw-pdp-sticky__meta">
          <span class="gw-pdp__rating-stars">{% render 'gw-star-rating' %}</span>
          {{ section.settings.sticky_offer | escape }}
        </p>
      </div>
      <button type="button" class="gw-pdp-sticky__btn" data-gw-sticky-atc>
        {{ section.settings.atc_label | default: 'Add to Cart' | escape }}
      </button>
    </div>
  </div>

  <dialog class="gw-pdp-size" data-gw-size-dialog aria-labelledby="gw-size-title-{{ section.id }}">
    <div class="gw-pdp-size__panel">
      <div class="gw-pdp-size__head">
        <h2 id="gw-size-title-{{ section.id }}">{{ section.settings.size_link_label | escape }}</h2>
        <button type="button" class="gw-pdp-size__close" data-gw-size-close aria-label="{{ 'girls_winter.product.close_size_guide' | t }}">×</button>
      </div>
      {% if section.settings.size_guide_body != blank %}
        <div class="rte">{{ section.settings.size_guide_body }}</div>
      {% else %}
        <p>Sizes XS–XL. Between sizes? Size up for layering.</p>
        <div class="gw-pdp-size__table-wrap">
          <table>
            <thead>
              <tr><th>Size</th><th>US</th><th>Bust</th><th>Waist</th><th>Hip</th></tr>
            </thead>
            <tbody>
              <tr><td>XS</td><td>0–2</td><td>32–33"</td><td>24–25"</td><td>34–35"</td></tr>
              <tr><td>S</td><td>4–6</td><td>34–35"</td><td>26–27"</td><td>36–37"</td></tr>
              <tr><td>M</td><td>8–10</td><td>36–37"</td><td>28–29"</td><td>38–39"</td></tr>
              <tr><td>L</td><td>12–14</td><td>38–40"</td><td>30–32"</td><td>40–42"</td></tr>
              <tr><td>XL</td><td>16–18</td><td>41–43"</td><td>33–35"</td><td>43–45"</td></tr>
            </tbody>
          </table>
        </div>
      {% endif %}
    </div>
  </dialog>

  <script type="application/json" data-gw-product-json>
    {
      "id": {{ product.id }},
      "title": {{ product.title | json }},
      "featured_image": {{ json_featured_image_url | json }},
      "options": {{ product.options | json }},
      "options_with_values": [
        {% for option in product.options_with_values %}
          {
            "name": {{ option.name | json }},
            "values": {{ option.values | json }}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ],
      "variants": [
        {% for variant in product.variants %}
          {
            "id": {{ variant.id }},
            "available": {{ variant.available }},
            "option1": {{ variant.option1 | json }},
            "option2": {{ variant.option2 | json }},
            "option3": {{ variant.option3 | json }},
            "price": {{ variant.price }},
            "featured_image": {% if variant.featured_image %}{{ variant.featured_image | image_url: width: 240 | json }}{% else %}null{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ],
      "selected_or_first_available_variant": {
        "id": {{ current_variant.id }}
      }
    }
  </script>
</gw-product-bundle>

<script type="module" src="{{ 'gw-product-bundle.js' | asset_url }}"></script>

{% stylesheet %}
  .gw-product-section {
    padding-top: 30px;
    padding-bottom: 0;
    background: #fff;
    color: #1c1412;
  }

  .gw-pdp {
    display: block;
    background: #fff;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    overflow-x: clip;
  }

  .gw-pdp__buy {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding: 8px clamp(16px, 4vw, 32px) 48px;
    box-sizing: border-box;
  }

  .gw-pdp__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(24px, 3.5vw, 56px);
    align-items: start;
  }

  .gw-pdp__media {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  @media screen and (min-width: 990px) {
    .gw-pdp__media {
      position: sticky;
      top: 96px;
    }
  }

  .gw-pdp__stage {
    position: relative;
    overflow: hidden;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }

  .gw-pdp__stage.is-dragging,
  .gw-pdp__stage.is-dragging .gw-pdp__swipe {
    cursor: grabbing;
  }

  .gw-pdp__swipe {
    position: absolute;
    inset: 0;
    z-index: 4;
    touch-action: pan-y;
    cursor: grab;
  }

  .gw-pdp__track {
    display: flex;
    align-items: flex-start;
    width: 100%;
    will-change: transform;
  }

  .gw-pdp__slide {
    flex: 0 0 100%;
    width: 100%;
    min-width: 0;
  }

  .gw-pdp__main-img,
  .gw-infographic__img {
    -webkit-user-drag: none;
    pointer-events: none;
  }

  .gw-infographic {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 18px;
    padding: 18px 26px 28px 18px;
    background: #f6efe6;
    border-radius: 22px;
    min-height: min(72vh, 760px);
  }

  .gw-infographic__photo {
    min-width: 0;
    border-radius: 16px;
    overflow: hidden;
    background: #efe6da;
  }

  .gw-infographic__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 12%;
  }

