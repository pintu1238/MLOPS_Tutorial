    .gw-pdp-compare__visual {
      aspect-ratio: 3 / 4;
      max-height: 210px;
    }

    .gw-pdp-compare__img {
      object-position: center 15%;
    }

    .gw-pdp-compare__body {
      padding: 10px 10px 12px;
    }

    .gw-pdp-compare__card-title {
      margin-bottom: 8px;
      font-size: 0.78rem;
    }

    .gw-pdp-compare__list {
      gap: 6px;
    }

    .gw-pdp-compare__list li {
      font-size: 0.68rem;
      line-height: 1.3;
    }

    .gw-pdp-compare__list li:nth-child(n + 4) {
      display: none;
    }

    .gw-pdp-compare__footnote {
      margin-top: 14px;
      padding: 10px 12px;
      font-size: 0.72rem;
    }

    .gw-pdp__atc {
      width: 100%;
      max-width: 100%;
      box-sizing: border-box;
      min-height: 48px;
      white-space: normal;
    }

    .gw-pdp__trust {
      flex-wrap: wrap;
      text-align: center;
      padding-inline: 4px;
    }

    .gw-pdp-proof,
    .gw-pdp-faq,
    .gw-pdp-compare,
    .gw-pdp-story,
    .gw-pdp-reviews {
      padding-inline: 16px;
      width: 100%;
      box-sizing: border-box;
    }

    .gw-pdp-proof__heading {
      max-width: none;
      padding-inline: 4px;
    }

    .gw-pdp-proof__grid,
    .gw-pdp-trust__grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .gw-pdp__ugc,
    .gw-pdp__ugc--videos {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 6px;
      width: 100%;
      max-width: 100%;
    }

    .gw-pdp__ugc-item {
      min-width: 0;
      border-radius: 8px;
    }

    .gw-pdp__ugc-video,
    .gw-pdp__ugc-img {
      aspect-ratio: 9 / 16;
    }

    .gw-pdp__mini-card {
      flex: 0 0 78cqw;
      width: 78cqw;
      max-width: 78cqw;
    }

    .gw-pdp__mini-photo {
      width: 100%;
      height: 260px;
      max-height: 280px;
      min-height: 240px;
      aspect-ratio: 3 / 4;
      object-fit: cover;
    }

    .gw-pdp__tier-body {
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
    }

    .gw-pdp__tier-prices {
      align-self: flex-start;
      text-align: left;
    }

    .gw-pdp__tier-prices {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      justify-content: flex-start;
      gap: 8px;
    }

    .gw-pdp__tier-ribbon {
      right: 12px;
      max-width: calc(100% - 48px);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .gw-bundle__line-fields {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .gw-pdp-reviews__inner {
      width: 100%;
      max-width: 100%;
      overflow: hidden;
    }

    .gw-pdp-reviews__grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 14px;
      padding-bottom: 8px;
      margin-inline: -4px;
      padding-inline: 4px;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .gw-pdp-reviews__grid::-webkit-scrollbar {
      display: none;
    }

    .gw-pdp-reviews {
      padding-block: 16px;
    }

    .gw-pdp-reviews__card {
      flex: 0 0 min(100%, 320px);
      scroll-snap-align: center;
      min-width: 0;
    }

    .gw-pdp-story__point-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
    }

    .gw-pdp-story__point-head span {
      white-space: normal;
    }

    .gw-pdp-faq__summary {
      padding: 16px 14px;
      gap: 12px;
    }

    .gw-pdp-faq__answer {
      padding: 0 14px 16px;
    }

    .gw-pdp-faq__kicker {
      font-size: 0.62rem;
      letter-spacing: 0.1em;
    }

    .gw-pdp-sticky {
      --gw-sticky-pad-inline: 8px;
    }

    .gw-pdp-sticky__inner {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'copy atc';
      column-gap: 10px;
      row-gap: 4px;
      padding-block: 10px;
      padding-inline: max(8px, env(safe-area-inset-left, 0px)) max(8px, env(safe-area-inset-right, 0px));
    }

    .gw-pdp-sticky__copy {
      grid-area: copy;
      justify-self: start;
      text-align: start;
      width: 100%;
      min-width: 0;
      max-width: 100%;
    }

    .gw-pdp-sticky__title {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .gw-pdp-sticky__meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: flex-start;
      gap: 4px;
      font-size: 0.72rem;
      line-height: 1.3;
    }

    .gw-pdp-sticky__btn {
      grid-area: atc;
      grid-column: auto;
      grid-row: auto;
      justify-self: end;
      align-self: center;
      flex-shrink: 0;
      padding: 10px 14px;
      font-size: 0.72rem;
      min-height: 44px;
      white-space: nowrap;
    }

    .gw-pdp__payments {
      flex-wrap: wrap;
      justify-content: center;
    }
  }

  @media screen and (max-width: 390px) {
    .gw-pdp__title {
      font-size: 1.55rem;
    }

    .gw-pdp__tier-title {
      font-size: 0.88rem;
    }

    .gw-pdp__tier-subtitle {
      font-size: 0.74rem;
    }

    .gw-bundle__line {
      grid-template-columns: 24px 40px minmax(0, 1fr);
      gap: 8px;
    }

    .gw-bundle__line-thumb {
      width: 40px;
      height: 50px;
    }
  }
{% endstylesheet %}

