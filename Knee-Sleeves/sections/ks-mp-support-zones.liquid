{% comment %}
  FLEXORA support-zone lifestyle grid — theme #155459158085.
  Hover zooms the photo and reveals a circular arrow.
{% endcomment %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@700;800&family=Roboto+Slab:wght@800&display=swap" rel="stylesheet">
{{ 'ks-mp-page-layout.css' | asset_url | stylesheet_tag }}
{{ 'ks-mp-support-zones.css' | asset_url | stylesheet_tag }}

<section class="ks-mp-zones" id="ks-mp-zones-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="ks-mp-zones__inner">
    {% if section.settings.heading != blank %}
      <h2 class="ks-mp-zones__title">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    <div class="ks-mp-zones__grid">
      {% for block in section.blocks %}
        {% liquid
          assign asset_file = block.settings.image_asset | default: 'ks-mp-zone-knee-sleeves.jpg'
          assign cat_key = block.settings.match_key | default: block.settings.title | handleize
          assign cat_view = ''
          case cat_key
            when 'knee-support', 'knee-supports', 'knee', 'knee-sleeves', 'knee-pads'
              assign cat_view = 'ks-mp-knee-155459'
            when 'back-support', 'back-supports', 'back'
              assign cat_view = 'ks-mp-cap-155459'
            when 'foot-support', 'foot-supports', 'foot', 'ankle-support', 'ankle-supports', 'ankle'
              assign cat_view = 'ks-mp-ankle-155459'
            when 'compression-stockings', 'half-terry-socks', 'socks', 'stockings', 'compression-wear'
              assign cat_view = 'ks-mp-socks-155459'
            when 'neck-support', 'neck-supports', 'neck', 'shoulder-support', 'shoulder-supports', 'shoulder'
              assign cat_view = 'ks-mp-cap-155459'
            when 'wrist-support', 'wrist-supports', 'wrist', 'wrist-thumb', 'wrist-and-thumb'
              assign cat_view = 'ks-mp-wrist-155459'
            when 'elbow-support', 'elbow-supports', 'elbow'
              assign cat_view = 'ks-mp-elbow-155459'
            when 'calf-sleeve', 'calf-support', 'calf-supports', 'calf', 'shin-calf', 'shin-and-calf'
              assign cat_view = 'ks-mp-calf-155459'
            when 'full-arm-sleeve', 'arm-sleeve', 'arm-support', 'arm'
              assign cat_view = 'ks-mp-arm-155459'
          endcase
          assign href = block.settings.link
          if href == blank and cat_view != blank
            assign href = '/collections/all?view=' | append: cat_view
          endif
          if href == blank
            assign href = '/collections/all?view=ks-mp-shop-155459'
          endif
        %}
        <a class="ks-mp-zones__card" href="{{ href }}" {{ block.shopify_attributes }}>
          <div class="ks-mp-zones__media">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 900
                | image_tag: loading: 'lazy', alt: block.settings.title, widths: '400, 600, 900', sizes: '(min-width: 980px) 25vw, 50vw'
              }}
            {% else %}
              <img
                src="{{ asset_file | asset_url }}"
                alt="{{ block.settings.title | escape }}"
                width="600"
                height="750"
                loading="lazy"
              >
            {% endif %}
          </div>
          {% if block.settings.title != blank %}
            <p class="ks-mp-zones__label">{{ block.settings.title | escape }}</p>
          {% endif %}
          <span class="ks-mp-zones__go" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 6l8 6-8 6"></path>
            </svg>
          </span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "KS Support zones",
  "tag": "section",
  "class": "ks-mp-support-zones-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Where do you need support?" }
  ],
  "blocks": [
    {
      "type": "zone",
      "name": "Zone",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Knee Sleeves" },
        {
          "type": "text",
          "id": "match_key",
          "label": "Category key",
          "info": "Optional. e.g. knee-support, calf-sleeve. Used when Link is empty.",
          "default": "knee-support"
        },
        { "type": "url", "id": "link", "label": "Link", "info": "Leave empty to open the matching FLEXORA category catalog." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_asset", "label": "Theme image filename", "default": "ks-mp-zone-knee-sleeves.jpg" }
      ]
    }
  ],
  "presets": [{ "name": "KS Support zones" }]
}
{% endschema %}
