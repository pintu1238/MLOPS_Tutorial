{% comment %}
  Section contract.
  Driver review cards carousel for the footer group (homepage only).
{% endcomment %}
{%- if request.page_type == 'index' -%}
  {% render 'tc-mp-driver-reviews-carousel',
    instance_id: section.id,
    kicker: section.settings.kicker,
    heading: section.settings.heading,
    blocks: section.blocks,
    shopify_attributes: section.shopify_attributes
  %}
{%- endif -%}

{% schema %}
{
  "name": "TC MP Driver reviews",
  "class": "tc-mp-driver-reviews-section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Verified owners"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What drivers say"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Star rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Headline", "default": "Feels like a real machine" },
        {
          "type": "textarea",
          "id": "body",
          "label": "Review text",
          "default": "The 17-channel excavator moves smoothly and the metal shovel feels solid. My son plays with it every evening after homework."
        },
        { "type": "text", "id": "author", "label": "Customer name", "default": "Arun K." },
        { "type": "text", "id": "product_label", "label": "Product name", "default": "17CH RC Excavator Truck" },
        { "type": "image_picker", "id": "avatar", "label": "Avatar image" },
        {
          "type": "text",
          "id": "fallback_image",
          "label": "Fallback avatar asset filename",
          "default": "flytek-review-01.jpg"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TC MP Driver reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
