<section class="ls-page ls-section">
  <div class="ls-wrap">
    <p class="ls-kicker">{{ section.settings.kicker }}</p>
    <h2 class="ls-h2">{{ section.settings.heading }}</h2>
    <div class="ls-benefits__grid">
      <div class="ls-benefits__card">
        <div class="ls-benefits__icon">💜</div>
        <h3>{{ section.settings.card_1_title }}</h3>
        <p>{{ section.settings.card_1_text }}</p>
      </div>
      <div class="ls-benefits__card">
        <div class="ls-benefits__icon">✨</div>
        <h3>{{ section.settings.card_2_title }}</h3>
        <p>{{ section.settings.card_2_text }}</p>
      </div>
      <div class="ls-benefits__card">
        <div class="ls-benefits__icon">🌿</div>
        <h3>{{ section.settings.card_3_title }}</h3>
        <p>{{ section.settings.card_3_text }}</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LS Benefits Grid",
  "class": "ls-benefits-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "kicker", "default": "Why LustraStrand" },
    { "type": "text", "id": "heading", "label": "heading", "default": "Thicker, fuller, stronger-looking hair — made simple" },
    { "type": "text", "id": "card_1_title", "label": "card 1 title", "default": "Promote volume" },
    { "type": "textarea", "id": "card_1_text", "label": "card 1 text", "default": "Support the look of thicker, fuller hair with a daily chew you'll actually remember to take." },
    { "type": "text", "id": "card_2_title", "label": "card 2 title", "default": "Support growth" },
    { "type": "textarea", "id": "card_2_text", "label": "card 2 text", "default": "Lustriva® plus biotin in a format designed for consistent daily use — for women and men." },
    { "type": "text", "id": "card_3_title", "label": "card 3 title", "default": "Nourish strands" },
    { "type": "textarea", "id": "card_3_text", "label": "card 3 text", "default": "No artificial sweeteners or dyes. Mixed berry flavor. 60 soft chews per pouch." }
  ],
  "presets": [{ "name": "LS Benefits Grid" }]
}
{% endschema %}
