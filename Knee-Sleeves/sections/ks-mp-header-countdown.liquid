{% comment %}
  FLEXORA header row 2 — promo line + sales countdown (black bar).
{% endcomment %}
{{ 'lustrastrand.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lustrastrand-countdown.js' | asset_url }}" defer></script>
<style>
  .ks-mp-header-countdown-section .ls-announce {
    padding-top: 6px !important;
    padding-bottom: 6px !important;
  }
  .ks-mp-header-countdown-section .ls-announce__inner,
  .ks-mp-header-countdown-section .ls-announce__inner--with-logo {
    flex-direction: column !important;
    justify-content: center !important;
    align-items: center !important;
    text-align: center !important;
    max-width: 100% !important;
    padding-inline: var(--ks-mp-page-gutter, 12px) !important;
  }
  @media (max-width: 479px) {
    .ks-mp-header-countdown-section .ls-announce {
      padding-top: 5px !important;
      padding-bottom: 5px !important;
      font-size: clamp(10px, 3.4vw, 12px);
    }
    .ks-mp-header-countdown-section .ls-announce__promo,
    .ks-mp-header-countdown-section .ls-announce__countdown {
      font-size: inherit;
      line-height: 1.25;
    }
  }
  .ks-mp-header-countdown-section .ls-announce__content {
    flex: 0 1 auto !important;
    align-items: center !important;
  }
</style>

<div
  class="ls-announce ks-mp-header-countdown"
  id="ks-mp-header-countdown-{{ section.id }}"
  data-ls-countdown
  data-end="{{ section.settings.end_datetime | escape }}"
  {{ section.shopify_attributes }}
>
  <div class="ls-announce__inner">
    <div class="ls-announce__content">
      <p class="ls-announce__promo">{{ section.settings.promo_text | escape }}</p>
      <p class="ls-announce__countdown" data-cd-live aria-live="polite">
        <span class="ls-announce__countdown-label">{{ section.settings.timer_label | escape }}</span>
        <span class="ls-announce__timer">
          <span data-cd-days>0d</span>
          <span data-cd-hours>00h</span>
          <span data-cd-mins>00m</span>
          <span data-cd-secs>00s</span>
        </span>
      </p>
      <p class="ls-announce__expired" data-cd-expired hidden>{{ section.settings.expired_text | escape }}</p>
      {% if section.settings.secondary_text != blank %}
        <p class="ls-announce__secondary">{{ section.settings.secondary_text | escape }}</p>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "FLEXORA — Countdown bar",
  "class": "ks-mp-header-countdown-section ls-announce-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "text",
      "id": "promo_text",
      "label": "Promo text",
      "default": "⚡ FLEXORA — Limited stock"
    },
    {
      "type": "text",
      "id": "timer_label",
      "label": "Timer label",
      "default": "Sales Ends in"
    },
    {
      "type": "text",
      "id": "end_datetime",
      "label": "Countdown end (ISO 8601)",
      "default": "2026-11-10T00:00:20+05:30"
    },
    {
      "type": "text",
      "id": "expired_text",
      "label": "Text when timer ends",
      "default": "Offer extended — shop now"
    },
    {
      "type": "text",
      "id": "secondary_text",
      "label": "Secondary text (optional)"
    }
  ],
  "presets": [{ "name": "FLEXORA — Countdown bar" }]
}
{% endschema %}
