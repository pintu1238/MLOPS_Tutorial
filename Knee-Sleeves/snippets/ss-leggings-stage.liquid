      <div class="vts">
        <div class="vts-grid">
          <video src="//sirasculpt.com/cdn/shop/t/5/assets/slp1-vt1.mp4?v=78584978882608119541787127130" autoplay muted loop playsinline preload="metadata" aria-label="Customer video review"></video>
          <video src="//sirasculpt.com/cdn/shop/t/5/assets/slp1-vt2.mp4?v=27854869096627248561787127132" autoplay muted loop playsinline preload="metadata" aria-label="Customer video review"></video>
          <video src="//sirasculpt.com/cdn/shop/t/5/assets/slp1-vt3.mp4?v=149548577010380044221787127134" autoplay muted loop playsinline preload="metadata" aria-label="Customer video review"></video>
          <video src="//sirasculpt.com/cdn/shop/t/5/assets/slp1-vt4.mp4?v=36203594278867430671787127918" autoplay muted loop playsinline preload="metadata" aria-label="Customer video review"></video>
        </div>
