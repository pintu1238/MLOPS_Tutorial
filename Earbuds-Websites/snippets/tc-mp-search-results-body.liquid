{% comment %}
  TORQVOLT search results markup. Used by tc-mp-search-results and legacy ss-search-results.
  @param {section} tc_mp_section
{% endcomment %}
{% liquid
  assign rc_fallback_handle = tc_mp_section.settings.fallback_product_handle | default: 'flytek-curve-rc-drift-car-4x4'
  assign rc_fallback_product = all_products[rc_fallback_handle]
%}

<section class="tc-mp-search tc-mp-shop-all" aria-labelledby="tc-mp-search-title-{{ tc_mp_section.id }}">
  <header class="tc-mp-shop-all__hero">
    <h1 class="tc-mp-shop-all__title" id="tc-mp-search-title-{{ tc_mp_section.id }}">
      {{ tc_mp_section.settings.heading | default: 'Search' | escape }}
    </h1>
    {% if search.performed and search.terms != blank %}
      {% assign terms_l = search.terms | downcase %}
      {% assign rc_result_count = 0 %}
      {% assign product_results = search.results | where: 'object_type', 'product' %}
      {% for product in product_results %}
        {% capture show_rc %}{% render 'tc-mp-search-show-product', tc_mp_product: product %}{% endcapture %}
        {% if show_rc == '1' %}
          {% assign rc_result_count = rc_result_count | plus: 1 %}
        {% endif %}
      {% endfor %}
      {% if rc_result_count == 0 and rc_fallback_product != blank %}
        {% if terms_l contains 'car' or terms_l contains 'rc' or terms_l contains 'remote' or terms_l contains 'hobby' or terms_l contains 'drift' or terms_l contains 'flytek' or terms_l contains 'crawler' or terms_l contains 'torqvolt' %}
          {% assign rc_result_count = 1 %}
        {% endif %}
      {% endif %}
      <p class="tc-mp-shop-all__sub">
        {{ rc_result_count }} results for “{{ search.terms | escape }}”
      </p>
    {% endif %}
  </header>

  <div class="tc-mp-shop-all__inner">
    <form action="{{ routes.search_url }}" method="get" role="search" class="tc-mp-search__form sssr__form">
      <div class="sssr__field">
        <input
          class="sssr__input"
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ tc_mp_section.settings.placeholder | default: 'Search RC cars, drift, crawlers…' | escape }}"
          autocomplete="off"
          autocorrect="off"
          spellcheck="false"
          aria-label="{{ 'content.search_input_label' | t }}"
        >
        <input type="hidden" name="type" value="product">
        <input type="hidden" name="options[prefix]" value="last">
        <button class="sssr__go" type="submit" aria-label="{{ 'content.search' | t }}">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
          </svg>
        </button>
      </div>
      <div class="sssr__live ss-search__results" hidden></div>
    </form>

    {% if search.performed %}
      {% assign product_results = search.results | where: 'object_type', 'product' %}
      {% assign terms_l = search.terms | downcase %}
      {% assign rc_result_count = 0 %}
      {% assign card_index = 0 %}

      <div
        id="tcMpCatalogSearchMount"
        class="tc-mp-shop-all__grid tc-mp-shop-all__grid--cols-4"
        role="list"
        data-q="{{ search.terms | escape }}"
        hidden
      ></div>

      <div id="tcMpShopifySearchGrid" class="tc-mp-shop-all__grid tc-mp-shop-all__grid--cols-4" role="list">
        {% for product in product_results %}
          {% capture show_rc %}{% render 'tc-mp-search-show-product', tc_mp_product: product %}{% endcapture %}
          {% unless show_rc == '1' %}
            {% continue %}
          {% endunless %}
          {% liquid
            assign card_index = card_index | plus: 1
            assign rc_result_count = rc_result_count | plus: 1
            assign variant = product.selected_or_first_available_variant
            assign sale_rupees = variant.price | divided_by: 100
            assign compare_rupees = variant.compare_at_price | divided_by: 100
            assign list_excerpt = product.description | strip_html | truncate: 160
            assign card_price_display = variant.price | money
          %}
          {% render 'tc-mp-shop-all-card',
            card_url: product.url,
            card_title: product.title,
            tag: product.type,
            subtitle: product.vendor,
            price_text: card_price_display,
            price_rupees: sale_rupees,
            compare_rupees: compare_rupees,
            card_order: card_index,
            in_stock: product.available,
            list_excerpt: list_excerpt,
            product: product,
            image: product.featured_image,
            rating: tc_mp_section.settings.default_rating,
            review_count: tc_mp_section.settings.default_review_count,
            reviews_label: tc_mp_section.settings.reviews_label,
            color_seed: card_index
          %}
        {% endfor %}

        {% if rc_result_count == 0 and rc_fallback_product != blank %}
          {% if terms_l contains 'car' or terms_l contains 'rc' or terms_l contains 'remote' or terms_l contains 'hobby' or terms_l contains 'drift' or terms_l contains 'flytek' or terms_l contains 'crawler' or terms_l contains 'torqvolt' %}
            {% liquid
              assign product = rc_fallback_product
              assign card_index = card_index | plus: 1
              assign variant = product.selected_or_first_available_variant
              assign sale_rupees = variant.price | divided_by: 100
              assign compare_rupees = variant.compare_at_price | divided_by: 100
              assign list_excerpt = product.description | strip_html | truncate: 160
              assign card_price_display = variant.price | money
            %}
            {% render 'tc-mp-shop-all-card',
              card_url: product.url,
              card_title: product.title,
              tag: product.type,
              subtitle: product.vendor,
              price_text: card_price_display,
              price_rupees: sale_rupees,
              compare_rupees: compare_rupees,
              card_order: card_index,
              in_stock: product.available,
              list_excerpt: list_excerpt,
              product: product,
              image: product.featured_image,
              rating: tc_mp_section.settings.default_rating,
              review_count: tc_mp_section.settings.default_review_count,
              reviews_label: tc_mp_section.settings.reviews_label,
              color_seed: card_index
            %}
            {% assign rc_result_count = 1 %}
          {% endif %}
        {% endif %}
      </div>

      {% if rc_result_count == 0 %}
        <p class="tc-mp-search__empty">{{ tc_mp_section.settings.empty_message | default: 'No products match your search. Try drift, crawler, or FLYTEK.' | escape }}</p>
      {% endif %}
    {% endif %}
  </div>
</section>
