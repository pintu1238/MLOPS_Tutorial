{% comment %}
  Cleer-style open-ear or headphone product grid — theme #155526856773.
{% endcomment %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700&display=swap" rel="stylesheet">
{{ 'eb-mp-showcase-cleer.css' | asset_url | stylesheet_tag }}

{% liquid
  assign layout = section.settings.layout | default: 'open_ear'
  assign grid_class = 'eb-mp-cleer__grid'
  if layout == 'open_ear'
    assign grid_class = grid_class | append: ' eb-mp-cleer__grid--3'
  endif
%}

<section class="eb-mp-cleer" id="eb-mp-cleer-{{ section.id }}" {{ section.shopify_attributes }}>
  {% if layout == 'headphones' %}
    <div class="eb-mp-cleer__toolbar eb-mp-cleer__toolbar--split">
      <p class="eb-mp-cleer__count">{{ section.settings.results_count | default: '4' }} Results</p>
      <p class="eb-mp-cleer__sort">
        Sort By: <strong>{{ section.settings.sort_label | default: 'Featured' | escape }}</strong>
      </p>
    </div>
  {% endif %}

  <div class="{{ grid_class }}" role="list">
    {% for block in section.blocks %}
      {% liquid
        assign title = block.settings.title
        assign link = block.settings.link | default: '/collections/all'
        assign price = block.settings.price
        assign compare = block.settings.compare_price
        assign badge = block.settings.badge
        assign img_key = block.settings.fallback_image | default: 'arc5'
        assign img_file = 'eb-mp-prod-' | append: img_key | append: '.jpg'
        assign img_src = img_file | asset_url
        assign title_class = 'eb-mp-cleer__title'
        if layout == 'headphones'
          assign title_class = title_class | append: ' eb-mp-cleer__title--caps'
        endif
      %}
      <article class="eb-mp-cleer__card" role="listitem" {{ block.shopify_attributes }}>
        <div class="eb-mp-cleer__media">
          {% if badge == 'new' %}
            <span class="eb-mp-cleer__badge eb-mp-cleer__badge--new">New</span>
          {% elsif badge == 'sale' %}
            <span class="eb-mp-cleer__badge eb-mp-cleer__badge--sale">Sale</span>
          {% endif %}
          {% if block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: 600
              | image_tag: class: 'eb-mp-cleer__img', loading: 'lazy', alt: title
            }}
          {% else %}
            <img class="eb-mp-cleer__img" src="{{ img_src }}" alt="{{ title | escape }}" width="400" height="400" loading="lazy">
          {% endif %}
        </div>
        {% if title != blank %}
          <h2 class="{{ title_class }}">{{ title | escape }}</h2>
        {% endif %}
        <div class="eb-mp-cleer__price-row">
          {% if price != blank %}
            <p class="eb-mp-cleer__price">{{ price | escape }}</p>
          {% endif %}
          {% if compare != blank %}
            <p class="eb-mp-cleer__compare">{{ compare | escape }}</p>
          {% endif %}
        </div>
        {% if block.settings.show_swatches %}
          <div class="eb-mp-cleer__swatches" aria-hidden="true">
            {% assign sw1 = block.settings.swatch_1 | default: 'black' %}
            {% assign sw2 = block.settings.swatch_2 | default: 'white' %}
            <span class="eb-mp-cleer__swatch eb-mp-cleer__swatch--{{ sw1 }} eb-mp-cleer__swatch--active"></span>
            <span class="eb-mp-cleer__swatch eb-mp-cleer__swatch--{{ sw2 }}"></span>
          </div>
        {% endif %}
        <a class="eb-mp-cleer__btn" href="{{ link }}">{{ section.settings.cta_label | default: 'Shop Now' | escape }}</a>
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "EB Cleer showcase",
  "tag": "section",
  "class": "section-eb-mp-cleer",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "open_ear", "label": "Open-ear (3 columns)" },
        { "value": "headphones", "label": "Headphones + toolbar" }
      ],
      "default": "open_ear"
    },
    {
      "type": "text",
      "id": "results_count",
      "label": "Results count (headphones)",
      "default": "4"
    },
    {
      "type": "text",
      "id": "sort_label",
      "label": "Sort label",
      "default": "Featured"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Shop Now"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Product name" },
        { "type": "text", "id": "price", "label": "Price", "default": "$99.99" },
        { "type": "text", "id": "compare_price", "label": "Compare at price" },
        {
          "type": "select",
          "id": "badge",
          "label": "Badge",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "new", "label": "New" },
            { "value": "sale", "label": "Sale" }
          ],
          "default": "none"
        },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "select",
          "id": "fallback_image",
          "label": "Fallback asset key",
          "options": [
            { "value": "arc5-gaming", "label": "ARC 5 Gaming" },
            { "value": "arc5", "label": "ARC 5" },
            { "value": "arc4", "label": "ARC 4" },
            { "value": "enduro100", "label": "ENDURO 100" },
            { "value": "enduro-anc", "label": "ENDURO ANC" },
            { "value": "alpha", "label": "ALPHA" },
            { "value": "wireless-premium", "label": "Wireless premium" }
          ],
          "default": "arc5"
        },
        { "type": "checkbox", "id": "show_swatches", "label": "Show color swatches", "default": true },
        {
          "type": "select",
          "id": "swatch_1",
          "label": "Swatch 1",
          "options": [
            { "value": "black", "label": "Black" },
            { "value": "white", "label": "White" },
            { "value": "navy", "label": "Navy" },
            { "value": "tan", "label": "Tan" },
            { "value": "bronze", "label": "Bronze" }
          ],
          "default": "black"
        },
        {
          "type": "select",
          "id": "swatch_2",
          "label": "Swatch 2",
          "options": [
            { "value": "white", "label": "White" },
            { "value": "black", "label": "Black" },
            { "value": "navy", "label": "Navy" },
            { "value": "tan", "label": "Tan" },
            { "value": "bronze", "label": "Bronze" }
          ],
          "default": "white"
        }
      ]
    }
  ],
  "presets": [{ "name": "EB Cleer showcase" }]
}
{% endschema %}
