{% comment %}
  Four-up trust bar above footer — SVG icon assets (theme #155526856773).
{% endcomment %}
{{ 'eb-mp-trust-bar.css' | asset_url | stylesheet_tag }}

<section class="eb-mp-trust-bar" id="eb-mp-trust-bar-{{ section.id }}" {{ section.shopify_attributes }}>
  <ul class="eb-mp-trust-bar__grid" role="list">
    {% for block in section.blocks %}
      {% liquid
        assign icon = block.settings.icon | default: 'shipping'
        assign icon_file = 'eb-mp-trust-icon-shipping.svg'
        case icon
          when 'returns'
            assign icon_file = 'eb-mp-trust-icon-returns.svg'
          when 'warranty'
            assign icon_file = 'eb-mp-trust-icon-warranty.svg'
          when 'trust'
            assign icon_file = 'eb-mp-trust-icon-trust.svg'
        endcase
      %}
      <li class="eb-mp-trust-bar__item" {{ block.shopify_attributes }}>
        <span class="eb-mp-trust-bar__icon" aria-hidden="true">
          <img
            src="{{ icon_file | asset_url }}"
            alt=""
            width="64"
            height="64"
            loading="lazy"
            decoding="async"
          >
        </span>
        <p class="eb-mp-trust-bar__text">{{ block.settings.label | escape }}</p>
      </li>
    {% endfor %}
  </ul>
</section>

{% schema %}
{
  "name": "EB trust bar",
  "tag": "section",
  "class": "section-eb-mp-trust-bar",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "item",
      "name": "Trust item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shipping", "label": "Free shipping" },
            { "value": "returns", "label": "Easy returns" },
            { "value": "warranty", "label": "Warranty" },
            { "value": "trust", "label": "Trust badge" }
          ],
          "default": "shipping"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Free Shipping"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "EB trust bar",
      "blocks": [
        { "type": "item", "settings": { "icon": "shipping", "label": "Free Shipping" } },
        { "type": "item", "settings": { "icon": "returns", "label": "72 Hours Easy Returns" } },
        { "type": "item", "settings": { "icon": "warranty", "label": "6 Months Warranty" } },
        { "type": "item", "settings": { "icon": "trust", "label": "Trust Since 2018" } }
      ]
    }
  ]
}
{% endschema %}
