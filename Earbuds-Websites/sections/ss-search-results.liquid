{% comment %}
  Legacy section id — renders TORQVOLT RC search (not Sira Sculpt).
{% endcomment %}
{{ 'tc-mp-shop-all.css' | asset_url | stylesheet_tag }}
{% render 'tc-mp-search-results-body', tc_mp_section: section %}

{% stylesheet %}
  .tc-mp-search__form {
    max-width: 560px;
    margin: 0 auto 2rem;
    position: relative;
  }

  .tc-mp-search__empty {
    text-align: center;
    padding: 2rem 1rem;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Sira Search Results",
  "tag": "section",
  "class": "ss-search-results",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Search"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Search placeholder",
      "default": "Search RC cars, drift, crawlers…"
    },
    {
      "type": "text",
      "id": "fallback_product_handle",
      "label": "Fallback RC product handle",
      "default": "flytek-curve-rc-drift-car-4x4"
    },
    {
      "type": "text",
      "id": "empty_message",
      "label": "No results message",
      "default": "No products match your search. Try drift, crawler, or FLYTEK."
    },
    {
      "type": "text",
      "id": "default_rating",
      "label": "Default rating (list view)",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "default_review_count",
      "label": "Default review count (list view)",
      "default": "120"
    },
    {
      "type": "text",
      "id": "reviews_label",
      "label": "Reviews label",
      "default": "Reviews"
    }
  ],
  "presets": [{ "name": "Sira Search Results" }]
}
{% endschema %}
