{% comment %}
  Walmart-style promo bento grid — text via HTML/CSS overlays (theme #155526856773).
{% endcomment %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&display=swap" rel="stylesheet">
{{ 'eb-mp-promo-bento.css' | asset_url | stylesheet_tag }}

<section class="eb-mp-bento" id="eb-mp-bento-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="eb-mp-bento__grid">
    {% for block in section.blocks %}
      {% liquid
        assign link = block.settings.link | default: '/collections/all'
        assign layout = block.settings.layout
        assign tone = block.settings.tone | default: 'dark'
        assign image_asset = block.settings.image_asset
        assign eyebrow = block.settings.eyebrow
        assign title = block.settings.title
        assign price = block.settings.price
        assign cta_label = block.settings.cta_label
        assign cta_style = block.settings.cta_style | default: 'link'
      %}
      <a
        class="eb-mp-bento__tile eb-mp-bento__tile--{{ layout }} eb-mp-bento__tile--tone-{{ tone }}"
        href="{{ link }}"
        {{ block.shopify_attributes }}
      >
        {% if tone == 'light' %}
          <div class="eb-mp-bento__copy eb-mp-bento__copy--top">
            {% if eyebrow != blank %}
              <p class="eb-mp-bento__eyebrow">{{ eyebrow | escape }}</p>
            {% endif %}
            {% if title != blank %}
              <p class="eb-mp-bento__title">{{ title | escape }}</p>
            {% endif %}
            {% if cta_label != blank and cta_style == 'link' %}
              <span class="eb-mp-bento__cta">{{ cta_label | escape }}</span>
            {% endif %}
          </div>
          {% if image_asset != blank or block.settings.image != blank %}
            <div class="eb-mp-bento__media" aria-hidden="true">
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 22vw, 100vw', alt: ''
                }}
              {% else %}
                <img
                  src="{{ image_asset | asset_url }}"
                  alt=""
                  width="800"
                  height="600"
                  loading="lazy"
                >
              {% endif %}
            </div>
          {% endif %}
          {% if price != blank %}
            <div class="eb-mp-bento__copy eb-mp-bento__copy--bottom">
              <p class="eb-mp-bento__price">{{ price | escape }}</p>
            </div>
          {% endif %}
        {% else %}
          {% if image_asset != blank or block.settings.image != blank %}
            <div class="eb-mp-bento__media" aria-hidden="true">
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 30vw, 100vw', alt: ''
                }}
              {% else %}
                <img
                  src="{{ image_asset | asset_url }}"
                  alt=""
                  width="800"
                  height="600"
                  loading="lazy"
                >
              {% endif %}
            </div>
          {% endif %}
          <span class="eb-mp-bento__shade" aria-hidden="true"></span>
          <div class="eb-mp-bento__copy">
            {% if eyebrow != blank %}
              <p class="eb-mp-bento__eyebrow">{{ eyebrow | escape }}</p>
            {% endif %}
            {% if title != blank %}
              <p class="eb-mp-bento__title">{{ title | escape }}</p>
            {% endif %}
            {% if cta_label != blank %}
              {% if cta_style == 'button' %}
                <span class="eb-mp-bento__btn">{{ cta_label | escape }}</span>
              {% else %}
                <span class="eb-mp-bento__cta">{{ cta_label | escape }}</span>
              {% endif %}
            {% endif %}
          </div>
        {% endif %}
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "EB promo bento",
  "tag": "section",
  "class": "section-eb-mp-promo-bento",
  "max_blocks": 5,
  "blocks": [
    {
      "type": "tile",
      "name": "Bento tile",
      "settings": [
        {
          "type": "select",
          "id": "layout",
          "label": "Grid slot",
          "options": [
            { "value": "hero", "label": "Large left" },
            { "value": "wide", "label": "Top wide" },
            { "value": "sq-a", "label": "Bottom left square" },
            { "value": "sq-b", "label": "Bottom right square" },
            { "value": "tall", "label": "Tall right" }
          ],
          "default": "hero"
        },
        {
          "type": "select",
          "id": "tone",
          "label": "Background tone",
          "options": [
            { "value": "dark", "label": "Photo + dark overlay" },
            { "value": "red", "label": "Red accent" },
            { "value": "green", "label": "Green accent" },
            { "value": "light", "label": "Light feature card" }
          ],
          "default": "dark"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override"
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Theme asset filename"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow / kicker"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Headline"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price (light card only)"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "CTA label",
          "default": "Shop now"
        },
        {
          "type": "select",
          "id": "cta_style",
          "label": "CTA style",
          "options": [
            { "value": "link", "label": "Underlined link" },
            { "value": "button", "label": "White pill button" }
          ],
          "default": "link"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "EB promo bento",
      "blocks": [
        {
          "type": "tile",
          "settings": {
            "layout": "hero",
            "tone": "dark",
            "image_asset": "eb-mp-bento-hero.jpg",
            "eyebrow": "Great sound, home or away",
            "title": "Headphones to earbuds",
            "cta_label": "Shop now",
            "cta_style": "button"
          }
        },
        {
          "type": "tile",
          "settings": {
            "layout": "wide",
            "tone": "dark",
            "image_asset": "eb-mp-bento-wide.jpg",
            "eyebrow": "Crisp detail & bass made easy",
            "title": "Premium headphones & open-ear",
            "cta_label": "Shop now"
          }
        },
        {
          "type": "tile",
          "settings": {
            "layout": "sq-a",
            "tone": "red",
            "image_asset": "eb-mp-bento-red.jpg",
            "title": "Audio gifts in as fast as 30 mins.*",
            "cta_label": "Shop now"
          }
        },
        {
          "type": "tile",
          "settings": {
            "layout": "sq-b",
            "tone": "green",
            "image_asset": "eb-mp-bento-green.jpg",
            "title": "Top audio for music lovers",
            "cta_label": "Shop now"
          }
        },
        {
          "type": "tile",
          "settings": {
            "layout": "tall",
            "tone": "light",
            "image_asset": "eb-mp-bento-feature.jpg",
            "eyebrow": "New this season",
            "title": "Pro Wireless Earbuds",
            "price": "₹2,499",
            "cta_label": "Shop now"
          }
        }
      ]
    }
  ]
}
{% endschema %}
