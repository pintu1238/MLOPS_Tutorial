{% comment %}
  Shop by collection — 3 promo cards (theme #155526856773).
{% endcomment %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700&display=swap" rel="stylesheet">
{{ 'eb-mp-shop-by-collection.css' | asset_url | stylesheet_tag }}

<section class="eb-mp-shop-col" id="eb-mp-shop-col-{{ section.id }}" {{ section.shopify_attributes }}>
  {% if section.settings.heading != blank %}
    <h2 class="eb-mp-shop-col__heading">{{ section.settings.heading | escape }}</h2>
  {% endif %}
  <div class="eb-mp-shop-col__grid" role="list">
    {% for block in section.blocks %}
      {% liquid
        assign label = block.settings.label
        assign link = block.settings.link | default: '/collections/all'
        assign image_asset = block.settings.image_asset
      %}
      <a
        class="eb-mp-shop-col__card"
        href="{{ link }}"
        role="listitem"
        {{ block.shopify_attributes }}
      >
        {% if block.settings.image != blank %}
          {{
            block.settings.image
            | image_url: width: 1200
            | image_tag:
              class: 'eb-mp-shop-col__img',
              loading: 'lazy',
              sizes: '(min-width: 990px) 33vw, 100vw',
              alt: label
          }}
        {% elsif image_asset != blank %}
          <img
            class="eb-mp-shop-col__img"
            src="{{ image_asset | asset_url }}"
            alt="{{ label | escape }}"
            width="1200"
            height="900"
            loading="lazy"
          >
        {% endif %}
        {% if label != blank %}
          <p class="eb-mp-shop-col__label">{{ label | escape }}</p>
        {% endif %}
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "EB shop by collection",
  "tag": "section",
  "class": "section-eb-mp-shop-by-collection",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Shop By Collection"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Collection card",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "All Products"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override"
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Theme asset filename"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "EB shop by collection",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "label": "All Products",
            "image_asset": "eb-mp-col-all.jpg"
          }
        },
        {
          "type": "card",
          "settings": {
            "label": "New Arrival",
            "image_asset": "eb-mp-col-new.jpg"
          }
        },
        {
          "type": "card",
          "settings": {
            "label": "Bestseller",
            "image_asset": "eb-mp-col-best.jpg"
          }
        }
      ]
    }
  ]
}
{% endschema %}
