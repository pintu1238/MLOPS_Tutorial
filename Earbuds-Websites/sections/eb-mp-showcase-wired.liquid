{% comment %}
  Flipkart-style wired earbuds grid — theme #155526856773.
{% endcomment %}
{{ 'eb-mp-showcase-wired.css' | asset_url | stylesheet_tag }}

<section class="eb-mp-wired-mkt" id="eb-mp-wired-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="eb-mp-wired-mkt__grid" role="list">
    {% for block in section.blocks %}
      {% liquid
        assign title = block.settings.title
        assign link = block.settings.link | default: '/collections/all'
        assign price = block.settings.price
        assign mrp = block.settings.mrp
        assign discount = block.settings.discount
        assign rating = block.settings.rating
        assign review_count = block.settings.review_count
        assign img_key = block.settings.fallback_image | default: 'typec-1'
        assign img_file = 'eb-mp-wired-' | append: img_key | append: '.jpg'
        assign img_src = img_file | asset_url
      %}
      <a class="eb-mp-wired-mkt__card" href="{{ link }}" role="listitem" {{ block.shopify_attributes }}>
        <div class="eb-mp-wired-mkt__media">
          {% if block.settings.show_trending %}
            <span class="eb-mp-wired-mkt__trend">Trending</span>
          {% endif %}
          <span class="eb-mp-wired-mkt__wish" aria-hidden="true">♡</span>
          {% if block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: 400
              | image_tag: class: 'eb-mp-wired-mkt__img', loading: 'lazy', alt: title
            }}
          {% else %}
            <img class="eb-mp-wired-mkt__img" src="{{ img_src }}" alt="{{ title | escape }}" width="320" height="320" loading="lazy">
          {% endif %}
        </div>
        <div class="eb-mp-wired-mkt__body">
          {% if block.settings.show_sponsored %}
            <p class="eb-mp-wired-mkt__sponsored">Sponsored</p>
          {% endif %}
          {% if title != blank %}
            <p class="eb-mp-wired-mkt__title">{{ title | escape }}</p>
          {% endif %}
          {% if rating != blank %}
            <p class="eb-mp-wired-mkt__rating">
              {{ rating | escape }} ★
              {% if review_count != blank %}
                <span>({{ review_count | escape }})</span>
              {% endif %}
            </p>
          {% endif %}
          <div class="eb-mp-wired-mkt__price-row">
            {% if price != blank %}
              <p class="eb-mp-wired-mkt__price">{{ price | escape }}</p>
            {% endif %}
            {% if mrp != blank %}
              <p class="eb-mp-wired-mkt__mrp">{{ mrp | escape }}</p>
            {% endif %}
            {% if discount != blank %}
              <p class="eb-mp-wired-mkt__off">{{ discount | escape }}</p>
            {% endif %}
          </div>
          {% if block.settings.bank_offer %}
            <p class="eb-mp-wired-mkt__offer">Bank Offer</p>
          {% endif %}
        </div>
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "EB wired marketplace",
  "tag": "section",
  "class": "section-eb-mp-wired-mkt",
  "blocks": [
    {
      "type": "listing",
      "name": "Listing",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "price", "label": "Price", "default": "₹376" },
        { "type": "text", "id": "mrp", "label": "MRP", "default": "₹999" },
        { "type": "text", "id": "discount", "label": "Discount label", "default": "62% off" },
        { "type": "text", "id": "rating", "label": "Rating", "default": "3.4" },
        { "type": "text", "id": "review_count", "label": "Review count", "default": "1,484" },
        { "type": "checkbox", "id": "show_sponsored", "label": "Sponsored label", "default": true },
        { "type": "checkbox", "id": "show_trending", "label": "Trending badge", "default": false },
        { "type": "checkbox", "id": "bank_offer", "label": "Bank offer line", "default": true },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "select",
          "id": "fallback_image",
          "label": "Fallback image",
          "options": [
            { "value": "typec-1", "label": "Type-C white #1" },
            { "value": "typec-2", "label": "Type-C with mic" },
            { "value": "lightning", "label": "Lightning" },
            { "value": "jack35", "label": "3.5mm jack" }
          ],
          "default": "typec-1"
        }
      ]
    }
  ],
  "presets": [{ "name": "EB wired marketplace" }]
}
{% endschema %}
