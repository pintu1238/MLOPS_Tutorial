        { "type": "spec", "settings": { "group": "item_details", "label": "Batteries are Included", "value": "Yes" } },
        { "type": "spec", "settings": { "group": "item_details", "label": "Included Components", "value": "Battery, Charging Cable, RC Car, Remote, extra 4 drift tyre & 4 cones" } },
        { "type": "spec", "settings": { "group": "item_details", "label": "Number of Items", "value": "1" } },
        { "type": "spec", "settings": { "group": "item_details", "label": "Model Number", "value": "FLYTEK-RC-DRIFT-4X4" } },
        { "type": "spec", "settings": { "group": "item_details", "label": "Model Year", "value": "2026" } },
        { "type": "spec", "settings": { "group": "item_details", "label": "Customer Package Type", "value": "Retail Box" } },
        { "type": "spec", "settings": { "group": "item_details", "label": "Sub Brand", "value": "FLYTEK Curve" } },
        { "type": "spec", "settings": { "group": "item_details", "label": "Item Highlight", "value": "Drifting & Racing Tyres, Includes Obstacles, USB Rechargeable, Extra 4 Tyres & Cones" } },
        { "type": "spec", "settings": { "group": "item_details", "label": "Number of Packs", "value": "1" } },
