{% comment %}
  Newsletter card removed — FAQ lives in footer group (flytek-faq).
{% endcomment %}

{% schema %}
{
  "name": "Newsletter card",
  "class": "ls-newsletter-card-section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Show newsletter card",
      "default": false
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get new arrivals and deals by email"
    }
  ],
  "presets": [
    {
      "name": "Newsletter card"
    }
  ]
}
{% endschema %}
