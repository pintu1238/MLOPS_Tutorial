{% comment %}
  Full-screen hero: 2 images + 1 video, slides one by one (theme #155526856773).
{% endcomment %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700&family=Sora:wght@600;700;800;900&display=swap" rel="stylesheet">
{{ 'eb-mp-hero-slideshow.css' | asset_url | stylesheet_tag }}
<script src="{{ 'eb-mp-hero-slideshow.js' | asset_url }}" defer></script>

{% liquid
  assign shop_default = section.settings.shop_link | default: '/collections/all'
  assign watch_default = section.settings.watch_link | default: shop_default
  assign interval = section.settings.autoplay_interval | default: 8
%}

<section
  class="eb-mp-hero"
  id="eb-mp-hero-{{ section.id }}"
  data-eb-mp-hero
  data-interval="{{ interval | times: 1000 }}"
  aria-roledescription="carousel"
  aria-label="{{ section.settings.carousel_label | escape }}"
  {{ section.shopify_attributes }}
>
  <div class="eb-mp-hero__media" aria-hidden="true">
    {% for block in section.blocks %}
      {% liquid
        assign is_first = forloop.first
        assign media_type = block.settings.media_type | default: 'image'
        assign image_asset = block.settings.image_asset | default: 'eb-mp-hero-left.jpg'
        assign video_asset = block.settings.video_asset | default: 'eb-mp-hero-center.mp4'
      %}
      {% if media_type == 'video' %}
        <video
          class="eb-mp-hero__slide eb-mp-hero__slide--video{% if is_first %} is-active{% endif %}"
          data-eb-mp-hero-slide
          src="{{ video_asset | asset_url }}"
          {% if block.settings.poster_asset != blank %}
            poster="{{ block.settings.poster_asset | asset_url }}"
          {% endif %}
          muted
          loop
          playsinline
          disablepictureinpicture
          {% if is_first %}
            preload="auto"
          {% else %}
            preload="metadata"
          {% endif %}
        ></video>
      {% else %}
        {% liquid
          if block.settings.image != blank
            assign img_src = block.settings.image | image_url: width: 2400
          else
            assign img_src = image_asset | asset_url
          endif
        %}
        <img
          class="eb-mp-hero__slide eb-mp-hero__slide--image{% if is_first %} is-active{% endif %}"
          data-eb-mp-hero-slide
          src="{{ img_src }}"
          alt="{{ block.settings.title | escape }}"
          width="2400"
          height="1600"
          loading="{% if is_first %}eager{% else %}lazy{% endif %}"
        >
      {% endif %}
    {% endfor %}
    <span class="eb-mp-hero__shade"></span>
  </div>

  <div class="eb-mp-hero__content">
    {% for block in section.blocks %}
      {% liquid
        assign slide_shop = block.settings.cta_link | default: shop_default
        assign slide_watch = block.settings.watch_link | default: watch_default
        assign text_align = block.settings.text_align | default: 'center'
      %}
      <div
        class="eb-mp-hero__slide-copy eb-mp-hero__slide-copy--{{ text_align }}{% if forloop.first %} is-active{% endif %}"
        data-eb-mp-hero-copy
        data-index="{{ forloop.index0 }}"
        {{ block.shopify_attributes }}
      >
        {% if block.settings.eyebrow != blank %}
          <p class="eb-mp-hero__eyebrow">{{ block.settings.eyebrow | escape }}</p>
        {% endif %}
        {% if block.settings.title != blank %}
          <h1 class="eb-mp-hero__title">{{ block.settings.title | escape }}</h1>
        {% endif %}
        {% if block.settings.copy != blank %}
          <p class="eb-mp-hero__copy">{{ block.settings.copy | escape }}</p>
        {% endif %}
        <div class="eb-mp-hero__actions">
          {% if block.settings.cta_label != blank %}
            <a class="eb-mp-hero__btn eb-mp-hero__btn--primary" href="{{ slide_shop }}">
              {{ block.settings.cta_label | escape }}
            </a>
          {% endif %}
          {% if block.settings.watch_label != blank %}
            <a class="eb-mp-hero__btn eb-mp-hero__btn--ghost" href="{{ slide_watch }}">
              {{ block.settings.watch_label | escape }}
            </a>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>

  <div class="eb-mp-hero__controls">
    <button type="button" class="eb-mp-hero__control" data-eb-mp-hero-toggle aria-label="Pause slideshow">
      <svg class="eb-mp-hero__icon-pause" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <rect x="14" y="3" width="5" height="18" rx="1"></rect>
        <rect x="5" y="3" width="5" height="18" rx="1"></rect>
      </svg>
      <svg class="eb-mp-hero__icon-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"></path>
      </svg>
    </button>
    <button type="button" class="eb-mp-hero__control" data-eb-mp-hero-prev aria-label="Previous slide">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="m14 6-6 6 6 6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </button>
    <button type="button" class="eb-mp-hero__control" data-eb-mp-hero-next aria-label="Next slide">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="m10 6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </button>
  </div>

  <div class="eb-mp-hero__dots">
    {% for block in section.blocks %}
      <button
        type="button"
        class="eb-mp-hero__dot{% if forloop.first %} is-active{% endif %}"
        data-eb-mp-hero-dot
        data-index="{{ forloop.index0 }}"
        aria-label="Show slide {{ forloop.index }}"
        {% if forloop.first %}
          aria-current="true"
        {% endif %}
      ></button>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "EB MP Hero Slideshow",
  "tag": "section",
  "class": "eb-mp-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "carousel_label",
      "label": "Carousel label (accessibility)",
      "default": "Featured hero slides"
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "label": "Seconds per slide",
      "min": 4,
      "max": 15,
      "step": 1,
      "default": 8
    },
    {
      "type": "url",
      "id": "shop_link",
      "label": "Default shop link"
    },
    {
      "type": "url",
      "id": "watch_link",
      "label": "Default explore link"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "select",
          "id": "media_type",
          "label": "Media type",
          "options": [
            { "value": "image", "label": "Image" },
            { "value": "video", "label": "Video" }
          ],
          "default": "image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (override)"
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Image theme asset filename",
          "default": "eb-mp-hero-left.jpg"
        },
        {
          "type": "text",
          "id": "video_asset",
          "label": "Video theme asset filename",
          "default": "eb-mp-hero-center.mp4"
        },
        {
          "type": "text",
          "id": "poster_asset",
          "label": "Video poster asset (optional)"
        },
        {
          "type": "select",
          "id": "text_align",
          "label": "Text alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Pure sound"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "HEAR EVERY DETAIL."
        },
        {
          "type": "textarea",
          "id": "copy",
          "label": "Subtext",
          "default": "Crisp highs, deep bass, and clarity that follows you everywhere."
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Shop button",
          "default": "Shop"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "Shop link"
        },
        {
          "type": "text",
          "id": "watch_label",
          "label": "Second button",
          "default": "Explore"
        },
        {
          "type": "url",
          "id": "watch_link",
          "label": "Second button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "EB MP Hero Slideshow",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "media_type": "image",
            "image_asset": "eb-mp-hero-left.jpg",
            "eyebrow": "Pure sound",
            "title": "HEAR EVERY DETAIL.",
            "copy": "Studio-grade drivers tuned for balance, depth, and everyday listening.",
            "cta_label": "Shop",
            "watch_label": "Explore"
          }
        },
        {
          "type": "slide",
          "settings": {
            "media_type": "video",
            "video_asset": "eb-mp-hero-center.mp4",
            "poster_asset": "eb-mp-hero-left.jpg",
            "eyebrow": "In motion",
            "title": "FEEL THE BEAT.",
            "copy": "Adaptive audio that moves with you — from commute to workout.",
            "cta_label": "Shop",
            "watch_label": "Explore"
          }
        },
        {
          "type": "slide",
          "settings": {
            "media_type": "image",
            "image_asset": "eb-mp-hero-right.jpg",
            "eyebrow": "All-day comfort",
            "title": "STAY IN YOUR FLOW.",
            "copy": "Secure fit, sweat-ready design, and hours of battery for long days.",
            "cta_label": "Shop",
            "watch_label": "Explore"
          }
        }
      ]
    }
  ]
}
{% endschema %}
