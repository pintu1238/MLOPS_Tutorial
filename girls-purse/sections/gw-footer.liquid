{% comment %}
  Section contract.
  Storefront footer in the dark editorial layout: wordmark, wardrobe links,
  policy links, newsletter, and payment marks. Copy is for Girls Winter.
  @example
  <!-- Girls Winter wordmark, winter dresses and coats, shipping, join list -->
{% endcomment %}

{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.background | default: '#000000' }} !important;
  }
{% endstyle %}

<div
  class="gw-foot"
  style="
    --gw-foot-bg: {{ section.settings.background }};
    --gw-foot-text: {{ section.settings.text_color }};
    --gw-foot-button: {{ section.settings.button_color }};
    --gw-foot-button-text: {{ section.settings.button_text }};
  "
>
  <div class="gw-foot__inner">
    <div class="gw-foot__grid">
      <div class="gw-foot__brand">
        {% if section.settings.logo != blank %}
          {{
            section.settings.logo
            | image_url: width: 480
            | image_tag:
              class: 'gw-foot__logo',
              widths: '240, 480',
              alt: section.settings.brand,
              loading: 'lazy'
          }}
        {% elsif settings.logo != blank %}
          {{
            settings.logo
            | image_url: width: 480
            | image_tag:
              class: 'gw-foot__logo',
              widths: '240, 480',
              alt: section.settings.brand,
              loading: 'lazy'
          }}
        {% else %}
          <a href="{{ routes.root_url }}" class="gw-foot__logo-link gw-brand" aria-label="{{ section.settings.brand | escape }}">
            <span class="gw-brand__title">{{ section.settings.brand | default: 'Luxe Step' | escape }}</span>
            {% if section.settings.brand_tag != blank %}
              <span class="gw-brand__script">{{ section.settings.brand_tag | escape }}</span>
            {% endif %}
          </a>
        {% endif %}
        {% if section.settings.tagline != blank %}
          <p class="gw-foot__tagline">{{ section.settings.tagline | escape }}</p>
        {% endif %}
      </div>

      <nav class="gw-foot__col" aria-label="{{ section.settings.wardrobe_heading | escape }}">
        {% if section.settings.wardrobe_heading != blank %}
          <p class="gw-foot__label">{{ section.settings.wardrobe_heading | escape }}</p>
        {% endif %}
        <ul class="gw-foot__links list-unstyled" role="list">
          {% for block in section.blocks %}
            {% if block.type == 'link' and block.settings.column == 'wardrobe' and block.settings.label != blank %}
              <li {{ block.shopify_attributes }}>
                {% capture gw_foot_href %}
                  {% render 'gw-footer-link-href', label: block.settings.label, link: block.settings.link %}
                {% endcapture %}
                {% assign gw_foot_href = gw_foot_href | strip %}
                {% if gw_foot_href != blank %}
                  <a href="{{ gw_foot_href | escape }}">{{ block.settings.label | escape }}</a>
                {% else %}
                  <span>{{ block.settings.label | escape }}</span>
                {% endif %}
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </nav>

      <nav class="gw-foot__col" aria-label="{{ section.settings.details_heading | escape }}">
        {% if section.settings.details_heading != blank %}
          <p class="gw-foot__label">{{ section.settings.details_heading | escape }}</p>
        {% endif %}
        <ul class="gw-foot__links list-unstyled" role="list">
          {% for block in section.blocks %}
            {% if block.type == 'link' and block.settings.column == 'details' and block.settings.label != blank %}
              <li {{ block.shopify_attributes }}>
                {% capture gw_foot_href %}
                  {% render 'gw-footer-link-href', label: block.settings.label, link: block.settings.link %}
                {% endcapture %}
                {% assign gw_foot_href = gw_foot_href | strip %}
                {% if gw_foot_href != blank %}
                  <a href="{{ gw_foot_href | escape }}">{{ block.settings.label | escape }}</a>
                {% else %}
                  <span>{{ block.settings.label | escape }}</span>
                {% endif %}
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </nav>

      <div class="gw-foot__signup">
        {% if section.settings.newsletter_heading != blank %}
          <p class="gw-foot__label">{{ section.settings.newsletter_heading | escape }}</p>
        {% endif %}
        {% if section.settings.newsletter_text != blank %}
          <p class="gw-foot__blurb">{{ section.settings.newsletter_text | escape }}</p>
        {% endif %}

        {% form 'customer', class: 'gw-foot__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {% if form.posted_successfully? %}
            <p class="gw-foot__status" role="status">{{ section.settings.success_message | escape }}</p>
          {% else %}
            <div class="gw-foot__field">
              <label class="visually-hidden" for="GwFooterEmail-{{ section.id }}">
                {{ 'blocks.email_signup.label' | t }}
              </label>
              <input
                id="GwFooterEmail-{{ section.id }}"
                class="gw-foot__email"
                type="email"
                name="contact[email]"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                placeholder="{{ section.settings.email_placeholder | escape }}"
                required
                {% if form.errors %}
                  autofocus
                  aria-invalid="true"
                  aria-describedby="GwFooterError-{{ section.id }}"
                {% endif %}
              >
              <button class="gw-foot__join" type="submit">
                {{ section.settings.button_label | escape }}
              </button>
            </div>
            {% if form.errors %}
              <p class="gw-foot__status gw-foot__status--error" id="GwFooterError-{{ section.id }}" role="alert">
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </p>
            {% endif %}
          {% endif %}
        {% endform %}
      </div>
    </div>

    <div class="gw-foot__base">
      {% if section.settings.show_payments %}
        {% liquid
          assign gw_payment_types = 'amazon_pay,american_express,apple_pay,diners_club,discover,google_pay,master,paypal,shopify_pay,visa' | split: ','
        %}
        <ul class="gw-foot__pays list-unstyled" role="list" aria-label="{{ 'blocks.payment_methods' | t }}">
          {% for type in gw_payment_types %}
            <li class="gw-foot__pay">
              {{ type | payment_type_svg_tag: class: 'icon icon--full-color gw-foot__pay-icon' }}
            </li>
          {% endfor %}
        </ul>
      {% endif %}
      {% if section.settings.show_copyright %}
        <p class="gw-foot__copy">
          &copy; {{ 'now' | date: '%Y' }}
          <a href="{{ routes.root_url }}">{{ shop.name | escape }}</a>
        </p>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .gw-foot {
    width: 100%;
    max-width: 100%;
    overflow-x: clip;
    box-sizing: border-box;
    background: var(--gw-foot-bg, #000000);
    color: var(--gw-foot-text, #ffffff);
    font-family: var(--gw-font-ui), var(--font-body--family), sans-serif;
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.55;
  }

  .gw-foot__inner {
    width: min(1280px, 100%);
    margin-inline: auto;
    padding-block: clamp(48px, 6vw, 68px) clamp(20px, 3vw, 28px);
    padding-inline: clamp(12px, 4vw, 48px);
    box-sizing: border-box;
  }

  .gw-foot__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.85fr) minmax(0, 0.95fr) minmax(min(100%, 260px), 1.15fr);
    gap: clamp(28px, 4vw, 40px) clamp(20px, 3vw, 48px);
    align-items: start;
    width: 100%;
    min-width: 0;
  }

  .gw-foot__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    text-align: left;
    width: 100%;
    min-width: 0;
  }

  /* Match header wordmark (_header-logo .gw-brand) */
  .gw-foot__brand .gw-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    margin: 0;
    line-height: 1.1;
    text-align: left;
    text-decoration: none;
    color: inherit;
    width: 100%;
    max-width: 100%;
  }

  .gw-foot__brand .gw-brand__title {
    display: block;
    font-family: var(--gw-font-ui), var(--gw-font-heading), sans-serif;
    font-size: clamp(1.15rem, 2.6vw, 1.65rem);
    font-weight: 700;
    letter-spacing: 0.18em;
    margin-inline-end: -0.18em;
    text-transform: uppercase;
    text-align: left;
    color: var(--gw-foot-text, #ffffff);
  }

  .gw-foot__brand .gw-brand__script {
    display: block;
    font-family: var(--gw-font-ui), sans-serif;
    font-size: clamp(0.55rem, 1.9vw, 0.68rem);
    font-weight: 700;
    color: #ff4d14;
    letter-spacing: 0.2em;
    margin-inline-end: -0.2em;
    text-transform: uppercase;
    text-align: left;
    align-self: flex-start;
  }

  .gw-foot__logo-link.gw-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    margin: 0 0 14px;
    padding: 0;
    line-height: 1.1;
    text-decoration: none;
    color: inherit;
    width: 100%;
    max-width: 100%;
  }

  .gw-foot__logo,
  .gw-foot__logo--asset {
    display: block;
    height: auto;
    max-height: var(--gw-foot-logo-max, 52px);
    width: auto;
    max-width: min(280px, 100%);
    object-fit: contain;
    object-position: left center;
    margin-bottom: 18px;
    /* Dark header logos read on charcoal footer */
    filter: brightness(0) invert(1);
  }

  .gw-foot__logo-link:not(.gw-brand) {
    display: inline-block;
    line-height: 0;
    max-width: 100%;
  }

  .gw-foot__tagline,
  .gw-foot__blurb {
    margin: 0;
    padding: 0;
    width: 100%;
    max-width: min(32ch, 100%);
    color: color-mix(in srgb, var(--gw-foot-text) 78%, transparent);
    font-size: clamp(0.9rem, 2vw, 1rem);
    font-weight: 400;
    line-height: 1.5;
    text-align: left;
    text-wrap: pretty;
    align-self: flex-start;
  }

  .gw-foot__label {
    margin: 0 0 18px;
    font-family: var(--gw-font-ui), sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .gw-foot__links {
    display: grid;
    gap: 11px;
    margin: 0;
    padding: 0;
  }

  .gw-foot__links a,
  .gw-foot__links span {
    color: inherit;
    font-family: var(--gw-font-ui), sans-serif;
    font-size: 0.94rem;
    font-weight: 500;
    line-height: 1.4;
    text-decoration: none;
  }

  .gw-foot__links a {
    display: inline-flex;
    padding-block: 2px;
    cursor: pointer;
    pointer-events: auto;
    position: relative;
    z-index: 1;
  }

  .gw-foot__links a:hover {
    color: #ff4d14;
    opacity: 1;
  }

  .gw-foot__blurb {
    margin-bottom: 18px;
    max-width: 32ch;
  }

  .gw-foot__field {
    display: flex;
    align-items: stretch;
    flex-wrap: wrap;
    gap: 8px;
    width: 100%;
    max-width: min(400px, 100%);
    padding: 4px 4px 4px 16px;
    background: #ffffff;
    border-radius: 999px;
    box-sizing: border-box;
  }

  .gw-foot .gw-foot__email {
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    padding: 10px 4px;
    border: 0;
    border-radius: 0;
    appearance: none;
    background: transparent;
    box-shadow: none;
    color: #3d2c32;
    font-size: 0.92rem;
    line-height: 1.2;
  }

  .gw-foot .gw-foot__email::placeholder {
    color: #9a8d88;
    opacity: 1;
  }

  .gw-foot__email:focus {
    outline: none;
  }

  .gw-foot__field:focus-within {
    outline: 2px solid var(--gw-foot-text);
    outline-offset: 3px;
  }

  .gw-foot__join {
    flex: 0 0 auto;
    margin: 0;
    padding: 10px 18px;
    border: 0;
    border-radius: 999px;
    background: var(--gw-foot-button, #8e685c);
    color: var(--gw-foot-button-text, #ffffff);
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0;
    text-transform: none;
    cursor: pointer;
  }

  .gw-foot__join:hover {
    background: color-mix(in srgb, var(--gw-foot-button, #8e685c) 86%, #000);
  }

  .gw-foot a:focus-visible,
  .gw-foot__join:focus-visible {
    outline: 2px solid var(--gw-foot-text);
    outline-offset: 3px;
  }

  .gw-foot__status {
    margin: 0;
    max-width: 34ch;
    font-size: 0.92rem;
    line-height: 1.45;
  }

  .gw-foot__status--error {
    margin-top: 10px;
  }

  .gw-foot__base {
    display: flex;
    flex-direction: column;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-top: 52px;
    padding-top: 28px;
    border-top: 1px solid color-mix(in srgb, var(--gw-foot-text) 18%, transparent);
  }

  .gw-foot__pays {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px 12px;
    width: 100%;
    margin: 0;
    padding: 0;
  }

  .gw-foot__pay {
    display: flex;
    align-items: center;
    border-radius: 4px;
    overflow: hidden;
    line-height: 0;
  }

  .gw-foot__pay-icon,
  .gw-foot__pay svg {
    display: block;
    width: 48px;
    height: 30px;
    max-width: none;
  }

  .gw-foot__copy {
    margin: 0;
    color: color-mix(in srgb, var(--gw-foot-text) 70%, transparent);
    font-size: 0.78rem;
  }

  .gw-foot__copy a {
    color: inherit;
    text-decoration: none;
  }

  .gw-foot__copy a:hover {
    text-decoration: underline;
  }

  @media screen and (min-width: 1200px) {
    .gw-foot__inner {
      width: min(1400px, 100%);
    }
  }

  @media screen and (max-width: 1199px) {
    .gw-foot__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 36px clamp(16px, 3vw, 28px);
    }

    .gw-foot__brand,
    .gw-foot__signup {
      grid-column: 1 / -1;
    }
  }

  @media screen and (max-width: 749px) {
    .gw-foot__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }

    .gw-foot__brand,
    .gw-foot__signup {
      grid-column: auto;
    }

    .gw-foot__base {
      align-items: flex-start;
      flex-direction: column;
      margin-top: 36px;
    }

    .gw-foot__field {
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
      max-width: 100%;
      padding: 12px 14px;
      border-radius: 18px;
    }

    .gw-foot .gw-foot__email {
      flex: none;
      width: 100%;
      padding: 10px 4px 4px;
      text-align: left;
    }

    .gw-foot__join {
      width: 100%;
      padding: 12px 18px;
      text-align: center;
    }
  }

  @media screen and (max-width: 389px) {
    .gw-foot__pay-icon,
    .gw-foot__pay svg {
      width: 40px;
      height: 26px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gw-foot__links a,
    .gw-foot__join {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Winter footer",
  "tag": "div",
  "class": "gw-footer-section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "brand",
      "label": "Brand name",
      "default": "Luxe Step"
    },
    {
      "type": "text",
      "id": "brand_tag",
      "label": "Brand script line",
      "default": "Footwear",
      "info": "Second line under the logo, matches header (e.g. Boutique)."
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Winter dresses that layer, warm, and hold their shape. No fuss, no extra layers, just wear them."
    },
    {
      "type": "text",
      "id": "wardrobe_heading",
      "label": "Wardrobe heading",
      "default": "The wardrobe"
    },
    {
      "type": "text",
      "id": "details_heading",
      "label": "Details heading",
      "default": "The details"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Join the winter list"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Newsletter text",
      "default": "First look at new dresses, drops, and restocks. No spam, ever."
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "your@email.com"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Join"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "You're on the list. We'll write when the next dresses drop."
    },
    {
      "type": "checkbox",
      "id": "show_payments",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_copyright",
      "label": "Show copyright",
      "default": true
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Join button",
      "default": "#ff4d14"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Join button text",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        {
          "type": "select",
          "id": "column",
          "label": "Column",
          "options": [
            {
              "value": "wardrobe",
              "label": "Wardrobe"
            },
            {
              "value": "details",
              "label": "Details"
            }
          ],
          "default": "wardrobe"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Winter dresses"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Winter footer",
      "blocks": {
        "link_dresses": {
          "type": "link",
          "settings": {
            "column": "wardrobe",
            "label": "Winter dresses"
          }
        },
        "link_coats": {
          "type": "link",
          "settings": {
            "column": "wardrobe",
            "label": "Coats"
          }
        },
        "link_jackets": {
          "type": "link",
          "settings": {
            "column": "wardrobe",
            "label": "Jackets"
          }
        },
        "link_hoodies": {
          "type": "link",
          "settings": {
            "column": "wardrobe",
            "label": "Hoodies"
          }
        },
        "link_pullovers": {
          "type": "link",
          "settings": {
            "column": "wardrobe",
            "label": "Pullovers"
          }
        },
        "link_shipping": {
          "type": "link",
          "settings": {
            "column": "details",
            "label": "Shipping"
          }
        },
        "link_returns": {
          "type": "link",
          "settings": {
            "column": "details",
            "label": "Returns & refunds"
          }
        },
        "link_about": {
          "type": "link",
          "settings": {
            "column": "details",
            "label": "About"
          }
        }
      },
      "block_order": [
        "link_dresses",
        "link_coats",
        "link_jackets",
        "link_hoodies",
        "link_pullovers",
        "link_shipping",
        "link_returns",
        "link_about"
      ]
    }
  ]
}
{% endschema %}
