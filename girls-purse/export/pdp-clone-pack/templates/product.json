        "faq_1": {
          "type": "faq",
          "settings": {
            "kicker": "Everyday",
            "question": "Can I carry this bag all day?",
            "answer": "<p>Yes. Our totes, crossbodies, and shoulder styles are built for real days out — balanced weight, smooth straps, and interiors that stay organized from commute to dinner without digging through clutter.</p>"
          }
        },
        "faq_2": {
          "type": "faq",
          "settings": {
            "kicker": "Quality",
            "question": "How is Girls Purse different from fast-fashion handbags?",
            "answer": "<p>We choose full-grain leather and suede, reinforced stitching, and brushed hardware meant to look polished season after season — not creased, peeling, or tired after a few weekends.</p>"
          }
        },
        "faq_3": {
          "type": "faq",
          "settings": {
            "kicker": "Size",
            "question": "Which bag size is right for me?",
            "answer": "<p>Check the Details tab for dimensions, strap drop, and pocket layout. Totes and shoppers note laptop-friendly sizing where it applies. Not sure? Message us with what you carry daily — we will point you to the right silhouette.</p>"
          }
        },
        "faq_4": {
          "type": "faq",
          "settings": {
            "kicker": "Care",
            "question": "How do I clean and store my handbag?",
            "answer": "<p>Wipe leather with a soft, dry cloth; brush suede gently and keep it away from rain. Store in a cool, dry spot, ideally in a dust bag, with straps relaxed so the shape stays true.</p>"
          }
        },
        "faq_5": {
          "type": "faq",
          "settings": {
            "kicker": "Straps",
            "question": "Are the straps adjustable? Will it fit my frame?",
            "answer": "<p>Many crossbodies and shoulder bags offer adjustable straps or multiple carry modes (hand, shoulder, crossbody). Strap drop and chain length are listed in Details — compare to a bag you already love for an easy reference.</p>"
          }
        },
        "faq_6": {
          "type": "faq",
          "settings": {
            "kicker": "Shipping",
            "question": "When will my bag arrive? What if I do not love it?",
            "answer": "<p>Orders ship in 2–3 business days with tracking. Carry it on your own routine for up to 90 days — if it is not the bag you reach for, we will refund you.</p>"
          }
        }
