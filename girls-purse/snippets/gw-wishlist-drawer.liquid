{% doc %}
  Wishlist drawer — lists items saved from bestsellers / product hearts (localStorage).

  @example
  {% render 'gw-wishlist-drawer' %}
{% enddoc %}

<script
  type="module"
  src="{{ 'gw-wishlist.js' | asset_url }}"
  fetchpriority="low"
></script>

<theme-drawer
  id="wishlist-drawer"
  data-skip-node-update
>
  <dialog
    ref="panel"
    class="theme-drawer__dialog color-custom-drawer gw-wishlist-drawer__dialog"
    aria-labelledby="gw-wishlist-heading"
  >
    <div class="gw-wishlist-drawer__inner">
      <div class="gw-cart__bar gw-wishlist-drawer__bar">
        <h2 class="gw-cart__bar-title" id="gw-wishlist-heading">
          <span class="gw-cart__bar-icon gw-wishlist-drawer__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4">
              <path d="M12 19.2s-6.4-3.9-6.4-8.1A3.6 3.6 0 0 1 9.2 7.5c1.15 0 2.15.55 2.8 1.45A3.3 3.3 0 0 1 14.8 7.5a3.6 3.6 0 0 1 3.6 3.6c0 4.2-6.4 8.1-6.4 8.1z"/>
            </svg>
          </span>
          <span>{{ 'gw.wishlist.title' | t }}</span>
        </h2>
        <button
          class="gw-cart__bar-close"
          on:click="#wishlist-drawer/close"
          type="button"
          aria-label="{{ 'actions.close' | t }}"
        >
          <span class="svg-wrapper" aria-hidden="true">
            {{- 'icon-close.svg' | inline_asset_content -}}
          </span>
        </button>
      </div>

      <div
        class="gw-wishlist-drawer__content"
        data-gw-wishlist-list
        data-remove-label="{{ 'gw.wishlist.remove' | t | escape }}"
      >
      </div>

      <p class="gw-wishlist-drawer__empty" data-gw-wishlist-empty hidden>
        {{ 'gw.wishlist.empty' | t }}
      </p>
    </div>
  </dialog>
</theme-drawer>

{% stylesheet %}
  .gw-wishlist-drawer__inner {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    background: #ffffff;
    color: #000;
  }

  #wishlist-drawer .gw-cart__bar {
    background: #ffffff;
    color: #000;
    border-bottom: 1px solid rgb(0 0 0 / 0.1);
  }

  #wishlist-drawer .gw-cart__bar-title,
  #wishlist-drawer .gw-cart__bar-close {
    color: #000000;
  }

  .gw-wishlist-drawer__content {
    flex: 1;
    overflow: auto;
    padding: 16px 20px 24px;
  }

  .gw-wishlist-drawer__empty {
    margin: 0;
    padding: 24px 20px 32px;
    text-align: center;
    font-size: 0.95rem;
    color: #000000;
  }

  .gw-wishlist__items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }

  .gw-wishlist__item {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr);
    gap: 12px;
    align-items: start;
  }

  .gw-wishlist__thumb {
    display: block;
    box-sizing: border-box;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: #f5f5f5;
    border: 1px solid #000000;
    border-radius: 4px;
  }

  .gw-wishlist__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gw-wishlist__name {
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    color: inherit;
  }

  .gw-wishlist__name:hover {
    text-decoration: underline;
  }

  .gw-wishlist__price {
    margin: 4px 0 8px;
    font-size: 0.9rem;
  }

  .gw-wishlist__remove {
    font-size: 0.8rem;
    text-decoration: underline;
    color: rgb(0 0 0 / 0.7);
    cursor: pointer;
  }

  .gw-wishlist-bubble--active .cart-bubble__background {
    opacity: 1;
  }
{% endstylesheet %}
