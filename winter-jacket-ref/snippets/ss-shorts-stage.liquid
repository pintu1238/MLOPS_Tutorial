{% comment %} Sticky gallery + shorts buy box (live anti-chafing shorts PDP). {% endcomment %}
{% liquid
  assign p = product
  assign current = p.selected_or_first_available_variant
  assign gal = '//sirasculpt.com/cdn/shop/files/1_hero_shorts.jpg?v=1786765044,//sirasculpt.com/cdn/shop/files/2_benefit_shorts.jpg?v=1786765048,//sirasculpt.com/cdn/shop/files/3_friction_shorts.jpg?v=1786765052,//sirasculpt.com/cdn/shop/files/4_stayput_shorts.jpg?v=1786765055,//sirasculpt.com/cdn/shop/files/5_compare_shorts.jpg?v=1786765058,//sirasculpt.com/cdn/shop/files/6_dress_shorts.jpg?v=1786765062,//sirasculpt.com/cdn/shop/files/7_ugc_shorts.jpg?v=1786765066,//sirasculpt.com/cdn/shop/files/8_offer_shorts.jpg?v=1786765070' | split: ','
%}
<div class="ss-offer-stage ss-offer-stage--shorts" id="ss-buy">
  <div class="ss-offer-gal">
    <div class="ssg" data-ssg>
      <div class="ssg__main">
        <img id="ssgMain" src="{{ gal.first }}" alt="{{ p.title | default: 'Sira Sculpt Anti-Chafing 3D Shorts' | escape }}" width="900" height="900">
      </div>
      <div class="ssg__row">
        <button class="ssg__arr ssg__arr--l" type="button" aria-label="Previous">‹</button>
        <div class="ssg__thumbs" id="ssgThumbs">
          {% for src in gal %}
            <button class="ssg__th{% if forloop.first %} on{% endif %}" type="button" data-src="{{ src }}" data-i="{{ forloop.index0 }}">
              <img src="{{ src }}" alt="" loading="lazy" width="120" height="120">
            </button>
          {% endfor %}
        </div>
        <button class="ssg__arr ssg__arr--r" type="button" aria-label="Next">›</button>
      </div>
    </div>
  </div>

  <div class="ss-offer-buy">
    <h1 class="ss-offer-buy__h1">{{ p.title | default: 'Sira Sculpt Anti-Chafing 3D Shorts' }}</h1>
    <div class="ssrt"><div class="rating"><span class="st">★★★★★</span> <b>4.9</b> <span class="n">· Loved by thousands of women</span></div></div>

    <div class="ssbb">
      <div class="fx">
        <div class="row"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4v16M18 4v16"/><path d="M6 8h12M6 16h12"/><rect x="8.5" y="9.5" width="7" height="5" rx="2.5"/></svg></span><span class="tx"><b>They stay down. Period.</b><span>No-roll grip waistband and hem</span></span><span class="bdg">Bestseller</span></div>
        <div class="row"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16"/><path d="M7 8c2 2 8 2 10 0M7 16c2-2 8-2 10 0"/></svg></span><span class="tx"><b>No more raw, burning thighs</b><span>Smooth anti-friction barrier knit</span></span></div>
        <div class="row"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10c3-3 5 3 8 0s5-3 8 0"/><path d="M6 15c2.5-2 5.5 2 8 0"/></svg></span><span class="tx"><b>Breathes in real heat</b><span>Cool, moisture-wicking at 90°F+</span></span><span class="bdg">Airy</span></div>
        <div class="row"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6Z"/><circle cx="12" cy="12" r="2.6"/></svg></span><span class="tx"><b>Invisible under any dress</b><span>Seamless flat edges, no panty line</span></span></div>
        <div class="row"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="5" r="2.1"/><path d="M12 7.3v5.1"/><path d="M8.6 9.4h6.8"/><path d="M12 12.4l-2.6 7.6M12 12.4l2.6 7.6"/></svg></span><span class="tx"><b>Built for real curves</b><span>Stay-put fit through fuller thighs · S–5XL</span></span></div>
      </div>

      <button class="checksize" type="button" onclick="ssOpenSize()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="7.5" width="19" height="9" rx="4.5"/><path d="M6 7.5v2.6M9.5 7.5v2.6M13 7.5v2.6M16.5 7.5v2.6"/></svg> Check Your Size</button>

      <div class="bhead"><span class="ln"></span><span class="bt"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.3-2.9 7.7-7 9-4.1-1.3-7-4.7-7-9V6l7-3Z"/><path d="M9 12l2 2 4-4"/></svg>Try it risk-free · 90-day guarantee</span><span class="ln"></span></div>

      <div id="ssTiers">
        <div class="tier" data-qty="1" onclick="ssSel(this)">
          <div class="thead"><span class="radio"></span><span class="tinfo"><span class="tt">1 Pair</span><span class="ts">Perfect to try them out</span></span><span class="tprice"><span class="now" data-now></span><span class="was" data-was></span></span></div>
          <div class="picks"></div>
        </div>
        <div class="tier sel" data-qty="2" onclick="ssSel(this)">
          <span class="ribbon">Most Popular</span>
          <div class="thead"><span class="radio"></span><span class="tinfo"><span class="tt">2 Pairs</span><span class="ts">One to wear, one to wash</span><span class="save" data-save></span></span><span class="tprice"><span class="now" data-now></span><span class="was" data-was></span></span></div>
          <div class="picks"></div>
        </div>
        <div class="tier best" data-qty="3" onclick="ssSel(this)">
          <span class="ribbon">Best Value</span>
          <div class="thead"><span class="radio"></span><span class="tinfo"><span class="tt">3 Pairs</span><span class="ts">A pair for every hot day</span><span class="save" data-save></span></span><span class="tprice"><span class="now" data-now></span><span class="was" data-was></span></span></div>
          <div class="picks"></div>
        </div>
      </div>

      <button class="atc" type="button" id="ssAtc" onclick="ssAddCart()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M2 3h3l2.5 12h11l2-8H6"/></svg> <span id="ssAtcLabel">Add to Cart</span></button>
      <div class="guar">🔒 Secure Checkout &nbsp;·&nbsp; <b>90-Day</b> Money-Back Guarantee</div>
      <div class="pays">{% render 'ss-payment-icons' %}</div>

      <div class="mrev">
        <div class="mrev-h"><b>What women are saying</b>
          <div class="mrev-nav"><button type="button" class="mrev-arrow" onclick="ssMrevScroll(-1)" aria-label="Previous review">‹</button><button type="button" class="mrev-arrow" onclick="ssMrevScroll(1)" aria-label="Next review">›</button></div>
        </div>
        <div class="mrev-track" id="ssMrevTrack">
          <div class="mrc"><div class="mrc-body"><div class="rs">★★★★★</div><p>"First pair that didn't roll up to my crotch. Ran errands in 94° heat and forgot my thighs were even there. I've thrown out every cream in my bathroom."</p><div class="mrc-who">Dana R., 41 <span class="vf">✓ Verified buyer</span></div></div></div>
          <div class="mrc"><div class="mrc-body"><div class="rs">★★★★★</div><p>"Wore a sundress for the first time in four years. Two hours at a farmers market, no rubbing, no raw skin that night."</p><div class="mrc-who">Michelle P., 53 <span class="vf">✓ Verified buyer</span></div></div></div>
          <div class="mrc"><div class="mrc-body"><div class="rs">★★★★★</div><p>"Bike shorts crept up and creams sweated off by lunch. These stayed put through a full day at the park. No waddle, no shower-sting."</p><div class="mrc-who">Yesenia G., 34 <span class="vf">✓ Verified buyer</span></div></div></div>
          <div class="mrc"><div class="mrc-body"><div class="rs">★★★★★</div><p>"Ordered one pair for a 5-day trip, huge mistake, I wanted to wear them every day. Bought two more the week I got home."</p><div class="mrc-who">Karen L., 47 <span class="vf">✓ Verified buyer</span></div></div></div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="ssbb-modal" id="ssSizeModal">
  <div class="box">
    <button class="x" type="button" onclick="ssCloseSize()">×</button>
    <div class="mh"><h3>Find Your Perfect Size</h3><p>Sizes S–5XL · stay-put fit for fuller thighs</p></div>
    <div class="tabs"><div class="tab on" data-t="calc" onclick="ssTab(this)">Size Calculator</div><div class="tab" data-t="chart" onclick="ssTab(this)">Size Chart</div></div>
    <div class="pane on calc" data-p="calc">
      <p class="calc-lead">Find your best fit from your body, no tape measure needed.</p>
      <div class="unit-toggle">
        <button type="button" class="ut on" data-unit="imperial" onclick="ssSetUnit('imperial')">Imperial (US)</button>
        <button type="button" class="ut" data-unit="metric" onclick="ssSetUnit('metric')">Metric</button>
      </div>
      <div id="ssAwh">
        <label>Age <span class="hint">Age affects how weight settles</span></label>
        <input id="ssAge" type="number" inputmode="numeric" placeholder="e.g. 48">
        <label>Weight <span class="unit-w">(lb)</span></label>
        <input id="ssWt" type="number" inputmode="decimal" placeholder="e.g. 170">
        <label>Height</label>
        <div class="h-imperial" id="ssHImp"><input id="ssFt" type="number" inputmode="numeric" placeholder="ft"><input id="ssIn" type="number" inputmode="numeric" placeholder="in"></div>
        <div id="ssHMet" style="display:none"><input id="ssCm" type="number" inputmode="numeric" placeholder="cm"></div>
      </div>
      <button class="go" type="button" onclick="ssCalc()">Show my size ›</button>
      <div class="res" id="ssRes"><div class="big" id="ssResSize"></div><div class="sm" id="ssResNote"></div></div>
    </div>
    <div class="pane chart" data-p="chart">
      <div class="sc-wrap">
        <table class="sc"><thead><tr><th>Size</th><th>US Dress</th><th>Waist (in)</th><th>Hips (in)</th></tr></thead><tbody><tr><td>S</td><td>4–6</td><td>24–28</td><td>34–38</td></tr><tr><td>M</td><td>8–10</td><td>28–32</td><td>38–42</td></tr><tr><td>L</td><td>12–14</td><td>32–36</td><td>42–46</td></tr><tr><td>XL</td><td>16–18</td><td>36–40</td><td>46–50</td></tr><tr><td>2XL</td><td>20–22</td><td>40–44</td><td>50–53</td></tr><tr><td>3XL</td><td>24–26</td><td>44–47</td><td>53–56</td></tr><tr><td>4XL</td><td>28–30</td><td>47–50</td><td>56–58</td></tr><tr><td>5XL</td><td>32–34</td><td>50–52</td><td>58–61</td></tr></tbody></table>
      </div>
    </div>
  </div>
</div>

<script>
window.SS_V = {
{%- for v in p.variants -%}
  {{ v.option1 | default: 'Default Title' | json }}: {id:{{ v.id }},av:{{ v.available | json }}},
  {{ v.title | json }}: {id:{{ v.id }},av:{{ v.available | json }}},
{%- endfor -%}
};
window.SS_FALLBACK_ID = {% if current %}{{ current.id }}{% else %}null{% endif %};
window.SS_SIZES = ["S","M","L","XL","2XL","3XL","4XL","5XL"];
window.SS_UNIT = 4995; window.SS_CMP = 8995;
window.SS_THUMB = "//sirasculpt.com/cdn/shop/files/1_hero_shorts.jpg?v=1786765044&width=160";
(function(){
  var thumbs = document.getElementById('ssgThumbs');
  var main = document.getElementById('ssgMain');
  if(thumbs && main){
    var btns = thumbs.querySelectorAll('.ssg__th');
    window._ssgI = 0;
    function show(i){
      if(!btns.length) return;
      if(i < 0) i = btns.length - 1;
      if(i >= btns.length) i = 0;
      window._ssgI = i;
      btns.forEach(function(b,n){ b.classList.toggle('on', n===i); });
      main.src = btns[i].getAttribute('data-src');
      try {
        var tr = thumbs.getBoundingClientRect();
        var br = btns[i].getBoundingClientRect();
        thumbs.scrollLeft += (br.left + br.right)/2 - (tr.left + tr.right)/2;
      } catch(e){}
    }
    thumbs.addEventListener('click', function(e){
      var b = e.target.closest('.ssg__th'); if(!b) return;
      show([].indexOf.call(btns, b));
    });
    var prev = document.querySelector('.ss-offer-stage--shorts .ssg__arr--l');
    var next = document.querySelector('.ss-offer-stage--shorts .ssg__arr--r');
    if(prev) prev.addEventListener('click', function(){ show(window._ssgI - 1); });
    if(next) next.addEventListener('click', function(){ show(window._ssgI + 1); });
  }
  var money = function(c){ return '$' + (c/100).toFixed(2); };
  function sizeOpts(){ return '<option value="">Size</option>' + window.SS_SIZES.map(function(s){ return '<option>'+s+'</option>'; }).join(''); }
  document.querySelectorAll('#ssTiers .tier').forEach(function(t){
    var q = parseInt(t.dataset.qty, 10);
    var nowEl = t.querySelector('[data-now]'); var wasEl = t.querySelector('[data-was]');
    if(nowEl) nowEl.textContent = money(window.SS_UNIT * q);
    if(wasEl) wasEl.textContent = money(window.SS_CMP * q);
    var sv = t.querySelector('[data-save]');
    if(sv) sv.textContent = 'Save ' + money((window.SS_CMP - window.SS_UNIT) * q);
    var picks = t.querySelector('.picks'); if(!picks) return;
    var html = '';
    for(var i=1;i<=q;i++){ html += '<div class="pk"><span class="lab">#'+i+'</span><img class="pk-th" src="'+window.SS_THUMB+'" alt="" loading="lazy"><select class="s">'+sizeOpts()+'</select></div>'; }
    picks.innerHTML = html;
    picks.addEventListener('click', function(e){ e.stopPropagation(); });
    picks.addEventListener('mousedown', function(e){ e.stopPropagation(); });
    picks.querySelectorAll('select').forEach(function(sel){
      sel.addEventListener('click', function(e){ e.stopPropagation(); });
      sel.addEventListener('change', function(e){ e.stopPropagation(); sel.classList.remove('err'); });
    });
  });
  window.ssSel = function(el){ document.querySelectorAll('#ssTiers .tier').forEach(function(t){ t.classList.remove('sel'); }); el.classList.add('sel'); };
  var toast;
  function ssToast(msg){
    if(!toast){ toast = document.createElement('div'); toast.className = 'ssbb-toast'; toast.innerHTML = '<span></span>'; document.body.appendChild(toast); }
    toast.querySelector('span').textContent = msg;
    toast.classList.add('show');
    clearTimeout(toast._t); toast._t = setTimeout(function(){ toast.classList.remove('show'); }, 3600);
  }
  window.ssAddCart = function(){
    var t = document.querySelector('#ssTiers .tier.sel'); if(!t) return;
    var items = [], missing = false;
    t.querySelectorAll('.pk').forEach(function(pk){
      var sSel = pk.querySelector('.s'); var s = sSel.value;
      if(!s){ sSel.classList.add('err'); missing = true; return; }
      var v = window.SS_V[s] || window.SS_V['Default Title'];
      var id = v && v.id ? v.id : window.SS_FALLBACK_ID;
      if(id) items.push({id:id, quantity:1}); else { sSel.classList.add('err'); missing = true; }
    });
    if(missing || !items.length){ ssToast('Please choose a size for each pair.'); return; }
    var btn = document.getElementById('ssAtc'); var lab = document.getElementById('ssAtcLabel');
    lab.textContent = 'Adding…'; btn.disabled = true;
    fetch('/cart/add.js', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({items:items})})
      .then(function(r){ if(!r.ok) throw 0; return r.json(); })
      .then(function(){ lab.textContent = 'Added ✓'; btn.disabled = false; setTimeout(function(){ lab.textContent = 'Add to Cart'; }, 1600); if(window.SiraCartDrawer){ window.SiraCartDrawer.open(); } else { window.location.href = '/cart'; } })
      .catch(function(){ lab.textContent = 'Add to Cart'; btn.disabled = false; ssToast('Something went wrong, please try again.'); });
  };
  window.ssOpenSize = function(){ var m = document.getElementById('ssSizeModal'); if(m && m.parentNode !== document.body) document.body.appendChild(m); m.classList.add('open'); document.body.style.overflow = 'hidden'; };
  window.ssCloseSize = function(){ document.getElementById('ssSizeModal').classList.remove('open'); document.body.style.overflow = ''; };
  var modal = document.getElementById('ssSizeModal');
  if(modal) modal.addEventListener('click', function(e){ if(e.target === this) ssCloseSize(); });
  window.ssTab = function(el){ document.querySelectorAll('#ssSizeModal .tab').forEach(function(t){ t.classList.remove('on'); }); el.classList.add('on'); var p = el.dataset.t; document.querySelectorAll('#ssSizeModal .pane').forEach(function(x){ x.classList.toggle('on', x.dataset.p === p); }); };
  window.ssUnit = 'imperial';
  window.ssSetUnit = function(u){
    window.ssUnit = u;
    document.querySelectorAll('#ssSizeModal .ut').forEach(function(x){ x.classList.toggle('on', x.dataset.unit === u); });
    var w = document.querySelector('#ssSizeModal .unit-w'); if(w) w.textContent = u === 'imperial' ? '(lb)' : '(kg)';
    document.getElementById('ssHImp').style.display = u === 'imperial' ? 'flex' : 'none';
    document.getElementById('ssHMet').style.display = u === 'imperial' ? 'none' : 'block';
  };
  function ssBand(hip_in){ var b = [[38,'S'],[42,'M'],[46,'L'],[50,'XL'],[53,'2XL'],[56,'3XL'],[58,'4XL'],[999,'5XL']]; for(var i=0;i<b.length;i++){ if(hip_in < b[i][0]) return b[i][1]; } return '5XL'; }
  window.ssCalc = function(){
    var res = document.getElementById('ssRes'), sz = document.getElementById('ssResSize'), note = document.getElementById('ssResNote');
    var age = parseFloat(document.getElementById('ssAge').value);
    var wt = parseFloat(document.getElementById('ssWt').value);
    var ht;
    if(window.ssUnit === 'imperial'){
      var ft = parseFloat(document.getElementById('ssFt').value) || 0, inch = parseFloat(document.getElementById('ssIn').value) || 0;
      ht = (ft * 12 + inch) * 2.54; wt = wt * 0.4536;
    } else { ht = parseFloat(document.getElementById('ssCm').value); }
    if(!age || !wt || !ht || ht < 120){ res.classList.add('show'); sz.textContent = '—'; note.textContent = 'Please add your age, weight and height.'; return; }
    var hip_cm = 0.62 * wt + 0.20 * ht + 20 + Math.max(0, (age - 45)) * 0.15;
    res.classList.add('show'); sz.textContent = ssBand(hip_cm / 2.54);
    note.textContent = 'Your best match. Between sizes? We suggest sizing up for all-day comfort.';
  };
  window.ssMrevScroll = function(dir){ var t = document.getElementById('ssMrevTrack'); if(!t) return; var c = t.querySelector('.mrc'); var w = c ? c.offsetWidth + 12 : 280; t.scrollBy({left: dir * w, behavior: 'smooth'}); };
})();
</script>
